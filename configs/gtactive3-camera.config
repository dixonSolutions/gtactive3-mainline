# Cameras for the bring-up kernel: media core built in, the Exynos9810
# CSIS raw capture driver and the S5K3L6 / GC5035 sensor drivers as
# modules, loaded by hand (docs/CAMERA.md). Opt-in, for kernels with the
# drv/cam branch:
#   KSRC=build/wt/cam EXTRA_CONFIGS=configs/gtactive3-camera.config scripts/build.sh
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
CONFIG_MEDIA_CONTROLLER=y
CONFIG_VIDEO_V4L2_SUBDEV_API=y
CONFIG_V4L_PLATFORM_DRIVERS=y
CONFIG_VIDEO_EXYNOS9810_CSIS=m
CONFIG_VIDEO_CAMERA_SENSOR=y
CONFIG_VIDEO_S5K3L6=m
CONFIG_VIDEO_GC5035=m
# rear autofocus voice coil (DW9808) and the rear module EEPROM
# (AF/AWB calibration, read through nvmem)
CONFIG_VIDEO_CAMERA_LENS=y
CONFIG_VIDEO_DW9807_VCM=m
CONFIG_NVMEM=y
CONFIG_EEPROM_AT24=m
CONFIG_CMA_SIZE_MBYTES=256
