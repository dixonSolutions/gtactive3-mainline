# Minimal mainline bring-up config for SM-T570: simplefb console + keys + initramfs
CONFIG_64BIT=y
CONFIG_ARCH_EXYNOS=y
CONFIG_SMP=y
CONFIG_NR_CPUS=8
CONFIG_ARM64_VA_BITS_48=y
CONFIG_ARM_PSCI_FW=y
CONFIG_ARM_ARCH_TIMER=y
CONFIG_ARM_GIC=y
CONFIG_OF=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_EARLY_PRINTK=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="@P@/build/initramfs.list"
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y
CONFIG_FB=y
# CONFIG_FB_SIMPLE is not set (replaced by simpledrm)
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_SAMSUNG=y
CONFIG_PINCTRL_EXYNOS=y
CONFIG_PINCTRL_EXYNOS_ARM64=y
CONFIG_GPIOLIB=y
CONFIG_EXYNOS_CHIPID=y
CONFIG_SOC_SAMSUNG=y

CONFIG_MAGIC_SYSRQ=y
CONFIG_CMDLINE="console=tty0 fbcon=rotate:3 loglevel=8 clk_ignore_unused maxcpus=4 printk.devkmsg=on"
CONFIG_CMDLINE_FORCE=y
CONFIG_MFD_SYSCON=y
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_SYSCON=y
CONFIG_REBOOT_MODE=y
CONFIG_SYSCON_REBOOT_MODE=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_DEVMEM=y
# CONFIG_IO_STRICT_DEVMEM is not set
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETDEVICES=y
CONFIG_CONFIGFS_FS=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_DWC3=m
CONFIG_USB_DWC3_GADGET=y
CONFIG_USB_DWC3_EXYNOS=m
CONFIG_PHY_EXYNOS5_USBDRD=m
CONFIG_GENERIC_PHY=y
CONFIG_PANIC_TIMEOUT=3
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=1
CONFIG_DETECT_HUNG_TASK=y
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=1
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_EXYNOS5=m
CONFIG_GPIO_CDEV=y
CONFIG_MISC_FILESYSTEMS=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_UFSHCD=m
CONFIG_SCSI_UFSHCD_PLATFORM=m
CONFIG_SCSI_UFS_EXYNOS=m
CONFIG_PHY_SAMSUNG_UFS=m
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y

# --- bundle 1: watchdog, HSI2C/USI, simpledrm + DCS backlight ---
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_WATCHDOG_SYSFS=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
CONFIG_S3C2410_WATCHDOG=y
CONFIG_EXYNOS_USI=m
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_EXYNOS9810_DSIM=m
CONFIG_DEBUG_FS=y

# --- bundle 2: power (ACPM read-only PMIC, TMU, MAX77705 charger/fuel gauge) ---
CONFIG_MAILBOX=y
CONFIG_EXYNOS_MBOX=m
CONFIG_EXYNOS_ACPM_PROTOCOL=m
CONFIG_REGULATOR=y
CONFIG_MFD_SEC_ACPM=m
CONFIG_REGULATOR_S2MPS11=m
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_HWMON=y
CONFIG_THERMAL_HWMON=y
CONFIG_EXYNOS9810_THERMAL=m
# CONFIG_EXYNOS_THERMAL is not set
CONFIG_I2C_GPIO=m
CONFIG_MFD_MAX77705=m
CONFIG_CHARGER_MAX77705=m
CONFIG_BATTERY_MAX17042=m
CONFIG_POWER_SUPPLY=y

# --- bundle 3: touch (CMU_CHUB, USI SPI21, Himax HX83102E) ---
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_S3C64XX=m
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_HIMAX_HX83112B=m
CONFIG_DYNAMIC_DEBUG=y

# --- bundle 3b: GPU stage 1 (panfrost, no PM), MAX77705 hwmon ---
CONFIG_DRM_PANFROST=m
CONFIG_SENSORS_MAX77705=m
