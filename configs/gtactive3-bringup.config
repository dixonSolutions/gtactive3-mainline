# Minimal mainline bring-up config for SM-T570: simplefb console + keys + initramfs
CONFIG_64BIT=y
CONFIG_ARCH_EXYNOS=y
CONFIG_SMP=y
CONFIG_NR_CPUS=8
CONFIG_ARM64_VA_BITS_48=y
CONFIG_ARM_PSCI_FW=y
CONFIG_ARM_ARCH_TIMER=y
CONFIG_ARM_GIC=y
CONFIG_OF=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_EARLY_PRINTK=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="@P@/build/initramfs.list"
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y
CONFIG_FB=y
# CONFIG_FB_SIMPLE is not set (replaced by simpledrm)
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_SAMSUNG=y
CONFIG_PINCTRL_EXYNOS=y
CONFIG_PINCTRL_EXYNOS_ARM64=y
CONFIG_GPIOLIB=y
CONFIG_EXYNOS_CHIPID=y
CONFIG_SOC_SAMSUNG=y

CONFIG_MAGIC_SYSRQ=y
CONFIG_CMDLINE="console=tty0 fbcon=rotate:3 loglevel=8 clk_ignore_unused maxcpus=4 printk.devkmsg=on"
CONFIG_CMDLINE_FORCE=y
CONFIG_MFD_SYSCON=y
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_SYSCON=y
CONFIG_REBOOT_MODE=y
CONFIG_SYSCON_REBOOT_MODE=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_DEVMEM=y
# CONFIG_IO_STRICT_DEVMEM is not set
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETDEVICES=y
CONFIG_CONFIGFS_FS=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_DWC3=m
CONFIG_USB_DWC3_GADGET=y
CONFIG_USB_DWC3_EXYNOS=m
CONFIG_PHY_EXYNOS5_USBDRD=m
CONFIG_GENERIC_PHY=y
CONFIG_PANIC_TIMEOUT=3
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=1
CONFIG_DETECT_HUNG_TASK=y
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=1
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_EXYNOS5=m
CONFIG_GPIO_CDEV=y
CONFIG_MISC_FILESYSTEMS=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_UFSHCD=m
CONFIG_SCSI_UFSHCD_PLATFORM=m
CONFIG_SCSI_UFS_EXYNOS=m
# UFS inline crypto: makes the Exynos driver set the FMP PRDT format
# (DESCTYPE 3, 128-byte entries) itself. U-Boot leaves the controller in
# that format; without this Linux builds 16-byte entries and every
# multi-entry transfer faults on the bus (IS.SBFES).
CONFIG_BLK_INLINE_ENCRYPTION=y
CONFIG_SCSI_UFS_CRYPTO=y
CONFIG_PHY_SAMSUNG_UFS=m
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y

# --- bundle 1: watchdog, HSI2C/USI, simpledrm + DCS backlight ---
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_WATCHDOG_SYSFS=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
CONFIG_S3C2410_WATCHDOG=y
CONFIG_EXYNOS_USI=m
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_EXYNOS9810_DSIM=m
CONFIG_DEBUG_FS=y

# --- bundle 2: power (ACPM read-only PMIC, TMU, MAX77705 charger/fuel gauge) ---
CONFIG_MAILBOX=y
CONFIG_EXYNOS_MBOX=m
CONFIG_EXYNOS_ACPM_PROTOCOL=m
CONFIG_REGULATOR=y
CONFIG_MFD_SEC_ACPM=m
CONFIG_REGULATOR_S2MPS11=m
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_HWMON=y
CONFIG_THERMAL_HWMON=y
CONFIG_EXYNOS9810_THERMAL=m
# CONFIG_EXYNOS_THERMAL is not set
CONFIG_I2C_GPIO=m
CONFIG_MFD_MAX77705=m
CONFIG_CHARGER_MAX77705=m
CONFIG_BATTERY_MAX17042=m
CONFIG_POWER_SUPPLY=y

# --- bundle 3: touch (CMU_CHUB, USI SPI21, Himax HX83102E) ---
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_S3C64XX=m
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_HIMAX_HX83112B=m
CONFIG_DYNAMIC_DEBUG=y

# --- bundle 3b: GPU stage 1 (panfrost, no PM), MAX77705 hwmon ---
CONFIG_DRM_PANFROST=m
CONFIG_SENSORS_MAX77705=m

# Wi-Fi (BCM4375 on PCIe ch0) and Bluetooth (UART_BT), drivers from drv/wifi
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIE_EXYNOS9810=m
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_NET=y
CONFIG_WIRELESS=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_CFG80211=m
CONFIG_BRCMUTIL=m
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_PCIE=y
# CONFIG_BRCMFMAC_SDIO is not set
# CONFIG_BRCMFMAC_USB is not set
CONFIG_BRCMDBG=y
CONFIG_RFKILL=m
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIUART_BCM=y
CONFIG_BT_BCM=m
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=m
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=m
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y
CONFIG_SERIAL_SAMSUNG=m
CONFIG_PCIE_DW_DEBUGFS=y
# sockets the Wi-Fi userspace needs (wpa_supplicant ctrl iface, musl
# if_nametoindex, udhcpc raw sockets)
CONFIG_UNIX=y
CONFIG_PACKET=y

# USB-C / BC1.2 input detection (drv/power)
CONFIG_CHARGER_MAX77705_USBC=m

# misc peripherals (drv/misc): pen, vibrator, flash LED, grip, SM5504, NFC
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_WACOM_W9000=m
CONFIG_INPUT_MISC=y
CONFIG_INPUT_GPIO_VIBRA=m
CONFIG_INPUT_FF_MEMLESS=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_FLASH=m
CONFIG_LEDS_RT8547=m
CONFIG_IIO=m
CONFIG_A96T3X6=m
CONFIG_EXTCON=y
CONFIG_EXTCON_SM5502=m
CONFIG_NFC=y
CONFIG_NFC_NCI=m
CONFIG_NFC_S3FWRN5_I2C=m

# audio (drv/audio): A-Box (firmware-less), RT5665 codec, RT5510 amp
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_SAMSUNG=m
CONFIG_SND_SOC_SAMSUNG_EXYNOS9810_ABOX=m
CONFIG_SND_SOC_SAMSUNG_GTACTIVE3_RT5665=m
CONFIG_SND_SOC_RT5665=m
CONFIG_SND_SOC_MT6660=m

# clocks and CPUs (drv/cpu): read-only CMUs, ACPM DVFS clocks, CPU hotplug
CONFIG_EXYNOS_ACPM_CLK=m
CONFIG_HOTPLUG_CPU=y
CONFIG_ARM64_DEBUG_SECONDARY_BOOT=y

# systemd-repart mounts the new root while it still holds the device open
# for writing (to populate it); without this the mount fails with EBUSY
# and the first Duranium boot cannot create its root partition.
CONFIG_BLK_DEV_WRITE_MOUNTED=y

# Display: Exynos9810 DPU takeover KMS driver (GPU scanout through Mesa
# kmsro), with a CMA pool for contiguous scanout buffers below 4 GiB
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=128
CONFIG_DRM_EXYNOS9810_DPU=y

# CPU DVFS through ACPM (cpufreq-dt on the ACPM DVFS clocks)
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPUFREQ_DT=m
CONFIG_CPUFREQ_DT_PLATDEV=y

# GPU DVFS (panfrost devfreq on the ACPM G3D clock)
CONFIG_PM_DEVFREQ=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y
CONFIG_DEVFREQ_GOV_PERFORMANCE=y
