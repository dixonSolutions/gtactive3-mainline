# Power management for the bring-up kernel, the same options as the Duranium
# pm.config fragment: runtime PM, suspend to idle (PSCI 0.1 has no
# SYSTEM_SUSPEND), PM test knobs, SoC RTC for rtcwake (not trusted as the
# system clock yet), PS_HOLD power-off. Opt-in, for kernels with the
# drv/suspend branch (DT and driver side):
#   KSRC=build/wt/<tree> EXTRA_CONFIGS=configs/gtactive3-pm.config scripts/build.sh
CONFIG_PM=y
CONFIG_PM_SLEEP=y
CONFIG_SUSPEND=y
# CONFIG_HIBERNATION is not set
# CONFIG_PM_AUTOSLEEP is not set
# CONFIG_PM_WAKELOCKS is not set
CONFIG_PM_DEBUG=y
CONFIG_PM_ADVANCED_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
CONFIG_RTC_CLASS=y
# CONFIG_RTC_HCTOSYS is not set
# CONFIG_RTC_SYSTOHC is not set
CONFIG_RTC_INTF_SYSFS=y
CONFIG_RTC_INTF_PROC=y
CONFIG_RTC_INTF_DEV=y
CONFIG_RTC_DRV_S3C=y
CONFIG_POWER_RESET_SYSCON_POWEROFF=y
