stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

bootdelay=0
bootcmd=mw.l 0x19030070 0x1281 1;
	setenv loadaddr 0x90000000;
	ufs init;
	scsi scan;
	part start scsi 0 31 ud_start;
	part size  scsi 0 31 ud_size;
	blkmap create root;
	blkmap map root 0 0x${ud_size} linear scsi 0 0x${ud_start};
	ls blkmap 0:1;
	bootefi bootmgr;
	pause;
	bootmenu

fastbootcmd=echo "Fastboot Mode";
	fastboot -l $fastboot_addr_r usb 0

reboot_recovery=mw.l 0x15860810 0xff; 
	mw.l 0x1586080c 0x12345674;
	reset

bootmenu_0=Continue Boot=boot
bootmenu_1=Enter Fastboot Mode=run fastbootcmd
bootmenu_2=UEFI Maintenance Menu=eficonfig
bootmenu_3=Reboot=reset
bootmenu_4=Power Off=poweroff
bootmenu_5=Recovery=run reboot_recovery

button_cmd_0_name=Volume Down Key
button_cmd_0=mw.l 0x19030070 0x1281 1; bootmenu
