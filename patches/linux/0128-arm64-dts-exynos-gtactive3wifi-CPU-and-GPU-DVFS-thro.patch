From 75214c0b536de295a51c9a4765e62e6da9947b0d Mon Sep 17 00:00:00 2001
From: dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>
Date: Thu, 22 Oct 2026 02:08:34 +1100
Subject: [PATCH 128/152] arm64: dts: exynos: gtactive3wifi: CPU and GPU DVFS
 through ACPM

OPP tables from the APM firmware's fvmap (A55 208-1950 MHz, M3
598-2704 MHz, G3D 260-572 MHz, capped at the retail clocks); the CPUs
and the GPU take their clocks from the ACPM DVFS domains, the firmware
sets the voltages.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../dts/exynos/exynos9810-gtactive3wifi.dts   | 221 +++++++++++++++++-
 1 file changed, 220 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/exynos/exynos9810-gtactive3wifi.dts b/arch/arm64/boot/dts/exynos/exynos9810-gtactive3wifi.dts
index 4f1ea3db3..4f00d21c6 100644
--- a/arch/arm64/boot/dts/exynos/exynos9810-gtactive3wifi.dts
+++ b/arch/arm64/boot/dts/exynos/exynos9810-gtactive3wifi.dts
@@ -13,6 +13,7 @@
 
 /dts-v1/;
 #include "exynos9810.dtsi"
+#include <dt-bindings/clock/samsung,exynos9810-acpm.h>
 #include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/input/input.h>
 #include <dt-bindings/interrupt-controller/irq.h>
@@ -1087,6 +1088,193 @@ proximity@20 {
 	};
 };
 
+/*
+ * CPU DVFS through the APM firmware (ACPM DVFS, channel 5). Levels from its
+ * fvmap in APM SRAM (domain 2: A55 208-2002 MHz, domain 3: M3 598-2886 MHz);
+ * the firmware sets the voltages. Capped at the retail clocks: 1.95 GHz
+ * (A55), 2.7 GHz (M3, the 2.86/2.89 GHz levels are 1-2 core turbo).
+ */
+/ {
+	cluster0_opp: opp-table-cluster0-opp {
+		compatible = "operating-points-v2";
+		opp-shared;
+
+		opp-208000000 {
+			opp-hz = /bits/ 64 <208000000>;
+			clock-latency-ns = <100000>;
+		};
+
+		opp-299000000 {
+			opp-hz = /bits/ 64 <299000000>;
+			clock-latency-ns = <100000>;
+		};
+
+		opp-455000000 {
