+&cpu3 { clocks = <&acpm_ipc EXYNOS9810_CLK_ACPM_DVFS_CPUCL0>; operating-points-v2 = <&cluster0_opp>; };
+&cpu4 { clocks = <&acpm_ipc EXYNOS9810_CLK_ACPM_DVFS_CPUCL1>; operating-points-v2 = <&cluster1_opp>; };
+&cpu5 { clocks = <&acpm_ipc EXYNOS9810_CLK_ACPM_DVFS_CPUCL1>; operating-points-v2 = <&cluster1_opp>; };
+&cpu6 { clocks = <&acpm_ipc EXYNOS9810_CLK_ACPM_DVFS_CPUCL1>; operating-points-v2 = <&cluster1_opp>; };
+&cpu7 { clocks = <&acpm_ipc EXYNOS9810_CLK_ACPM_DVFS_CPUCL1>; operating-points-v2 = <&cluster1_opp>; };
+
 &soc {
 	/*
 	 * DECON0 + the IDMA channel S-Boot scans the panel out from
@@ -1164,8 +1352,39 @@ gpu_clk: clock-gpu {
 	};
 };
 
+/ {
+	/* G3D DVFS through ACPM (fvmap domain 4: 260-598 MHz, retail max 572) */
+	gpu_opp: opp-table-gpu {
+		compatible = "operating-points-v2";
+
+		opp-260000000 {
+			opp-hz = /bits/ 64 <260000000>;
+		};
+		opp-299000000 {
+			opp-hz = /bits/ 64 <299000000>;
+		};
+		opp-338000000 {
+			opp-hz = /bits/ 64 <338000000>;
+		};
+		opp-385000000 {
+			opp-hz = /bits/ 64 <385000000>;
+		};
+		opp-455000000 {
+			opp-hz = /bits/ 64 <455000000>;
+		};
+		opp-546000000 {
+			opp-hz = /bits/ 64 <546000000>;
+		};
+		opp-572000000 {
+			opp-hz = /bits/ 64 <572000000>;
+		};
+	};
+};
+
 &gpu {
-	clocks = <&gpu_clk>;
+	/* ACPM sets the G3D clock and BUCK6 voltage together */
+	clocks = <&acpm_ipc EXYNOS9810_CLK_ACPM_DVFS_G3D>;
+	operating-points-v2 = <&gpu_opp>;
