+
+&cpu0 { clocks = <&acpm_ipc EXYNOS9810_CLK_ACPM_DVFS_CPUCL0>; operating-points-v2 = <&cluster0_opp>; };
+&cpu1 { clocks = <&acpm_ipc EXYNOS9810_CLK_ACPM_DVFS_CPUCL0>; operating-points-v2 = <&cluster0_opp>; };
