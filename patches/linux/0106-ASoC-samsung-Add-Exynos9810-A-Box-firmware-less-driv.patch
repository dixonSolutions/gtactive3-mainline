+/* ---- register dump for bring-up ----------------------------------------- */
+
+static const struct {
+	const char *name;
+	u32 reg;
+} abox_dump_regs[] = {
+	{ "IP_INDEX", ABOX_IP_INDEX },
+	{ "VERSION", ABOX_VERSION },
+	{ "SYSPOWER_CTRL", ABOX_SYSPOWER_CTRL },
+	{ "SYSPOWER_STATUS", ABOX_SYSPOWER_STATUS },
+	{ "QCHANNEL_DISABLE", ABOX_QCHANNEL_DISABLE },
+	{ "ROUTE_CTRL0", ABOX_ROUTE_CTRL0 },
+	{ "ROUTE_CTRL1", ABOX_ROUTE_CTRL1 },
+	{ "SPUS_CTRL0", ABOX_SPUS_CTRL0 },
+	{ "SPUS_CTRL1", ABOX_SPUS_CTRL1 },
+	{ "SPUS_SBANK_RDMA0", ABOX_SPUS_SBANK_RDMA(0) },
+	{ "SPUS_SBANK_RDMA1", ABOX_SPUS_SBANK_RDMA(1) },
+	{ "SPUS_SBANK_ASRC0", ABOX_SPUS_SBANK_ASRC(0) },
+	{ "SPUM_CTRL0", ABOX_SPUM_CTRL0 },
+	{ "UAIF0_CTRL0", ABOX_UAIF_CTRL0(0) },
+	{ "UAIF0_CTRL1", ABOX_UAIF_CTRL1(0) },
+	{ "UAIF0_STATUS", ABOX_UAIF_STATUS(0) },
+	{ "UAIF1_CTRL0", ABOX_UAIF_CTRL0(1) },
+	{ "UAIF1_CTRL1", ABOX_UAIF_CTRL1(1) },
+	{ "UAIF1_STATUS", ABOX_UAIF_STATUS(1) },
+};
+
+static ssize_t regs_show(struct device *dev, struct device_attribute *attr,
+			 char *buf)
+{
+	struct abox *abox = dev_get_drvdata(dev);
+	int i, n = 0;
+
+	for (i = 0; i < ARRAY_SIZE(abox_dump_regs); i++)
+		n += sysfs_emit_at(buf, n, "%-18s %08x\n", abox_dump_regs[i].name,
+				   readl(abox->sfr + abox_dump_regs[i].reg));
+	for (i = 0; i < 2; i++) {
+		void __iomem *b = abox->sfr + ABOX_RDMA_BASE(i);
+
+		n += sysfs_emit_at(buf, n,
+				   "RDMA%d ctrl %08x %08x buf %08x-%08x off %08x str %08x vol %08x/%08x lim %08x st %08x\n",
+				   i, readl(b), readl(b + 4), readl(b + 8),
+				   readl(b + 0xc), readl(b + 0x10),
+				   readl(b + 0x14), readl(b + 0x18),
+				   readl(b + 0x1c), readl(b + 0x20),
+				   readl(b + 0x30));
+	}
+	for (i = 1; i < 3; i++) {
+		void __iomem *b = abox->sfr + ABOX_WDMA_BASE(i);
+
+		n += sysfs_emit_at(buf, n,
+				   "WDMA%d ctrl %08x buf %08x-%08x off %08x str %08x st %08x\n",
+				   i, readl(b), readl(b + 8), readl(b + 0xc),
+				   readl(b + 0x10), readl(b + 0x14),
+				   readl(b + 0x30));
+	}
+	return n;
+}
+static DEVICE_ATTR_RO(regs);
+
+/*
+ * Bring-up self test without ALSA userspace: "echo UAIF MS > tone" plays a
+ * 1 kHz square wave (-12 dBFS, 48 kHz S16 stereo, A-Box clock provider) on
+ * UAIF0 or UAIF1 through RDMA0/1 for MS milliseconds and logs the DMA and
+ * UAIF status. It only proves that the DMA runs and the port clocks out;
+ * the codec/amplifier path is not enabled by it.
+ */
+static ssize_t tone_store(struct device *dev, struct device_attribute *attr,
+			  const char *buf, size_t count)
+{
+	struct abox *abox = dev_get_drvdata(dev);
+	const unsigned int rate = 48000, frames = 4800, period = 480;
+	unsigned int uaif, ms, i, steps;
+	struct abox_dma *dma;
+	dma_addr_t addr;
+	s16 *pcm;
+	int ret;
+
+	if (sscanf(buf, "%u %u", &uaif, &ms) != 2 || uaif > 1 || !ms ||
+	    ms > 10000)
+		return -EINVAL;
+	dma = &abox->rdma[uaif];
+	if (dma->substream || abox->active)
+		return -EBUSY;
+
+	pcm = dma_alloc_coherent(dev, frames * 4, &addr, GFP_KERNEL);
+	if (!pcm)
+		return -ENOMEM;
+	for (i = 0; i < frames; i++)
+		pcm[2 * i] = pcm[2 * i + 1] = (i % 48) < 24 ? 0x2000 : -0x2000;
+
+	ret = abox_dma_setup(abox, dma, uaif, addr, frames * 4, period * 4,
+			     16, 2);
+	if (ret)
+		goto free;
+	ret = abox_uaif_config(abox, uaif, SND_SOC_DAIFMT_I2S |
+			       SND_SOC_DAIFMT_NB_NF | SND_SOC_DAIFMT_BP_FP,
+			       rate, 16, 2);
+	if (ret)
+		goto free;
+
+	writel(1, abox->sfr + ABOX_SYSPOWER_CTRL);
+	abox_update(abox, ABOX_QCHANNEL_DISABLE,
+		    ABOX_QCH_ACLK | ABOX_QCH_BCLK_UAIF(uaif),
+		    ABOX_QCH_ACLK | ABOX_QCH_BCLK_UAIF(uaif));
+	dma_update(dma, DMA_CTRL0, DMA_CTRL0_ENABLE, DMA_CTRL0_ENABLE);
+	if (abox_dma_wait_progress(dma, true))
+		dev_warn(dev, "tone: RDMA%u did not start\n", uaif);
+	abox_update(abox, ABOX_UAIF_CTRL0(uaif), ABOX_UAIF_SPK_ENABLE,
+		    ABOX_UAIF_SPK_ENABLE);
+
+	steps = min(ms / 10, 20U) ?: 1;
+	for (i = 0; i < steps; i++) {
+		msleep(ms / steps);
+		dev_info(dev, "tone: t=%ums RDMA%u st %08x UAIF%u ctrl0 %08x st %08x\n",
+			 (i + 1) * (ms / steps), uaif,
+			 readl(dma->base + DMA_STATUS), uaif,
+			 readl(abox->sfr + ABOX_UAIF_CTRL0(uaif)),
+			 readl(abox->sfr + ABOX_UAIF_STATUS(uaif)));
+	}
+
+	abox_update(abox, ABOX_UAIF_CTRL0(uaif), ABOX_UAIF_SPK_ENABLE, 0);
+	dma_update(dma, DMA_CTRL0, DMA_CTRL0_ENABLE, 0);
+	if (abox_dma_wait_progress(dma, false))
+		dev_warn(dev, "tone: RDMA%u did not stop\n", uaif);
+	abox_update(abox, ABOX_QCHANNEL_DISABLE, ABOX_QCH_BCLK_UAIF(uaif), 0);
+	writel(0, abox->sfr + ABOX_SYSPOWER_CTRL);
+	ret = 0;
+free:
+	dma_free_coherent(dev, frames * 4, pcm, addr);
+	return ret ?: count;
+}
+static DEVICE_ATTR_WO(tone);
+
+static struct attribute *abox_attrs[] = {
+	&dev_attr_regs.attr,
+	&dev_attr_tone.attr,
+	NULL
+};
+ATTRIBUTE_GROUPS(abox);
