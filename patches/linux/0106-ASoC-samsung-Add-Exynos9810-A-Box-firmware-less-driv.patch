+/* ---- probe -------------------------------------------------------------- */
+
+static int abox_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct abox *abox;
+	struct resource *res;
+	u32 ip, ver, smc_addr;
+	int i, ret;
+
+	abox = devm_kzalloc(dev, sizeof(*abox), GFP_KERNEL);
+	if (!abox)
+		return -ENOMEM;
+	abox->dev = dev;
+	spin_lock_init(&abox->lock);
+	platform_set_drvdata(pdev, abox);
+
+	/* The A-Box DMA address registers are 32 bit wide */
+	ret = dma_coerce_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (ret)
+		return ret;
+
+	abox->sfr = devm_platform_ioremap_resource_byname(pdev, "sfr");
+	if (IS_ERR(abox->sfr))
+		return PTR_ERR(abox->sfr);
+
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "sysreg");
+	if (res) {
+		abox->sysreg = devm_ioremap_resource(dev, res);
+		if (IS_ERR(abox->sysreg))
+			return PTR_ERR(abox->sysreg);
+	}
+
+	if (of_property_read_bool(dev->of_node, "samsung,cmu-bringup")) {
+		abox->cmu = devm_platform_ioremap_resource_byname(pdev, "cmu");
+		if (IS_ERR(abox->cmu))
+			return PTR_ERR(abox->cmu);
+	}
+
+	abox->pmu = syscon_regmap_lookup_by_phandle_optional(dev->of_node,
+							     "samsung,pmu-syscon");
+	if (IS_ERR(abox->pmu))
+		return PTR_ERR(abox->pmu);
+
+	ret = devm_clk_bulk_get_all_enabled(dev, &abox->clks);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "failed to get clocks\n");
+	abox->num_clks = ret;
+	for (i = 0; i < ABOX_NUM_UAIF; i++) {
+		char name[8];
+
+		snprintf(name, sizeof(name), "bclk%d", i);
+		abox->bclk[i] = devm_clk_get_optional(dev, name);
+		if (IS_ERR(abox->bclk[i]))
+			return PTR_ERR(abox->bclk[i]);
+	}
+
+	/*
+	 * Touching a powered-down AUD block is an SError. S-Boot leaves the
+	 * domain on (PMU 0x14064004 reads 0x0010000f on the device), but
+	 * check it, since there is no power domain driver for it yet.
+	 */
+	if (abox->pmu) {
+		u32 st = 0, cpu = 0, opt = 0, ret_opt = 0;
+
+		regmap_read(abox->pmu, PMU_AUD_STATUS, &st);
+		if ((st & PMU_AUD_STATUS_ON) != PMU_AUD_STATUS_ON)
+			return dev_err_probe(dev, -ENODEV,
+					     "AUD power domain is off (%08x)\n", st);
+
+		/* the Calliope CPU stays in reset: nothing boots it here */
+		regmap_read(abox->pmu, PMU_ABOX_CPU_STATUS, &cpu);
+		regmap_read(abox->pmu, PMU_ABOX_CPU_OPTION, &opt);
+		regmap_read(abox->pmu, PMU_PAD_RETENTION_ABOX_OPTION, &ret_opt);
+		dev_info(dev, "PMU: AUD %08x CPU status %08x option %08x pad retention %08x\n",
+			 st, cpu, opt, ret_opt);
+	}
+
+	/*
+	 * Downstream exynos-pd restores the AUD DTZPC with this SMC after
+	 * powering the domain up. Only issued when the DT asks for it.
+	 */
+	if (!of_property_read_u32(dev->of_node, "samsung,dtzpc-smc", &smc_addr)) {
+		struct arm_smccc_res smc;
+
+		arm_smccc_smc(0x82000410, 1, smc_addr, 0, 0, 0, 0, 0, &smc);
+		dev_info(dev, "DTZPC restore SMC(%#x): %ld\n", smc_addr,
+			 (long)smc.a0);
+	}
+
+	if (abox->cmu) {
+		ret = abox_cmu_init(abox);
+		if (ret)
+			return ret;
+	}
+
+	ip = readl(abox->sfr + ABOX_IP_INDEX);
+	ver = readl(abox->sfr + ABOX_VERSION);
+	dev_info(dev, "IP %08x (%.4s) version %08x\n", ip, (char *)&ip, ver);
+
+	if (abox->pmu) {
+		/* abox_pad_retention(false) */
+		regmap_update_bits(abox->pmu, PMU_PAD_RETENTION_ABOX_OPTION,
+				   PMU_PAD_RETENTION_RELEASE,
+				   PMU_PAD_RETENTION_RELEASE);
+		regmap_update_bits(abox->pmu, PMU_GPIO_MODE_ABOX_SYS_PWR_REG,
+				   PMU_GPIO_MODE_ABOX, PMU_GPIO_MODE_ABOX);
+	}
+	if (abox->sysreg)
+		writel(1, abox->sysreg + 0x32c);	/* ABOX_SYSREG_MISC_CON */
+
+	for (i = 0; i < ABOX_NUM_RDMA; i++) {
+		struct abox_dma *dma = &abox->rdma[i];
+
+		dma->abox = abox;
+		dma->id = i;
+		dma->base = abox->sfr + ABOX_RDMA_BASE(i);
+		hrtimer_setup(&dma->timer, abox_dma_timer, CLOCK_MONOTONIC,
+			      HRTIMER_MODE_REL_SOFT);
+	}
+	for (i = 0; i < ABOX_NUM_WDMA; i++) {
+		struct abox_dma *dma = &abox->wdma[i];
+
+		dma->abox = abox;
+		dma->id = i;
+		dma->capture = true;
+		dma->base = abox->sfr + ABOX_WDMA_BASE(i);
+		hrtimer_setup(&dma->timer, abox_dma_timer, CLOCK_MONOTONIC,
+			      HRTIMER_MODE_REL_SOFT);
+	}
+
+	return devm_snd_soc_register_component(dev, &abox_component, abox_dais,
+					       ARRAY_SIZE(abox_dais));
+}
+
+static const struct of_device_id abox_of_match[] = {
+	{ .compatible = "samsung,exynos9810-abox" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, abox_of_match);
+
+static struct platform_driver abox_driver = {
+	.driver = {
+		.name = "exynos9810-abox",
+		.of_match_table = abox_of_match,
+		.dev_groups = abox_groups,
+	},
+	.probe = abox_probe,
+};
+module_platform_driver(abox_driver);
+
+MODULE_DESCRIPTION("Samsung Exynos9810 A-Box firmware-less ASoC driver");
+MODULE_LICENSE("GPL");
