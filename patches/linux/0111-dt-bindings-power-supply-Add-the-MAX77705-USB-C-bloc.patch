From 6dc84cf2d17a9164cb745efdb6dfd7ac571c5df1 Mon Sep 17 00:00:00 2001
From: dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>
Date: Wed, 21 Oct 2026 18:43:25 +1100
Subject: [PATCH 111/119] dt-bindings: power: supply: Add the MAX77705 USB-C
 block

Describe the USB-C block of the Maxim MAX77705 (I2C address 0x25) as a
USB power supply. It reports the BC1.2 and Type-C Rp source type, and
the MAX77705 charger references it through power-supplies.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../power/supply/maxim,max77705-usbc.yaml     | 48 +++++++++++++++++++
 1 file changed, 48 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/power/supply/maxim,max77705-usbc.yaml

diff --git a/Documentation/devicetree/bindings/power/supply/maxim,max77705-usbc.yaml b/Documentation/devicetree/bindings/power/supply/maxim,max77705-usbc.yaml
new file mode 100644
index 000000000..374a92a77
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/supply/maxim,max77705-usbc.yaml
@@ -0,0 +1,48 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/maxim,max77705-usbc.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Maxim MAX77705 USB-C block input power detection
+
+maintainers:
+  - Sebastian Reichel <sre@kernel.org>
+
+description:
+  The USB-C block of the Maxim MAX77705 (its own I2C address, usually 0x25)
+  runs the Type-C, USB PD and BC1.2 detection. Described here as the USB
+  power supply it detects, for use as the supplier of the MAX77705 charger.
+
+allOf:
+  - $ref: power-supply.yaml#
+
+properties:
+  compatible:
+    const: maxim,max77705-usbc
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        usb-c@25 {
+            compatible = "maxim,max77705-usbc";
+            reg = <0x25>;
+            interrupt-parent = <&max77705>;
+            interrupts = <3>;
+        };
+    };
-- 
