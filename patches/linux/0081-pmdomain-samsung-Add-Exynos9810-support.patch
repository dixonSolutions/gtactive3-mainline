From abeb1f1340213bd7c80f69c867a3d85ddbca2a10 Mon Sep 17 00:00:00 2001
From: dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>
Date: Wed, 21 Oct 2026 16:05:52 +1100
Subject: [PATCH 081/152] pmdomain: samsung: Add Exynos9810 support

Exynos9810 power domains use a 4-bit LOCAL_PWR_CFG like Exynos5433, but
need two more things that Samsung's PMUCAL does on every transition:

- The secure monitor must save the domain's D-TZPC before power-off and
  restore it after power-on (SiP SMC 0x82000410, arg 0 = save, 1 =
  restore, then the D-TZPC address from the "need_smc" property of the
  stock DT). Taken from exynos-el3_mon.c:327-337 and pmucal_local.c:42-49,
  93-100 of Samsung's 4.9 kernel.

- The embedded G3D domain keeps CMU_G3D powered; PLL_G3D and the GPU
  user mux are moved to the oscillator after power-off and back before
  power-on (flexpmu_cal_local_exynos9810.h:475-492).

Allow up to 10 ms for the status to follow (the GPU has 18 cores) and
print the status register on a timeout.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/pmdomain/samsung/exynos-pm-domains.c | 146 ++++++++++++++++++-
 1 file changed, 141 insertions(+), 5 deletions(-)

diff --git a/drivers/pmdomain/samsung/exynos-pm-domains.c b/drivers/pmdomain/samsung/exynos-pm-domains.c
index 5c3aa8983..77e4629f6 100644
--- a/drivers/pmdomain/samsung/exynos-pm-domains.c
+++ b/drivers/pmdomain/samsung/exynos-pm-domains.c
@@ -9,6 +9,7 @@
 // conjunction with runtime-pm. Support for both device-tree and non-device-tree
 // based power domain support is included.
 
+#include <linux/arm-smccc.h>
 #include <linux/io.h>
 #include <linux/err.h>
 #include <linux/platform_device.h>
@@ -19,9 +20,16 @@
 #include <linux/of_address.h>
 #include <linux/pm_runtime.h>
 
+struct exynos_pm_domain;
+
 struct exynos_pm_domain_config {
 	/* Value for LOCAL_PWR_CFG and STATUS fields for each domain */
 	u32 local_pwr_cfg;
+	/* Status poll timeout, 0 means the historical 1 ms */
+	u32 timeout_us;
+	/* Optional hooks around the PMU write, e.g. to park clocks */
+	void (*pre_on)(struct exynos_pm_domain *pd);
+	void (*post_off)(struct exynos_pm_domain *pd);
 };
 
 /*
@@ -29,10 +37,39 @@ struct exynos_pm_domain_config {
  */
 struct exynos_pm_domain {
 	void __iomem *base;
+	void __iomem *cmu;
 	struct generic_pm_domain pd;
+	const struct exynos_pm_domain_config *cfg;
 	u32 local_pwr_cfg;
+	u32 dtzpc;
 };
 
+/* Exynos9810 secure monitor: save/restore a domain's D-TZPC (SiP, SMC32) */
+#define EXYNOS_SMC_PREPARE_PD_ONOFF	0x82000410
+#define EXYNOS_PD_DTZPC_SAVE		0
+#define EXYNOS_PD_DTZPC_RESTORE		1
+
+static int exynos_pd_dtzpc(struct exynos_pm_domain *pd, unsigned long op)
+{
+	struct arm_smccc_res res;
+
+	if (!pd->dtzpc)
+		return 0;
+
+	if (!IS_ENABLED(CONFIG_HAVE_ARM_SMCCC))
+		return -EOPNOTSUPP;
+
+	arm_smccc_smc(EXYNOS_SMC_PREPARE_PD_ONOFF, op, pd->dtzpc, 0, 0, 0, 0, 0,
+		      &res);
+	if (res.a0) {
+		pr_err("Power domain %s: D-TZPC %s SMC failed: %ld\n",
+		       pd->pd.name, op ? "restore" : "save", (long)res.a0);
+		return -EIO;
+	}
+
+	return 0;
+}
+
 static int exynos_pd_power(struct generic_pm_domain *domain, bool power_on)
 {
 	struct exynos_pm_domain *pd;
@@ -46,13 +83,14 @@ static int exynos_pd_power(struct generic_pm_domain *domain, bool power_on)
 	pwr = power_on ? pd->local_pwr_cfg : 0;
 	writel_relaxed(pwr, base);
 
-	/* Wait max 1ms */
-	timeout = 10;
+	/* Wait max 1ms, or what the SoC asks for */
+	timeout = pd->cfg && pd->cfg->timeout_us ? pd->cfg->timeout_us / 100 : 10;
 
 	while ((readl_relaxed(base + 0x4) & pd->local_pwr_cfg) != pwr) {
 		if (!timeout) {
 			op = (power_on) ? "enable" : "disable";
-			pr_err("Power domain %s %s failed\n", domain->name, op);
+			pr_err("Power domain %s %s failed (status 0x%08x)\n",
+			       domain->name, op, readl_relaxed(base + 0x4));
 			return -ETIMEDOUT;
 		}
 		timeout--;
@@ -65,12 +103,81 @@ static int exynos_pd_power(struct generic_pm_domain *domain, bool power_on)
 
 static int exynos_pd_power_on(struct generic_pm_domain *domain)
 {
-	return exynos_pd_power(domain, true);
+	struct exynos_pm_domain *pd =
+		container_of(domain, struct exynos_pm_domain, pd);
+	int ret;
+
+	if (pd->cfg && pd->cfg->pre_on)
+		pd->cfg->pre_on(pd);
+
+	ret = exynos_pd_power(domain, true);
+	if (ret)
+		return ret;
+
+	return exynos_pd_dtzpc(pd, EXYNOS_PD_DTZPC_RESTORE);
 }
 
 static int exynos_pd_power_off(struct generic_pm_domain *domain)
 {
-	return exynos_pd_power(domain, false);
+	struct exynos_pm_domain *pd =
+		container_of(domain, struct exynos_pm_domain, pd);
+	int ret;
+
+	ret = exynos_pd_dtzpc(pd, EXYNOS_PD_DTZPC_SAVE);
+	if (ret)
+		return ret;
+
+	ret = exynos_pd_power(domain, false);
+	if (ret)
+		return ret;
+
+	if (pd->cfg && pd->cfg->post_off)
+		pd->cfg->post_off(pd);
+
+	return 0;
+}
+
+/*
+ * Exynos9810 embedded G3D: CMU_G3D stays powered, but Samsung's PMUCAL
+ * switches the G3D PLL and the GPU user mux to the oscillator while the
+ * domain is off and back before it is powered on
+ * (cal-if/exynos9810/flexpmu_cal_local_exynos9810.h, embedded_g3d_on/off).
+ */
+#define EXYNOS9810_CMU_G3D_PLL_CON0_MUX_USER	0x100
+#define EXYNOS9810_CMU_G3D_PLL_CON0_PLL		0x140
+#define EXYNOS9810_CMU_G3D_PLL_CON2_PLL		0x148
+#define EXYNOS9810_CMU_G3D_MUX_SEL		BIT(4)
+#define EXYNOS9810_CMU_G3D_PLL_CON2_ON		0x30000003
+#define EXYNOS9810_CMU_G3D_PLL_CON2_OFF		0x10000001
+
+static void exynos9810_g3d_pre_on(struct exynos_pm_domain *pd)
+{
+	void __iomem *cmu = pd->cmu;
+	u32 val;
+
+	writel(EXYNOS9810_CMU_G3D_PLL_CON2_ON,
+	       cmu + EXYNOS9810_CMU_G3D_PLL_CON2_PLL);
+	val = readl(cmu + EXYNOS9810_CMU_G3D_PLL_CON0_PLL);
+	writel(val | EXYNOS9810_CMU_G3D_MUX_SEL,
+	       cmu + EXYNOS9810_CMU_G3D_PLL_CON0_PLL);
+	val = readl(cmu + EXYNOS9810_CMU_G3D_PLL_CON0_MUX_USER);
+	writel(val | EXYNOS9810_CMU_G3D_MUX_SEL,
+	       cmu + EXYNOS9810_CMU_G3D_PLL_CON0_MUX_USER);
+}
+
+static void exynos9810_g3d_post_off(struct exynos_pm_domain *pd)
+{
+	void __iomem *cmu = pd->cmu;
+	u32 val;
+
+	val = readl(cmu + EXYNOS9810_CMU_G3D_PLL_CON0_MUX_USER);
+	writel(val & ~EXYNOS9810_CMU_G3D_MUX_SEL,
+	       cmu + EXYNOS9810_CMU_G3D_PLL_CON0_MUX_USER);
+	val = readl(cmu + EXYNOS9810_CMU_G3D_PLL_CON0_PLL);
+	writel(val & ~EXYNOS9810_CMU_G3D_MUX_SEL,
+	       cmu + EXYNOS9810_CMU_G3D_PLL_CON0_PLL);
+	writel(EXYNOS9810_CMU_G3D_PLL_CON2_OFF,
+	       cmu + EXYNOS9810_CMU_G3D_PLL_CON2_PLL);
 }
 
 static const struct exynos_pm_domain_config exynos4210_cfg = {
@@ -81,6 +188,18 @@ static const struct exynos_pm_domain_config exynos5433_cfg = {
 	.local_pwr_cfg		= 0xf,
 };
 
+static const struct exynos_pm_domain_config exynos9810_cfg = {
+	.local_pwr_cfg		= 0xf,
+	.timeout_us		= 10000,
+};
+
+static const struct exynos_pm_domain_config exynos9810_g3d_cfg = {
+	.local_pwr_cfg		= 0xf,
+	.timeout_us		= 10000,
+	.pre_on			= exynos9810_g3d_pre_on,
+	.post_off		= exynos9810_g3d_post_off,
+};
+
 static const struct of_device_id exynos_pm_domain_of_match[] = {
 	{
 		.compatible = "samsung,exynos4210-pd",
@@ -88,6 +207,12 @@ static const struct of_device_id exynos_pm_domain_of_match[] = {
 	}, {
 		.compatible = "samsung,exynos5433-pd",
 		.data = &exynos5433_cfg,
+	}, {
+		.compatible = "samsung,exynos9810-pd",
+		.data = &exynos9810_cfg,
+	}, {
+		.compatible = "samsung,exynos9810-g3d-pd",
+		.data = &exynos9810_g3d_cfg,
 	},
 	{ },
 };
@@ -124,8 +249,19 @@ static int exynos_pd_probe(struct platform_device *pdev)
 	if (!pd->base)
 		return -ENODEV;
 
+	if (pm_domain_cfg->pre_on || pm_domain_cfg->post_off) {
+		pd->cmu = of_iomap(np, 1);
+		if (!pd->cmu) {
+			iounmap(pd->base);
+			return -ENODEV;
+		}
+	}
+
+	of_property_read_u32(np, "samsung,dtzpc", &pd->dtzpc);
+
 	pd->pd.power_off = exynos_pd_power_off;
 	pd->pd.power_on = exynos_pd_power_on;
+	pd->cfg = pm_domain_cfg;
 	pd->local_pwr_cfg = pm_domain_cfg->local_pwr_cfg;
 
 	/*
-- 
2.56.0

