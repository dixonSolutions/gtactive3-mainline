+
+	bool dgc;
+	struct work_struct dgc_work;
+	spinlock_t dgc_slock;
+	u16 dgc_want[3], dgc_sent[3];	/* channel scales, 0xffff = Samsung's */
 };
 
 static int dsim_bl_wait_not_full(void __iomem *base, u32 full)
@@ -156,6 +201,78 @@ static int dsim_bl_dcs_write(struct dsim_bl *bl, const u8 *buf, size_t len)
 	return ret;
 }
 
+/* one curve scaled, in the panel's packing, with the 0xC1 command byte */
+static void dsim_bl_dgc_pack(u8 out[DGC_LEN], const u16 *curve, u16 scale)
+{
+	unsigned int i;
+	u16 v;
+
+	memset(out, 0, DGC_LEN);
+	out[0] = 0xc1;
+	for (i = 0; i < DGC_POINTS; i++) {
+		v = DIV_ROUND_CLOSEST((u32)curve[i] * scale, 0xffff);
+		out[1 + i] = v >> 2;
+		/* low bits: point i at bit pair 2i of the tail, MSB first */
+		out[1 + DGC_POINTS + i / 4] |= (v & 3) << (6 - 2 * (i % 4));
+	}
+}
+
+static void dsim_bl_dgc_work(struct work_struct *work)
+{
+	struct dsim_bl *bl = container_of(work, struct dsim_bl, dgc_work);
+	static const u8 unlock[] = { 0xb9, 0x83, 0x10, 0x2e };
+	static const u8 lock[] = { 0xb9, 0x00, 0x00, 0x00 };
+	u8 bank[2] = { 0xbd, 0 }, cmd[DGC_LEN];
+	u16 want[3];
+	unsigned int c;
+	int ret;
+
+	spin_lock_irq(&bl->dgc_slock);
+	memcpy(want, bl->dgc_want, sizeof(want));
+	spin_unlock_irq(&bl->dgc_slock);
+	if (!memcmp(want, bl->dgc_sent, sizeof(want)))
+		return;
+
+	ret = dsim_bl_dcs_write(bl, unlock, sizeof(unlock));
+	for (c = 0; c < 3 && !ret; c++) {
+		bank[1] = c + 1;
+		dsim_bl_dgc_pack(cmd, hx83102e_dgc[c], want[c]);
+		ret = dsim_bl_dcs_write(bl, bank, sizeof(bank));
+		if (!ret)
+			ret = dsim_bl_dcs_write(bl, cmd, sizeof(cmd));
+	}
+	bank[1] = 0;
+	dsim_bl_dcs_write(bl, bank, sizeof(bank));
+	dsim_bl_dcs_write(bl, lock, sizeof(lock));
+	if (ret) {
+		dev_err(bl->dev, "digital gamma not loaded: %d\n", ret);
+		return;
+	}
+	memcpy(bl->dgc_sent, want, sizeof(want));
+	dev_dbg(bl->dev, "digital gamma scales %04x %04x %04x\n",
+		want[0], want[1], want[2]);
+}
+
+/* from the DPU's commit: keep only the newest request, send it from a work */
