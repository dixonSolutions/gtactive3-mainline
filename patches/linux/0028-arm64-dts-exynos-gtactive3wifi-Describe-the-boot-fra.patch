From 6ebe9ae81aa1e24a3fdf23386b93b9c0e31031d9 Mon Sep 17 00:00:00 2001
From: dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>
Date: Wed, 21 Oct 2026 16:08:18 +1100
Subject: [PATCH 28/38] arm64: dts: exynos: gtactive3wifi: Describe the boot
 framebuffer for simpledrm

Point the simple-framebuffer at its reserved-memory region instead of
repeating the address, so simpledrm and simplefb both use the no-map
carve-out, and link a panel node with the physical size from the stock
DTBO (hx83102e: size = <108 172>) and its mounting (rotation = <0>,
portrait with the keys at the bottom). simpledrm turns that into the
connector's width/height in mm and "panel orientation" property, which
compositors use to rotate.

DECON_F window 5 scans the buffer out with PD_FUNC_COPY
(WIN_CONTROL_0(5) reads 0x00000102), i.e. the alpha byte is ignored,
so describe it as x8r8g8b8: XRGB8888 is what every client renders and
simpledrm no longer has to convert each frame.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../dts/exynos/exynos9810-gtactive3wifi.dts   | 27 ++++++++++++++++---
 1 file changed, 23 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/boot/dts/exynos/exynos9810-gtactive3wifi.dts b/arch/arm64/boot/dts/exynos/exynos9810-gtactive3wifi.dts
index edbbecdea..eaab8375e 100644
--- a/arch/arm64/boot/dts/exynos/exynos9810-gtactive3wifi.dts
+++ b/arch/arm64/boot/dts/exynos/exynos9810-gtactive3wifi.dts
@@ -26,16 +26,35 @@ chosen {
 		#size-cells = <1>;
 		ranges;
 
-		framebuffer@ca000000 {
+		/*
+		 * Scanned out by DECON_F window 5 in video mode, dual DSI
+		 * (2 x 600x1920). The window blends with PD_FUNC_COPY, so the
+		 * alpha byte is ignored and XRGB8888 needs no conversion.
+		 */
+		framebuffer0: framebuffer-0 {
 			compatible = "simple-framebuffer";
-			reg = <0x0 0xca000000 (1200 * 1920 * 4)>;
+			memory-region = <&fb_mem>;
 			width = <1200>;
 			height = <1920>;
 			stride = <(1200 * 4)>;
-			format = "a8r8g8b8";
+			format = "x8r8g8b8";
+			panel = <&panel>;
 		};
 	};
 
+	/*
+	 * Himax HX83102E (BOE) TDDI, 1200x1920 portrait, on DSIM0 + DSIM1.
+	 * There is no DSI host driver yet: the bootloader initialises the
+	 * panel and this node only describes it for simpledrm (physical size,
+	 * mounting). Change "rotation" here if userspace should treat another
+	 * edge as the top.
+	 */
+	panel: panel {
+		width-mm = <108>;
+		height-mm = <172>;
+		rotation = <0>;
+	};
+
 	gpio-keys {
 		compatible = "gpio-keys";
 
@@ -103,7 +122,7 @@ reserved-memory {
 		#size-cells = <1>;
 		ranges;
 
-		framebuffer@ca000000 {
+		fb_mem: framebuffer@ca000000 {
 			reg = <0x0 0xca000000 (1200 * 1920 * 4)>;
 			no-map;
 		};
-- 
