From 8dd40730356dcab98000049b5d71a0a2c6f86364 Mon Sep 17 00:00:00 2001
From: dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>
Date: Thu, 22 Oct 2026 10:58:12 +1100
Subject: [PATCH 142/152] iio: adc: exynos: Add Exynos9810 support

The Exynos9810 ADC (the vendor kernel's "exynos-adc-v3") uses the ADC_V2
control registers, but the soft reset has to be released explicitly
(CON1 bit 1) and the conversion result is read from offset 0x08, with
bit 31 flagging a finished conversion. It has 12 channels and two bus
clocks.

Add a read_data hook for the result register and the 9810 variant.
The register sequence was checked on the Galaxy Tab Active3 (SM-T570)
by hand (conversions on all channels; with the stock battery NTC table
channel 1 reads 25.0-26.0 C at room temperature).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/iio/adc/exynos_adc.c | 55 +++++++++++++++++++++++++++++++++++-
 1 file changed, 54 insertions(+), 1 deletion(-)

diff --git a/drivers/iio/adc/exynos_adc.c b/drivers/iio/adc/exynos_adc.c
index c1a0061b1..b33c7eb7e 100644
--- a/drivers/iio/adc/exynos_adc.c
+++ b/drivers/iio/adc/exynos_adc.c
@@ -46,6 +46,9 @@
 #define ADC_V2_INT_ST(x)	((x) + 0x14)
 #define ADC_V2_VER(x)		((x) + 0x20)
 
+/* Exynos9810 ADC: ADC_V2 control registers, conversion result at 0x08 */
+#define ADC_EXYNOS9810_DAT(x)	((x) + 0x08)
+
 /* Bit definitions for ADC_V1 */
 #define ADC_V1_CON_RES		(1u << 16)
 #define ADC_V1_CON_PRSCEN	(1u << 14)
@@ -70,6 +73,7 @@
 
 /* Bit definitions for ADC_V2 */
 #define ADC_V2_CON1_SOFT_RESET	(1u << 2)
+#define ADC_V2_CON1_SOFT_NON_RESET	(1u << 1)
 
 #define ADC_V2_CON2_OSEL	(1u << 10)
 #define ADC_V2_CON2_ESEL	(1u << 9)
@@ -79,6 +83,7 @@
 #define ADC_V2_CON2_ACH_MASK	0xF
 
 #define MAX_ADC_V2_CHANNELS		10
+#define MAX_EXYNOS9810_ADC_CHANNELS	12
 #define MAX_ADC_V1_CHANNELS		8
 #define MAX_EXYNOS3250_ADC_CHANNELS	2
 #define MAX_EXYNOS4212_ADC_CHANNELS	4
@@ -133,6 +138,7 @@ struct exynos_adc_data {
 	void (*exit_hw)(struct exynos_adc *info);
 	void (*clear_irq)(struct exynos_adc *info);
 	void (*start_conv)(struct exynos_adc *info, unsigned long addr);
+	u32 (*read_data)(struct exynos_adc *info);
 };
 
 static void exynos_adc_unprepare_clk(struct exynos_adc *info)
@@ -397,6 +403,45 @@ static const struct exynos_adc_data exynos7_adc_data = {
 	.start_conv	= exynos_adc_v2_start_conv,
 };
 
+/*
+ * Exynos9810: the ADC_V2 control block, but the soft reset has to be released
+ * explicitly and the result is read from 0x08 (bit 31 flags a finished
+ * conversion), as in the vendor driver's "exynos-adc-v3".
+ */
+static void exynos_adc_exynos9810_init_hw(struct exynos_adc *info)
+{
+	writel(ADC_V2_CON1_SOFT_RESET, ADC_V2_CON1(info->regs));
+	writel(ADC_V2_CON1_SOFT_NON_RESET, ADC_V2_CON1(info->regs));
+
+	writel(ADC_V2_CON2_C_TIME(6), ADC_V2_CON2(info->regs));
+
+	/* Enable interrupts */
+	writel(1, ADC_V2_INT_EN(info->regs));
+}
+
+static void exynos_adc_exynos9810_exit_hw(struct exynos_adc *info)
+{
+	writel(0, ADC_V2_INT_EN(info->regs));
+	writel(ADC_V2_CON1_SOFT_RESET, ADC_V2_CON1(info->regs));
+}
+
+static u32 exynos_adc_exynos9810_read_data(struct exynos_adc *info)
+{
+	return readl(ADC_EXYNOS9810_DAT(info->regs));
+}
+
+static const struct exynos_adc_data exynos9810_adc_data = {
+	.num_channels	= MAX_EXYNOS9810_ADC_CHANNELS,
+	.mask		= ADC_DATX_MASK, /* 12 bit ADC resolution */
+	.needs_sclk	= true,
+
+	.init_hw	= exynos_adc_exynos9810_init_hw,
+	.exit_hw	= exynos_adc_exynos9810_exit_hw,
+	.clear_irq	= exynos_adc_v2_clear_irq,
+	.start_conv	= exynos_adc_v2_start_conv,
+	.read_data	= exynos_adc_exynos9810_read_data,
+};
+
 static const struct of_device_id exynos_adc_match[] = {
 	{
 		.compatible = "samsung,s3c6410-adc",
@@ -419,6 +464,9 @@ static const struct of_device_id exynos_adc_match[] = {
 	}, {
 		.compatible = "samsung,exynos7-adc",
 		.data = &exynos7_adc_data,
+	}, {
+		.compatible = "samsung,exynos9810-adc",
+		.data = &exynos9810_adc_data,
 	},
 	{ }
 };
@@ -487,7 +535,10 @@ static irqreturn_t exynos_adc_isr(int irq, void *dev_id)
 	u32 mask = info->data->mask;
 
 	/* Read value */
-	info->value = readl(ADC_V1_DATX(info->regs)) & mask;
+	if (info->data->read_data)
+		info->value = info->data->read_data(info) & mask;
+	else
+		info->value = readl(ADC_V1_DATX(info->regs)) & mask;
 
 	/* clear irq */
 	if (info->data->clear_irq)
@@ -538,6 +589,8 @@ static const struct iio_chan_spec exynos_adc_iio_channels[] = {
 	ADC_CHANNEL(7, "adc7"),
 	ADC_CHANNEL(8, "adc8"),
 	ADC_CHANNEL(9, "adc9"),
+	ADC_CHANNEL(10, "adc10"),
+	ADC_CHANNEL(11, "adc11"),
 };
 
 static int exynos_adc_probe(struct platform_device *pdev)
-- 
