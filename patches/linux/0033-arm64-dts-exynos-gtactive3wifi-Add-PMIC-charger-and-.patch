+	pmic-1 {
+		compatible = "samsung,s2mps18-pmic";
+
+		regulators {
+			s2mps18_buck1: BUCK1 {
+				regulator-name = "vdd_mif";
+				regulator-always-on;
+				/* stock: 450-950 mV */
+			};
+
+			s2mps18_buck2: BUCK2 {
