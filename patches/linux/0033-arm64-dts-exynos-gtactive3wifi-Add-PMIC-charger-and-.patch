+++ b/arch/arm64/boot/dts/exynos/exynos9810-gtactive3wifi.dts
@@ -15,12 +15,26 @@
 #include "exynos9810.dtsi"
 #include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/input/input.h>
+#include <dt-bindings/interrupt-controller/irq.h>
 
 / {
 	model = "Samsung Galaxy Tab Active3 (SM-T570)";
 	compatible = "samsung,gtactive3wifi", "samsung,exynos9810";
 	chassis-type = "tablet";
 
+	/*
+	 * EB-BT575BBE, values from the stock sec-battery node (DTBO hw_rev 4):
+	 * battery_full_capacity 5000 mAh, chg_float_voltage 4260 mV,
+	 * max_charging_current 3100 mA, sw_v_empty_voltage 3200 mV.
+	 */
+	battery: battery {
+		compatible = "simple-battery";
+		charge-full-design-microamp-hours = <5000000>;
+		constant-charge-current-max-microamp = <3100000>;
+		voltage-max-design-microvolt = <4260000>;
+		voltage-min-design-microvolt = <3200000>;
+	};
+
 	chosen {
 		#address-cells = <2>;
 		#size-cells = <1>;
@@ -164,6 +178,13 @@ key_hot: key-hot-pins {
 		samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
 		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
 	};
+
+	max77705_irq: max77705-irq-pins {
+		samsung,pins = "gpa1-6";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
+	};
 };
 
 &pinctrl_peric1 {
@@ -322,3 +343,311 @@ ufs: ufs@11120000 {
 		phy-names = "ufs-phy";
 	};
 };
