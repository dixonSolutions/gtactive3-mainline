From 76f0418e603d14cb550fb119f68b8cec45b0292f Mon Sep 17 00:00:00 2001
From: dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>
Date: Wed, 21 Oct 2026 18:16:38 +1100
Subject: [PATCH 54/64] arm64: dts: exynos: gtactive3wifi: Link the fuel gauge
 to the battery

Point the MAX77705 fuel gauge at the simple-battery node, so that the
battery power supply also exposes the design limits (constant charge
current/voltage, voltage range). Add the stock float voltage as
constant-charge-voltage-max-microvolt, and replace the deprecated
maxim,rsns-microohm with shunt-resistor-micro-ohms (same 5 mOhm, from
stock fg_resistor = 2).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../boot/dts/exynos/exynos9810-gtactive3wifi-i2cgpio.dtso     | 3 ++-
 arch/arm64/boot/dts/exynos/exynos9810-gtactive3wifi.dts       | 4 +++-
 2 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/exynos/exynos9810-gtactive3wifi-i2cgpio.dtso b/arch/arm64/boot/dts/exynos/exynos9810-gtactive3wifi-i2cgpio.dtso
index 6be014da2..3b1456e60 100644
--- a/arch/arm64/boot/dts/exynos/exynos9810-gtactive3wifi-i2cgpio.dtso
+++ b/arch/arm64/boot/dts/exynos/exynos9810-gtactive3wifi-i2cgpio.dtso
@@ -61,7 +61,8 @@ fuel-gauge@36 {
 			reg = <0x36>;
 			interrupt-parent = <&gpio_max77705>;
 			interrupts = <2>;
-			maxim,rsns-microohm = <5000>;
+			monitored-battery = <&battery>;
+			shunt-resistor-micro-ohms = <5000>;
 			power-supplies = <&gpio_max77705_charger>;
 		};
 	};
diff --git a/arch/arm64/boot/dts/exynos/exynos9810-gtactive3wifi.dts b/arch/arm64/boot/dts/exynos/exynos9810-gtactive3wifi.dts
index 55806182f..7506a5f3e 100644
--- a/arch/arm64/boot/dts/exynos/exynos9810-gtactive3wifi.dts
+++ b/arch/arm64/boot/dts/exynos/exynos9810-gtactive3wifi.dts
@@ -31,6 +31,7 @@ battery: battery {
 		compatible = "simple-battery";
 		charge-full-design-microamp-hours = <5000000>;
 		constant-charge-current-max-microamp = <3100000>;
+		constant-charge-voltage-max-microvolt = <4260000>;
 		voltage-max-design-microvolt = <4260000>;
 		voltage-min-design-microvolt = <3200000>;
 	};
@@ -782,7 +783,8 @@ fuel-gauge@36 {
 		reg = <0x36>;
 		interrupt-parent = <&max77705>;
 		interrupts = <2>;
-		maxim,rsns-microohm = <5000>;
+		monitored-battery = <&battery>;
+		shunt-resistor-micro-ohms = <5000>;
 		power-supplies = <&max77705_charger>;
 	};
 };
-- 
