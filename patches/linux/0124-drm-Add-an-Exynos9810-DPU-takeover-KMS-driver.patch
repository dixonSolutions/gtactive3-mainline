diff --git a/arch/arm64/boot/dts/exynos/exynos9810-gtactive3wifi.dts b/arch/arm64/boot/dts/exynos/exynos9810-gtactive3wifi.dts
index 2882b2628..50c0e1cc2 100644
--- a/arch/arm64/boot/dts/exynos/exynos9810-gtactive3wifi.dts
+++ b/arch/arm64/boot/dts/exynos/exynos9810-gtactive3wifi.dts
@@ -1086,6 +1086,32 @@ proximity@20 {
 	};
 };
 
+&soc {
+	/*
+	 * DECON0 + the IDMA channel S-Boot scans the panel out from
+	 * (stock decon_f@16030000, idma_* dma regs 0x16071000 + n * 0x1000).
+	 * Takeover driver: flips the buffer, keeps the panel/DSI setup.
+	 * Measured: window 5 (0..1199 x 0..1919) <- IDMA_G0, base 0xca000000,
+	 * SysMMU DPU0 in bypass.
+	 */
+	dpu: display-controller@16030000 {
+		compatible = "samsung,exynos9810-decon-takeover";
+		reg = <0x16030000 0x10000>,
+		      <0x16071000 0x1000>;
+		interrupts = <GIC_SPI 182 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 183 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 188 IRQ_TYPE_LEVEL_HIGH>;
+		samsung,window = <5>;	/* S-Boot: window 5 <- IDMA_G0 */
+		width = <1200>;
+		height = <1920>;
+		/* 8.0" 16:10 panel, portrait */
+		width-mm = <108>;
+		height-mm = <172>;
+		refresh-rate = <60>;
+		status = "okay";
+	};
+};
+
 &spi_21 {
 	/* Software chip select, as in the stock firmware */
 	cs-gpios = <&gph0 7 GPIO_ACTIVE_LOW>;
