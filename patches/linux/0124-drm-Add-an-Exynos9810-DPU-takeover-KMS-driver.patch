+# SPDX-License-Identifier: GPL-2.0-only
+config DRM_EXYNOS9810_DPU
+	tristate "Exynos9810 DPU (bootloader takeover)"
+	depends on DRM && OF
+	depends on ARCH_EXYNOS || COMPILE_TEST
+	select DRM_CLIENT_SELECTION
+	select DRM_GEM_DMA_HELPER
+	select DRM_KMS_HELPER
+	select APERTURE_HELPERS
+	help
+	  KMS driver for the Exynos9810 display controller (DECON + IDMA) as
+	  the bootloader left it: flips the scanout buffer at vsync, so the
+	  GPU (panfrost, through Mesa's kmsro) can render straight to the
+	  panel. The panel and DSI links are not reprogrammed.
