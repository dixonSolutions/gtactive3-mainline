From 01800498023050becb27d1df484fed7ce87d8d9f Mon Sep 17 00:00:00 2001
From: dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>
Date: Thu, 22 Oct 2026 02:08:34 +1100
Subject: [PATCH 127/152] clk: samsung: acpm: Exynos9810: allow DVFS rate
 changes, cache the rate

The Exynos9810 APM firmware's DVFS plugin (channel 5) takes FREQ_REQ
like gs101 and sets the voltage from its own fvmap, but does not report
the current rate (FREQ_GET returns 0; the stock kernel caches what it
set). Make the clocks writable, keep the last rate set, and start from
the fvmap init levels read from APM SRAM (A55 1053 MHz, M3 1066 MHz,
G3D 260 MHz).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/clk/samsung/clk-acpm.c | 50 +++++++++++++++++++++++++---------
 1 file changed, 37 insertions(+), 13 deletions(-)

diff --git a/drivers/clk/samsung/clk-acpm.c b/drivers/clk/samsung/clk-acpm.c
index 68ef89f53..89fceb307 100644
--- a/drivers/clk/samsung/clk-acpm.c
+++ b/drivers/clk/samsung/clk-acpm.c
@@ -22,10 +22,15 @@ struct acpm_clk {
 	struct clk_hw hw;
 	unsigned int mbox_chan_id;
 	struct acpm_handle *handle;
+	/* last rate set, for firmware that does not answer FREQ_GET */
+	unsigned long rate;
+	bool cached;
 };
 
 struct acpm_clk_variant {
 	const char *name;
+	/* rate the firmware boots the domain at (fvmap init level), Hz */
+	unsigned long boot_rate;
 };
 
 struct acpm_clk_driver_data {
@@ -33,6 +38,8 @@ struct acpm_clk_driver_data {
 	unsigned int nr_clks;
 	unsigned int mbox_chan_id;
 	bool read_only;
+	/* FREQ_GET returns nothing useful: report the last rate set */
+	bool cache_rate;
 };
 
 #define to_acpm_clk(clk) container_of(clk, struct acpm_clk, hw)
@@ -42,6 +49,12 @@ struct acpm_clk_driver_data {
 		.name		= cname,		\
 	}
 
+#define ACPM_CLK_BOOT(cname, khz)			\
+	{						\
+		.name		= cname,		\
+		.boot_rate	= (khz) * HZ_PER_KHZ,	\
+	}
+
 static const struct acpm_clk_variant gs101_acpm_clks[] = {
 	ACPM_CLK("mif"),
 	ACPM_CLK("int"),
@@ -67,24 +80,26 @@ static const struct acpm_clk_driver_data acpm_clk_gs101 = {
 
 /*
  * Exynos9810: the DVFS plugin of the APM firmware listens on ACPM channel 5
- * ("acpm-ipc-channel" of the stock acpm_dvfs node) and uses the same
- * FREQ_REQ/FREQ_GET messages as gs101, rates in kHz. Domains 0-4 only, the
- * ones with a consumer; the IDs must stay sequential from zero.
+ * ("acpm-ipc-channel" of the stock acpm_dvfs node) and takes the same
+ * FREQ_REQ messages as gs101, rates in kHz; it sets the voltage itself
+ * from its fvmap (ECT/ASV) table. FREQ_GET does not report the current
+ * rate (the stock kernel caches what it set), so neither do we. Boot
+ * rates are the fvmap init levels read from APM SRAM. The IDs must stay
+ * sequential from zero (domain index of the fvmap).
  */
 static const struct acpm_clk_variant exynos9810_acpm_clks[] = {
 	ACPM_CLK("dvfs_mif"),
 	ACPM_CLK("dvfs_int"),
-	ACPM_CLK("dvfs_cpucl0"),
-	ACPM_CLK("dvfs_cpucl1"),
-	ACPM_CLK("dvfs_g3d"),
+	ACPM_CLK_BOOT("dvfs_cpucl0", 1053000),
+	ACPM_CLK_BOOT("dvfs_cpucl1", 1066000),
+	ACPM_CLK_BOOT("dvfs_g3d", 260000),
 };
 
 static const struct acpm_clk_driver_data acpm_clk_exynos9810 = {
 	.clks = exynos9810_acpm_clks,
 	.nr_clks = ARRAY_SIZE(exynos9810_acpm_clks),
 	.mbox_chan_id = 5,
-	/* only FREQ_GET until the rates have been checked on hardware */
-	.read_only = true,
+	.cache_rate = true,
 };
 
 static unsigned long acpm_clk_recalc_rate(struct clk_hw *hw,
@@ -92,6 +107,8 @@ static unsigned long acpm_clk_recalc_rate(struct clk_hw *hw,
 {
 	struct acpm_clk *clk = to_acpm_clk(hw);
 
+	if (clk->cached)
+		return clk->rate;
 	return clk->handle->ops->dvfs.get_rate(clk->handle, clk->mbox_chan_id,
 					       clk->id);
 }
@@ -100,9 +117,13 @@ static int acpm_clk_set_rate(struct clk_hw *hw, unsigned long rate,
 			     unsigned long parent_rate)
 {
 	struct acpm_clk *clk = to_acpm_clk(hw);
+	int ret;
 
-	return clk->handle->ops->dvfs.set_rate(clk->handle, clk->mbox_chan_id,
-					       clk->id, rate);
+	ret = clk->handle->ops->dvfs.set_rate(clk->handle, clk->mbox_chan_id,
+					      clk->id, rate);
+	if (!ret)
+		clk->rate = rate;
+	return ret;
 }
 
 static const struct clk_ops acpm_clk_ops = {
@@ -172,6 +193,8 @@ static int acpm_clk_probe(struct platform_device *pdev)
 		aclk->id = i;
 		aclk->handle = acpm_handle;
 		aclk->mbox_chan_id = mbox_chan_id;
+		aclk->cached = data->cache_rate;
+		aclk->rate = data->clks[i].boot_rate;
 
 		hws[i] = &aclk->hw;
 
@@ -181,10 +204,11 @@ static int acpm_clk_probe(struct platform_device *pdev)
 			return dev_err_probe(dev, err,
 					     "Failed to register clock\n");
 
-		if (data->read_only)
-			dev_info(dev, "%s: %lu kHz (read-only)\n",
+		if (data->read_only || data->cache_rate)
+			dev_info(dev, "%s: %lu kHz%s\n",
 				 data->clks[i].name,
-				 clk_hw_get_rate(&aclk->hw) / HZ_PER_KHZ);
+				 clk_hw_get_rate(&aclk->hw) / HZ_PER_KHZ,
+				 data->read_only ? " (read-only)" : "");
 	}
 
 	return devm_of_clk_add_hw_provider(dev, of_clk_hw_onecell_get,
-- 
2.56.0

