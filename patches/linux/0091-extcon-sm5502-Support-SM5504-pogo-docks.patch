From e9deea1a36d3719076c6bf72832708fcb66e11b4 Mon Sep 17 00:00:00 2001
From: dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>
Date: Wed, 21 Oct 2026 18:32:13 +1100
Subject: [PATCH 091/152] extcon: sm5502: Support SM5504 pogo docks

On the Samsung Galaxy Tab Active3 the SM5504 sits on the pogo connector.
Samsung's sm5504-muic-pogo driver treats the ID resistors 34k (ADC 0x0f)
and 49.9k (ADC 0x11) as a pogo dock: it then switches the USB D+/D- mux
(usb-mux-sel) to the pogo pins and the USB manager makes the controller
the host (USB_STATUS_NOTIFY_ATTACH_DFP); on detach both are restored.

Report these IDs on the SM5504 as EXTCON_DOCK. When the board describes
the data line switch (usb-switch-gpios) or links a USB role switch,
drive the switch and the role while the dock is attached, report
EXTCON_USB_HOST, and restore the previous role on detach.

The other SM5502 variants keep ignoring these IDs.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/extcon/Kconfig         |  1 +
 drivers/extcon/extcon-sm5502.c | 86 +++++++++++++++++++++++++++++++++-
 2 files changed, 85 insertions(+), 2 deletions(-)

diff --git a/drivers/extcon/Kconfig b/drivers/extcon/Kconfig
index 68d9df7d2..d33889cb3 100644
--- a/drivers/extcon/Kconfig
+++ b/drivers/extcon/Kconfig
@@ -186,6 +186,7 @@ config EXTCON_RT8973A
 config EXTCON_SM5502
 	tristate "Silicon Mitus SM5502/SM5504/SM5703 EXTCON support"
 	depends on I2C
+	depends on USB_ROLE_SWITCH || !USB_ROLE_SWITCH
 	select IRQ_DOMAIN
 	select REGMAP_I2C
 	select REGMAP_IRQ
diff --git a/drivers/extcon/extcon-sm5502.c b/drivers/extcon/extcon-sm5502.c
index c8c4b9ef7..63af64e50 100644
--- a/drivers/extcon/extcon-sm5502.c
+++ b/drivers/extcon/extcon-sm5502.c
@@ -7,6 +7,7 @@
  */
 
 #include <linux/err.h>
+#include <linux/gpio/consumer.h>
 #include <linux/i2c.h>
 #include <linux/interrupt.h>
 #include <linux/irqdomain.h>
@@ -16,6 +17,7 @@
 #include <linux/regmap.h>
 #include <linux/slab.h>
 #include <linux/extcon-provider.h>
+#include <linux/usb/role.h>
 
 #include "extcon-sm5502.h"
 
@@ -56,6 +58,15 @@ struct sm5502_muic_info {
 	 * driver should notify cable state to upper layer.
 	 */
 	struct delayed_work wq_detcable;
+
+	/*
+	 * Optional routing of the AP's USB data lines to this MUIC's
+	 * connector while a dock is attached (SM5504 pogo connectors).
+	 */
+	struct gpio_desc *usb_switch;
+	struct usb_role_switch *role_sw;
+	enum usb_role saved_role;
+	bool dock_routed;
 };
 
 struct sm5502_type {
@@ -67,6 +78,8 @@ struct sm5502_type {
 	unsigned int num_reg_data;
 
 	unsigned int otg_dev_type1;
+	/* ID resistors 34k and 49.9k identify a (pogo) dock */
+	bool has_dock_ids;
 	int (*parse_irq)(struct sm5502_muic_info *info, int irq_type);
 };
 
@@ -131,6 +144,7 @@ static const unsigned int sm5502_extcon_cable[] = {
 	EXTCON_USB_HOST,
 	EXTCON_CHG_USB_SDP,
 	EXTCON_CHG_USB_DCP,
+	EXTCON_DOCK,
 	EXTCON_NONE,
 };
 
@@ -178,6 +192,7 @@ enum sm5502_muic_acc_type {
 	SM5502_MUIC_ADC_AUDIO_TYPE1_FULL_REMOTE = 0x3e,	/* |      001|11110| */
 	SM5502_MUIC_ADC_AUDIO_TYPE1_SEND_END = 0x5e,	/* |      010|11110| */
 							/* |Dev Type1|--ADC| */
+	SM5502_MUIC_ADC_DOCK = 0x100,			/* 34k or 49.9k ID (SM5504) */
 	SM5502_MUIC_ADC_GROUND_USB_OTG = 0x80,		/* |      100|00000| */
 	SM5502_MUIC_ADC_OPEN_USB = 0x5f,		/* |      010|11111| */
 	SM5502_MUIC_ADC_OPEN_TA = 0xdf,			/* |      110|11111| */
@@ -405,10 +420,13 @@ static unsigned int sm5502_muic_get_cable_type(struct sm5502_muic_info *info)
 	case SM5502_MUIC_ADC_REMOTE_S10_BUTTON:
 	case SM5502_MUIC_ADC_REMOTE_S11_BUTTON:
 	case SM5502_MUIC_ADC_REMOTE_S12_BUTTON:
+	case SM5502_MUIC_ADC_RESERVED_ACC_2:	/* 34k */
+	case SM5502_MUIC_ADC_RESERVED_ACC_4:	/* 49.9k */
+		if (info->type->has_dock_ids)
+			cable_type = SM5502_MUIC_ADC_DOCK;
+		break;
 	case SM5502_MUIC_ADC_RESERVED_ACC_1:
-	case SM5502_MUIC_ADC_RESERVED_ACC_2:
 	case SM5502_MUIC_ADC_RESERVED_ACC_3:
-	case SM5502_MUIC_ADC_RESERVED_ACC_4:
 	case SM5502_MUIC_ADC_RESERVED_ACC_5:
 	case SM5502_MUIC_ADC_AUDIO_TYPE2:
 	case SM5502_MUIC_ADC_PHONE_POWERED_DEV:
@@ -466,6 +484,37 @@ static unsigned int sm5502_muic_get_cable_type(struct sm5502_muic_info *info)
 	return cable_type;
 }
 
+/*
+ * Route the AP's USB data lines to the dock and make the controller the
+ * host while a dock is attached; restore the previous role afterwards.
+ */
+static void sm5502_muic_route_dock(struct sm5502_muic_info *info,
+				   bool attached)
+{
+	int ret;
+
+	if (attached == info->dock_routed)
+		return;
+	info->dock_routed = attached;
+
+	if (info->role_sw) {
+		if (attached) {
+			info->saved_role =
+				usb_role_switch_get_role(info->role_sw);
+			ret = usb_role_switch_set_role(info->role_sw,
+						       USB_ROLE_HOST);
+		} else {
+			ret = usb_role_switch_set_role(info->role_sw,
+						       info->saved_role);
+		}
+		if (ret)
+			dev_warn(info->dev, "failed to set USB role: %d\n",
+				 ret);
+	}
+
+	gpiod_set_value_cansleep(info->usb_switch, attached);
+}
+
 static int sm5502_muic_cable_handler(struct sm5502_muic_info *info,
 				     bool attached)
 {
@@ -500,6 +549,16 @@ static int sm5502_muic_cable_handler(struct sm5502_muic_info *info,
 		con_sw	= DM_DP_SWITCH_USB;
 		vbus_sw	= VBUSIN_SWITCH_OPEN;
 		break;
+	case SM5502_MUIC_ADC_DOCK:
+		/* The dock's USB lines bypass the MUIC switches */
+		dev_info(info->dev, "dock %s\n",
+			 attached ? "attached" : "detached");
+		sm5502_muic_route_dock(info, attached);
+		extcon_set_state(info->edev, EXTCON_USB_HOST,
+				 attached && (info->usb_switch || info->role_sw));
+		extcon_set_state_sync(info->edev, EXTCON_DOCK, attached);
+		extcon_sync(info->edev, EXTCON_USB_HOST);
+		return 0;
 	default:
 		dev_dbg(info->dev,
 			"cannot handle this cable_type (0x%x)\n", cable_type);
@@ -672,6 +731,13 @@ static void sm5502_init_dev_type(struct sm5502_muic_info *info)
 	}
 }
 
+static void sm5502_muic_put_role_sw(void *data)
+{
+	struct sm5502_muic_info *info = data;
+
+	usb_role_switch_put(info->role_sw);
+}
+
 static int sm5022_muic_i2c_probe(struct i2c_client *i2c)
 {
 	struct device_node *np = i2c->dev.of_node;
@@ -709,6 +775,21 @@ static int sm5022_muic_i2c_probe(struct i2c_client *i2c)
 		return ret;
 	}
 
+	info->usb_switch = devm_gpiod_get_optional(info->dev, "usb-switch",
+						   GPIOD_OUT_LOW);
+	if (IS_ERR(info->usb_switch))
+		return dev_err_probe(info->dev, PTR_ERR(info->usb_switch),
+				     "failed to get USB switch GPIO\n");
+
+	info->role_sw = usb_role_switch_get(info->dev);
+	if (IS_ERR(info->role_sw))
+		return dev_err_probe(info->dev, PTR_ERR(info->role_sw),
+				     "failed to get USB role switch\n");
+	ret = devm_add_action_or_reset(info->dev, sm5502_muic_put_role_sw,
+				       info);
+	if (ret)
+		return ret;
+
 	/* Support irq domain for SM5502 MUIC device */
 	irq_flags = IRQF_TRIGGER_FALLING | IRQF_ONESHOT | IRQF_SHARED;
 	ret = devm_regmap_add_irq_chip(info->dev, info->regmap, info->irq,
@@ -790,6 +871,7 @@ static const struct sm5502_type sm5504_data = {
 	.reg_data = sm5504_reg_data,
 	.num_reg_data = ARRAY_SIZE(sm5504_reg_data),
 	.otg_dev_type1 = SM5504_REG_DEV_TYPE1_USB_OTG_MASK,
+	.has_dock_ids = true,
 	.parse_irq = sm5504_parse_irq,
 };
 
-- 
2.56.0

