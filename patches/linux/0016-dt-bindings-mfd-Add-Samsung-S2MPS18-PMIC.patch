From cc64330f54ead80f1c671455f2d1bd161e6c92c3 Mon Sep 17 00:00:00 2001
From: dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>
Date: Wed, 21 Oct 2026 15:52:07 +1100
Subject: [PATCH 016/152] dt-bindings: mfd: Add Samsung S2MPS18 PMIC

The S2MPS18 is the main PMIC of Exynos9810 boards. It sits on the
SPEEDY bus owned by the APM and the AP reaches it through ACPM IPC, so
it is described as a child of the ACPM node, like the S2MPG10.

Regulator names follow the S2MPS11 family (BUCKn, LDOn). Only the LDOs
that the stock Exynos9810 kernel exposes are listed.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../bindings/mfd/samsung,s2mps18-pmic.yaml    | 59 +++++++++++++++++++
 .../bindings/regulator/samsung,s2mps18.yaml   | 43 ++++++++++++++
 2 files changed, 102 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/mfd/samsung,s2mps18-pmic.yaml
 create mode 100644 Documentation/devicetree/bindings/regulator/samsung,s2mps18.yaml

diff --git a/Documentation/devicetree/bindings/mfd/samsung,s2mps18-pmic.yaml b/Documentation/devicetree/bindings/mfd/samsung,s2mps18-pmic.yaml
new file mode 100644
index 000000000..2dd136ec6
--- /dev/null
+++ b/Documentation/devicetree/bindings/mfd/samsung,s2mps18-pmic.yaml
@@ -0,0 +1,59 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/mfd/samsung,s2mps18-pmic.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung S2MPS18 Power Management IC
+
+maintainers:
+  - dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>
+
+description: |
+  The Samsung S2MPS18 is the main Power Management IC of Exynos9810 based
+  devices, with buck converters, LDOs, power meters and an RTC. It sits on
+  the SPEEDY bus, which is owned by the APM, so the AP reaches it through
+  the ACPM firmware. The node is a child of the ACPM IPC node.
+
+properties:
+  compatible:
+    const: samsung,s2mps18-pmic
+
+  interrupts:
+    maxItems: 1
+
+  regulators:
+    type: object
+    $ref: /schemas/regulator/samsung,s2mps18.yaml
+    description:
+      List of child nodes that specify the regulators.
+
+  wakeup-source: true
+
+required:
+  - compatible
+  - regulators
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    pmic {
+        compatible = "samsung,s2mps18-pmic";
+        interrupts-extended = <&gpa0 1 IRQ_TYPE_LEVEL_LOW>;
+
+        regulators {
+            BUCK1 {
+                regulator-name = "vdd_mif";
+                regulator-min-microvolt = <450000>;
+                regulator-max-microvolt = <950000>;
+                regulator-always-on;
+            };
+
+            LDO2 {
+                regulator-name = "vqmmc";
+            };
+        };
+    };
diff --git a/Documentation/devicetree/bindings/regulator/samsung,s2mps18.yaml b/Documentation/devicetree/bindings/regulator/samsung,s2mps18.yaml
new file mode 100644
index 000000000..fabe93a8b
--- /dev/null
+++ b/Documentation/devicetree/bindings/regulator/samsung,s2mps18.yaml
@@ -0,0 +1,43 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/regulator/samsung,s2mps18.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung S2MPS18 Power Management IC regulators
+
+maintainers:
+  - dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>
+
+description: |
+  This is a part of device tree bindings for S2M and S5M family of Power
+  Management IC (PMIC).
+
+  The S2MPS18 provides 13 buck and up to 45 LDO regulators. The LDOs that
+  are not routed to the AP on Exynos9810 boards are not described.
+
+  See also Documentation/devicetree/bindings/mfd/samsung,s2mps18-pmic.yaml
+  for additional information and example.
+
+patternProperties:
+  "^LDO([1-9]|1[0-4]|22|28|3[0-9]|4[0-5])$":
+    type: object
+    $ref: regulator.yaml#
+    unevaluatedProperties: false
+    description:
+      Properties for single LDO regulator.
+
+    required:
+      - regulator-name
+
+  "^BUCK([1-9]|1[0-3])$":
+    type: object
+    $ref: regulator.yaml#
+    unevaluatedProperties: false
+    description:
+      Properties for single BUCK regulator.
+
+    required:
+      - regulator-name
+
+additionalProperties: false
-- 
