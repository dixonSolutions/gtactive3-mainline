From 0c6bf8207ad1cd217dde715891efbac471f0e628 Mon Sep 17 00:00:00 2001
From: dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>
Date: Wed, 21 Oct 2026 18:13:21 +1100
Subject: [PATCH 058/152] mfd: simple-mfd-i2c: Use a 16-bit regmap for the
 MAX77705 fuel gauge

The MAX77705 fuel gauge block (the "maxim,max77705-battery" device)
has 16-bit registers, but its simple_mfd_data carries no regmap_config,
so the parent regmap is the default 8-bit one. The max77705-hwmon cell
reads IIN, ISYS, AVGISYS, VSYS and VBYP through dev_get_regmap() on the
parent. Whether it gets this 8-bit map or the 16-bit map that the
max17042 cell registers later on the same client then depends on probe
order. With the 8-bit map it reads only the low byte and reports
garbage.

Give the parent a 16-bit little-endian regmap, the layout both cells
expect.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/mfd/simple-mfd-i2c.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/drivers/mfd/simple-mfd-i2c.c b/drivers/mfd/simple-mfd-i2c.c
index ef3ce4bdf..42c8f155c 100644
--- a/drivers/mfd/simple-mfd-i2c.c
+++ b/drivers/mfd/simple-mfd-i2c.c
@@ -93,7 +93,15 @@ static const struct mfd_cell max77705_sensor_cells[] = {
 	{ .name = "max77705-hwmon", },
 };
 
+/* The fuel gauge registers are 16 bits wide, LSB first on the wire */
+static const struct regmap_config maxim_mon_max77705_regmap_config = {
+	.reg_bits = 8,
+	.val_bits = 16,
+	.val_format_endian = REGMAP_ENDIAN_LITTLE,
+};
+
 static const struct simple_mfd_data maxim_mon_max77705 = {
+	.regmap_config = &maxim_mon_max77705_regmap_config,
 	.mfd_cell = max77705_sensor_cells,
 	.mfd_cell_size = ARRAY_SIZE(max77705_sensor_cells),
 };
