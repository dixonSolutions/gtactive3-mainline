From 3a5632d250978cdb749edaece2b3326555c69726 Mon Sep 17 00:00:00 2001
From: dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>
Date: Wed, 21 Oct 2026 18:36:53 +1100
Subject: [PATCH 100/152] clk: samsung: acpm: Add read-only Exynos9810 DVFS
 clocks

The Exynos9810 APM firmware runs its DVFS plugin behind ACPM channel 5
(the "acpm-ipc-channel" of the acpm_dvfs node in the stock device tree)
and answers the same FREQ_GET/FREQ_REQ messages as gs101: domain ID in
cmd[0], rate in kHz in cmd[1], request type in cmd[2] (Samsung's
cal-if/acpm_dvfs.c).

Take the per-SoC data from the platform device ID and add the first
five Exynos9810 domains, MIF, INT, CPUCL0, CPUCL1 and G3D. They are
registered read-only for now: the clocks only ask the firmware for the
current rate, which is logged at probe, and never request one. The
rate tables kept by the firmware in its SRAM (fvmap) list the levels
the DVFS plugin accepts, 208-2002 MHz for CPUCL0, 598-2886 MHz for
CPUCL1 and 260-598 MHz for G3D on SM-T570.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/clk/samsung/clk-acpm.c | 58 ++++++++++++++++++++++++++++++----
 1 file changed, 51 insertions(+), 7 deletions(-)

diff --git a/drivers/clk/samsung/clk-acpm.c b/drivers/clk/samsung/clk-acpm.c
index 7680bc8c5..68ef89f53 100644
--- a/drivers/clk/samsung/clk-acpm.c
+++ b/drivers/clk/samsung/clk-acpm.c
@@ -15,6 +15,7 @@
 #include <linux/module.h>
 #include <linux/platform_device.h>
 #include <linux/types.h>
+#include <linux/units.h>
 
 struct acpm_clk {
 	u32 id;
@@ -31,6 +32,7 @@ struct acpm_clk_driver_data {
 	const struct acpm_clk_variant *clks;
 	unsigned int nr_clks;
 	unsigned int mbox_chan_id;
+	bool read_only;
 };
 
 #define to_acpm_clk(clk) container_of(clk, struct acpm_clk, hw)
@@ -63,6 +65,28 @@ static const struct acpm_clk_driver_data acpm_clk_gs101 = {
 	.mbox_chan_id = 0,
 };
 
+/*
+ * Exynos9810: the DVFS plugin of the APM firmware listens on ACPM channel 5
+ * ("acpm-ipc-channel" of the stock acpm_dvfs node) and uses the same
+ * FREQ_REQ/FREQ_GET messages as gs101, rates in kHz. Domains 0-4 only, the
+ * ones with a consumer; the IDs must stay sequential from zero.
+ */
+static const struct acpm_clk_variant exynos9810_acpm_clks[] = {
+	ACPM_CLK("dvfs_mif"),
+	ACPM_CLK("dvfs_int"),
+	ACPM_CLK("dvfs_cpucl0"),
+	ACPM_CLK("dvfs_cpucl1"),
+	ACPM_CLK("dvfs_g3d"),
+};
+
+static const struct acpm_clk_driver_data acpm_clk_exynos9810 = {
+	.clks = exynos9810_acpm_clks,
+	.nr_clks = ARRAY_SIZE(exynos9810_acpm_clks),
+	.mbox_chan_id = 5,
+	/* only FREQ_GET until the rates have been checked on hardware */
+	.read_only = true,
+};
+
 static unsigned long acpm_clk_recalc_rate(struct clk_hw *hw,
 					  unsigned long parent_rate)
 {
@@ -87,13 +111,20 @@ static const struct clk_ops acpm_clk_ops = {
 	.set_rate = acpm_clk_set_rate,
 };
 
+static const struct clk_ops acpm_clk_ro_ops = {
+	.recalc_rate = acpm_clk_recalc_rate,
+};
+
 static int acpm_clk_register(struct device *dev, struct acpm_clk *aclk,
-			     const char *name)
+			     const char *name, bool read_only)
 {
 	struct clk_init_data init = {};
 
 	init.name = name;
-	init.ops = &acpm_clk_ops;
+	init.ops = read_only ? &acpm_clk_ro_ops : &acpm_clk_ops;
+	/* nobody asks for a rate here, so do not cache the firmware's choice */
+	if (read_only)
+		init.flags = CLK_GET_RATE_NOCACHE;
 	aclk->hw.init = &init;
 
 	return devm_clk_hw_register(dev, &aclk->hw);
@@ -101,6 +132,8 @@ static int acpm_clk_register(struct device *dev, struct acpm_clk *aclk,
 
 static int acpm_clk_probe(struct platform_device *pdev)
 {
+	const struct acpm_clk_driver_data *data =
+		(const void *)platform_get_device_id(pdev)->driver_data;
 	struct acpm_handle *acpm_handle;
 	struct clk_hw_onecell_data *clk_data;
 	struct clk_hw **hws;
@@ -114,8 +147,8 @@ static int acpm_clk_probe(struct platform_device *pdev)
 		return dev_err_probe(dev, PTR_ERR(acpm_handle),
 				     "Failed to get acpm handle\n");
 
-	count = acpm_clk_gs101.nr_clks;
-	mbox_chan_id = acpm_clk_gs101.mbox_chan_id;
+	count = data->nr_clks;
+	mbox_chan_id = data->mbox_chan_id;
 
 	clk_data = devm_kzalloc(dev, struct_size(clk_data, hws, count),
 				GFP_KERNEL);
@@ -142,11 +175,16 @@ static int acpm_clk_probe(struct platform_device *pdev)
 
 		hws[i] = &aclk->hw;
 
-		err = acpm_clk_register(dev, aclk,
-					acpm_clk_gs101.clks[i].name);
+		err = acpm_clk_register(dev, aclk, data->clks[i].name,
+					data->read_only);
 		if (err)
 			return dev_err_probe(dev, err,
 					     "Failed to register clock\n");
+
+		if (data->read_only)
+			dev_info(dev, "%s: %lu kHz (read-only)\n",
+				 data->clks[i].name,
+				 clk_hw_get_rate(&aclk->hw) / HZ_PER_KHZ);
 	}
 
 	return devm_of_clk_add_hw_provider(dev, of_clk_hw_onecell_get,
@@ -154,7 +192,13 @@ static int acpm_clk_probe(struct platform_device *pdev)
 }
 
 static const struct platform_device_id acpm_clk_id[] = {
-	{ .name = "gs101-acpm-clk" },
+	{
+		.name = "gs101-acpm-clk",
+		.driver_data = (kernel_ulong_t)&acpm_clk_gs101,
+	}, {
+		.name = "exynos9810-acpm-clk",
+		.driver_data = (kernel_ulong_t)&acpm_clk_exynos9810,
+	},
 	{ }
 };
 MODULE_DEVICE_TABLE(platform, acpm_clk_id);
-- 
