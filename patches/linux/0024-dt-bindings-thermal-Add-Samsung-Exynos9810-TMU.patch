From e39c36b35e338236e5f00aecea69a302c6c8c623 Mon Sep 17 00:00:00 2001
From: dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>
Date: Wed, 21 Oct 2026 15:54:21 +1100
Subject: [PATCH 24/64] dt-bindings: thermal: Add Samsung Exynos9810 TMU

The Exynos9810 TMU instances have up to 16 remote probes each, so the
sensor specifier selects the probe. Its register layout differs from
the TMUs covered by samsung,exynos-thermal.yaml (per-probe TRIMINFO and
packed 9-bit CURRENT_TEMP fields).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../thermal/samsung,exynos9810-tmu.yaml       | 51 +++++++++++++++++++
 1 file changed, 51 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/thermal/samsung,exynos9810-tmu.yaml

diff --git a/Documentation/devicetree/bindings/thermal/samsung,exynos9810-tmu.yaml b/Documentation/devicetree/bindings/thermal/samsung,exynos9810-tmu.yaml
new file mode 100644
index 000000000..5700f150e
--- /dev/null
+++ b/Documentation/devicetree/bindings/thermal/samsung,exynos9810-tmu.yaml
@@ -0,0 +1,51 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/thermal/samsung,exynos9810-tmu.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung Exynos9810 Thermal Management Unit (TMU)
+
+maintainers:
+  - dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>
+
+description:
+  Exynos9810 has two TMU instances, TMU_TOP and TMU_SUB, with up to 16
+  remote temperature probes each. The probes are selected with the sensor
+  specifier, which is the probe number.
+
+$ref: thermal-sensor.yaml#
+
+properties:
+  compatible:
+    const: samsung,exynos9810-tmu
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+
+  "#thermal-sensor-cells":
+    const: 1
+
+required:
+  - compatible
+  - reg
+  - "#thermal-sensor-cells"
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+
+    thermal-sensor@10070000 {
+        compatible = "samsung,exynos9810-tmu";
+        reg = <0x10070000 0x700>;
+        interrupts = <GIC_SPI 478 IRQ_TYPE_LEVEL_HIGH>;
+        #thermal-sensor-cells = <1>;
+    };
-- 
