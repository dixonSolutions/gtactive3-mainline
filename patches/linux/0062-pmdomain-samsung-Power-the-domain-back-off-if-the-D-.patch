From 6db8f4bd19fe32db8b448019f9518990c00778a4 Mon Sep 17 00:00:00 2001
From: dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>
Date: Wed, 21 Oct 2026 17:16:29 +1100
Subject: [PATCH 62/64] pmdomain: samsung: Power the domain back off if the
 D-TZPC restore fails

When the secure monitor refuses to restore a domain's D-TZPC after
power-on, genpd records the domain as off, but the PMU had already
switched it on and the G3D clocks had been moved back to the PLL. Turn
it off again and park the clocks, so the hardware matches genpd's view
and the next power-on runs the full sequence again.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/pmdomain/samsung/exynos-pm-domains.c | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/drivers/pmdomain/samsung/exynos-pm-domains.c b/drivers/pmdomain/samsung/exynos-pm-domains.c
index 7823132fd..2a42be8fb 100644
--- a/drivers/pmdomain/samsung/exynos-pm-domains.c
+++ b/drivers/pmdomain/samsung/exynos-pm-domains.c
@@ -114,7 +114,19 @@ static int exynos_pd_power_on(struct generic_pm_domain *domain)
 	if (ret)
 		return ret;
 
-	return exynos_pd_dtzpc(pd, EXYNOS_PD_DTZPC_RESTORE);
+	ret = exynos_pd_dtzpc(pd, EXYNOS_PD_DTZPC_RESTORE);
+	if (ret) {
+		/*
+		 * genpd now considers the domain off: make the hardware match,
+		 * so that nobody reaches the block with its D-TZPC unrestored
+		 * and the next power-on starts from a clean state.
+		 */
+		if (!exynos_pd_power(domain, false) &&
+		    pd->cfg && pd->cfg->post_off)
+			pd->cfg->post_off(pd);
+	}
+
+	return ret;
 }
 
 static int exynos_pd_power_off(struct generic_pm_domain *domain)
