From 22cde7bf834bdcacd63eb6d71681aecac70519ac Mon Sep 17 00:00:00 2001
From: dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>
Date: Wed, 21 Oct 2026 18:56:53 +1100
Subject: [PATCH 115/119] arm64: dts: exynos: gtactive3wifi: Drop the GPU power
 domain link for now

With CONFIG_PM=n there is no driver for pd_g3d and fw_devlink defers
the GPU indefinitely ("supplier 14064040.power-domain not ready").
S-Boot leaves G3D powered, so drop the link until power cycling works.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/exynos/exynos9810-gtactive3wifi.dts | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/exynos9810-gtactive3wifi.dts b/arch/arm64/boot/dts/exynos/exynos9810-gtactive3wifi.dts
index 2f166f2fc..eb7425e3f 100644
--- a/arch/arm64/boot/dts/exynos/exynos9810-gtactive3wifi.dts
+++ b/arch/arm64/boot/dts/exynos/exynos9810-gtactive3wifi.dts
@@ -856,6 +856,13 @@ gpu_clk: clock-gpu {
 
 &gpu {
 	clocks = <&gpu_clk>;
+	/*
+	 * Stage 1: G3D is left on by S-Boot and the pm-domain driver is not
+	 * built (CONFIG_PM=n), so a power-domains link would only make
+	 * fw_devlink defer the GPU forever. Drop it until power cycling is
+	 * implemented and tested.
+	 */
+	/delete-property/ power-domains;
 	status = "okay";
 };
 
-- 
