From 4e01b8f2ef16940d35536095b7e9fe2938816954 Mon Sep 17 00:00:00 2001
From: dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>
Date: Wed, 21 Oct 2026 16:47:05 +1100
Subject: [PATCH 064/152] dt-bindings: PCI: Add Samsung Exynos9810 PCIe
 controller

Channel 0 of the Exynos9810 PCIe block: a DesignWare Gen2 x1 root
complex whose PHY (PCS + PMA) shares resets with the controller ELBI.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../bindings/pci/samsung,exynos9810-pcie.yaml | 98 +++++++++++++++++++
 1 file changed, 98 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/pci/samsung,exynos9810-pcie.yaml

diff --git a/Documentation/devicetree/bindings/pci/samsung,exynos9810-pcie.yaml b/Documentation/devicetree/bindings/pci/samsung,exynos9810-pcie.yaml
new file mode 100644
index 000000000..9853e57ac
--- /dev/null
+++ b/Documentation/devicetree/bindings/pci/samsung,exynos9810-pcie.yaml
@@ -0,0 +1,98 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/pci/samsung,exynos9810-pcie.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung Exynos9810 PCIe Gen2 Host Controller
+
+maintainers:
+  - dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>
+
+description:
+  Channel 0 of the Exynos9810 PCIe subsystem, a Synopsys DesignWare Gen2 x1
+  root complex with an integrated PHY. It inherits the common properties
+  defined in snps,dw-pcie.yaml. The PHY is programmed through the "phy"
+  region (PCS block, followed by the PMA block at offset 0x10000).
+
+allOf:
+  - $ref: /schemas/pci/snps,dw-pcie.yaml#
+
+properties:
+  compatible:
+    const: samsung,exynos9810-pcie
+
+  reg:
+    items:
+      - description: Data Bus Interface (DBI) registers.
+      - description: External Local Bus interface (ELBI) registers.
+      - description: PHY PCS and PMA registers.
+      - description: PCIe configuration space region.
+
+  reg-names:
+    items:
+      - const: dbi
+      - const: elbi
+      - const: phy
+      - const: config
+
+  interrupts:
+    maxItems: 1
+
+  reset-gpios:
+    maxItems: 1
+    description: PERST# line to the endpoint.
+
+  vpcie3v3-supply:
+    description: Endpoint power, e.g. the Wi-Fi chip's WL_REG_ON line.
+
+  samsung,pmu-syscon:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: PMU system controller, holds the PHY isolation control.
+
+  samsung,fsys-sysreg:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: FSYS1 system registers, hold the PHY lane configuration.
+
+required:
+  - reg
+  - reg-names
+  - interrupts
+  - "#interrupt-cells"
+  - interrupt-map
+  - interrupt-map-mask
+  - ranges
+  - reset-gpios
+  - samsung,pmu-syscon
+  - samsung,fsys-sysreg
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+
+    pcie@11700000 {
+        compatible = "samsung,exynos9810-pcie";
+        reg = <0x11700000 0x1000>,
+              <0x116a0000 0x1000>,
+              <0x116c0000 0x20000>,
+              <0x127fe000 0x2000>;
+        reg-names = "dbi", "elbi", "phy", "config";
+        interrupts = <GIC_SPI 253 IRQ_TYPE_LEVEL_HIGH>;
+        #address-cells = <3>;
+        #size-cells = <2>;
+        device_type = "pci";
+        bus-range = <0x00 0xff>;
+        ranges = <0x82000000 0x0 0x11800000 0x11800000 0x0 0xff0000>;
+        num-lanes = <1>;
+        max-link-speed = <2>;
+        #interrupt-cells = <1>;
+        interrupt-map-mask = <0 0 0 0>;
+        interrupt-map = <0 0 0 0 &gic GIC_SPI 253 IRQ_TYPE_LEVEL_HIGH>;
+        reset-gpios = <&gpf2 2 GPIO_ACTIVE_LOW>;
+        samsung,pmu-syscon = <&pmu_system_controller>;
+        samsung,fsys-sysreg = <&syscon_fsys1>;
+    };
+...
-- 
