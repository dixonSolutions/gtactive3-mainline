From 8fae428e5ede2bdb58f159fecd036050088945d7 Mon Sep 17 00:00:00 2001
From: dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>
Date: Wed, 21 Oct 2026 16:41:13 +1100
Subject: [PATCH 054/152] Input: himax_hx83112b - add SPI bus and HX83102E
 support

The Himax HX83102E is a TDDI chip found e.g. in the Samsung Galaxy Tab
Active3 (SM-T570). Its touch controller is connected over SPI but uses
the same AHB register interface as the I2C parts: every access is
prefixed with a command byte (0xf2 = write, 0xf3 = read, followed by a
dummy byte before the data), so the driver core can stay unchanged
behind a small regmap bus.

The IC ID register reads 0x83102e. Samsung's firmware for this chip
appends per finger major/minor data to the standard event, giving
80 byte frames whose checksum covers the whole frame, so make the event
size per chip and read the events into a DMA safe buffer. The firmware
also needs 50 ms after reset before it can be accessed.

Event layout, SPI protocol, SPI mode 3 and the reset timing are taken
from the Himax driver in Samsung's GPL kernel for the SM-T570.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/input/touchscreen/Kconfig          |  10 +-
 drivers/input/touchscreen/himax_hx83112b.c | 305 ++++++++++++++++++---
 2 files changed, 274 insertions(+), 41 deletions(-)

diff --git a/drivers/input/touchscreen/Kconfig b/drivers/input/touchscreen/Kconfig
index 9b9ae8ac3..1b4c04330 100644
--- a/drivers/input/touchscreen/Kconfig
+++ b/drivers/input/touchscreen/Kconfig
@@ -1404,10 +1404,14 @@ config TOUCHSCREEN_ZINITIX
 
 config TOUCHSCREEN_HIMAX_HX83112B
 	tristate "Himax hx83112b touchscreen driver"
-	depends on I2C
-	select REGMAP_I2C
+	depends on I2C || SPI_MASTER
+	depends on I2C || !I2C
+	select REGMAP
+	select REGMAP_I2C if I2C
 	help
-	  Say Y here to enable support for Himax hx83112b touchscreens.
+	  Say Y here to enable support for Himax hx83100a and hx83112b
+	  touchscreens connected over I2C and for Himax hx83102e TDDI
+	  touchscreens connected over SPI.
 
 	  If unsure, say N.
 
diff --git a/drivers/input/touchscreen/himax_hx83112b.c b/drivers/input/touchscreen/himax_hx83112b.c
index 79fc1c492..5796039a9 100644
--- a/drivers/input/touchscreen/himax_hx83112b.c
+++ b/drivers/input/touchscreen/himax_hx83112b.c
@@ -7,6 +7,9 @@
  * HX83100A support
  * Copyright (C) 2024 Felix Kaechele <felix@kaechele.ca>
  *
+ * HX83102E (SPI) support, based on the Himax driver in Samsung's GPL
+ * kernel for the Galaxy Tab Active3 (SM-T570).
+ *
  * This code is based on "Himax Android Driver Sample Code for QCT platform":
  *
  * Copyright (C) 2017 Himax Corporation.
@@ -22,6 +25,7 @@
 #include <linux/interrupt.h>
 #include <linux/kernel.h>
 #include <linux/regmap.h>
+#include <linux/spi/spi.h>
 
 #define HIMAX_MAX_POINTS		10
 
@@ -42,6 +46,18 @@
 
 #define HIMAX_INVALID_COORD		0xffff
 
+/* SPI command bytes preceding the register address */
+#define HIMAX_SPI_CMD_WRITE		0xf2
+#define HIMAX_SPI_CMD_READ		0xf3
+
+/*
+ * Largest event the firmware reports: Samsung builds of the HX83102E
+ * firmware append 24 bytes of per finger major/minor data to the
+ * standard 56 byte event, and the checksum covers the whole frame.
+ */
+#define HIMAX_MAX_EVENT_SIZE		128
+#define HX83102E_EVENT_SIZE		80
+
 struct himax_event_point {
 	__be16 x;
 	__be16 y;
@@ -62,8 +78,12 @@ struct himax_ts_data;
 struct himax_chip {
 	u32 id;
 	int (*check_id)(struct himax_ts_data *ts);
-	int (*read_events)(struct himax_ts_data *ts, struct himax_event *event,
+	int (*read_events)(struct himax_ts_data *ts, void *event,
 			   size_t length);
+	/* bytes read from the event stack and covered by the checksum */
+	size_t event_size;
+	/* time the firmware needs to start after reset, 0 for the default */
+	unsigned int reset_delay_ms;
 };
 
 struct himax_ts_data {
@@ -73,6 +93,7 @@ struct himax_ts_data {
 	struct device *dev;
 	struct regmap *regmap;
 	int irq;
+	u8 *event_buf;
 	struct touchscreen_properties props;
 };
 
@@ -143,7 +164,10 @@ static void himax_reset(struct himax_ts_data *ts)
 	 * The downstream driver doesn't contain this delay but is seems safer
 	 * to include it. The range is just a guess that seems to work well.
 	 */
-	usleep_range(1000, 1100);
+	if (ts->chip->reset_delay_ms)
+		msleep(ts->chip->reset_delay_ms);
+	else
+		usleep_range(1000, 1100);
 }
 
 static int himax_read_product_id(struct himax_ts_data *ts, u32 *product_id)
@@ -259,18 +283,17 @@ static void himax_process_event(struct himax_ts_data *ts,
 }
 
 static bool himax_verify_checksum(struct himax_ts_data *ts,
-				  const struct himax_event *event)
+				  const u8 *data, size_t length)
 {
-	u8 *data = (u8 *)event;
-	int i;
+	size_t i;
 	u16 checksum = 0;
 
-	for (i = 0; i < sizeof(*event); i++)
+	for (i = 0; i < length; i++)
 		checksum += data[i];
 
 	if ((checksum & 0x00ff) != 0) {
-		dev_err(ts->dev, "Wrong event checksum: %04x\n",
-			checksum);
+		dev_err_ratelimited(ts->dev, "Wrong event checksum: %04x\n",
+				    checksum);
 		return false;
 	}
 
@@ -278,36 +301,39 @@ static bool himax_verify_checksum(struct himax_ts_data *ts,
 }
 
 static int himax_read_events(struct himax_ts_data *ts,
-			     struct himax_event *event, size_t length)
+			     void *event, size_t length)
 {
 	return regmap_raw_read(ts->regmap, HIMAX_AHB_ADDR_EVENT_STACK, event,
 			       length);
 }
 
 static int hx83100a_read_events(struct himax_ts_data *ts,
-				struct himax_event *event, size_t length)
+				void *event, size_t length)
 {
 	return himax_bus_read(ts, HX83100A_REG_FW_EVENT_STACK, event, length);
 };
 
 static int himax_handle_input(struct himax_ts_data *ts)
 {
+	size_t length = ts->chip->event_size;
 	int error;
-	struct himax_event event;
 
-	error = ts->chip->read_events(ts, &event, sizeof(event));
+	error = ts->chip->read_events(ts, ts->event_buf, length);
 	if (error) {
 		dev_err(ts->dev, "Failed to read input event: %d\n",
 			error);
 		return error;
 	}
 
+	print_hex_dump_debug("himax event: ", DUMP_PREFIX_OFFSET, 16, 1,
+			     ts->event_buf, length, false);
+
 	/*
 	 * Only process the current event when it has a valid checksum but
 	 * don't consider it a fatal error when it doesn't.
 	 */
-	if (himax_verify_checksum(ts, &event))
-		himax_process_event(ts, &event);
+	if (himax_verify_checksum(ts, ts->event_buf, length))
+		himax_process_event(ts, (const struct himax_event *)ts->event_buf);
 
 	return 0;
 }
@@ -330,6 +356,9 @@ static int himax_probe_common(struct device *dev, struct regmap *regmap,
 	int error;
 	struct himax_ts_data *ts;
 
+	if (!chip)
+		return -ENODEV;
+
 	ts = devm_kzalloc(dev, sizeof(*ts), GFP_KERNEL);
 	if (!ts)
 		return -ENOMEM;
@@ -340,6 +369,15 @@ static int himax_probe_common(struct device *dev, struct regmap *regmap,
 	ts->regmap = regmap;
 	ts->irq = irq;
 
+	if (WARN_ON(chip->event_size < sizeof(struct himax_event) ||
+		    chip->event_size > HIMAX_MAX_EVENT_SIZE))
+		return -EINVAL;
+
+	/* Also used as a SPI rx buffer, so it must be DMA safe */
+	ts->event_buf = devm_kzalloc(dev, HIMAX_MAX_EVENT_SIZE, GFP_KERNEL);
+	if (!ts->event_buf)
+		return -ENOMEM;
+
 	ts->gpiod_rst = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
 	error = PTR_ERR_OR_ZERO(ts->gpiod_rst);
 	if (error) {
@@ -368,26 +406,6 @@ static int himax_probe_common(struct device *dev, struct regmap *regmap,
 	return 0;
 }
 
-static int himax_i2c_probe(struct i2c_client *client)
-{
-	struct device *dev = &client->dev;
-	struct regmap *regmap;
-
-	if (!i2c_check_functionality(client->adapter, I2C_FUNC_I2C)) {
-		dev_err(dev, "I2C check functionality failed\n");
-		return -ENXIO;
-	}
-
-	regmap = devm_regmap_init_i2c(client, &himax_regmap_config);
-	if (IS_ERR(regmap)) {
-		dev_err(dev, "Failed to initialize regmap: %pe\n", regmap);
-		return PTR_ERR(regmap);
-	}
-
-	return himax_probe_common(dev, regmap, client->irq,
-				  i2c_get_match_data(client));
-}
-
 static int himax_suspend(struct device *dev)
 {
 	struct himax_ts_data *ts = dev_get_drvdata(dev);
@@ -406,16 +424,48 @@ static int himax_resume(struct device *dev)
 
 static DEFINE_SIMPLE_DEV_PM_OPS(himax_pm_ops, himax_suspend, himax_resume);
 
-static const struct himax_chip hx83100a_chip = {
+static const struct himax_chip hx83100a_chip __maybe_unused = {
 	.read_events = hx83100a_read_events,
+	.event_size = sizeof(struct himax_event),
+};
+
+static const struct himax_chip hx83102e_chip __maybe_unused = {
+	.id = 0x83102e,
+	.check_id = himax_check_product_id,
+	.read_events = himax_read_events,
+	.event_size = HX83102E_EVENT_SIZE,
+	/* Samsung's driver waits 50 ms before talking to the firmware */
+	.reset_delay_ms = 50,
 };
 
-static const struct himax_chip hx83112b_chip = {
+static const struct himax_chip hx83112b_chip __maybe_unused = {
 	.id = 0x83112b,
 	.check_id = himax_check_product_id,
 	.read_events = himax_read_events,
+	.event_size = sizeof(struct himax_event),
 };
 
+#if IS_ENABLED(CONFIG_I2C)
+static int himax_i2c_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct regmap *regmap;
+
+	if (!i2c_check_functionality(client->adapter, I2C_FUNC_I2C)) {
+		dev_err(dev, "I2C check functionality failed\n");
+		return -ENXIO;
+	}
+
+	regmap = devm_regmap_init_i2c(client, &himax_regmap_config);
+	if (IS_ERR(regmap)) {
+		dev_err(dev, "Failed to initialize regmap: %pe\n", regmap);
+		return PTR_ERR(regmap);
+	}
+
+	return himax_probe_common(dev, regmap, client->irq,
+				  i2c_get_match_data(client));
+}
+
 static const struct i2c_device_id himax_ts_id[] = {
 	{ .name = "hx83100a", .driver_data = (kernel_ulong_t)&hx83100a_chip },
 	{ .name = "hx83112b", .driver_data = (kernel_ulong_t)&hx83112b_chip },
@@ -441,8 +491,187 @@ static struct i2c_driver himax_ts_driver = {
 		.pm = pm_sleep_ptr(&himax_pm_ops),
 	},
 };
-module_i2c_driver(himax_ts_driver);
+
+static int himax_i2c_register(void)
+{
+	return i2c_add_driver(&himax_ts_driver);
+}
+
+static void himax_i2c_unregister(void)
+{
+	i2c_del_driver(&himax_ts_driver);
+}
+#else
+static int himax_i2c_register(void)
+{
+	return 0;
+}
+
+static void himax_i2c_unregister(void)
+{
+}
+#endif /* CONFIG_I2C */
+
+#if IS_ENABLED(CONFIG_SPI_MASTER)
+/*
+ * Over SPI, every register access starts with a command byte: 0xf2 for a
+ * write, followed by the register address and the data, and 0xf3 for a
+ * read, followed by the register address and one dummy byte before the
+ * controller shifts the data out.
+ */
+struct himax_spi {
+	struct spi_device *spi;
+	u8 *buf;	/* DMA safe tx buffer, serialized by the regmap lock */
+};
+
+#define HIMAX_SPI_BUF_SIZE	16
+
+static int himax_spi_regmap_write(void *context, const void *data,
+				  size_t count)
+{
+	struct himax_spi *hs = context;
+
+	if (count + 1 > HIMAX_SPI_BUF_SIZE)
+		return -EINVAL;
+
+	hs->buf[0] = HIMAX_SPI_CMD_WRITE;
+	memcpy(&hs->buf[1], data, count);
+
+	return spi_write(hs->spi, hs->buf, count + 1);
+}
+
+static int himax_spi_regmap_read(void *context, const void *reg,
+				 size_t reg_size, void *val, size_t val_size)
+{
+	struct himax_spi *hs = context;
+	struct spi_transfer xfers[] = {
+		{
+			.tx_buf = hs->buf,
+			.len = 3,
+		}, {
+			.rx_buf = val,
+			.len = val_size,
+		},
+	};
+
+	if (reg_size != 1)
+		return -EINVAL;
+
+	hs->buf[0] = HIMAX_SPI_CMD_READ;
+	hs->buf[1] = *(const u8 *)reg;
+	hs->buf[2] = 0;
+
+	return spi_sync_transfer(hs->spi, xfers, ARRAY_SIZE(xfers));
+}
+
+static const struct regmap_bus himax_spi_regmap_bus = {
+	.write = himax_spi_regmap_write,
+	.read = himax_spi_regmap_read,
+	.max_raw_write = HIMAX_SPI_BUF_SIZE - 1,
+	.max_raw_read = HIMAX_MAX_EVENT_SIZE,
+};
+
+static int himax_spi_probe(struct spi_device *spi)
+{
+	struct device *dev = &spi->dev;
+	struct regmap *regmap;
+	struct himax_spi *hs;
+	int error;
+
+	if (spi->controller->flags & SPI_CONTROLLER_HALF_DUPLEX)
+		return dev_err_probe(dev, -EINVAL,
+				     "Full duplex SPI controller required\n");
+
+	spi->bits_per_word = 8;
+	error = spi_setup(spi);
+	if (error)
+		return error;
+
+	hs = devm_kzalloc(dev, sizeof(*hs), GFP_KERNEL);
+	if (!hs)
+		return -ENOMEM;
+
+	hs->buf = devm_kzalloc(dev, HIMAX_SPI_BUF_SIZE, GFP_KERNEL);
+	if (!hs->buf)
+		return -ENOMEM;
+
+	hs->spi = spi;
+
+	regmap = devm_regmap_init(dev, &himax_spi_regmap_bus, hs,
+				  &himax_regmap_config);
+	if (IS_ERR(regmap))
+		return dev_err_probe(dev, PTR_ERR(regmap),
+				     "Failed to initialize regmap\n");
+
+	return himax_probe_common(dev, regmap, spi->irq,
+				  spi_get_device_match_data(spi));
+}
+
+static const struct spi_device_id himax_spi_id[] = {
+	{ .name = "hx83102e", .driver_data = (kernel_ulong_t)&hx83102e_chip },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(spi, himax_spi_id);
+
+static const struct of_device_id himax_spi_of_match[] = {
+	{ .compatible = "himax,hx83102e", .data = &hx83102e_chip },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, himax_spi_of_match);
+
+static struct spi_driver himax_spi_driver = {
+	.probe = himax_spi_probe,
+	.id_table = himax_spi_id,
+	.driver = {
+		.name = "himax-hx83102e-ts",
+		.of_match_table = himax_spi_of_match,
+		.pm = pm_sleep_ptr(&himax_pm_ops),
+	},
+};
+
+static int himax_spi_register(void)
+{
+	return spi_register_driver(&himax_spi_driver);
+}
+
+static void himax_spi_unregister(void)
+{
+	spi_unregister_driver(&himax_spi_driver);
+}
+#else
+static int himax_spi_register(void)
+{
+	return 0;
+}
+
+static void himax_spi_unregister(void)
+{
+}
+#endif /* CONFIG_SPI_MASTER */
+
+static int __init himax_ts_init(void)
+{
+	int error;
+
+	error = himax_i2c_register();
+	if (error)
+		return error;
+
+	error = himax_spi_register();
+	if (error)
+		himax_i2c_unregister();
+
+	return error;
+}
+module_init(himax_ts_init);
+
+static void __exit himax_ts_exit(void)
+{
+	himax_spi_unregister();
+	himax_i2c_unregister();
+}
+module_exit(himax_ts_exit);
 
 MODULE_AUTHOR("Job Noorman <job@noorman.info>");
-MODULE_DESCRIPTION("Himax hx83112b touchscreen driver");
+MODULE_DESCRIPTION("Himax hx83112b/hx83102e touchscreen driver");
 MODULE_LICENSE("GPL");
