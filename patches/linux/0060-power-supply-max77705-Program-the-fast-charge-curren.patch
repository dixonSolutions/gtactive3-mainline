From 150521e4697f2c519d643338d158a9732e752e1a Mon Sep 17 00:00:00 2001
From: dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>
Date: Wed, 21 Oct 2026 18:15:56 +1100
Subject: [PATCH 060/152] power: supply: max77705: Program the fast-charge
 current from battery info

The driver sets the float voltage from the monitored battery but never
touches CHG_CC, so charging always runs at the 450 mA reset default,
whatever the battery and the source allow. On the Galaxy Tab Active3
this makes a 500 mA USB port barely hold the battery level while the
system runs.

Program CHG_CC from constant-charge-current-max-microamp when the
battery node provides it. The input current limit (CHGIN_ILIM, which
AICL lowers on weak sources) still bounds the power taken from the
source.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/power/supply/max77705_charger.c | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/drivers/power/supply/max77705_charger.c b/drivers/power/supply/max77705_charger.c
index a71d0f74c..b62127ba4 100644
--- a/drivers/power/supply/max77705_charger.c
+++ b/drivers/power/supply/max77705_charger.c
@@ -548,7 +548,6 @@ static int max77705_charger_initialize(struct max77705_charger_data *chg)
 	if (err)
 		goto err;
 
-	/* charge current 450mA(default) */
 	/* otg current limit 900mA */
 	err = regmap_field_write(chg->rfield[MAX77705_OTG_ILIM], MAX77705_OTG_ILIM_900);
 	if (err)
@@ -582,6 +581,17 @@ static int max77705_charger_initialize(struct max77705_charger_data *chg)
 		max77705_set_float_voltage(chg, info->voltage_max_design_uv);
 	}
 
+	/*
+	 * Fast-charge current: the battery's limit if it has one, otherwise
+	 * keep the 450 mA reset default. The input current limit still caps
+	 * what is actually drawn from the source.
+	 */
+	if (info->constant_charge_current_max_ua > 0) {
+		err = max77705_set_charge_current(chg, info->constant_charge_current_max_ua);
+		if (err)
+			goto err;
+	}
+
 	err = regmap_field_write(chg->rfield[MAX77705_VCHGIN], MAX77705_VCHGIN_4_5);
 	if (err)
 		goto err;
