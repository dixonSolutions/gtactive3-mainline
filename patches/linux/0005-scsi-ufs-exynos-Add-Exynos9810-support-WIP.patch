From c9e9d8d1962978194f803da8be3a48a1bc1ec92b Mon Sep 17 00:00:00 2001
From: dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>
Date: Wed, 21 Oct 2026 14:44:18 +1100
Subject: [PATCH 5/7] scsi: ufs: exynos: Add Exynos9810 support (WIP)

Exynos9810 is calibrated almost like FSD; differences from Samsung's
ufs-cal-9810.c are applied in its own pre_link and pre_pwr_change hooks.
The UFSP SMU is secured, HCI_UFS_ACG_DISABLE must be set before link
startup on this IP revision, and the lane count is read before the
per-lane PCS writes. Bring-up module parameters allow trying link
startup variants without rebuilding.

Work in progress: link startup does not succeed yet.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/ufs/host/ufs-exynos.c | 149 ++++++++++++++++++++++++++++++++++
 1 file changed, 149 insertions(+)

diff --git a/drivers/ufs/host/ufs-exynos.c b/drivers/ufs/host/ufs-exynos.c
index b2f65c465..206961b40 100644
--- a/drivers/ufs/host/ufs-exynos.c
+++ b/drivers/ufs/host/ufs-exynos.c
@@ -2258,6 +2258,153 @@ static struct exynos_ufs_uic_attr fsd_uic_attr = {
 	.pa_dbg_opt_suite1_off		= PA_DBG_OPTION_SUITE,
 };
 
+/*
+ * Exynos9810 is calibrated like FSD (same UniPro debug option suite, same
+ * post-link sequence); the differences below come from Samsung's
+ * ufs-cal-9810.c init_cfg and calib_of_hs_rate tables.
+ */
+static struct exynos_ufs_uic_attr exynos9810_uic_attr = {
+	.tx_trailingclks		= 0x10,
+	.pa_dbg_clk_period_off		= PA_DBG_CLK_PERIOD,
+	.pa_dbg_opt_suite1_val		= 0x2E820183,
+	.pa_dbg_opt_suite1_off		= PA_DBG_OPTION_SUITE,
+};
+
+/* bring-up knobs, to try link startup variants without rebuilding */
+static bool e9810_no_apb_div;
+module_param(e9810_no_apb_div, bool, 0644);
+static uint e9810_mclk_hz;
+module_param(e9810_mclk_hz, uint, 0644);
+/* Samsung's CAL truncates the UniPro clock period; FSD rounds it up */
+static bool e9810_period_roundup;
+module_param(e9810_period_roundup, bool, 0644);
+static int e9810_trailing = -1;
+module_param(e9810_trailing, int, 0644);
+/* force HCI_MISC / HCI_CLKSTOP_CTRL to given values before link startup */
+static int e9810_misc = -1;
+module_param(e9810_misc, int, 0644);
+static int e9810_clkstop = -1;
+module_param(e9810_clkstop, int, 0644);
+
+static int exynos9810_ufs_drv_init(struct exynos_ufs *ufs)
+{
+	if (e9810_no_apb_div)
+		ufs->opts &= ~EXYNOS_UFS_OPT_HAS_APB_CLK_CTRL;
+	return 0;
+}
+
+/*
+ * HCI_UFS_ACG_DISABLE resets to 0 (HW auto clock gating on) on this UFS
+ * IP revision; Samsung sets it to 1 before link startup, otherwise the
+ * link never comes up.
+ */
+#define HCI_UFS_ACG_DISABLE	0xFC
+#define HCI_UFS_ACG_DISABLE_EN	BIT(0)
+
+static int exynos9810_ufs_pre_link(struct exynos_ufs *ufs)
+{
+	struct exynos_ufs_uic_attr *attr = ufs->drv_data->uic_attr;
+	struct ufs_hba *hba = ufs->hba;
+	u32 period;
+	int i;
+
+	hci_writel(ufs, hci_readl(ufs, HCI_UFS_ACG_DISABLE) | HCI_UFS_ACG_DISABLE_EN,
+		   HCI_UFS_ACG_DISABLE);
+	if (e9810_misc >= 0)
+		hci_writel(ufs, e9810_misc, HCI_MISC);
+	if (e9810_clkstop >= 0)
+		hci_writel(ufs, e9810_clkstop, HCI_CLKSTOP_CTRL);
+	dev_info(hba->dev, "9810 pre_link: MISC %08x CLKSTOP %08x ACG %08x APBCLK %08x\n",
+		 hci_readl(ufs, HCI_MISC), hci_readl(ufs, HCI_CLKSTOP_CTRL),
+		 hci_readl(ufs, HCI_UFS_ACG_DISABLE), hci_readl(ufs, HCI_UNIPRO_APB_CLK_CTRL));
+
+	/* the per-lane writes below need the lane count before phy_init() */
+	if (!ufs->avail_ln_rx || !ufs->avail_ln_tx) {
+		ufshcd_dme_get(hba, UIC_ARG_MIB(PA_AVAILRXDATALANES), &ufs->avail_ln_rx);
+		ufshcd_dme_get(hba, UIC_ARG_MIB(PA_AVAILTXDATALANES), &ufs->avail_ln_tx);
+	}
+
+	if (e9810_mclk_hz)
+		ufs->mclk_rate = e9810_mclk_hz;
+	period = e9810_period_roundup ? DIV_ROUND_UP(NSEC_PER_SEC, ufs->mclk_rate) :
+					NSEC_PER_SEC / ufs->mclk_rate;
+	if (e9810_trailing >= 0)
+		ufshcd_dme_set(hba, UIC_ARG_MIB(PA_TXTRAILINGCLOCKS), e9810_trailing);
+	dev_info(hba->dev, "9810 pre_link: mclk %lu Hz (period %u ns), lanes tx %d rx %d, opts 0x%x\n",
+		 ufs->mclk_rate, period, ufs->avail_ln_tx, ufs->avail_ln_rx, ufs->opts);
+
+	ufshcd_dme_set(hba, UIC_ARG_MIB(attr->pa_dbg_clk_period_off), period);
+	ufshcd_dme_set(hba, UIC_ARG_MIB(0x200), 0x40);
+
+	for_each_ufs_rx_lane(ufs, i) {
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0x12, i), period);
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0x5C, i), 0x38);
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0x0F, i), 0x0);
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0x65, i), 0x1);
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0x69, i), 0x1);
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0x21, i), 0x0);
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0x22, i), 0x0);
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0x84, i), 0x1);
+	}
+
+	for_each_ufs_tx_lane(ufs, i) {
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0xAA, i), period);
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0x04, i), 0x1);
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0x8F, i), 0x3E);
+	}
+
+	ufshcd_dme_set(hba, UIC_ARG_MIB(0x200), 0x0);
+	ufshcd_dme_set(hba, UIC_ARG_MIB(PA_DBG_AUTOMODE_THLD), 0x4E20);
+	ufshcd_dme_set(hba, UIC_ARG_MIB(attr->pa_dbg_opt_suite1_off),
+		       attr->pa_dbg_opt_suite1_val);
+	ufshcd_dme_set(hba, UIC_ARG_MIB(PA_LOCAL_TX_LCC_ENABLE), 0x0);
+
+	exynos_ufs_establish_connt(ufs);
+
+	return 0;
+}
+
+static int exynos9810_ufs_pre_pwr_change(struct exynos_ufs *ufs,
+					 struct ufs_pa_layer_attr *pwr)
+{
+	struct ufs_hba *hba = ufs->hba;
+
+	/* DL_FC0ProtectionTimeOutVal, DL_TC0ReplayTimeOutVal, DL_AFC0ReqTimeOutVal */
+	ufshcd_dme_set(hba, UIC_ARG_MIB(0x2041), 8064);
+	ufshcd_dme_set(hba, UIC_ARG_MIB(0x2042), 28224);
+	ufshcd_dme_set(hba, UIC_ARG_MIB(0x2043), 20160);
+	ufshcd_dme_set(hba, UIC_ARG_MIB(PA_PWRMODEUSERDATA0), 12000);
+	ufshcd_dme_set(hba, UIC_ARG_MIB(PA_PWRMODEUSERDATA1), 32000);
+	ufshcd_dme_set(hba, UIC_ARG_MIB(PA_PWRMODEUSERDATA2), 16000);
+
+	unipro_writel(ufs, 8064, 0x7888);
+	unipro_writel(ufs, 28224, 0x788c);
+	unipro_writel(ufs, 20160, 0x7890);
+	unipro_writel(ufs, 12000, UNIPRO_DME_POWERMODE_REQ_REMOTEL2TIMER0);
+	unipro_writel(ufs, 32000, UNIPRO_DME_POWERMODE_REQ_REMOTEL2TIMER1);
+	unipro_writel(ufs, 16000, UNIPRO_DME_POWERMODE_REQ_REMOTEL2TIMER2);
+
+	return 0;
+}
+
+static const struct exynos_ufs_drv_data exynos9810_ufs_drvs = {
+	.uic_attr		= &exynos9810_uic_attr,
+	.quirks			= UFSHCD_QUIRK_PRDT_BYTE_GRAN |
+				  UFSHCI_QUIRK_BROKEN_REQ_LIST_CLR |
+				  UFSHCD_QUIRK_BROKEN_OCS_FATAL_ERROR |
+				  UFSHCD_QUIRK_SKIP_DEF_UNIPRO_TIMEOUT_SETTING |
+				  UFSHCI_QUIRK_SKIP_RESET_INTR_AGGR |
+				  UFSHCD_QUIRK_BROKEN_AUTO_HIBERN8,
+	.opts			= EXYNOS_UFS_OPT_HAS_APB_CLK_CTRL |
+				  EXYNOS_UFS_OPT_BROKEN_AUTO_CLK_CTRL |
+				  EXYNOS_UFS_OPT_SKIP_CONFIG_PHY_ATTR |
+				  EXYNOS_UFS_OPT_UFSPR_SECURE,
+	.drv_init		= exynos9810_ufs_drv_init,
+	.pre_link		= exynos9810_ufs_pre_link,
+	.post_link		= fsd_ufs_post_link,
+	.pre_pwr_change		= exynos9810_ufs_pre_pwr_change,
+};
+
 static const struct exynos_ufs_drv_data fsd_ufs_drvs = {
 	.uic_attr               = &fsd_uic_attr,
 	.quirks                 = UFSHCD_QUIRK_PRDT_BYTE_GRAN |
@@ -2320,6 +2467,8 @@ static const struct of_device_id exynos_ufs_of_match[] = {
 	  .data	      = &exynosauto_ufs_vh_drvs },
 	{ .compatible = "samsung,exynosautov920-ufs",
 	  .data       = &exynosautov920_ufs_drvs },
+	{ .compatible = "samsung,exynos9810-ufs",
+	  .data	      = &exynos9810_ufs_drvs },
 	{ .compatible = "tesla,fsd-ufs",
 	  .data       = &fsd_ufs_drvs },
 	{},
-- 
2.56.0

