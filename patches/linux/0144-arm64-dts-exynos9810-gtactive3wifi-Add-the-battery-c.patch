+	};
+
+	/*
+	 * No trips: the MAX77705 charger driver reads battery-thermal and
+	 * charger-thermal itself and throttles or stops charging at the stock
+	 * thresholds.
+	 */
+	thermal-zones {
+		battery-thermal {
+			polling-delay-passive = <0>;
+			polling-delay = <0>;
+			thermal-sensors = <&batt_ntc>;
+		};
+
+		charger-thermal {
+			polling-delay-passive = <0>;
+			polling-delay = <0>;
+			thermal-sensors = <&chg_ntc>;
+		};
+
+		usb-thermal {
+			polling-delay-passive = <0>;
+			polling-delay = <0>;
+			thermal-sensors = <&usb_ntc>;
+		};
+	};
+
 	/*
 	 * Stock routing (dtbo-4.dts sound node, samsung,routing): headset mic
 	 * on IN1 with MICBIAS1, main mic on IN3 with MICBIAS2, sub mic on IN4
@@ -275,6 +429,11 @@ &abox {
 	status = "okay";
 };
 
+&adc {
+	vdd-supply = <&vref_adc>;
+	status = "okay";
+};
+
 &pinctrl_alive {
 	key_power: key-power-pins {
 		samsung,pins = "gpa2-4";
