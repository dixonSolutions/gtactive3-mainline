From 786989ab8bd62f1a99d31029f904997f3f0c773d Mon Sep 17 00:00:00 2001
From: dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>
Date: Thu, 22 Oct 2026 10:58:13 +1100
Subject: [PATCH 144/152] arm64: dts: exynos9810-gtactive3wifi: Add the
 battery, charger and USB NTCs

The stock sec-battery node reads the battery NTC (thermal_source ADC)
on AP ADC channel 1, the charger NTC on channel 3 and the USB-C
connector NTC on channel 4. Describe each as a generic-adc-thermal
sensor with the stock ADC code tables (converted to mV against an
assumed 1.8 V reference, which cancels out) and give each a thermal
zone without trips: battery-thermal, charger-thermal, usb-thermal. The
charger driver and the fuel gauge read them by name.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../dts/exynos/exynos9810-gtactive3wifi.dts   | 159 ++++++++++++++++++
 1 file changed, 159 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/exynos9810-gtactive3wifi.dts b/arch/arm64/boot/dts/exynos/exynos9810-gtactive3wifi.dts
index 964030050..79a3f8363 100644
--- a/arch/arm64/boot/dts/exynos/exynos9810-gtactive3wifi.dts
+++ b/arch/arm64/boot/dts/exynos/exynos9810-gtactive3wifi.dts
@@ -187,6 +187,160 @@ vdd_wacom: regulator-wacom {
 		regulator-boot-on;
 	};
 
+	/*
+	 * The AP ADC samples the NTCs ratiometrically; its reference is not
+	 * described in the stock DT and is assumed to be 1.8 V here. The
+	 * lookup tables below are the stock sec-battery ADC code tables
+	 * (DTBO hw_rev 4) converted to mV with the same 1.8 V, so only the
+	 * ratio matters.
+	 */
+	vref_adc: regulator-adc-vref {
+		compatible = "regulator-fixed";
+		regulator-name = "adc_vref";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		regulator-always-on;
+	};
+
+	/* Battery pack NTC (stock adc-temp, thermal_source ADC) */
+	batt_ntc: thermal-sensor-battery {
