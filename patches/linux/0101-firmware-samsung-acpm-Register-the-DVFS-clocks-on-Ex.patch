From 4e92e69844cd283dbdcfca068b558381764e0afe Mon Sep 17 00:00:00 2001
From: dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>
Date: Wed, 21 Oct 2026 18:36:53 +1100
Subject: [PATCH 101/152] firmware: samsung: acpm: Register the DVFS clocks on
 Exynos9810

Create the ACPM clock device on Exynos9810 as well, now that the clock
driver knows the Exynos9810 DVFS domains.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/firmware/samsung/exynos-acpm.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/drivers/firmware/samsung/exynos-acpm.c b/drivers/firmware/samsung/exynos-acpm.c
index 7e710743e..eb7d8c752 100644
--- a/drivers/firmware/samsung/exynos-acpm.c
+++ b/drivers/firmware/samsung/exynos-acpm.c
@@ -888,11 +888,12 @@ static const struct acpm_match_data acpm_gs101 = {
 
 /*
  * The Exynos9810 ACPM firmware uses the same framework header and channel
- * descriptor layout as GS101 (checked against a live SRAM dump), but has
- * no DVFS clock interface wired up in this driver yet.
+ * descriptor layout as GS101 (checked against a live SRAM dump), and its
+ * DVFS plugin speaks the same FREQ_REQ/FREQ_GET protocol.
  */
 static const struct acpm_match_data acpm_exynos9810 = {
 	.initdata_base = ACPM_EXYNOS9810_INITDATA_BASE,
+	.acpm_clk_dev_name = "exynos9810-acpm-clk",
 };
 
 static const struct of_device_id acpm_match[] = {
-- 
