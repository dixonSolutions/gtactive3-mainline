From 1a386ebf3bc27d2106bfcc0a43d9f20436729537 Mon Sep 17 00:00:00 2001
From: dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>
Date: Wed, 21 Oct 2026 17:20:26 +1100
Subject: [PATCH 039/152] power: supply: max77705: Stop AICL backoff at the
 minimum input current

The AICL interrupt handler lowers CHGIN_LIM one step at a time until the
AICL status bit reports OK. If the source cannot hold VBUS even at the
lowest setting, regval is decremented past zero, wraps, and
regmap_field_write() masks it to 0x7f: the input current limit jumps to
its 3.2 A maximum, the opposite of what AICL asked for. On a weak source
such as a PC USB port this can brown out the port, and the handler keeps
cycling through the whole range.

Selectors 0 to 3 all select the 100 mA minimum (see
max77705_get_input_current()), so stop there and warn.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/power/supply/max77705_charger.c | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/drivers/power/supply/max77705_charger.c b/drivers/power/supply/max77705_charger.c
index 63b0b4f0c..0c16f7403 100644
--- a/drivers/power/supply/max77705_charger.c
+++ b/drivers/power/supply/max77705_charger.c
@@ -18,6 +18,9 @@
 #include <linux/power_supply.h>
 #include <linux/regmap.h>
 
+/* CHGIN_LIM selectors up to this one all select MAX77705_CURRENT_CHGIN_MIN */
+#define MAX77705_CHGIN_LIM_MIN_SEL	3
+
 static const char *max77705_charger_model		= "max77705";
 static const char *max77705_charger_manufacturer	= "Maxim Integrated";
 
@@ -57,6 +60,16 @@ static irqreturn_t max77705_aicl_irq(int irq, void *irq_drv_data)
 		if (err < 0)
 			return IRQ_HANDLED;
 
+		/*
+		 * Selectors 0-3 all mean the 100 mA minimum. Stop there instead
+		 * of letting regval wrap and the limit jump to its maximum.
+		 */
+		if (regval <= MAX77705_CHGIN_LIM_MIN_SEL) {
+			dev_warn_ratelimited(chg->dev,
+					     "AICL: input current already at minimum\n");
+			break;
+		}
+
 		regval--;
 
 		err = regmap_field_write(chg->rfield[MAX77705_CHG_CHGIN_LIM], regval);
-- 
