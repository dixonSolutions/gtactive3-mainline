From eb451f757508b5e3700ca4c47b3c6f4131b5810e Mon Sep 17 00:00:00 2001
From: dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>
Date: Wed, 21 Oct 2026 16:09:19 +1100
Subject: [PATCH 053/152] dt-bindings: input: touchscreen: Add Himax HX83102E

The Himax HX83102E is a TDDI chip whose touch controller is connected
over SPI (mode 3) and exposes the same AHB register interface as the I2C
connected HX83112B. It runs firmware from its own flash and is powered
together with the display panel.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../input/touchscreen/himax,hx83102e.yaml     | 69 +++++++++++++++++++
 MAINTAINERS                                   |  1 +
 2 files changed, 70 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/input/touchscreen/himax,hx83102e.yaml

diff --git a/Documentation/devicetree/bindings/input/touchscreen/himax,hx83102e.yaml b/Documentation/devicetree/bindings/input/touchscreen/himax,hx83102e.yaml
new file mode 100644
index 000000000..6a8889878
--- /dev/null
+++ b/Documentation/devicetree/bindings/input/touchscreen/himax,hx83102e.yaml
@@ -0,0 +1,69 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/input/touchscreen/himax,hx83102e.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Himax HX83102E SPI touchscreen controller
+
+maintainers:
+  - Job Noorman <job@noorman.info>
+
+description:
+  The Himax HX83102E is a touch and display driver integrated (TDDI) chip.
+  Its touch controller is connected over SPI and runs firmware stored in the
+  chip's flash. The touch part is powered together with the display panel,
+  so this node has no supplies of its own.
+
+allOf:
+  - $ref: touchscreen.yaml#
+  - $ref: /schemas/spi/spi-peripheral-props.yaml#
+
+properties:
+  compatible:
+    const: himax,hx83102e
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  reset-gpios:
+    maxItems: 1
+
+  spi-cpha: true
+  spi-cpol: true
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - reset-gpios
+  - touchscreen-size-x
+  - touchscreen-size-y
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    spi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        touchscreen@0 {
+            compatible = "himax,hx83102e";
+            reg = <0>;
+            spi-max-frequency = <7000000>;
+            spi-cpha;
+            spi-cpol;
+            interrupt-parent = <&gpa1>;
+            interrupts = <0 IRQ_TYPE_EDGE_FALLING>;
+            reset-gpios = <&gpg0 6 GPIO_ACTIVE_LOW>;
+            touchscreen-size-x = <1200>;
+            touchscreen-size-y = <1920>;
+        };
+    };
diff --git a/MAINTAINERS b/MAINTAINERS
index 54b5106ed..b06584b40 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
