From f174e4b3b6271440d631ea1ac459b08ffe3db93e Mon Sep 17 00:00:00 2001
From: dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>
Date: Wed, 21 Oct 2026 16:31:38 +1100
Subject: [PATCH 103/119] ASoC: dt-bindings: Document MediaTek MT6660 and
 Richtek RT5510

The MT6660 driver has no binding document. Add one, together with the
Richtek RT5510, which is the same chip under the Richtek name. It is the
speaker amplifier of the Galaxy Tab Active3 (SM-T570, hw_rev 4) at
i2c 0x34 on HSI2C_18 (stock dtbo-4.dts rt5510@34).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../bindings/sound/mediatek,mt6660.yaml       | 49 +++++++++++++++++++
 1 file changed, 49 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/sound/mediatek,mt6660.yaml

diff --git a/Documentation/devicetree/bindings/sound/mediatek,mt6660.yaml b/Documentation/devicetree/bindings/sound/mediatek,mt6660.yaml
new file mode 100644
index 000000000..02a55c822
--- /dev/null
+++ b/Documentation/devicetree/bindings/sound/mediatek,mt6660.yaml
@@ -0,0 +1,49 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/mediatek,mt6660.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6660 / Richtek RT5510 mono smart speaker amplifier
+
+maintainers:
+  - Jeff Chang <jeff_chang@richtek.com>
+
+description:
+  The MT6660 and the Richtek RT5510 are the same I2S/TDM-input mono class-D
+  speaker amplifier with an integrated boost converter and voltage/current
+  sensing. They share the register map and the chip ID.
+
+allOf:
+  - $ref: dai-common.yaml#
+
+properties:
+  compatible:
+    enum:
+      - mediatek,mt6660
+      - richtek,rt5510
+
+  reg:
+    maxItems: 1
+
+  '#sound-dai-cells':
+    const: 0
+
+required:
+  - compatible
+  - reg
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        amplifier@34 {
+            compatible = "richtek,rt5510";
+            reg = <0x34>;
+            #sound-dai-cells = <0>;
+        };
+    };
-- 
2.56.0

