From d7f8e290827ed369789a085adfac7e03eb574086 Mon Sep 17 00:00:00 2001
From: dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>
Date: Wed, 21 Oct 2026 15:54:49 +1100
Subject: [PATCH 40/64] dt-bindings: clock: samsung: Add Exynos9810 CMU_CHUB

Add a binding for the Exynos9810 clock management unit of the CHUB
(context hub) block. Besides the Cortex-M4 sensor hub, CMU_CHUB clocks the
two CHUB USI blocks (SPI20/SPI21) and the CHUB I2C controllers.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../clock/samsung,exynos9810-clock.yaml       | 72 +++++++++++++++++++
 .../dt-bindings/clock/samsung,exynos9810.h    | 32 +++++++++
 2 files changed, 104 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/clock/samsung,exynos9810-clock.yaml
 create mode 100644 include/dt-bindings/clock/samsung,exynos9810.h

diff --git a/Documentation/devicetree/bindings/clock/samsung,exynos9810-clock.yaml b/Documentation/devicetree/bindings/clock/samsung,exynos9810-clock.yaml
new file mode 100644
index 000000000..d60087cb8
--- /dev/null
+++ b/Documentation/devicetree/bindings/clock/samsung,exynos9810-clock.yaml
@@ -0,0 +1,72 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/samsung,exynos9810-clock.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung Exynos9810 SoC clock controller
+
+maintainers:
+  - Chanwoo Choi <cw00.choi@samsung.com>
+  - Krzysztof Kozlowski <krzk@kernel.org>
+
+description: |
+  Exynos9810 clock controller is comprised of several CMU units, generating
+  clocks for different domains. Those CMU units are modeled as separate device
+  tree nodes, and might depend on each other. The root clock in that root tree
+  is an external clock: OSCCLK (26 MHz). This external clock must be defined
+  as a fixed-rate clock in dts.
+
+  CMU_TOP is a top-level CMU, where all base clocks are prepared using PLLs and
+  dividers; all other clocks of function blocks (other CMUs) are usually
+  derived from CMU_TOP.
+
+  Each clock is assigned an identifier and client nodes can use this identifier
+  to specify the clock which they consume. All clocks available for usage
+  in clock consumer nodes are defined as preprocessor macros in
+  'include/dt-bindings/clock/samsung,exynos9810.h' header.
+
+properties:
+  compatible:
+    enum:
+      - samsung,exynos9810-cmu-chub
+
+  clocks:
+    items:
+      - description: External reference clock (26 MHz)
+      - description: CMU_CHUB bus clock (from CMU_TOP)
+
+  clock-names:
+    items:
+      - const: oscclk
+      - const: bus
+
+  "#clock-cells":
+    const: 1
+
+  reg:
+    maxItems: 1
+
+required:
+  - compatible
+  - clocks
+  - clock-names
+  - reg
+  - "#clock-cells"
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/samsung,exynos9810.h>
+
+    cmu_chub: clock-controller@13a00000 {
+        compatible = "samsung,exynos9810-cmu-chub";
+        reg = <0x13a00000 0x8000>;
+        #clock-cells = <1>;
+
+        clocks = <&oscclk>, <&cmu_top_chub_bus>;
+        clock-names = "oscclk", "bus";
+    };
+
+...
diff --git a/include/dt-bindings/clock/samsung,exynos9810.h b/include/dt-bindings/clock/samsung,exynos9810.h
new file mode 100644
index 000000000..c016014bb
--- /dev/null
+++ b/include/dt-bindings/clock/samsung,exynos9810.h
@@ -0,0 +1,32 @@
+/* SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause) */
+/*
+ * Device Tree binding constants for the Exynos9810 clock controller.
+ */
+
+#ifndef _DT_BINDINGS_CLOCK_EXYNOS9810_H
+#define _DT_BINDINGS_CLOCK_EXYNOS9810_H
+
+/* CMU_CHUB */
+#define CLK_RCO_CHUB				1
+#define CLK_MOUT_CHUB_BUS_USER			2
+#define CLK_MOUT_CHUB_DLL_BUS_USER		3
+#define CLK_MOUT_CHUB_BUS			4
+#define CLK_MOUT_CHUB_I2C			5
+#define CLK_MOUT_CHUB_USI00			6
+#define CLK_MOUT_CHUB_USI01			7
+#define CLK_DOUT_CHUB_BUS			8
+#define CLK_DOUT_CHUB_I2C			9
+#define CLK_DOUT_CHUB_USI00			10
+#define CLK_DOUT_CHUB_USI01			11
+#define CLK_GOUT_CHUB_I2C			12
+#define CLK_GOUT_CHUB_USI00			13
+#define CLK_GOUT_CHUB_USI01			14
+#define CLK_GOUT_CHUB_I2C_CHUB00_IPCLK		15
+#define CLK_GOUT_CHUB_I2C_CHUB01_IPCLK		16
+#define CLK_GOUT_CHUB_USI_CHUB00_IPCLK		17
+#define CLK_GOUT_CHUB_USI_CHUB01_IPCLK		18
+#define CLK_GOUT_CHUB_RSTNSYNC_I2C		19
+#define CLK_GOUT_CHUB_RSTNSYNC_USI00		20
+#define CLK_GOUT_CHUB_RSTNSYNC_USI01		21
+
+#endif /* _DT_BINDINGS_CLOCK_EXYNOS9810_H */
