+/* The RTC and IRQs need register writes and are not wired up yet */
+static const struct mfd_cell s2mps18_devs[] = {
+	MFD_CELL_NAME("s2mps18-regulator"),
+};
+
 static const struct mfd_cell s2mpa01_devs[] = {
 	MFD_CELL_NAME("s2mpa01-pmic"),
 	MFD_CELL_RES("s2mps14-rtc", s2mps14_rtc_resources),
@@ -125,7 +130,8 @@ static void sec_pmic_dump_rev(struct sec_pmic_dev *sec_pmic)
 	switch (sec_pmic->device_type) {
 	case S2MPG10:
 	case S2MPG11:
-		/* For s2mpg1x, the revision is in a different regmap */
+	case S2MPS18X:
+		/* For s2mpg1x and s2mps18, the revision is in a different regmap */
 		return;
 	case S2MU005:
 		reg = S2MU005_REG_ID;
@@ -263,6 +269,10 @@ int sec_pmic_probe(struct device *dev, int device_type, unsigned int irq,
 		sec_devs = s2mps15_devs;
 		num_sec_devs = ARRAY_SIZE(s2mps15_devs);
 		break;
+	case S2MPS18X:
+		sec_devs = s2mps18_devs;
+		num_sec_devs = ARRAY_SIZE(s2mps18_devs);
+		break;
 	case S2MPU02:
 		sec_devs = s2mpu02_devs;
 		num_sec_devs = ARRAY_SIZE(s2mpu02_devs);
@@ -324,6 +334,9 @@ static int sec_pmic_suspend(struct device *dev)
 {
 	struct sec_pmic_dev *sec_pmic = dev_get_drvdata(dev);
 
+	if (!sec_pmic->irq)
+		return 0;
+
 	if (device_may_wakeup(dev))
 		enable_irq_wake(sec_pmic->irq);
 	/*
@@ -344,6 +357,9 @@ static int sec_pmic_resume(struct device *dev)
 {
 	struct sec_pmic_dev *sec_pmic = dev_get_drvdata(dev);
 
+	if (!sec_pmic->irq)
+		return 0;
+
 	if (device_may_wakeup(dev))
 		disable_irq_wake(sec_pmic->irq);
 	enable_irq(sec_pmic->irq);
diff --git a/drivers/mfd/sec-irq.c b/drivers/mfd/sec-irq.c
index 42862807b..ad9e2fb01 100644
--- a/drivers/mfd/sec-irq.c
+++ b/drivers/mfd/sec-irq.c
@@ -506,6 +506,11 @@ struct regmap_irq_chip_data *sec_irq_init(struct sec_pmic_dev *sec_pmic)
 	case S2MPS15X:
 		sec_irq_chip = &s2mps15_irq_chip;
 		break;
+	case S2MPS18X:
+		/* Not implemented yet, unmasking needs PMIC register writes */
+		if (sec_pmic->irq)
+			dev_warn(sec_pmic->dev, "S2MPS18 interrupts not supported yet\n");
+		return NULL;
 	case S2MPU02:
 		sec_irq_chip = &s2mpu02_irq_chip;
 		break;
