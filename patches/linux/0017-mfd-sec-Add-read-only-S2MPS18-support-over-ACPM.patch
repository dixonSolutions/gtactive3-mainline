+/*
+ * S2MPS18 (Exynos9810). The ACPM firmware itself keeps changing the DVFS
+ * rail voltages, so nothing is cached. INTx are clear-on-read.
+ */
+static const struct regmap_range s2mps18_common_registers[] = {
+	regmap_reg_range(0x00, 0x02), /* PMICID, INTSRC, INTSRC_MASK */
+};
+
+static const struct regmap_access_table s2mps18_common_rd_table = {
+	.yes_ranges = s2mps18_common_registers,
+	.n_yes_ranges = ARRAY_SIZE(s2mps18_common_registers),
+};
+
+static const struct regmap_range s2mps18_common_precious_registers[] = {
+	regmap_reg_range(0x01, 0x01), /* INTSRC */
+};
+
+static const struct regmap_access_table s2mps18_common_precious_table = {
+	.yes_ranges = s2mps18_common_precious_registers,
+	.n_yes_ranges = ARRAY_SIZE(s2mps18_common_precious_registers),
+};
+
+static const struct regmap_range s2mps18_ro_registers[] = {
+	regmap_reg_range(0x00, 0xff),
+};
+
+/* Writes are refused for now, both here and in the bus callbacks. */
+static const struct regmap_access_table s2mps18_wr_table = {
+	.no_ranges = s2mps18_ro_registers,
+	.n_no_ranges = ARRAY_SIZE(s2mps18_ro_registers),
+};
+
+static const struct regmap_config s2mps18_regmap_config_common = {
+	.name = "common",
+	.reg_bits = ACPM_ADDR_BITS,
+	.val_bits = 8,
+	.max_register = S2MPS18_TOP_REG_INTSRC_MASK,
+	.wr_table = &s2mps18_wr_table,
+	.rd_table = &s2mps18_common_rd_table,
+	.precious_table = &s2mps18_common_precious_table,
+	.cache_type = REGCACHE_NONE,
+};
+
+static const struct regmap_range s2mps18_pmic_registers[] = {
+	regmap_reg_range(0x00, 0x16), /* INTx, INTxM, STATUSx, CTRLx */
+	regmap_reg_range(0x1c, 0x48), /* BUCKs, ramp, DVS */
+	regmap_reg_range(0x49, 0x7e), /* LDOs, discharge */
+	regmap_reg_range(0x88, 0x88), /* TCXO_CTRL */
+	regmap_reg_range(0xc8, 0xd4), /* PWREN_SEL, LPM, ADC, OCP_WARN */
+};
+
+static const struct regmap_access_table s2mps18_pmic_rd_table = {
+	.yes_ranges = s2mps18_pmic_registers,
+	.n_yes_ranges = ARRAY_SIZE(s2mps18_pmic_registers),
+};
+
+static const struct regmap_range s2mps18_pmic_precious_registers[] = {
+	regmap_reg_range(S2MPS18_REG_INT1, S2MPS18_REG_INT7),
+};
+
+static const struct regmap_access_table s2mps18_pmic_precious_table = {
+	.yes_ranges = s2mps18_pmic_precious_registers,
+	.n_yes_ranges = ARRAY_SIZE(s2mps18_pmic_precious_registers),
+};
+
+static const struct regmap_config s2mps18_regmap_config_pmic = {
+	.name = "pmic",
+	.reg_bits = ACPM_ADDR_BITS,
+	.val_bits = 8,
+	.max_register = S2MPS18_REG_OCP_WARN2,
+	.wr_table = &s2mps18_wr_table,
+	.rd_table = &s2mps18_pmic_rd_table,
+	.precious_table = &s2mps18_pmic_precious_table,
+	.cache_type = REGCACHE_NONE,
+};
+
 struct sec_pmic_acpm_shared_bus_context {
 	struct acpm_handle *acpm;
 	unsigned int acpm_chan_id;
 	u8 speedy_channel;
+	bool read_only;
 };
 
 enum sec_pmic_acpm_accesstype {
@@ -401,6 +483,9 @@ static int sec_pmic_acpm_bus_write(void *context, const void *data,
 
 	reg = d[0];
 
+	if (ctx->shared->read_only)
+		return -EPERM;
+
 	return pmic_ops->bulk_write(acpm, ctx->shared->acpm_chan_id, ctx->type, reg,
 				    ctx->shared->speedy_channel, val_count, vals);
 }
@@ -431,6 +516,9 @@ static int sec_pmic_acpm_bus_reg_update_bits(void *context, unsigned int reg, un
 	struct acpm_handle *acpm = ctx->shared->acpm;
 	const struct acpm_pmic_ops *pmic_ops = &acpm->ops->pmic;
 
+	if (ctx->shared->read_only)
+		return -EPERM;
+
 	return pmic_ops->update_reg(acpm, ctx->shared->acpm_chan_id, ctx->type, reg & 0xff,
 				    ctx->shared->speedy_channel, val, mask);
 }
@@ -491,9 +579,13 @@ static int sec_pmic_acpm_probe(struct platform_device *pdev)
 	if (IS_ERR(acpm))
 		return dev_err_probe(dev, PTR_ERR(acpm), "failed to get acpm\n");
 
-	irq = platform_get_irq(pdev, 0);
-	if (irq < 0)
-		return irq;
+	if (pdata->read_only) {
+		irq = 0;
+	} else {
+		irq = platform_get_irq(pdev, 0);
+		if (irq < 0)
+			return irq;
+	}
 
 	shared_ctx = devm_kzalloc(dev, sizeof(*shared_ctx), GFP_KERNEL);
 	if (!shared_ctx)
@@ -502,6 +594,7 @@ static int sec_pmic_acpm_probe(struct platform_device *pdev)
 	shared_ctx->acpm = acpm;
 	shared_ctx->acpm_chan_id = pdata->acpm_chan_id;
 	shared_ctx->speedy_channel = pdata->speedy_channel;
+	shared_ctx->read_only = pdata->read_only;
 
 	regmap_common = sec_pmic_acpm_regmap_init(dev, shared_ctx, SEC_PMIC_ACPM_ACCESSTYPE_COMMON,
 						  pdata->regmap_cfg_common, true);
@@ -520,10 +613,24 @@ static int sec_pmic_acpm_probe(struct platform_device *pdev)
 			return PTR_ERR(regmap);
 	}
 
-	regmap = sec_pmic_acpm_regmap_init(dev, shared_ctx, SEC_PMIC_ACPM_ACCESSTYPE_METER,
-					   pdata->regmap_cfg_meter, true);
-	if (IS_ERR(regmap))
-		return PTR_ERR(regmap);
+	if (pdata->regmap_cfg_meter) {
+		regmap = sec_pmic_acpm_regmap_init(dev, shared_ctx,
+						   SEC_PMIC_ACPM_ACCESSTYPE_METER,
+						   pdata->regmap_cfg_meter, true);
+		if (IS_ERR(regmap))
+			return PTR_ERR(regmap);
+	}
+
+	if (pdata->id_reg >= 0) {
+		unsigned int id;
+
+		ret = regmap_read(regmap_common, pdata->id_reg, &id);
+		if (ret)
+			return dev_err_probe(dev, ret, "failed to read PMIC ID\n");
+
+		dev_info(dev, "PMIC ID 0x%02x%s\n", id,
+			 pdata->read_only ? ", read-only" : "");
+	}
 
 	ret = sec_pmic_probe(dev, pdata->device_type, irq, regmap_pmic, NULL);
 	if (ret)
@@ -544,6 +651,7 @@ static const struct sec_pmic_acpm_platform_data s2mpg10_data = {
 	.device_type = S2MPG10,
 	.acpm_chan_id = 2,
 	.speedy_channel = 0,
+	.id_reg = -1,
 	.regmap_cfg_common = &s2mpg10_regmap_config_common,
 	.regmap_cfg_pmic = &s2mpg10_regmap_config_pmic,
 	.regmap_cfg_rtc = &s2mpg10_regmap_config_rtc,
@@ -554,14 +662,31 @@ static const struct sec_pmic_acpm_platform_data s2mpg11_data = {
 	.device_type = S2MPG11,
 	.acpm_chan_id = 2,
 	.speedy_channel = 1,
+	.id_reg = -1,
 	.regmap_cfg_common = &s2mpg11_regmap_config_common,
 	.regmap_cfg_pmic = &s2mpg11_regmap_config_pmic,
 	.regmap_cfg_meter = &s2mpg11_regmap_config_meter,
 };
 
+/*
+ * Bring-up: register access is read-only until the regulator and IRQ
+ * support has been checked on hardware. ACPM IPC channel 2 per the
+ * "acpm-ipc-channel" property of the stock s2mps18mfd node.
+ */
+static const struct sec_pmic_acpm_platform_data s2mps18_data = {
+	.device_type = S2MPS18X,
+	.acpm_chan_id = 2,
+	.speedy_channel = 0,
+	.read_only = true,
+	.id_reg = S2MPS18_TOP_REG_PMICID,
+	.regmap_cfg_common = &s2mps18_regmap_config_common,
+	.regmap_cfg_pmic = &s2mps18_regmap_config_pmic,
+};
+
 static const struct of_device_id sec_pmic_acpm_of_match[] = {
 	{ .compatible = "samsung,s2mpg10-pmic", .data = &s2mpg10_data, },
 	{ .compatible = "samsung,s2mpg11-pmic", .data = &s2mpg11_data, },
+	{ .compatible = "samsung,s2mps18-pmic", .data = &s2mps18_data, },
 	{ },
 };
 MODULE_DEVICE_TABLE(of, sec_pmic_acpm_of_match);
