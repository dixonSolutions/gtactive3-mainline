@@ -0,0 +1,144 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Samsung S2MPS18 PMIC register definitions
+ *
+ * Register map taken from the Samsung downstream s2mps18-private.h
+ * (Exynos 9810 kernel, Copyright (C) 2015 Samsung Electronics).
+ */
+
+#ifndef __LINUX_MFD_S2MPS18_H
+#define __LINUX_MFD_S2MPS18_H
+
+/* TOP (COMMON) block, ACPM type 0x00 */
+#define S2MPS18_TOP_REG_PMICID		0x00
+#define S2MPS18_TOP_REG_INTSRC		0x01
+#define S2MPS18_TOP_REG_INTSRC_MASK	0x02
+
+/* PMIC block, ACPM type 0x01 */
+#define S2MPS18_REG_INT1		0x00
+#define S2MPS18_REG_INT7		0x06
+#define S2MPS18_REG_INT1M		0x07
+#define S2MPS18_REG_INT7M		0x0d
+#define S2MPS18_REG_STATUS1		0x0e
+#define S2MPS18_REG_STATUS2		0x0f
+#define S2MPS18_REG_PWRONSRC		0x10
+#define S2MPS18_REG_OFFSRC		0x11
+#define S2MPS18_REG_BUCHG		0x12
+#define S2MPS18_REG_RTCBUF		0x13
+#define S2MPS18_REG_CTRL1		0x14
+#define S2MPS18_REG_CTRL2		0x15
+#define S2MPS18_REG_CTRL3		0x16
+
+#define S2MPS18_REG_B1CTRL		0x1c
+#define S2MPS18_REG_B1OUT1		0x1d
+#define S2MPS18_REG_B2CTRL		0x1f
+#define S2MPS18_REG_B2OUT1		0x20
+#define S2MPS18_REG_B3CTRL		0x22
+#define S2MPS18_REG_B3OUT1		0x23
+#define S2MPS18_REG_B4CTRL		0x25
+#define S2MPS18_REG_B4OUT1		0x26
+#define S2MPS18_REG_B5CTRL		0x28
+#define S2MPS18_REG_B5OUT		0x29
+#define S2MPS18_REG_B6CTRL		0x2a
+#define S2MPS18_REG_B6OUT		0x2b
+#define S2MPS18_REG_B7CTRL		0x2c
+#define S2MPS18_REG_B7OUT		0x2d
+#define S2MPS18_REG_B8CTRL		0x2e
+#define S2MPS18_REG_B8OUT		0x2f
+#define S2MPS18_REG_B9CTRL		0x30
+#define S2MPS18_REG_B9OUT		0x31
+#define S2MPS18_REG_B10CTRL		0x32
+#define S2MPS18_REG_B10OUT		0x33
+#define S2MPS18_REG_B11CTRL		0x34
+#define S2MPS18_REG_B11OUT1		0x35
+#define S2MPS18_REG_B12CTRL		0x37
+#define S2MPS18_REG_B12OUT		0x38
+#define S2MPS18_REG_B13CTRL		0x39
+#define S2MPS18_REG_B13OUT		0x3a
+#define S2MPS18_REG_B14CTRL		0x3b
+#define S2MPS18_REG_B14OUT		0x3c
+#define S2MPS18_REG_BB1CTRL		0x3d
+#define S2MPS18_REG_BB1OUT		0x3e
+#define S2MPS18_REG_BUCKRAMP		0x3f
+#define S2MPS18_REG_BUCKRAMP2		0x40
+
+#define S2MPS18_REG_L1CTRL		0x49
+#define S2MPS18_REG_L2CTRL1		0x4a
