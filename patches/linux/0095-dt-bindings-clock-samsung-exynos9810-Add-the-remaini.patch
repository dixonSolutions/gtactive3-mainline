 additionalProperties: false
 
 examples:
   - |
     #include <dt-bindings/clock/samsung,exynos9810.h>
 
-    cmu_chub: clock-controller@13a00000 {
-        compatible = "samsung,exynos9810-cmu-chub";
-        reg = <0x13a00000 0x8000>;
+    cmu_peric0: clock-controller@10400000 {
+        compatible = "samsung,exynos9810-cmu-peric0";
+        reg = <0x10400000 0x8000>;
         #clock-cells = <1>;
 
-        clocks = <&oscclk>, <&cmu_top_chub_bus>;
-        clock-names = "oscclk", "bus";
+        clocks = <&oscclk>,
+                 <&cmu_top CLK_DOUT_CMU_PERIC0_BUS>,
+                 <&cmu_top CLK_DOUT_CMU_PERIC0_IP>;
+        clock-names = "oscclk", "bus", "ip";
     };
 
