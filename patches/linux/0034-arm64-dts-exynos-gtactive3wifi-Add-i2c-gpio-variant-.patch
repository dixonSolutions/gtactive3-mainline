From 6e5ad366f84d0eee0292a371fdeedad8f8dff746 Mon Sep 17 00:00:00 2001
From: dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>
Date: Wed, 21 Oct 2026 16:11:19 +1100
Subject: [PATCH 34/38] arm64: dts: exynos: gtactive3wifi: Add i2c-gpio variant
 for the MAX77705

The HSI2C_40 controller still times out after the bootloader, while
bit-banging its pins works (init.c finds SDA = gpm15-0, SCL = gpm14-0
and gets an ACK from the MAX77705 at 0x66). Add an overlay that disables
HSI2C_40 and puts the same MAX77705 devices on an i2c-gpio bus, built
into exynos9810-gtactive3wifi-i2cgpio.dtb, so the charger and fuel gauge
can be brought up independently of the HSI2C work.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/exynos/Makefile           |  4 ++
 .../exynos9810-gtactive3wifi-i2cgpio.dtso     | 68 +++++++++++++++++++
 2 files changed, 72 insertions(+)
 create mode 100644 arch/arm64/boot/dts/exynos/exynos9810-gtactive3wifi-i2cgpio.dtso

diff --git a/arch/arm64/boot/dts/exynos/Makefile b/arch/arm64/boot/dts/exynos/Makefile
index d88adb99c..d209e9221 100644
--- a/arch/arm64/boot/dts/exynos/Makefile
+++ b/arch/arm64/boot/dts/exynos/Makefile
@@ -17,6 +17,7 @@ dtb-$(CONFIG_ARCH_EXYNOS) += \
 	exynos8855-smdk.dtb		\
 	exynos8895-dreamlte.dtb		\
 	exynos9810-gtactive3wifi.dtb	\
+	exynos9810-gtactive3wifi-i2cgpio.dtb \
 	exynos9810-starlte.dtb		\
 	exynos990-c1s.dtb		\
 	exynos990-r8s.dtb               \
@@ -24,3 +25,6 @@ dtb-$(CONFIG_ARCH_EXYNOS) += \
 	exynos990-x1slte.dtb		\
 	exynosautov9-sadk.dtb		\
 	exynosautov920-sadk.dtb
+
+exynos9810-gtactive3wifi-i2cgpio-dtbs := exynos9810-gtactive3wifi.dtb \
+	exynos9810-gtactive3wifi-i2cgpio.dtbo
diff --git a/arch/arm64/boot/dts/exynos/exynos9810-gtactive3wifi-i2cgpio.dtso b/arch/arm64/boot/dts/exynos/exynos9810-gtactive3wifi-i2cgpio.dtso
new file mode 100644
index 000000000..6be014da2
--- /dev/null
+++ b/arch/arm64/boot/dts/exynos/exynos9810-gtactive3wifi-i2cgpio.dtso
@@ -0,0 +1,68 @@
+// SPDX-License-Identifier: GPL-2.0 OR BSD-3-Clause
+/*
+ * Bring-up variant: reach the MAX77705 through a bit-banged I2C bus on the
+ * HSI2C_40 pins (SDA = gpm15-0, SCL = gpm14-0, found by the init.c probe)
+ * while the HSI2C_40 controller still times out. The board has external
+ * pull-ups on both lines.
+ */
+
+/dts-v1/;
+/plugin/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include "exynos-pinctrl.h"
+
+&hsi2c_40 {
+	status = "disabled";
+};
+
+&pinctrl_cmgp {
+	i2c40_gpio_pins: i2c40-gpio-pins {
+		samsung,pins = "gpm14-0", "gpm15-0";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_INPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
+	};
+};
+
+&{/} {
+	i2c-40 {
+		compatible = "i2c-gpio";
+		sda-gpios = <&gpm15 0 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		scl-gpios = <&gpm14 0 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		/* 5 us half period, about 100 kHz */
+		i2c-gpio,delay-us = <5>;
+		pinctrl-0 = <&i2c40_gpio_pins>;
+		pinctrl-names = "default";
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		gpio_max77705: pmic@66 {
+			compatible = "maxim,max77705";
+			reg = <0x66>;
+			interrupts-extended = <&gpa1 6 IRQ_TYPE_LEVEL_LOW>;
+			interrupt-controller;
+			#interrupt-cells = <1>;
+			pinctrl-0 = <&max77705_irq>;
+			pinctrl-names = "default";
+		};
+
+		gpio_max77705_charger: charger@69 {
+			compatible = "maxim,max77705-charger";
+			reg = <0x69>;
+			interrupt-parent = <&gpio_max77705>;
+			interrupts = <0>;
+			monitored-battery = <&battery>;
+		};
+
+		fuel-gauge@36 {
+			compatible = "maxim,max77705-battery";
+			reg = <0x36>;
+			interrupt-parent = <&gpio_max77705>;
+			interrupts = <2>;
+			maxim,rsns-microohm = <5000>;
+			power-supplies = <&gpio_max77705_charger>;
+		};
+	};
+};
-- 
