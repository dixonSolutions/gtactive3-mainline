From fc8961402b1a8120cacce86640244d95bac39bca Mon Sep 17 00:00:00 2001
From: dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>
Date: Wed, 21 Oct 2026 18:36:53 +1100
Subject: [PATCH 099/152] dt-bindings: firmware: google,gs101-acpm-ipc: Allow
 DVFS clocks on Exynos9810

The APM firmware of the Exynos9810 has a DVFS plugin that takes the same
frequency requests as the gs101 one, so the ACPM node can be a clock
provider there too. Allow #clock-cells for it and add the IDs of the
DVFS domains, which follow the firmware's numbering.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../firmware/google,gs101-acpm-ipc.yaml        |  1 -
 .../clock/samsung,exynos9810-acpm.h            | 18 ++++++++++++++++++
 2 files changed, 18 insertions(+), 1 deletion(-)
 create mode 100644 include/dt-bindings/clock/samsung,exynos9810-acpm.h

diff --git a/Documentation/devicetree/bindings/firmware/google,gs101-acpm-ipc.yaml b/Documentation/devicetree/bindings/firmware/google,gs101-acpm-ipc.yaml
index 464f6e8f0..8292f5078 100644
--- a/Documentation/devicetree/bindings/firmware/google,gs101-acpm-ipc.yaml
+++ b/Documentation/devicetree/bindings/firmware/google,gs101-acpm-ipc.yaml
@@ -95,7 +95,6 @@ allOf:
               const: samsung,s2mpg10-pmic
     else:
       properties:
-        "#clock-cells": false
         pmic: false
         pmic-2: false
         pmic-1:
diff --git a/include/dt-bindings/clock/samsung,exynos9810-acpm.h b/include/dt-bindings/clock/samsung,exynos9810-acpm.h
new file mode 100644
index 000000000..fec91c649
--- /dev/null
+++ b/include/dt-bindings/clock/samsung,exynos9810-acpm.h
@@ -0,0 +1,18 @@
+/* SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause) */
+/*
+ * Device Tree binding constants for the Exynos9810 ACPM DVFS clocks.
+ *
+ * The IDs are the DVFS domain numbers of the APM firmware (dvfs_mif = 0,
+ * ... in Samsung's acpm_dvfs_exynos9810.h), in the order of its fvmap.
+ */
+
+#ifndef _DT_BINDINGS_CLOCK_SAMSUNG_EXYNOS9810_ACPM_H
+#define _DT_BINDINGS_CLOCK_SAMSUNG_EXYNOS9810_ACPM_H
+
+#define EXYNOS9810_CLK_ACPM_DVFS_MIF		0
+#define EXYNOS9810_CLK_ACPM_DVFS_INT		1
+#define EXYNOS9810_CLK_ACPM_DVFS_CPUCL0		2
+#define EXYNOS9810_CLK_ACPM_DVFS_CPUCL1		3
+#define EXYNOS9810_CLK_ACPM_DVFS_G3D		4
+
+#endif /* _DT_BINDINGS_CLOCK_SAMSUNG_EXYNOS9810_ACPM_H */
-- 
2.56.0

