From 97ff9e77e6c8612f11df6eb422e3fc05cb479c22 Mon Sep 17 00:00:00 2001
From: dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>
Date: Wed, 21 Oct 2026 16:28:34 +1100
Subject: [PATCH 06/18] configs: gtactive3wifi: EFI boot from userdata with a
 watchdog fallback

- MULTI_DTB_FIT: without it board_fit_config_name_match() never runs,
  gd->board_type stays 0 and board_early_init_f() fails with -ENODATA,
  so U-Boot could not start at all.
- WDT + WDT_EXYNOS + WATCHDOG_AUTOSTART: kick the watchdog that uniLoader
  arms; CMD_WDT, BUTTON_CMD, CMD_SETEXPR; fastboot flashing to scsi 0.
- gtactive3wifi.env: ufs init, scsi scan, map userdata (sda31) as a whole
  disk with blkmap, bootefi bootmgr, then systemd-boot from the ESP
  directly. Any failure runs "fallback": a deliberate watchdog reset that
  uniLoader answers with the bring-up Linux. bootdelay=-2 so that a stuck
  key cannot leave U-Boot at a prompt; hold Volume Up for the boot menu.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 board/samsung/exynos-mobile/gtactive3wifi.env | 88 ++++++++++++++++---
 configs/gtactive3wifi_defconfig               | 11 +++
 2 files changed, 89 insertions(+), 10 deletions(-)

diff --git a/board/samsung/exynos-mobile/gtactive3wifi.env b/board/samsung/exynos-mobile/gtactive3wifi.env
index 6214f2f3..86959736 100644
--- a/board/samsung/exynos-mobile/gtactive3wifi.env
+++ b/board/samsung/exynos-mobile/gtactive3wifi.env
@@ -1,16 +1,84 @@
-/* Galaxy Tab Active3 (SM-T570): no UART is wired out, use the display. */
+/*
+ * Galaxy Tab Active3 (SM-T570), chain-loaded by uniLoader from BOOT:
+ *   S-Boot -> uniLoader -> U-Boot (EFI) -> systemd-boot -> Duranium UKI
+ * uniLoader arms the cluster 0 watchdog before starting U-Boot and boots its
+ * embedded bring-up Linux after a watchdog reset. Every failure below ends in
+ * "run fallback", which fires that watchdog now.
+ *
+ * No UART is wired out: the console is the display, input the keys.
+ */
 stdin=button-kbd
 stdout=vidconsole
 stderr=vidconsole
 
-bootdelay=0
-bootcmd=echo "gtactive3wifi: starting fastboot";
-	fastboot usb 0
+/* Autoboot without checking for a key: a stuck key must not stop us here */
+bootdelay=-2
+bootmenu_delay=15
+
+/* Hold Volume Up after the S-Boot warning screen for the boot menu */
+button_cmd_0_name=Volume Up
+button_cmd_0=bootmenu ${bootmenu_delay}
+
+/* Duranium image written raw to userdata (sda31), with its own GPT */
+ud_part=31
+esp_part=1
+kernel_addr_r=0x90000000
+
+/* Watchdog for the OS: keep (running, ~80 s) or stop */
+wdt_handover=keep
+wdt_handover_ms=80000
+
+/* DECON_F HW_SW_TRIG_CONTROL: keep the bootloader framebuffer on screen */
+bootcmd=mw.l 0x16030070 0x1281;
+	run duranium;
+	echo "gtactive3wifi: boot failed, bring-up Linux in 5 s";
+	sleep 5;
+	run fallback
+
+ufs_scan=ufs init && scsi scan
+
+userdata_map=run ufs_scan;
+	if blkmap get root dev ud_dev; then
+		echo "blkmap root is device ${ud_dev}";
+	else
+		part start scsi 0 ${ud_part} ud_start &&
+		part size scsi 0 ${ud_part} ud_size &&
+		blkmap create root &&
+		blkmap map root 0 0x${ud_size} linear scsi 0 0x${ud_start} &&
+		blkmap get root dev ud_dev;
+	fi
+
+duranium=echo "gtactive3wifi: userdata as a disk";
+	run userdata_map &&
+	part list blkmap ${ud_dev} &&
+	echo "gtactive3wifi: EFI boot manager" &&
+	bootefi bootmgr;
+	echo "gtactive3wifi: systemd-boot from blkmap ${ud_dev}:${esp_part}";
+	load blkmap ${ud_dev}:${esp_part} ${kernel_addr_r} EFI/BOOT/BOOTAA64.EFI &&
+	bootefi ${kernel_addr_r}
+
+/* Back to uniLoader's bring-up Linux: watchdog reset now */
+fallback=echo "gtactive3wifi: watchdog reset to the bring-up Linux";
+	wdt dev watchdog@10050000 && wdt expire;
+	run fallback_raw
+
+/* The same without the driver: WTCNT=1, unmask the PMU reset, enable */
+fallback_raw=mw.l 0x10050000 0;
+	mw.l 0x10050004 1;
+	mw.l 0x10050008 1;
+	setexpr.l pmu *0x14060408 "&" 0xfeffffff;
+	mw.l 0x14060408 ${pmu};
+	setexpr.l pmu *0x1406040c "&" 0xfeffffff;
+	mw.l 0x1406040c ${pmu};
+	mw.l 0x10050000 0x21;
+	sleep 1;
+	reset
 
 fastbootcmd=echo "Fastboot Mode";
+	run ufs_scan;
 	fastboot usb 0
 
-/* Exynos 9810 PMU INFORM3 reboot reasons (Samsung sec_reboot) */
+/* Exynos 9810 PMU INFORM2/INFORM3 reboot reasons (Samsung sec_reboot.c) */
 reboot_download=mw.l 0x14060808 0x12345678;
 	mw.l 0x1406080c 0x12345671;
 	reset
@@ -19,9 +87,9 @@ reboot_recovery=mw.l 0x14060808 0x12345678;
 	mw.l 0x1406080c 0x12345674;
 	reset
 
-bootmenu_0=Continue Boot=boot
-bootmenu_1=Enter Fastboot Mode=run fastbootcmd
-bootmenu_2=UEFI Maintenance Menu=eficonfig
-bootmenu_3=Reboot=reset
+bootmenu_0=Boot postmarketOS Duranium=run duranium; run fallback
+bootmenu_1=Bring-up Linux (USB console)=run fallback
+bootmenu_2=Fastboot=run fastbootcmd
+bootmenu_3=UEFI Maintenance Menu=eficonfig
 bootmenu_4=Download Mode=run reboot_download
-bootmenu_5=Recovery=run reboot_recovery
+bootmenu_5=Reboot=reset
diff --git a/configs/gtactive3wifi_defconfig b/configs/gtactive3wifi_defconfig
index 0d5931f9..7a488095 100644
--- a/configs/gtactive3wifi_defconfig
+++ b/configs/gtactive3wifi_defconfig
@@ -88,3 +88,14 @@ CONFIG_ENV_SOURCE_FILE="gtactive3wifi"
 CONFIG_SYSRESET_PSCI=y
 CONFIG_EXYNOS9810_EARLY_SAFETY=y
 CONFIG_EXYNOS_MOBILE_RAMLOG=y
+CONFIG_MULTI_DTB_FIT=y
+CONFIG_BUTTON_CMD=y
+CONFIG_WDT=y
+CONFIG_WATCHDOG_AUTOSTART=y
+CONFIG_WDT_EXYNOS=y
+CONFIG_CMD_WDT=y
+CONFIG_CMD_SETEXPR=y
+CONFIG_FASTBOOT_FLASH=y
+CONFIG_FASTBOOT_FLASH_BLOCK=y
+CONFIG_FASTBOOT_FLASH_BLOCK_INTERFACE_NAME="scsi"
+CONFIG_FASTBOOT_FLASH_BLOCK_DEVICE_ID=0
-- 
2.56.0

