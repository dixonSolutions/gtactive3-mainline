From d778de34e7fdc21c17365e22da49fb343c747783 Mon Sep 17 00:00:00 2001
From: dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>
Date: Wed, 21 Oct 2026 16:28:33 +1100
Subject: [PATCH 04/13] arm64: dts: exynos9810-gtactive3wifi: Add watchdog,
 reserve the RAM log

Cluster 0 watchdog at 0x10050000 (stock DT watchdog_cl0, SPI 464) for
U-Boot to kick, 60 s timeout. Reserve the 1 MiB U-Boot RAM log at
0x8ff100000 (no-map) like the Linux DT does, so EFI never hands it out;
its last 4 KiB hold uniLoader's boot decision record.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../arm64/exynos/exynos9810-gtactive3wifi.dts | 27 +++++++++++++++++++
 1 file changed, 27 insertions(+)

diff --git a/dts/upstream/src/arm64/exynos/exynos9810-gtactive3wifi.dts b/dts/upstream/src/arm64/exynos/exynos9810-gtactive3wifi.dts
index 71cef428..30934369 100644
--- a/dts/upstream/src/arm64/exynos/exynos9810-gtactive3wifi.dts
+++ b/dts/upstream/src/arm64/exynos/exynos9810-gtactive3wifi.dts
@@ -116,6 +116,15 @@
 			record-size = <0x20000>;
 			pmsg-size = <0x10000>;
 		};
+
+		/*
+		 * bring-up: U-Boot's console log (CONFIG_EXYNOS_MOBILE_RAMLOG);
+		 * the last 4 KiB hold uniLoader's boot decision record.
+		 */
+		uboot-log@8ff100000 {
+			reg = <0x8 0xff100000 0x100000>;
+			no-map;
+		};
 	};
 };
 
@@ -316,3 +325,21 @@
 		phy-names = "ufs-phy";
 	};
 };
+
+&soc {
+	/*
+	 * Cluster 0 (A55) watchdog, as in the stock DT (watchdog_cl0@10050000).
+	 * uniLoader arms it before starting U-Boot; U-Boot kicks it and hands
+	 * it to Linux running (see wdt_handover in gtactive3wifi.env).
+	 */
+	watchdog_cl0: watchdog@10050000 {
+		compatible = "samsung,exynos9810-wdt";
+		reg = <0x10050000 0x100>;
+		interrupts = <GIC_SPI 464 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&oscclk>;
+		clock-names = "watchdog";
+		samsung,syscon-phandle = <&pmu_system_controller>;
+		samsung,cluster-index = <0>;
+		timeout-sec = <60>;
+	};
+};
