From 509108624190f890126501aea964354240d46846 Mon Sep 17 00:00:00 2001
From: dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>
Date: Wed, 21 Oct 2026 17:22:28 +1100
Subject: [PATCH 07/13] watchdog: Do not build the legacy s5p_wdt with the
 watchdog uclass

ARCH_EXYNOS selects S5P, which always built the non-DM s5p_wdt.c. Its
wdt_start()/wdt_stop() clash with the uclass functions as soon as an Exynos
board enables CONFIG_WDT (multiple definitions, undefined s5p_cpu_id on
arm64). Only the old Exynos 4 boards without CONFIG_WDT use it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/watchdog/Makefile | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/drivers/watchdog/Makefile b/drivers/watchdog/Makefile
index 92c26397..83ba9505 100644
--- a/drivers/watchdog/Makefile
+++ b/drivers/watchdog/Makefile
@@ -9,7 +9,10 @@ obj-y += imx_watchdog.o
 else
 obj-$(CONFIG_IMX_WATCHDOG) += imx_watchdog.o
 endif
+# Legacy non-DM S5P watchdog: its wdt_start()/wdt_stop() clash with the uclass
+ifndef CONFIG_$(PHASE_)WDT
 obj-$(CONFIG_S5P)               += s5p_wdt.o
+endif
 obj-$(CONFIG_XILINX_TB_WATCHDOG) += xilinx_tb_wdt.o
 obj-$(CONFIG_OMAP_WATCHDOG) += omap_wdt.o
 obj-$(CONFIG_DESIGNWARE_WATCHDOG) += designware_wdt.o
-- 
