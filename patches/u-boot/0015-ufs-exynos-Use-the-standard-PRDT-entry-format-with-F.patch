From 3a275dec142c30ef9ea65aade0a31d9e2ea96a31 Mon Sep 17 00:00:00 2001
From: dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>
Date: Wed, 21 Oct 2026 22:01:24 +1100
Subject: [PATCH 15/18] ufs: exynos: Use the standard PRDT entry format with
 FMP security

U-Boot builds 16-byte PRDT entries but asked the secure firmware for
DESCTYPE 3, the 128-byte FMP entries. That setting outlives U-Boot: a
Linux kernel without UFS inline encryption (also 16-byte entries) then
reads multi-entry PRDTs at the wrong stride and the controller faults
on the bus (IS.SBFES); seen on the Galaxy Tab Active3 (Exynos9810)
booting through EFI. Ask for DESCTYPE 0. The SMCs themselves stay:
without them U-Boot's own transfers fail after its host reset.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/ufs/ufs-exynos.c | 12 ++++++++----
 1 file changed, 8 insertions(+), 4 deletions(-)

diff --git a/drivers/ufs/ufs-exynos.c b/drivers/ufs/ufs-exynos.c
index 80318543..5ea17c6b 100644
--- a/drivers/ufs/ufs-exynos.c
+++ b/drivers/ufs/ufs-exynos.c
@@ -871,6 +871,7 @@ static inline void exynos_ufs_priv_init(struct ufs_hba *hba,
 			   ARM_SMCCC_OWNER_SIP, 0x1850)
 #define SMU_EMBEDDED			0
 #define SMU_INIT			0
+#define CFG_DESCTYPE_0			0
 #define CFG_DESCTYPE_3			3
 
 static void exynos_ufs_fmp_init(struct ufs_hba *hba, struct exynos_ufs *ufs)
@@ -906,11 +907,14 @@ static void exynos_ufs_fmp_init(struct ufs_hba *hba, struct exynos_ufs *ufs)
 		return;
 
 	/*
-	 * This call (which sets DESCTYPE to 0x3 in the FMPSECURITY0 register)
-	 * is needed to make the hardware use the larger PRDT entry size.
+	 * FMP_SECURITY sets DESCTYPE in FMPSECURITY0, the PRDT entry format.
+	 * U-Boot builds standard 16-byte entries (type 0); type 3 would be the
+	 * 128-byte FMP entries. The setting outlives U-Boot, and a Linux
+	 * kernel without UFS inline encryption also uses 16-byte entries:
+	 * with type 3 it reads every multi-entry PRDT at the wrong stride and
+	 * the controller faults on the bus (IS.SBFES).
 	 */
-	// BUILD_BUG_ON(sizeof(struct fmp_sg_entry) != 128);
-	arm_smccc_smc(SMC_CMD_FMP_SECURITY, 0, SMU_EMBEDDED, CFG_DESCTYPE_3,
+	arm_smccc_smc(SMC_CMD_FMP_SECURITY, 0, SMU_EMBEDDED, CFG_DESCTYPE_0,
 		      0, 0, 0, 0, &res);
 	if (res.a0) {
 		dev_warn(hba->dev,
-- 
