From e3627a652b17bb5b532cc224199867465977377f Mon Sep 17 00:00:00 2001
From: dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>
Date: Wed, 21 Oct 2026 16:28:33 +1100
Subject: [PATCH 05/13] exynos-mobile: gtactive3wifi: Run as a uniLoader
 payload

- Board match: when the FDT in x0 does not identify the board (uniLoader
  passes its own DTB if the S-Boot one is unusable), still use the
  gtactive3wifi DT when it is the only one built in.
- RAM log: stop at 0xff000 bytes; the last 4 KiB of the reserved area are
  uniLoader's boot decision record, printed at misc_init_r.
- board_quiesce_devices(): hand the watchdog to the OS on ExitBootServices
  and booti, either running with a full timeout (wdt_handover=keep, the
  default; wdt_handover_ms) or stopped (wdt_handover=stop).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 board/samsung/exynos-mobile/exynos-mobile.c | 73 ++++++++++++++++++++-
 1 file changed, 70 insertions(+), 3 deletions(-)

diff --git a/board/samsung/exynos-mobile/exynos-mobile.c b/board/samsung/exynos-mobile/exynos-mobile.c
index 8554a4f3..b393d08f 100644
--- a/board/samsung/exynos-mobile/exynos-mobile.c
+++ b/board/samsung/exynos-mobile/exynos-mobile.c
@@ -8,9 +8,11 @@
 #include <asm/armv8/mmu.h>
 #include <asm/io.h>
 #include <blk.h>
+#include <bootm.h>
 #include <bootflow.h>
 #include <ctype.h>
 #include <dm/ofnode.h>
+#include <dm/uclass.h>
 #include <efi_loader.h>
 #include <env.h>
 #include <errno.h>
@@ -22,6 +24,7 @@
 #include <lmb.h>
 #include <part.h>
 #include <stdbool.h>
+#include <wdt.h>
 
 DECLARE_GLOBAL_DATA_PTR;
 
@@ -156,6 +159,25 @@ static int exynos7870_fdt_match(struct exynos_board_info *board_info)
 	return 0;
 }
 
+/*
+ * Galaxy Tab Active3: match like the other boards, but when chain-loaded by
+ * uniLoader without a usable S-Boot FDT (it then passes its own DTB, which
+ * has no Samsung command line), still take the device tree if this image
+ * is built for this board alone.
+ */
+static int exynos9810_gtactive3_match(struct exynos_board_info *board_info)
+{
+	if (!exynos7870_fdt_match(board_info))
+		return 0;
+
+	if (strcmp(CONFIG_OF_LIST, CONFIG_DEFAULT_DEVICE_TREE))
+		return -1;
+
+	log_warning("%s: previous bootloader did not identify the board, using %s\n",
+		    __func__, CONFIG_DEFAULT_DEVICE_TREE);
+	return 0;
+}
+
 /*
  * This array is used for matching the models and revisions with the
  * devicetree used by U-Boot. This allows a single U-Boot to work on
@@ -194,7 +216,7 @@ static struct exynos_board_info exynos_board_info_match[] = {
 		.name = "gtactive3wifi",
 		.chip = "exynos9810",
 		.dram_bank_bases = exynos9810_common_dram_bank_bases,
-		.match = exynos7870_fdt_match,
+		.match = exynos9810_gtactive3_match,
 		.match_model = "T570",
 		.match_max_rev = U8_MAX,
 	}, {
@@ -435,7 +457,8 @@ int board_init(void)
  * watchdog reset whether or not the data cache is on yet.
  */
 #define RAMLOG_MAGIC	0x474f4c55	/* "ULOG" */
-#define RAMLOG_SIZE	0x100000
+/* 1 MiB reserved; the last 4 KiB hold uniLoader's boot decision record */
+#define RAMLOG_SIZE	0xff000
 
 static int ramlog_started __section(".data");
 
@@ -533,6 +556,48 @@ static void gtactive3_max77705_com_usb(void)
 	writel(con_scl, GTA3_SCL);
 }
 
+#if IS_ENABLED(CONFIG_EXYNOS_MOBILE_RAMLOG)
+/*
+ * uniLoader's boot decision record (main/chainload.h in uniLoader), in the
+ * last 4 KiB of the RAM log area: magic, version, run, decision, reason,
+ * reset status, keys.
+ */
+static void exynos_show_uniloader_record(void)
+{
+	const u32 *ci = (const u32 *)(CONFIG_EXYNOS_MOBILE_RAMLOG_ADDR + RAMLOG_SIZE);
+
+	if (ci[0] != 0x48434c55)	/* "ULCH" */
+		return;
+	log_info("uniLoader: run %u, %s, reason 0x%x, RST_STAT 0x%08x\n",
+		 ci[2], ci[3] ? "fallback" : "chained", ci[4], ci[5]);
+}
+#else
+static void exynos_show_uniloader_record(void) {}
+#endif
+
+/*
+ * Hand the watchdog to the OS (EFI ExitBootServices and booti both end up
+ * here). wdt_handover=keep (default): leave it running with a full timeout,
+ * so a kernel that hangs before its watchdog driver takes over resets into
+ * uniLoader's fallback Linux. wdt_handover=stop: stop it.
+ */
+void board_quiesce_devices(void)
+{
+	struct udevice *dev;
+	const char *mode = env_get("wdt_handover");
+
+	if (!IS_ENABLED(CONFIG_WDT) || uclass_first_device_err(UCLASS_WDT, &dev))
+		return;
+
+	if (mode && !strcmp(mode, "stop")) {
+		wdt_stop(dev);
+		log_info("watchdog stopped for the OS\n");
+	} else {
+		wdt_start(dev, env_get_ulong("wdt_handover_ms", 10, 80000), 0);
+		log_info("watchdog left running for the OS\n");
+	}
+}
+
 int misc_init_r(void)
 {
 	const struct exynos_board_info *board_info;
@@ -545,8 +610,10 @@ int misc_init_r(void)
 	env_set("platform", board_info->chip);
 	env_set("board", board_info->name);
 
-	if (!strcmp(board_info->name, "gtactive3wifi"))
+	if (!strcmp(board_info->name, "gtactive3wifi")) {
+		exynos_show_uniloader_record();
 		gtactive3_max77705_com_usb();
+	}
 
 	if (strlen(board_info->serial))
 		env_set("serial#", board_info->serial);
-- 
