From 7a08356f9eee6df478866dce7f2703b59ec840c6 Mon Sep 17 00:00:00 2001
From: dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>
Date: Wed, 21 Oct 2026 20:01:43 +1100
Subject: [PATCH 13/13] exynos-mobile: gtactive3wifi: Mark uniLoader's record
 when handing over to the OS

Stage 7 tells uniLoader that the chained boot reached the OS, so a
record left at stage 4 means U-Boot died and the next run boots the
fallback Linux instead of the same crash.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 board/samsung/exynos-mobile/exynos-mobile.c | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/board/samsung/exynos-mobile/exynos-mobile.c b/board/samsung/exynos-mobile/exynos-mobile.c
index fc3f7594..6a2e50ca 100644
--- a/board/samsung/exynos-mobile/exynos-mobile.c
+++ b/board/samsung/exynos-mobile/exynos-mobile.c
@@ -10,6 +10,7 @@
 #include <blk.h>
 #include <bootm.h>
 #include <bootflow.h>
+#include <cpu_func.h>
 #include <ctype.h>
 #include <dm/ofnode.h>
 #include <dm/uclass.h>
@@ -579,6 +580,24 @@ static void exynos_show_uniloader_record(void)
 static void exynos_show_uniloader_record(void) {}
 #endif
 
+/*
+ * Tell uniLoader that this chained boot got as far as handing over to the
+ * OS: stage 7 (CHAIN_STAGE_OS). A record still at stage 4 (jumped to us)
+ * on the next run means U-Boot died on the way, and uniLoader then boots
+ * its fallback Linux instead of chaining into the same crash again.
+ */
+static void exynos_mark_uniloader_os(void)
+{
+#if IS_ENABLED(CONFIG_EXYNOS_MOBILE_RAMLOG)
+	u32 *ci = (u32 *)(CONFIG_EXYNOS_MOBILE_RAMLOG_ADDR + RAMLOG_SIZE);
+
+	if (ci[0] != 0x48434c55)
+		return;
+	ci[19] = 7;
+	flush_dcache_range((ulong)ci, (ulong)ci + 128);
+#endif
+}
+
 /*
  * Hand the watchdog to the OS (EFI ExitBootServices and booti both end up
  * here). wdt_handover=keep (default): leave it running with a full timeout,
@@ -590,6 +609,7 @@ void board_quiesce_devices(void)
 	struct udevice *dev;
 	const char *mode = env_get("wdt_handover");
 
+	exynos_mark_uniloader_os();
 	if (!IS_ENABLED(CONFIG_WDT) || uclass_first_device_err(UCLASS_WDT, &dev))
 		return;
 
