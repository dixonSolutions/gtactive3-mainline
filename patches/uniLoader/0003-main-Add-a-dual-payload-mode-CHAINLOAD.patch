@@ -36,9 +37,13 @@ void main(void* dt, void* kernel, void* ramdisk, void* prev_fdt, void* load_addr
 
 	INITCALL(board_ops.ops.late_init);
 
-	/* Handed over by the previous bootloader, unused for now */
+#ifdef CONFIG_CHAINLOAD
+	/* Only returns when the embedded Linux is to be booted */
+	chainload(dt, prev_fdt, load_addr);
+#else
 	(void)prev_fdt;
 	(void)load_addr;
+#endif
 
 	boot_kernel(dt, kernel, ramdisk);
 
