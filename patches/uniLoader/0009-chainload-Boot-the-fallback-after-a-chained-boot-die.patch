From ea0931088d22e7cdbf436ff8a899f0696aade361 Mon Sep 17 00:00:00 2001
From: dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>
Date: Wed, 21 Oct 2026 20:01:43 +1100
Subject: [PATCH 9/9] chainload: Boot the fallback after a chained boot died
 before the OS

The chained bootloader sets the record's stage to CHAIN_STAGE_OS when it
hands over to the OS. A record still at CHAIN_STAGE_JUMP on entry means
it crashed or reset on the way (e.g. into Download mode, which the boot
loop would otherwise repeat forever): boot the fallback Linux once.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include/main/chainload.h |  2 ++
 main/chainload.c         | 10 ++++++++++
 2 files changed, 12 insertions(+)

diff --git a/include/main/chainload.h b/include/main/chainload.h
index 9091f68..712f66b 100644
--- a/include/main/chainload.h
+++ b/include/main/chainload.h
@@ -22,6 +22,7 @@
 #define CHAIN_STAGE_JUMP	4	/* jumping to the chained bootloader */
 #define CHAIN_STAGE_WDT_TEST	5	/* CHAINLOAD_DEFAULT=2: waiting for the reset */
 #define CHAIN_STAGE_WDT_PASSED	6	/* ... and it came, with RST_STAT bit set */
+#define CHAIN_STAGE_OS		7	/* set by the chained bootloader at OS handover */
 
 /* chain_info.reason: bits below 8 select the fallback, the others are notes */
 #define CHAIN_R_WDT_RESET	(1 << 0)	/* last reset was the watchdog */
@@ -29,6 +30,7 @@
 #define CHAIN_R_FORCED		(1 << 2)	/* CONFIG_CHAINLOAD_DEFAULT != 0 */
 #define CHAIN_R_BAD_PAYLOAD	(1 << 3)	/* no arm64 Image header, or too big */
 #define CHAIN_R_WDT_FAIL	(1 << 4)	/* watchdog not armed / did not reset */
+#define CHAIN_R_CHAIN_DIED	(1 << 5)	/* last chained boot never reached the OS */
 #define CHAIN_R_FALLBACK_MASK	0xff
 #define CHAIN_N_PREV_FDT_BAD	(1 << 8)	/* x0 was not a usable FDT */
 #define CHAIN_N_NO_BOOTLOADER	(1 << 9)	/* no androidboot.bootloader= */
diff --git a/main/chainload.c b/main/chainload.c
index 5e2fe27..4c7db20 100644
--- a/main/chainload.c
+++ b/main/chainload.c
@@ -180,6 +180,16 @@ void chainload(void *dt, void *prev_fdt, void *load_addr)
 		ci.reason |= CHAIN_N_PREV_FDT_BAD;
 	}
 
+	/*
+	 * The last run jumped to the chained bootloader and it never marked
+	 * the OS handover (CHAIN_STAGE_OS): it crashed or reset on the way.
+	 * Boot the fallback once; the record then says FALLBACK, so the run
+	 * after that chains again.
+	 */
+	if (prev_stage == CHAIN_STAGE_JUMP) {
+		ci.reason |= CHAIN_R_CHAIN_DIED;
+		printk(KERN_INFO, "chainload: the last chained boot did not reach the OS\n");
+	}
 	if (CONFIG_CHAINLOAD_DEFAULT != 0)
 		ci.reason |= CHAIN_R_FORCED;
 	if (size < 0x40 ||
-- 
