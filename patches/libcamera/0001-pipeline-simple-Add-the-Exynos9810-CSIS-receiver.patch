From 244bef5f2d011cb41cefc32281e098cb86a0ccf4 Mon Sep 17 00:00:00 2001
From: dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>
Date: Thu, 22 Oct 2026 18:07:47 +1100
Subject: [PATCH] pipeline: simple: Add the Exynos9810 CSIS receiver

The Samsung Exynos9810 camera front end has MIPI CSI-2 receivers (CSIS
v5.1) whose virtual channel DMA writes the raw Bayer stream of the
sensor straight to memory. The image processing of the SoC ISP runs in
proprietary firmware, so the exynos9810-csis driver only exposes that
raw path: a sensor subdev linked to one video capture node per
receiver. Support it in the simple pipeline handler with the software
ISP.

Signed-off-by: dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>
---
 src/libcamera/pipeline/simple/simple.cpp | 1 +
 1 file changed, 1 insertion(+)

diff --git a/src/libcamera/pipeline/simple/simple.cpp b/src/libcamera/pipeline/simple/simple.cpp
index e26f438..181a99d 100644
--- a/src/libcamera/pipeline/simple/simple.cpp
+++ b/src/libcamera/pipeline/simple/simple.cpp
@@ -257,6 +257,7 @@ namespace {
 
 static const SimplePipelineInfo supportedDevices[] = {
 	{ "dcmipp", {}, false },
+	{ "exynos9810-csis", {}, true },
 	{ "imx7-csi", { { "pxp", 1 } }, true },
 	{ "intel-ipu6", {}, true },
 	{ "intel-ipu7", {}, true },
-- 
