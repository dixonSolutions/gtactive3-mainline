 	for (unsigned int x = 0; x < widthInBytes; x += 5) {
 		/* GBRG */
@@ -316,12 +350,14 @@ void SwStatsCpu::statsGBRG10PLine0(const uint8_t *src[], SwIspStats &stats)
 		b = src0[x + 1];
 		r = src1[x];
 		g2 = src1[x + 1];
