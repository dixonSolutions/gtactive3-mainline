diff --git a/src/libcamera/software_isp/swstats_cpu.cpp b/src/libcamera/software_isp/swstats_cpu.cpp
index 0d33594..2749708 100644
--- a/src/libcamera/software_isp/swstats_cpu.cpp
+++ b/src/libcamera/software_isp/swstats_cpu.cpp
@@ -195,6 +195,34 @@ static constexpr unsigned int kBlueYMul = 29; /* 0.114 * 256 */
 	stats.sum_.g() += sumG;     \
 	stats.sum_.b() += sumB;
 
+/*
+ * Focus measure over the central third of the line: the two greens of a
+ * 2x2 block differ by the diagonal detail, consecutive sampled blocks by
+ * the horizontal detail. Squared, so strong edges dominate sensor noise.
+ */
+#define SWSTATS_START_SHARPNESS()                            \
+	const unsigned int afStart = widthInBytes / 15 * 5;  \
+	const unsigned int afEnd = widthInBytes / 15 * 10;   \
+	int gPrev = -1;                                      \
+	uint64_t sharp = 0;                                  \
+	uint64_t sharpBase = 0;
+
+#define SWSTATS_ACCUMULATE_SHARPNESS(x)                      \
+	if ((x) >= afStart && (x) < afEnd) {                 \
+		int dd = static_cast<int>(g) - g2;           \
+		sharp += dd * dd;                            \
+		if (gPrev >= 0) {                            \
+			int dh = static_cast<int>(g) - gPrev;\
+			sharp += dh * dh;                    \
+		}                                            \
+		gPrev = g;                                   \
+		sharpBase += g;                              \
+	}
+
+#define SWSTATS_FINISH_SHARPNESS()        \
+	stats.sharpness += sharp;         \
+	stats.sharpnessBase += sharpBase;
+
 void SwStatsCpu::statsBGGR8Line0(const uint8_t *src[], SwIspStats &stats)
 {
 	const uint8_t *src0 = src[1] + window_.x;
@@ -283,6 +311,8 @@ void SwStatsCpu::statsBGGR10PLine0(const uint8_t *src[], SwIspStats &stats)
 
 	SWSTATS_START_LINE_STATS(uint8_t)
 
+	SWSTATS_START_SHARPNESS()
+
 	/* x += 5 sample every other 2x2 block */
 	for (unsigned int x = 0; x < widthInBytes; x += 5) {
 		/* BGGR */
@@ -290,12 +320,14 @@ void SwStatsCpu::statsBGGR10PLine0(const uint8_t *src[], SwIspStats &stats)
 		g = src0[x + 1];
 		g2 = src1[x];
 		r = src1[x + 1];
+		SWSTATS_ACCUMULATE_SHARPNESS(x)
 		g = (g + g2) / 2;
 		/* Data is already 8 bits, divide by 1 */
 		SWSTATS_ACCUMULATE_LINE_STATS(1)
 	}
 
 	SWSTATS_FINISH_LINE_STATS()
+	SWSTATS_FINISH_SHARPNESS()
 }
 
