+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast autofocus for the simple software ISP
+ */
+
+#pragma once
+
+#include <vector>
+
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+class Af : public Algorithm
+{
+public:
+	Af() = default;
+	~Af() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context, const IPAConfigInfo &configInfo) override;
+	void process(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     const SwIspStats *stats,
+		     ControlList &metadata) override;
+
+private:
+	enum class State {
+		Coarse,
+		Fine,
+		Locked,
+	};
+
+	void moveTo(IPAContext &context, int32_t position);
+	void startScan(IPAContext &context);
+	void startFine(IPAContext &context);
+
+	int32_t min_ = 0;
+	int32_t max_ = 1023;
+	int32_t park_ = 512;
+	int32_t coarseStep_ = 96;
+	int32_t fineStep_ = 24;
+	float rescanDrop_ = 0.5f;
+	float rescanLuma_ = 0.35f;
+	unsigned int holdStats_ = 15;
+
+	State state_ = State::Locked;
+	int32_t position_ = 0;
+	std::vector<int32_t> scan_;
+	size_t scanIndex_ = 0;
+	int32_t bestPosition_ = 0;
+	double bestMeasure_ = 0.0;
+	double minMeasure_ = 0.0;
+	unsigned int belowBest_ = 0;
+
+	double lockedMeasure_ = 0.0;
+	double lockedLuma_ = 0.0;
+	unsigned int lowCount_ = 0;
+	unsigned int sinceLock_ = 0;
+};
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
