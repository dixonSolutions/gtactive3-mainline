--- /dev/null
+++ b/src/ipa/simple/algorithms/af.cpp
@@ -0,0 +1,189 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast autofocus for the simple software ISP
+ *
+ * A full-range coarse scan of the lens, a fine scan around the sharpest
+ * coarse position, then hold. The focus measure is the green-pixel
+ * gradient energy the CPU statistics gather over the central third of the
+ * frame, normalised by its brightness. A held position is rescanned when
+ * the measure falls well below the value it locked at, or the scene
+ * brightness changes a lot, both for a few statistics frames in a row.
+ *
+ * The algorithm only runs when the sensor's tuning file has an "Af" block
+ * (the sensor has a focus lens); keys: min, max, park, coarseStep,
+ * fineStep, rescanDrop, rescanLuma, holdStats.
+ */
+
+#include "af.h"
+
+#include <algorithm>
+#include <cmath>
+
+#include <libcamera/base/log.h>
+
+namespace libcamera {
+
+LOG_DEFINE_CATEGORY(IPASoftAf)
+
+namespace ipa::soft::algorithms {
+
+/* a coarse step this far below the best counts as past the peak */
+static constexpr double kPastPeak = 0.85;
+/* best/worst coarse measure below this: nothing to focus on */
+static constexpr double kMinContrast = 1.08;
+
+int Af::init([[maybe_unused]] IPAContext &context, const ValueNode &tuningData)
+{
+	min_ = tuningData["min"].get<int32_t>(min_);
+	max_ = tuningData["max"].get<int32_t>(max_);
+	park_ = std::clamp(tuningData["park"].get<int32_t>((min_ + max_) / 2), min_, max_);
+	coarseStep_ = std::max(tuningData["coarseStep"].get<int32_t>(coarseStep_), 1);
+	fineStep_ = std::max(tuningData["fineStep"].get<int32_t>(fineStep_), 1);
+	rescanDrop_ = tuningData["rescanDrop"].get<float>(rescanDrop_);
+	rescanLuma_ = tuningData["rescanLuma"].get<float>(rescanLuma_);
+	holdStats_ = tuningData["holdStats"].get<unsigned int>(holdStats_);
+
+	return 0;
+}
+
+int Af::configure(IPAContext &context,
+		  [[maybe_unused]] const IPAConfigInfo &configInfo)
+{
+	/* configure() resets the active state: (re)enable here */
+	context.activeState.af.enabled = true;
+	moveTo(context, park_);
+	startScan(context);
+	return 0;
+}
+
+void Af::moveTo(IPAContext &context, int32_t position)
+{
+	position_ = std::clamp(position, min_, max_);
+	context.activeState.af.position = position_;
+	context.activeState.af.changed = true;
+	/*
+	 * Statistics come every fourth frame: the lens is set while the
+	 * next three are in flight and has settled before the one after
+	 * them is exposed, so no statistics frame is skipped.
+	 */
+}
+
+void Af::startScan(IPAContext &context)
+{
+	scan_.clear();
+	for (int32_t p = min_; p < max_; p += coarseStep_)
+		scan_.push_back(p);
+	scan_.push_back(max_);
+	scanIndex_ = 0;
+	bestMeasure_ = -1.0;
+	minMeasure_ = 1e30;
+	belowBest_ = 0;
+	state_ = State::Coarse;
+	moveTo(context, scan_[0]);
+	LOG(IPASoftAf, Debug) << "coarse scan, " << scan_.size() << " steps";
+}
+
+void Af::startFine(IPAContext &context)
+{
+	int32_t lo = std::max(bestPosition_ - coarseStep_, min_);
+	int32_t hi = std::min(bestPosition_ + coarseStep_, max_);
+
+	scan_.clear();
+	for (int32_t p = lo; p <= hi; p += fineStep_)
+		scan_.push_back(p);
+	scanIndex_ = 0;
+	bestMeasure_ = -1.0;
+	state_ = State::Fine;
+	moveTo(context, scan_[0]);
+}
+
+void Af::process(IPAContext &context,
+		 [[maybe_unused]] const uint32_t frame,
+		 [[maybe_unused]] IPAFrameContext &frameContext,
+		 const SwIspStats *stats,
+		 [[maybe_unused]] ControlList &metadata)
+{
+	if (!stats->valid || !stats->sharpnessBase)
+		return;
+
+	double luma = static_cast<double>(stats->sharpnessBase);
+	double measure = static_cast<double>(stats->sharpness) / luma;
+
+	switch (state_) {
+	case State::Coarse:
+	case State::Fine:
+		if (measure > bestMeasure_) {
+			bestMeasure_ = measure;
+			bestPosition_ = scan_[scanIndex_];
+			belowBest_ = 0;
+		} else if (measure < bestMeasure_ * kPastPeak) {
+			belowBest_++;
+		}
+		minMeasure_ = std::min(minMeasure_, measure);
+		LOG(IPASoftAf, Debug)
+			<< (state_ == State::Coarse ? "coarse " : "fine ")
+			<< scan_[scanIndex_] << ": " << measure;
+
+		/* a coarse scan stops once it is clearly past a peak */
+		if (++scanIndex_ < scan_.size() &&
+		    !(state_ == State::Coarse && belowBest_ >= 2)) {
+			moveTo(context, scan_[scanIndex_]);
+			break;
+		}
+
+		if (state_ == State::Coarse) {
+			/* a flat scene has no peak to find: park mid-distance */
+			if (bestMeasure_ < minMeasure_ * kMinContrast) {
+				LOG(IPASoftAf, Debug) << "no contrast, parking";
+				bestPosition_ = park_;
+				moveTo(context, park_);
+				state_ = State::Locked;
+				lockedMeasure_ = 0.0;
+				lowCount_ = 0;
+				sinceLock_ = 0;
+				break;
+			}
+			startFine(context);
+			break;
+		}
+
+		moveTo(context, bestPosition_);
+		state_ = State::Locked;
+		lockedMeasure_ = 0.0;
+		lowCount_ = 0;
+		sinceLock_ = 0;
+		LOG(IPASoftAf, Info) << "focus locked at " << bestPosition_;
+		break;
+
+	case State::Locked:
+		/* the first frame at the final position sets the reference */
+		if (lockedMeasure_ == 0.0) {
+			lockedMeasure_ = measure;
+			lockedLuma_ = luma;
+			break;
+		}
+
+		sinceLock_++;
+		lockedMeasure_ = std::max(lockedMeasure_, measure);
+
+		if (measure < lockedMeasure_ * (1.0 - rescanDrop_) ||
+		    std::abs(luma - lockedLuma_) > lockedLuma_ * rescanLuma_)
+			lowCount_++;
+		else
+			lowCount_ = 0;
+
+		if (lowCount_ >= 3 && sinceLock_ >= holdStats_) {
+			LOG(IPASoftAf, Debug)
+				<< "scene changed (" << measure << " vs "
+				<< lockedMeasure_ << "), rescanning";
+			startScan(context);
+		}
+		break;
+	}
+}
+
+REGISTER_IPA_ALGORITHM(Af, "Af")
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
