Date: Thu, 22 Oct 2026 18:07:47 +1100
Subject: [PATCH 2/2] libcamera: sensor: Add Samsung S5K3L6 and GalaxyCore
 GC5035

Add the camera sensor properties and the sensor helpers of the Samsung
S5K3L6 (13MP, 1.12um) and the GalaxyCore GC5035 (5MP, 1.12um), the rear
and front cameras of the Samsung Galaxy Tab Active3.

The S5K3L6 analogue gain code is the gain in 1/32 (0x20 = 1x to
0x200 = 16x). The GC5035 driver exposes the total gain in 1/256: it
picks the largest analogue step below the request and makes up the
rest with digital gain, so the code maps linearly as well.

Signed-off-by: dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>
---
 src/ipa/libipa/camera_sensor_helper.cpp       | 25 +++++++++++++++++++
 .../sensor/camera_sensor_properties.cpp       | 21 ++++++++++++++++
 2 files changed, 46 insertions(+)

diff --git a/src/ipa/libipa/camera_sensor_helper.cpp b/src/ipa/libipa/camera_sensor_helper.cpp
index 9457d62..f37f56a 100644
--- a/src/ipa/libipa/camera_sensor_helper.cpp
+++ b/src/ipa/libipa/camera_sensor_helper.cpp
@@ -520,6 +520,19 @@ public:
 };
 REGISTER_CAMERA_SENSOR_HELPER("gc08a3", CameraSensorHelperGc08a3)
 
+class CameraSensorHelperGc5035 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperGc5035()
+	{
+		/* 64 at 10bits. */
+		blackLevel_ = 4096;
+		/* Total gain in 1/256: analogue steps, digital for the rest. */
+		gain_ = AnalogueGainLinear{ 1, 0, 0, 256 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("gc5035", CameraSensorHelperGc5035)
+
 class CameraSensorHelperHm1246 : public CameraSensorHelper
 {
 public:
@@ -827,6 +840,18 @@ public:
 };
 REGISTER_CAMERA_SENSOR_HELPER("ov13858", CameraSensorHelperOv13858)
 
+class CameraSensorHelperS5k3l6 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperS5k3l6()
+	{
+		/* 64 at 10bits. */
+		blackLevel_ = 4096;
+		gain_ = AnalogueGainLinear{ 1, 0, 0, 32 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("s5k3l6", CameraSensorHelperS5k3l6)
+
 class CameraSensorHelperVd55g1 : public CameraSensorHelper
 {
 public:
