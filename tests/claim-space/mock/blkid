#!/bin/sh
# mock blkid -p -o export DEV: the LUKS volumes of the mock cryptsetup
echo "blkid $*" >> "$MOCK_STATE/calls"
for dev; do :; done
v=$MOCK_STATE/luks/${dev##*/}
[ -f "$v/uuid" ] || exit 2
printf 'UUID=%s\nLABEL=%s\nVERSION=2\nTYPE=crypto_LUKS\nUSAGE=crypto\n' "$(cat "$v/uuid")" "$(cat "$v/label")"
