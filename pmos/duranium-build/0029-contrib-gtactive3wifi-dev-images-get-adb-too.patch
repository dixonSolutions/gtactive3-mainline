From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>
Date: Thu, 22 Oct 2026 18:05:15 +1100
Subject: [PATCH] contrib: gtactive3wifi: dev images get adb too

mkosi splits an --environment= value at whitespace, so
DURANIUM_EXTRA_PACKAGES="duranium-usb-debug duranium-usb-debug-adb"
reached pmaports.py as just duranium-usb-debug: the published dev images
had no adbd. Pass the list comma separated (pmaports.py takes both).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 contrib/samsung-gtactive3wifi/build-image.sh | 3 ++-
 scripts/pmaports.py                          | 7 ++++---
 scripts/tests/test_pmaports.py               | 2 +-
 3 files changed, 7 insertions(+), 5 deletions(-)

diff --git a/contrib/samsung-gtactive3wifi/build-image.sh b/contrib/samsung-gtactive3wifi/build-image.sh
index f50facf..db14756 100755
--- a/contrib/samsung-gtactive3wifi/build-image.sh
+++ b/contrib/samsung-gtactive3wifi/build-image.sh
@@ -35,7 +35,8 @@ UI=${UI:-gnome}
 RELEASE=edge
 CHANNEL=${CHANNEL:-dev}
 case "$CHANNEL" in
-dev) GTA3_CHANNEL=dev; EXTRA="duranium-usb-debug duranium-usb-debug-adb" ;;
+# comma separated: mkosi splits --environment= values at whitespace
+dev) GTA3_CHANNEL=dev; EXTRA=duranium-usb-debug,duranium-usb-debug-adb ;;
 release) GTA3_CHANNEL=; EXTRA= ;;
 *) echo "CHANNEL must be dev or release" >&2; exit 1 ;;
 esac
diff --git a/scripts/pmaports.py b/scripts/pmaports.py
index 0a20f2b..689d25c 100755
--- a/scripts/pmaports.py
+++ b/scripts/pmaports.py
@@ -251,9 +251,10 @@ def resolve(device: str, ui: str, release: str, skip_fetch: bool = False) -> dic
     if f"{device_pkg}-initramfs" in device_subpkgs:
         initrd_packages.append(f"{device_pkg}-initramfs")
 
-    # Extra packages for this build only (space separated), e.g. a
-    # development layer that release images of the same device leave out.
-    extra = os.environ.get("DURANIUM_EXTRA_PACKAGES", "").split()
+    # Extra packages for this build only (comma separated: mkosi's
+    # --environment= splits its value at whitespace), e.g. a development
+    # layer that release images of the same device leave out.
+    extra = os.environ.get("DURANIUM_EXTRA_PACKAGES", "").replace(",", " ").split()
     packages += extra
 
     # The Duranium USB debug layer (duranium-usb-debug) must also be in the
diff --git a/scripts/tests/test_pmaports.py b/scripts/tests/test_pmaports.py
index 3f2cea6..2a9f84f 100644
--- a/scripts/tests/test_pmaports.py
+++ b/scripts/tests/test_pmaports.py
@@ -324,7 +324,7 @@ def test_resolve_extra_packages_usb_debug(mock_prepare, tmp_path, monkeypatch):
         device_subpackages="device-testphone-initramfs:initramfs",
     )
     mock_prepare.return_value = pmaports_dir
-    monkeypatch.setenv("DURANIUM_EXTRA_PACKAGES", "duranium-usb-debug duranium-usb-debug-adb")
+    monkeypatch.setenv("DURANIUM_EXTRA_PACKAGES", "duranium-usb-debug,duranium-usb-debug-adb")
 
     result = pm.resolve("testphone", "testui", "edge")
     assert "duranium-usb-debug" in result["Packages"]
