-OUT=$ROOT/build/wt/duranium-out
-FRAG=$ROOT/build/wt/pmaports-duranium/device/testing/linux-samsung-gtactive3wifi-duranium/duranium.config
-PKGDIR=$ROOT/build/wt/pmaports-duranium/device/testing/linux-samsung-gtactive3wifi-duranium
-LOCK=$ROOT/build/kbuild.lock
-CROSS=${CROSS_COMPILE:-aarch64-linux-gnu-}
-JOBS=${JOBS:-6}
-
-commit=$(git -C "$LINUX_GIT" rev-parse --verify "$KREF^{commit}")
-if [ "$(cat "$SRC/.duranium-commit" 2>/dev/null || true)" != "$commit" ]; then
-	echo "Exporting $KREF ($commit) -> $SRC (clean output dir)"
-	rm -rf "$SRC" "$OUT"
-	mkdir -p "$SRC"
-	git -C "$LINUX_GIT" archive "$commit" | tar -x -C "$SRC"
-	echo "$commit" > "$SRC/.duranium-commit"
-fi
-
-mkdir -p "$OUT"
