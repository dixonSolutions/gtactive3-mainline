-flock "$LOCK" nice -n 19 make -C "$SRC" O="$OUT" ARCH=arm64 CROSS_COMPILE="$CROSS" \
-	INSTALL_MOD_PATH="$STAGE/usr" INSTALL_MOD_STRIP=1 modules_install
