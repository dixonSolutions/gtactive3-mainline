-#!/bin/sh
-# Build the Duranium bring-up kernel for the Galaxy Tab Active3 and package it
-# into the tarball that the prebuilt bridge APKBUILD
-# (device/testing/linux-samsung-gtactive3wifi-duranium) consumes.
-#
-# This is the bridge until the regular gtactive3wifi pmaports track ships a
-# from-source kernel package. It uses the SAME source and config that the lead
-# tests on the device:
-#   source : gtactive3-mainline src/linux, ref $KREF (default: the integration
-#            branch gtactive3wifi, which already contains drv/wdt), exported
-#            with "git archive" into build/wt/duranium-linux
-#   config : build/bringup/.config + the duranium.config fragment
-#
-# When the exported commit changes, the snapshot and the output directory are
-# recreated: "git archive" stamps files with the commit time, so an
-# incremental build over an older output tree could silently keep stale
-# objects.
-#
-# Run under the shared kernel build lock, like every other heavy build here.
-set -eu
-
-ROOT=${GTA3_ROOT:-/home/borysthebear/Projects/gtactive3-mainline}
-LINUX_GIT=$ROOT/src/linux
