diff --git a/contrib/samsung-gtactive3wifi/build-apks.sh b/contrib/samsung-gtactive3wifi/build-apks.sh
index f4b9ea5..aafc280 100755
--- a/contrib/samsung-gtactive3wifi/build-apks.sh
+++ b/contrib/samsung-gtactive3wifi/build-apks.sh
@@ -1,48 +1,93 @@
 #!/bin/sh
-# Build the local Duranium bring-up apks (device + -initramfs, usb-debug +
-# -initramfs, the prebuilt kernel bridge) from the pmaports worktree in an
-# arm64 Alpine edge container (qemu-user binfmt on x86 hosts), without
-# needing an initialized pmbootstrap. Output: a flat directory of .apk files
-# for mkosi's --package-directory.
+# Build the samsung-gtactive3wifi packages that are not in the
+# postmarketOS binary repository, from the pmaports worktree, without
+# pmbootstrap:
 #
-# devicepkg-dev (a pmaports package) is built first and installed as the
-# makedepend of the device package. Runtime depends are not installed
-# (abuild -d); mkosi resolves them from the Alpine/postmarketOS repos.
+#   duranium-usb-debug(-initramfs)                    main/
+#   device-samsung-gtactive3wifi(-initramfs,-bootimg) device/testing/
+#   linux-postmarketos-exynos9810                     device/testing/
+#   firmware-samsung-gtactive3wifi (local only)       contrib/.../firmware/
+#
+# They are built in an x86_64 postmarketOS container (pkgbuilder.
+# Containerfile) with CARCH=aarch64, the kernel and the device helper with
+# the aarch64 cross compiler, like pmbootstrap's "cross-native" mode: no
+# qemu-user emulation. Output: a flat directory of .apk files for mkosi's
+# --package-directory.
+#
+# The firmware package is only built when the extracted vendor firmware is
+# present (GTA3_FIRMWARE_DIR, default firmware/extracted/linux-firmware/
+# lib/firmware). It is proprietary: the .apk stays in the local package
+# directory, which is outside every git tree.
+#
+# Usage: build-apks.sh [aport ...]   (default: all of the above)
 set -eu
 
+HERE=$(cd "$(dirname "$0")" && pwd)
 ROOT=${GTA3_ROOT:-/home/borysthebear/Projects/gtactive3-mainline}
-PMAPORTS=$ROOT/build/wt/pmaports-duranium
+PMAPORTS=${PMAPORTS:-$ROOT/build/wt/pmaports-duranium}
 PKGS=${PKGS:-$ROOT/build/wt/duranium-localpkgs}
+DISTFILES=${DISTFILES:-$ROOT/build/wt/duranium-distfiles}
+FWDIR=${GTA3_FIRMWARE_DIR:-$ROOT/firmware/extracted/linux-firmware/lib/firmware}
 LOCK=$ROOT/build/kbuild.lock
-IMAGE=${ALPINE_IMAGE:-docker.io/library/alpine:edge}
+BUILDER=${BUILDER:-gta3-pkgbuilder}
+JOBS=${JOBS:-6}
+
+if [ $# -eq 0 ]; then
+	set -- main/duranium-usb-debug \
+		device/testing/device-samsung-gtactive3wifi \
+		device/testing/linux-postmarketos-exynos9810
+	[ -d "$FWDIR" ] && set -- "$@" firmware
+fi
 
-[ -f "$PMAPORTS/device/testing/linux-samsung-gtactive3wifi-duranium/kernel-prebuilt.tar.gz" ] || {
-	echo "kernel tarball missing: run build-kernel.sh first" >&2; exit 1; }
+podman image exists "$BUILDER" ||
+	podman build -t "$BUILDER" -f "$HERE/pkgbuilder.Containerfile" "$HERE"
 
+mkdir -p "$PKGS" "$DISTFILES"
 work=$(mktemp -d)
 trap 'rm -rf "$work"' EXIT
+mkdir -p "$work/repo" "$work/out"
+
 cat > "$work/build.sh" <<'IN'
 #!/bin/sh
 set -eu
-apk add -q alpine-sdk linux-headers
 abuild-keygen -a -n -q >/dev/null 2>&1
-cp /root/.abuild/*.pub /etc/apk/keys/
-for p in main/devicepkg-dev main/duranium-usb-debug \
-	 device/testing/linux-samsung-gtactive3wifi-duranium \
-	 device/testing/device-samsung-gtactive3wifi; do
-	rm -rf /b && mkdir -p /b && cp -r "/src/$p" /b/pkg
-	( cd /b/pkg && abuild -F -d -P /repo )
+export CARCH=aarch64 SRCDEST=/distfiles JOBS
+export MAKEFLAGS="-j$JOBS"
+for p in "$@"; do
 	case "$p" in
-	*/devicepkg-dev) apk add -q --allow-untrusted /repo/b/*/devicepkg-dev-*.apk ;;
+	firmware) src=/contrib/firmware; export GTA3_FIRMWARE_DIR=/firmware ;;
+	*) src="/pmaports/$p" ;;
+	esac
+	name=$(basename "$p")
+	echo "=== $name"
+	rm -rf /b && mkdir -p /b && cp -r "$src" "/b/$name"
+	cd "/b/$name"
+	case "$name" in
+	firmware) ;;
+	*) abuild -F verify ;;
 	esac
+	# cross-native: compile with the aarch64 cross compiler on the host CPU
+	CROSS_COMPILE=aarch64-alpine-linux-musl- CC=aarch64-alpine-linux-musl-gcc \
+		abuild -F -d -P /repo -D postmarketOS
 done
-find /repo -name '*.apk' ! -name 'devicepkg-dev-*' -exec cp {} /out/ \;
+find /repo -name '*.apk' -exec cp {} /out/ \;
 IN
 chmod +x "$work/build.sh"
 
-mkdir -p "$PKGS"
-rm -f "$PKGS"/*.apk
-flock "$LOCK" podman run --rm --arch arm64 \
-	-v "$PMAPORTS:/src:ro,Z" -v "$PKGS:/out:Z" -v "$work:/s:ro,Z" \
-	"$IMAGE" /s/build.sh
+fwmount=""
+[ -d "$FWDIR" ] && fwmount="-v $FWDIR:/firmware:ro,Z"
+# shellcheck disable=SC2086
+flock "$LOCK" nice -n 19 podman run --rm -e JOBS="$JOBS" \
+	-v "$PMAPORTS:/pmaports:ro,Z" -v "$HERE:/contrib:ro,Z" $fwmount \
+	-v "$DISTFILES:/distfiles:Z" -v "$work/repo:/repo:Z" -v "$work:/s:Z" \
+	-v "$work/out:/out:Z" \
+	"$BUILDER" /s/build.sh "$@"
+
+# Replace only the packages that were rebuilt (and their old versions)
+for apk in "$work"/out/*.apk; do
+	[ -e "$apk" ] || continue
+	n=$(basename "$apk" | sed 's/-[0-9][^-]*-r[0-9]*\.apk$//')
+	rm -f "$PKGS/$n"-[0-9]*.apk
+	cp "$apk" "$PKGS/"
+done
 ls -l "$PKGS"
