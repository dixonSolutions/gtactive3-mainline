-# all heavy steps take the shared build/kbuild.lock themselves
-cd build/wt/duranium
-contrib/samsung-gtactive3wifi/build-image.sh            # phosh, edge
-UI=plasma-mobile contrib/samsung-gtactive3wifi/build-image.sh
