diff --git a/contrib/samsung-gtactive3wifi/firmware/APKBUILD b/contrib/samsung-gtactive3wifi/firmware/APKBUILD
new file mode 100644
index 0000000..396e5e1
--- /dev/null
+++ b/contrib/samsung-gtactive3wifi/firmware/APKBUILD
@@ -0,0 +1,44 @@
+# LOCAL-ONLY firmware package for the Galaxy Tab Active3 (gtactive3-mainline).
+#
+# This recipe contains no firmware. It packages the vendor firmware that the
+# user extracted from their own stock T570XXSFEYI1 package
+# (gtactive3-mainline firmware/extracted/linux-firmware, staged under the
+# names the mainline drivers request, see firmware/extracted/INDEX.md), read
+# at build time from $GTA3_FIRMWARE_DIR. Samsung's firmware is proprietary:
+# never commit the files, the built .apk, or a copy of this aport with the
+# files next to it, and never upload the .apk to a public repository.
+#
+# install_if: apk installs it automatically next to the device package when
+# it is available in a repository (the local package directory that
+# contrib/samsung-gtactive3wifi/build-apks.sh hands to mkosi), and images
+# built without it simply do not get it.
+pkgname=firmware-samsung-gtactive3wifi
+pkgver=20251001
+pkgrel=0
+pkgdesc="Samsung Galaxy Tab Active3 vendor firmware (local build, not redistributable)"
+url="https://github.com/dixonSolutions/gtactive3-mainline"
+arch="noarch"
+license="proprietary"
+options="!check !strip !tracedeps !archcheck"
+install_if="device-samsung-gtactive3wifi"
+source=""
+
+: "${GTA3_FIRMWARE_DIR:?set GTA3_FIRMWARE_DIR to firmware/extracted/linux-firmware/lib/firmware}"
+
+# Everything that has a kernel driver (in mainline or one of the
+# gtactive3-mainline driver tracks): Wi-Fi/BT (brcmfmac, btbcm), touch
+# (Himax), S Pen (Wacom), NFC, speaker amp, ABOX, MFC, VTS, voice DSP, grip
+# sensor, ACPM TMU plugin, GNSS hub. The camera ISP libraries (15 MB, no
+# driver) are left out.
+_exclude="samsung/gtactive3wifi/camera"
+
+package() {
+	local f rel
+	cd "$GTA3_FIRMWARE_DIR"
+	find . -type f | sort | while read -r f; do
+		rel=${f#./}
+		case "$rel" in $_exclude/*) continue ;; esac
+		install -Dm644 "$rel" "$pkgdir/usr/lib/firmware/$rel"
+	done
+	test -f "$pkgdir/usr/lib/firmware/brcm/brcmfmac4375b1-pcie.samsung,gtactive3wifi.bin"
+}
diff --git a/contrib/samsung-gtactive3wifi/kernel/gen-kernel-config.sh b/contrib/samsung-gtactive3wifi/kernel/gen-kernel-config.sh
new file mode 100755
index 0000000..0b45a2d
--- /dev/null
+++ b/contrib/samsung-gtactive3wifi/kernel/gen-kernel-config.sh
@@ -0,0 +1,72 @@
+#!/bin/sh
+# Generate the linux-postmarketos-exynos9810 kernel config from the bring-up
+# config that runs on the device, the pmbootstrap kconfigcheck fragment and
+# the device fragment (gtactive3wifi.config), then check it.
+#
+#   base      : build/bringup/.config (the lead's live-tested config, from
+#               configs/gtactive3-bringup.config)
+#   fragments : pmos-deps.config, pmos-fragment.config, gtactive3wifi.config
+#               (in this order; later ones win, except that an "=m" from the
+#               pmOS fragment never downgrades a "=y")
+#   source    : git archive of src/linux $KREF (default gtactive3wifi), which
+#               is tree-identical to the aport's tarball + patches
+#   output    : <pmaports>/device/testing/linux-postmarketos-exynos9810/
+#               config-postmarketos-exynos9810.aarch64
+#
+# olddefconfig runs in the package builder container (same cross compiler
+# and pahole as the package build, so CONFIG_DEBUG_INFO_BTF survives).
+# Fails if any line of gtactive3wifi.config did not survive olddefconfig, or
+# if the pmbootstrap kconfigcheck categories of the APKBUILD do not pass.
+set -eu
+
+HERE=$(cd "$(dirname "$0")" && pwd)
+ROOT=${GTA3_ROOT:-/home/borysthebear/Projects/gtactive3-mainline}
+KREF=${KREF:-gtactive3wifi}
+BASE=${BASE:-$ROOT/build/bringup/.config}
+PMAPORTS=${PMAPORTS:-$ROOT/build/wt/pmaports-duranium}
+APORT=$PMAPORTS/device/testing/linux-postmarketos-exynos9810
+OUTCFG=$APORT/config-postmarketos-exynos9810.aarch64
+LOCK=$ROOT/build/kbuild.lock
+BUILDER=${BUILDER:-gta3-pkgbuilder}
+
+podman image exists "$BUILDER" ||
+	podman build -t "$BUILDER" -f "$HERE/../pkgbuilder.Containerfile" "$HERE/.."
+
+work=$(mktemp -d)
+[ -n "${KEEP:-}" ] && echo "work: $work" || trap 'rm -rf "$work"' EXIT
+mkdir -p "$work/src" "$work/out" "$work/in"
+git -C "$ROOT/src/linux" archive "$KREF" | tar -x -C "$work/src"
+cp "$BASE" "$work/in/base.config"
+cp "$HERE"/mergecfg.py "$HERE"/pmos-deps.config "$HERE"/pmos-fragment.config \
+	"$HERE"/gtactive3wifi.config "$work/in/"
+
+flock "$LOCK" nice -n 19 podman run --rm \
+	-v "$work:/w:Z" -w /w/src "$BUILDER" sh -euc '
+	python3 /w/in/mergecfg.py /w/in/base.config /w/out/.config \
+		/w/in/pmos-deps.config /w/in/pmos-fragment.config /w/in/gtactive3wifi.config
+	make -s O=/w/out ARCH=arm64 CROSS_COMPILE=aarch64-alpine-linux-musl- olddefconfig
+	'
+
+missing=$(grep -E '^(CONFIG_[A-Za-z0-9_]+=|# CONFIG_[A-Za-z0-9_]+ is not set)' "$HERE/gtactive3wifi.config" |
+	while IFS= read -r line; do
+		case "$line" in
+		"# "*)	sym=${line#\# }; sym=${sym%% *}
+			grep -q "^$sym=[ym]" "$work/out/.config" && echo "$line" ;;
+		*)	grep -qxF "$line" "$work/out/.config" || echo "$line" ;;
+		esac
+	done)
+if [ -n "$missing" ]; then
+	echo "gtactive3wifi.config lines not applied by olddefconfig:" >&2
+	printf '  %s\n' "$missing" >&2
+	exit 1
+fi
+
+pkgver=$(sed -n 's/^pkgver=//p' "$APORT/APKBUILD")
+# shellcheck disable=SC2016
+cats=$(sh -c '. "$1/APKBUILD"; echo $options' sh "$APORT" | tr ' ' '\n' |
+	sed -n 's/^pmb:kconfigcheck-//p' | tr '\n' ' ')
+KCATS="$cats" python3 -I "$HERE/kcheck.py" "$ROOT/src/pmbootstrap" \
+	"$PMAPORTS/kconfigcheck.toml" "${pkgver%%_*}" "$work/out/.config"
+
+cp "$work/out/.config" "$OUTCFG"
+echo "config: $OUTCFG"
diff --git a/contrib/samsung-gtactive3wifi/kernel/gtactive3wifi.config b/contrib/samsung-gtactive3wifi/kernel/gtactive3wifi.config
new file mode 100644
index 0000000..3f8df8e
--- /dev/null
+++ b/contrib/samsung-gtactive3wifi/kernel/gtactive3wifi.config
@@ -0,0 +1,246 @@
+# Device kconfig fragment for postmarketOS (regular and Duranium) on the
+# Samsung Galaxy Tab Active3 Wi-Fi (SM-T570, samsung-gtactive3wifi).
+#
+# Applied last, on top of
+#   1. the bring-up config the lead runs on the device (build/bringup/.config,
+#      generated from configs/gtactive3-bringup.config),
+#   2. pmos-deps.config + pmos-fragment.config (pmbootstrap kconfigcheck
+#      categories of the linux-postmarketos-exynos9810 APKBUILD),
+# by gen-kernel-config.sh, which also checks that every line below survived
+# olddefconfig. Covers what systemd, Duranium (UKI + systemd-boot, dm-verity
+# /usr on erofs, LUKS root, nested GPT on a loop device) and the
+# duranium-usb-debug layer need, plus what the regular pmOS boot.img
+# pipeline (uniLoader + boot-deploy) needs.
+
+# --- no built-in initramfs ---
+# The bring-up .config embeds the nolibc init cpio (build/initramfs.list:
+# "dir /lib", /init, /lib/modules/*.ko). The kernel would unpack it before the
+# UKI's initrd, and the mkosi initrd's "lib -> usr/lib" symlink could then not
+# replace the non-empty /lib: no ELF interpreter, "No working init found".
+CONFIG_INITRAMFS_SOURCE=""
+CONFIG_BLK_DEV_INITRD=y
+CONFIG_RD_GZIP=y
+CONFIG_RD_ZSTD=y
+CONFIG_RD_LZ4=y
+
+# --- command line: from the UKI (.cmdline, via systemd-stub) or the boot
+#     image (uniLoader); this is only the fallback ---
+# CONFIG_CMDLINE_FORCE is not set
+CONFIG_CMDLINE_FROM_BOOTLOADER=y
+CONFIG_CMDLINE="console=tty0 fbcon=rotate:3 clk_ignore_unused maxcpus=4 loglevel=7"
+CONFIG_LOCALVERSION=""
+
+# --- UEFI: S-Boot -> uniLoader -> U-Boot -> systemd-boot -> UKI ---
+# pmaports' "uefi" kconfigcheck category minus EFI_ZBOOT: keep a plain arm64
+# Image (PE/COFF), which systemd-stub boots and uniLoader can still chain
+# directly (it reads the image size from the PE header).
+CONFIG_EFI=y
+CONFIG_EFI_STUB=y
+CONFIG_EFI_GENERIC_STUB=y
+CONFIG_EFI_PARAMS_FROM_FDT=y
+CONFIG_EFI_RUNTIME_WRAPPERS=y
+CONFIG_EFI_ESRT=y
+CONFIG_EFIVAR_FS=y
+CONFIG_EFI_VARS_PSTORE=y
+CONFIG_DMI=y
+# CONFIG_EFI_ZBOOT is not set
+
+# --- systemd requirements (systemd README "REQUIREMENTS") ---
+CONFIG_CGROUPS=y
+CONFIG_MEMCG=y
+CONFIG_BLK_CGROUP=y
+CONFIG_CGROUP_SCHED=y
+CONFIG_CGROUP_PIDS=y
+CONFIG_CGROUP_FREEZER=y
+CONFIG_CGROUP_DEVICE=y
+CONFIG_CGROUP_CPUACCT=y
+CONFIG_CGROUP_BPF=y
+CONFIG_CPUSETS=y
+CONFIG_BPF=y
+CONFIG_BPF_SYSCALL=y
+CONFIG_BPF_JIT=y
+CONFIG_NAMESPACES=y
+CONFIG_USER_NS=y
+CONFIG_NET_NS=y
+CONFIG_PID_NS=y
+CONFIG_IPC_NS=y
+CONFIG_UTS_NS=y
+CONFIG_SYSVIPC=y
+CONFIG_POSIX_MQUEUE=y
+CONFIG_FHANDLE=y
+CONFIG_EPOLL=y
+CONFIG_SIGNALFD=y
+CONFIG_TIMERFD=y
+CONFIG_EVENTFD=y
+CONFIG_INOTIFY_USER=y
+CONFIG_FANOTIFY=y
+CONFIG_AUTOFS_FS=y
+CONFIG_TMPFS=y
+CONFIG_TMPFS_POSIX_ACL=y
+CONFIG_TMPFS_XATTR=y
+CONFIG_DEVTMPFS=y
+CONFIG_DEVTMPFS_MOUNT=y
+CONFIG_SECCOMP=y
+CONFIG_SECCOMP_FILTER=y
+CONFIG_KCMP=y
+CONFIG_CHECKPOINT_RESTORE=y
+CONFIG_PSI=y
+# CONFIG_PSI_DEFAULT_DISABLED is not set
+CONFIG_SECURITY=y
+CONFIG_SECURITYFS=y
+# CONFIG_SECURITY_DMESG_RESTRICT is not set
+CONFIG_UNIX=y
+CONFIG_INET=y
+CONFIG_IPV6=y
+CONFIG_PACKET=y
+CONFIG_NETLINK_DIAG=y
+CONFIG_UNIX98_PTYS=y
+CONFIG_VT=y
+CONFIG_VT_CONSOLE=y
+CONFIG_BINFMT_ELF=y
+CONFIG_BINFMT_SCRIPT=y
+CONFIG_MODULE_COMPRESS=y
+CONFIG_MODULE_COMPRESS_ZSTD=y
+CONFIG_MODULE_DECOMPRESS=y
+CONFIG_FW_LOADER=y
+CONFIG_FW_LOADER_COMPRESS=y
+CONFIG_FW_LOADER_COMPRESS_ZSTD=y
+CONFIG_KEYS=y
+
+# --- Duranium storage stack: nested GPT in userdata via a loop device,
+#     dm-verity /usr (erofs), LUKS root (ext4), vfat ESP. Built in so that
+#     the initrd does not depend on module load order for the root. ---
+CONFIG_BLK_DEV=y
+CONFIG_BLK_DEV_LOOP=y
+CONFIG_BLK_DEV_LOOP_MIN_COUNT=0
+CONFIG_PARTITION_ADVANCED=y
+CONFIG_EFI_PARTITION=y
+CONFIG_MSDOS_PARTITION=y
+CONFIG_MD=y
+CONFIG_BLK_DEV_DM=y
+CONFIG_DM_CRYPT=y
+CONFIG_DM_VERITY=y
+CONFIG_DM_UEVENT=y
+CONFIG_CRYPTO_XTS=y
+CONFIG_CRYPTO_CBC=y
+CONFIG_CRYPTO_AES=y
+CONFIG_CRYPTO_AES_ARM64_CE_BLK=y
+CONFIG_CRYPTO_SHA256=y
+CONFIG_CRYPTO_SHA512=y
+CONFIG_CRYPTO_USER_API_HASH=y
+CONFIG_CRYPTO_USER_API_SKCIPHER=y
+CONFIG_CRYPTO_USER_API_AEAD=y
+CONFIG_CRYPTO_HMAC=y
+CONFIG_CRYPTO_LZ4=y
+CONFIG_CRYPTO_ZSTD=y
+CONFIG_EXT4_FS=y
+CONFIG_EXT4_FS_POSIX_ACL=y
+CONFIG_EXT4_FS_SECURITY=y
+CONFIG_EROFS_FS=y
+CONFIG_EROFS_FS_XATTR=y
+CONFIG_EROFS_FS_POSIX_ACL=y
+CONFIG_EROFS_FS_ZIP=y
+CONFIG_EROFS_FS_ZIP_LZMA=y
+CONFIG_EROFS_FS_ZIP_DEFLATE=y
+CONFIG_EROFS_FS_ZIP_ZSTD=y
+CONFIG_VFAT_FS=y
+CONFIG_FAT_DEFAULT_UTF8=y
+CONFIG_NLS=y
+CONFIG_NLS_CODEPAGE_437=y
+CONFIG_NLS_ISO8859_1=y
+CONFIG_NLS_ASCII=y
+CONFIG_NLS_UTF8=y
+CONFIG_OVERLAY_FS=y
+CONFIG_BLK_DEV_NBD=y
+
+# --- UFS stays modular, as in the bring-up config: a UFS problem must not
+#     take USB networking (and the debug layer) down. The clocks are the
+#     bootloader's (fixed clocks in DT). ---
+CONFIG_SCSI_UFSHCD=m
+CONFIG_SCSI_UFSHCD_PLATFORM=m
+CONFIG_SCSI_UFS_EXYNOS=m
+CONFIG_PHY_SAMSUNG_UFS=m
+
+# --- display: simpledrm on the S-Boot framebuffer (0xca000000) so phoc gets
+#     a KMS device; fbdev emulation keeps fbcon. Software rendering only
+#     (no Panfrost yet). ---
+CONFIG_DRM=y
+CONFIG_DRM_SIMPLEDRM=y
+CONFIG_DRM_FBDEV_EMULATION=y
+CONFIG_DRM_PANIC=y
+CONFIG_FB=y
+CONFIG_FRAMEBUFFER_CONSOLE=y
+CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
+# CONFIG_FB_SIMPLE is not set
+CONFIG_UDMABUF=y
+
+# --- input ---
+CONFIG_INPUT_EVDEV=y
+CONFIG_INPUT_UINPUT=y
+CONFIG_INPUT_MISC=y
+CONFIG_KEYBOARD_GPIO=y
+
+# --- USB device mode. The controller and PHY are modules: there is no clock
+#     driver yet, so their registers are only clocked after the USB gates are
+#     forced on (device package usb-prep in the Duranium initrd; uniLoader's
+#     bring-up quirks in the regular boot.img chain, where the pmOS initramfs
+#     loads them from modules-initfs). ---
+CONFIG_USB_SUPPORT=y
+CONFIG_USB_GADGET=y
+CONFIG_USB_LIBCOMPOSITE=y
+CONFIG_USB_CONFIGFS=y
+CONFIG_USB_CONFIGFS_NCM=y
+CONFIG_USB_CONFIGFS_RNDIS=y
+CONFIG_USB_CONFIGFS_ECM=y
+CONFIG_USB_CONFIGFS_ACM=y
+CONFIG_USB_CONFIGFS_MASS_STORAGE=y
+CONFIG_USB_CONFIGFS_F_FS=y
+CONFIG_USB_DWC3=m
+CONFIG_USB_DWC3_GADGET=y
+CONFIG_USB_DWC3_EXYNOS=m
+CONFIG_PHY_EXYNOS5_USBDRD=m
+
+# --- I2C (MAX77705 USB data switch at i2c-0 0x25 via i2c-dev) ---
+CONFIG_I2C=y
+CONFIG_I2C_CHARDEV=y
+CONFIG_I2C_EXYNOS5=m
+CONFIG_EXYNOS_USI=m
+
+# --- /dev/mem for the USB clock gates (no clock driver yet). MMIO only:
+#     RAM stays protected, and blocks claimed by drivers too. ---
+CONFIG_DEVMEM=y
+CONFIG_STRICT_DEVMEM=y
+# CONFIG_IO_STRICT_DEVMEM is not set
+
+# --- kernel log streaming over the USB network (duranium-usb-debug) ---
+CONFIG_NETCONSOLE=m
+CONFIG_NETCONSOLE_DYNAMIC=y
+CONFIG_PRINTK_TIME=y
+CONFIG_MAGIC_SYSRQ=y
+
+# --- watchdog (live-tested): U-Boot arms the cluster 0 watchdog, the kernel
+#     keeps it alive until systemd (RuntimeWatchdogSec) opens /dev/watchdog0 ---
+CONFIG_WATCHDOG=y
+CONFIG_WATCHDOG_CORE=y
+CONFIG_WATCHDOG_SYSFS=y
+CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
+CONFIG_S3C2410_WATCHDOG=y
+
+# --- bring-up safety net: stalls and oopses panic, a panic resets after 3 s
+#     (into Download mode: INFORM3 is set by uniLoader/U-Boot) ---
+CONFIG_SOFTLOCKUP_DETECTOR=y
+CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=1
+CONFIG_DETECT_HUNG_TASK=y
+CONFIG_PANIC_ON_OOPS=y
+CONFIG_PANIC_TIMEOUT=3
+
+# --- no suspend: PSCI v0.1 and no SoC PM drivers yet; a failed resume would
+#     be a silent hang. Runtime PM would let ufshcd/dwc3 power down blocks
+#     whose clocks and power domains have no driver. ---
+# CONFIG_SUSPEND is not set
+# CONFIG_HIBERNATION is not set
+# CONFIG_PM is not set
+
+# --- interactive desktop basics (the bring-up config is tinyconfig-like) ---
+CONFIG_HIGH_RES_TIMERS=y
+CONFIG_NO_HZ_IDLE=y
diff --git a/contrib/samsung-gtactive3wifi/kernel/kcheck.py b/contrib/samsung-gtactive3wifi/kernel/kcheck.py
new file mode 100644
index 0000000..8e66cd9
--- /dev/null
+++ b/contrib/samsung-gtactive3wifi/kernel/kcheck.py
@@ -0,0 +1,16 @@
+# kcheck.py PMBOOTSTRAP_DIR KCONFIGCHECK_TOML PKGVER CONFIG
+# Check a kernel config with pmbootstrap's own kconfig checker against the
+# pmb:kconfigcheck-* categories listed in $KCATS (space separated).
+import os, sys, logging
+from pathlib import Path
+pmb_dir, toml, ver, cfg = sys.argv[1:5]
+sys.path.insert(0, pmb_dir)
+import pmb.parse.kconfigcheck as kc
+import pmb.parse.kconfig as k
+from pmb.core.arch import Arch
+kc.get_path = lambda: Path(toml)
+logging.basicConfig(level=logging.INFO, format="%(message)s")
+cats = os.environ.get("KCATS", "").split()
+ok = k.check_config(Path(cfg), Arch.aarch64, ver, cats, details=True)
+print("kconfigcheck", " ".join(cats) or "(default only)", ":", "PASS" if ok else "FAIL")
+sys.exit(0 if ok else 1)
diff --git a/contrib/samsung-gtactive3wifi/kernel/mergecfg.py b/contrib/samsung-gtactive3wifi/kernel/mergecfg.py
new file mode 100644
index 0000000..afcc8cf
--- /dev/null
+++ b/contrib/samsung-gtactive3wifi/kernel/mergecfg.py
@@ -0,0 +1,27 @@
+# mergecfg.py BASE OUT FRAG... : apply fragments in order; "=m" never downgrades "=y"
+import re, sys
+base, out, frags = sys.argv[1], sys.argv[2], sys.argv[3:]
+lines = open(base).read().splitlines()
+idx, vals = {}, {}
+pat_set = re.compile(r'^(CONFIG_[A-Za-z0-9_]+)=(.*)$')
+pat_unset = re.compile(r'^# (CONFIG_[A-Za-z0-9_]+) is not set$')
+for i, l in enumerate(lines):
+    m = pat_set.match(l) or pat_unset.match(l)
+    if m:
+        idx[m.group(1)] = i
+        vals[m.group(1)] = m.group(2) if pat_set.match(l) else 'n'
+for f in frags:
+    for l in open(f).read().splitlines():
+        m = pat_set.match(l); u = pat_unset.match(l)
+        if not (m or u):
+            continue
+        sym = (m or u).group(1); new = m.group(2) if m else 'n'
+        if new == 'm' and vals.get(sym) == 'y' and 'pmos-fragment' in f:
+            continue
+        txt = l
+        vals[sym] = new
+        if sym in idx:
+            lines[idx[sym]] = txt
+        else:
+            idx[sym] = len(lines); lines.append(txt)
+open(out, 'w').write('\n'.join(lines) + '\n')
