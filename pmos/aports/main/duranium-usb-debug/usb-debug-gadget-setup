#!/bin/sh
# Bring up the Duranium USB debug NCM network interface. Matches the SM-T570
# bring-up init (gtactive3-mainline initramfs/init.c, setup_gadget/ifup): same
# VID/PID and fixed MAC addresses, so the device keeps the IPv6 link-local
# fe80::57:aff:fe00:1 and the host keeps fe80::57:aff:fe00:2 across reboots,
# and the existing host tools (scripts/tab, tab-get, tab-put) keep working.
#
# Device-specific preparation (e.g. clock gates or a USB data switch that
# must be set before the controller probes) is the device package's job and
# is ordered before this unit (Before=duranium-usb-debug.service).
set -eu

CONFIGFS=/sys/kernel/config/usb_gadget
GADGET=$CONFIGFS/g_debug
HOST_MAC="02:57:0a:00:00:02"
DEV_MAC="02:57:0a:00:00:01"

# The UDC appears asynchronously once dwc3 has probed (deferred probing, PHY
# first), so wait for it like the bring-up init does (init.c setup_gadget,
# 5 s) with some margin.
for _ in $(seq 1 100); do
    [ -n "$(ls /sys/class/udc 2>/dev/null)" ] && break
    sleep 0.1
done
if [ -z "$(ls /sys/class/udc 2>/dev/null)" ]; then
    echo "duranium-usb-debug: no UDC after 10 s, skipping"
    exit 0
fi

modprobe libcomposite 2>/dev/null || true
if ! mountpoint -q /sys/kernel/config; then
    mount -t configfs none /sys/kernel/config
fi

# Already configured (e.g. carried over from the initrd): nothing to do
if [ -e "$GADGET/UDC" ] && [ -n "$(cat "$GADGET/UDC" 2>/dev/null)" ]; then
    exit 0
fi

mkdir -p "$GADGET"
echo 0x1d6b > "$GADGET/idVendor"	# Linux Foundation
echo 0x0104 > "$GADGET/idProduct"	# Multifunction composite gadget
echo 0x0200 > "$GADGET/bcdUSB"
mkdir -p "$GADGET/strings/0x409"
echo "postmarketOS"                 > "$GADGET/strings/0x409/manufacturer"
echo "Duranium Debug (Tab Active3)" > "$GADGET/strings/0x409/product"
echo "gtactive3-duranium-debug"     > "$GADGET/strings/0x409/serialnumber"

mkdir -p "$GADGET/functions/ncm.usb0"
echo "$HOST_MAC" > "$GADGET/functions/ncm.usb0/host_addr"
echo "$DEV_MAC"  > "$GADGET/functions/ncm.usb0/dev_addr"

mkdir -p "$GADGET/configs/c.1/strings/0x409"
echo "Debug NCM" > "$GADGET/configs/c.1/strings/0x409/configuration"
ln -sf "$GADGET/functions/ncm.usb0" "$GADGET/configs/c.1/"

udc=$(ls /sys/class/udc | head -1)
if ! echo "$udc" > "$GADGET/UDC"; then
    # e.g. another gadget (Duranium's rescue gadget g1) already owns the UDC
    echo "duranium-usb-debug: cannot bind $udc (busy?)"
    exit 1
fi

# Wait for the interface, then bring it up. The fixed MAC gives the stable
# fe80:: link-local address that matches the bring-up console.
iface=""
for _ in $(seq 1 20); do
    iface=$(cat "$GADGET/functions/ncm.usb0/ifname" 2>/dev/null || true)
    [ -n "$iface" ] && break
    sleep 0.1
done
if [ -z "$iface" ]; then
    echo "duranium-usb-debug: gadget interface did not appear"
    exit 1
fi
ip link set "$iface" up
echo "$iface" > /run/duranium-usb-debug.iface
echo "duranium-usb-debug: up on $iface (fe80::57:aff:fe00:1)"
