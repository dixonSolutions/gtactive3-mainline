# DURANIUM USB DEBUG LAYER (gtactive3-mainline Duranium track).
#
# A separate, development-only package so release images can simply drop it.
# It is installed into the base image for the device (dev images) and its
# initramfs subpackage goes into the mkosi initrd via pmaports.py's
# InitrdPackages handling.
maintainer="dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>"
pkgname=duranium-usb-debug
pkgver=1
pkgrel=6
pkgdesc="Duranium development USB debug layer: NCM gadget, root console, ssh, kernel log"
url="https://github.com/dixonSolutions/gtactive3-mainline"
arch="noarch"
license="GPL-3.0-or-later"
# The -initramfs subpackage carries the gadget setup and the console, which
# the booted system needs too, hence the hard dependency on it.
# busybox-extras: telnetd; openssh-server (sshd -i) + openssh-keygen;
# iproute2 for "ip"; kmod for modprobe (libcomposite etc).
depends="
	$pkgname-initramfs=$pkgver-r$pkgrel
	busybox-extras
	iproute2
	kmod
	openssh-server
	openssh-keygen
"
subpackages="$pkgname-initramfs:initramfs $pkgname-adb:adb"
source="
	usb-debug-gadget-setup
	usb-debug-gadget-teardown
	usb-debug-sshd-keygen
	sshd_config
	duranium-usb-debug.target
	duranium-usb-debug.service
	duranium-debug-shell.socket
	duranium-debug-shell@.service
	duranium-debug-sshd.socket
	duranium-debug-sshd@.service
	duranium-debug-sockets.service
	duranium-debug-klog.socket
	duranium-debug-klog@.service
	80-duranium-usb-debug.preset
	initramfs-duranium-usb-debug.preset
	60_duranium_usb_debug.nft
	10-duranium-usb-debug.link
	90-duranium-usb-debug-sockets.rules
	50-duranium-usb-debug-nm.conf
	40-duranium-usb-debug-watchdog.conf
	usb-debug-adb-attach
	duranium-debug-adb.service
	duranium-debug-adbd.service
	80-duranium-usb-debug-adb.preset
	README
"
options="!check"

package() {
	install -Dm755 "$srcdir"/usb-debug-gadget-setup \
		"$pkgdir"/usr/libexec/duranium/usb-debug-gadget-setup
	install -Dm755 "$srcdir"/usb-debug-gadget-teardown \
		"$pkgdir"/usr/libexec/duranium/usb-debug-gadget-teardown
	install -Dm755 "$srcdir"/usb-debug-sshd-keygen \
		"$pkgdir"/usr/libexec/duranium/usb-debug-sshd-keygen

	install -Dm644 "$srcdir"/sshd_config \
		"$pkgdir"/etc/duranium-usb-debug/sshd_config

	for u in duranium-usb-debug.target duranium-usb-debug.service \
		 duranium-debug-shell.socket duranium-debug-shell@.service \
		 duranium-debug-sshd.socket duranium-debug-sshd@.service \
		 duranium-debug-klog.socket duranium-debug-klog@.service \
		 duranium-debug-sockets.service; do
		install -Dm644 "$srcdir/$u" -t "$pkgdir"/usr/lib/systemd/system/
	done

	install -Dm644 "$srcdir"/80-duranium-usb-debug.preset \
		"$pkgdir"/usr/lib/systemd/system-preset/80-duranium-usb-debug.preset

	# firewall rule (only matters when postmarketos-config-nftables is used)
	install -Dm644 "$srcdir"/60_duranium_usb_debug.nft \
		"$pkgdir"/usr/share/nftables.avail/60_duranium_usb_debug.nft
	mkdir -p "$pkgdir"/etc/nftables.d
	ln -s /usr/share/nftables.avail/60_duranium_usb_debug.nft \
		"$pkgdir"/etc/nftables.d/60_duranium_usb_debug.nft

	install -Dm644 "$srcdir"/10-duranium-usb-debug.link \
		-t "$pkgdir"/usr/lib/systemd/network/
	install -Dm644 "$srcdir"/90-duranium-usb-debug-sockets.rules \
		-t "$pkgdir"/usr/lib/udev/rules.d/
	install -Dm644 "$srcdir"/50-duranium-usb-debug-nm.conf \
		-t "$pkgdir"/usr/lib/NetworkManager/conf.d/
	install -Dm644 "$srcdir"/40-duranium-usb-debug-watchdog.conf \
		"$pkgdir"/usr/lib/systemd/system.conf.d/40-duranium-usb-debug.conf

	install -Dm644 "$srcdir"/README \
		"$pkgdir"/usr/share/doc/$pkgname/README
}

# The parts that must already exist in the mkosi initrd: the NCM interface,
# the telnet console and the kernel log stream, so pre-switch-root failures
# are debuggable over USB.
initramfs() {
	pkgdesc="$pkgdesc (initramfs)"
	depends="busybox-extras iproute2 kmod"

	amove usr/libexec/duranium/usb-debug-gadget-setup
	amove usr/libexec/duranium/usb-debug-gadget-teardown
	amove usr/lib/systemd/system/duranium-usb-debug.target
	amove usr/lib/systemd/system/duranium-usb-debug.service
	amove usr/lib/systemd/system/duranium-debug-shell.socket
	amove usr/lib/systemd/system/duranium-debug-shell@.service
	amove usr/lib/systemd/system/duranium-debug-klog.socket
	amove usr/lib/systemd/system/duranium-debug-klog@.service
	# unit files only (sshd itself is not in the initrd; the socket has
	# ConditionPathExists=!/etc/initrd-release), so that the target's Also=
	# list resolves in both the initrd and the booted system
	amove usr/lib/systemd/system/duranium-debug-sshd.socket
	amove usr/lib/systemd/system/duranium-debug-sshd@.service
	amove usr/lib/systemd/network/10-duranium-usb-debug.link
	amove usr/lib/udev/rules.d/90-duranium-usb-debug-sockets.rules
	amove usr/lib/systemd/system.conf.d/40-duranium-usb-debug.conf

	install -Dm644 "$srcdir"/initramfs-duranium-usb-debug.preset \
		"$subpkgdir"/usr/lib/systemd/initrd-preset/80-duranium-usb-debug.preset
}

# adb on the debug gadget: adbd (from the art_standalone port, ~30 MB with
# its runtime) lives only in the booted system, never in the initrd. It
# attaches an adb FunctionFS function next to NCM ("adb shell", "adb push").
adb() {
	pkgdesc="$pkgdesc (adb function)"
	depends="$pkgname=$pkgver-r$pkgrel adbd"

	install -Dm755 "$srcdir"/usb-debug-adb-attach \
		"$subpkgdir"/usr/libexec/duranium/usb-debug-adb-attach
	install -Dm644 "$srcdir"/duranium-debug-adb.service \
		"$srcdir"/duranium-debug-adbd.service \
		-t "$subpkgdir"/usr/lib/systemd/system/
	install -Dm644 "$srcdir"/80-duranium-usb-debug-adb.preset \
		"$subpkgdir"/usr/lib/systemd/system-preset/80-duranium-usb-debug-adb.preset
}

