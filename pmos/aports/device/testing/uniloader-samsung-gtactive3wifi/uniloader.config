# Appended to configs/gtactive3wifi_defconfig: a uniLoader binary that is
# independent of the kernel and initramfs. boot-deploy appends the Image and
# DTB ("vmlinuz-dtb"), S-Boot loads the boot image ramdisk (the initramfs).
# CONFIG_EMBED_LINUX is not set
# CONFIG_COMPRESS_GZIP is not set
CONFIG_APPENDED_PAYLOAD=y
CONFIG_PAYLOAD_BOOTARGS_ALLOW="pmos. pmos_ PMOS_ console= fbcon= loglevel= clk_ignore_unused maxcpus= printk. rd. init= root= rootfstype= rootwait ro rw quiet splash debug ignore_loglevel initcall_debug panic="
CONFIG_GTACTIVE3WIFI_BRINGUP_QUIRKS=y
CONFIG_GTACTIVE3WIFI_RESET_TO_DOWNLOAD=y
