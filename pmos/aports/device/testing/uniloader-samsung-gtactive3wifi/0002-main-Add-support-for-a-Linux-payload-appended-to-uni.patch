diff --git a/main/boot-payload.c b/main/boot-payload.c
new file mode 100644
index 0000000..345ad2a
--- /dev/null
+++ b/main/boot-payload.c
@@ -0,0 +1,332 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Boot a Linux Image + DTB appended to the uniLoader binary, with the initrd
+ * (and selected command line words) taken from the previous bootloader.
+ *
+ * Layout of what the previous bootloader loaded, starting at _start:
+ *
+ *   [ uniLoader ... _bin_end ][ arm64 Image ][ DTB ]
+ *
+ * The Image size is not stored anywhere in a plain "cat", so it is taken
+ * from the PE/COFF header of an EFI stub kernel, or else the DTB is searched
+ * for after the Image header.
+ */
+
+#ifndef __aarch64__
+#error "CONFIG_APPENDED_PAYLOAD is only supported on aarch64"
+#endif
+
+#include <lib/debug.h>
+#include <lib/libfdt/libfdt.h>
+#include <lib/nanoprintf.h>
+#include <main/boot.h>
+#include <main/boot-fdt.h>
+#include <string.h>
+
+#define ARM64_IMAGE_MAGIC	0x644d5241	/* "ARM\x64" */
+#define CMDLINE_MAX		2048		/* arm64 COMMAND_LINE_SIZE */
+#define DTB_MAX_SIZE		(4UL << 20)
+
+/* Set by start.S before main() */
+unsigned long payload_prev_fdt;
+unsigned long payload_load_start;
+
+extern char _uniloader_start[], _start[], _bin_end[], _stack_end[];
+
+static char cmdline[CMDLINE_MAX];
+/* What the previous bootloader handed over, for /chosen/uniloader,payload */
+static unsigned long prev_initrd_start, prev_initrd_end;
+
+/*
+ * Called when the payload cannot be booted. main() hangs afterwards, so a
+ * board can override this to reset into a recovery path instead.
+ */
+void __attribute__((weak)) payload_boot_failed(void)
+{
+}
+
+static unsigned long ld_le(const unsigned char *p, int n)
+{
+	unsigned long v = 0;
+
+	while (n--)
+		v = (v << 8) | p[n];
+	return v;
+}
+
+static unsigned long round16(unsigned long v)
+{
+	return (v + 15) & ~15UL;
+}
+
+static int overlaps(unsigned long a, unsigned long alen,
+		    unsigned long b, unsigned long blen)
+{
+	return a < b + blen && b < a + alen;
+}
+
+static int fdt_plausible(const void *fdt)
+{
+	return fdt_magic(fdt) == FDT_MAGIC && !fdt_check_header(fdt) &&
+	       fdt_totalsize(fdt) <= DTB_MAX_SIZE;
+}
+
+/* File size of an EFI stub Image: end of the last PE section, or 0 */
+static unsigned long pe_file_size(const unsigned char *img, unsigned long max)
+{
+	unsigned long pe, sec, nsec, size = 0, end, i;
+
+	if (img[0] != 'M' || img[1] != 'Z')
+		return 0;
+	pe = ld_le(img + 0x3c, 4);
+	if (pe + 24 > max || memcmp(img + pe, "PE\0\0", 4))
+		return 0;
+	nsec = ld_le(img + pe + 6, 2);
+	sec = pe + 24 + ld_le(img + pe + 20, 2);
+	for (i = 0; i < nsec && sec + 40 <= max; i++, sec += 40) {
+		end = ld_le(img + sec + 20, 4) + ld_le(img + sec + 16, 4);
+		if (end > size)
+			size = end;
+	}
+	return size <= max ? size : 0;
+}
+
+/* Find the DTB appended to the Image; returns the Image file size or 0 */
+static unsigned long find_appended_dtb(const unsigned char *img,
+				       unsigned long image_size)
+{
+	unsigned long off = pe_file_size(img, image_size);
+
+	if (off && !(off & 7) && fdt_plausible(img + off))
+		return off;
+
+	printk(KERN_WARNING, "payload: no PE size, searching for the DTB\n");
+	for (off = 64; off < image_size; off += 8) {
+		const void *fdt = img + off;
+
+		if (fdt_plausible(fdt) &&
+		    fdt_getprop(fdt, 0, "compatible", NULL))
+			return off;
+	}
+	return 0;
+}
+
+static int word_allowed(const char *w, int wlen)
+{
+	const char *a = CONFIG_PAYLOAD_BOOTARGS_ALLOW;
+	int alen;
+
+	while (*a) {
+		while (*a == ' ')
+			a++;
+		for (alen = 0; a[alen] && a[alen] != ' '; alen++)
+			;
+		if (alen) {
+			char last = a[alen - 1];
+			int prefix = last == '=' || last == '.' || last == '_';
+
+			if ((alen == wlen || (prefix && alen < wlen)) &&
+			    !strncmp(w, a, alen))
+				return 1;
+		}
+		a += alen;
+	}
+	return 0;
+}
+
+static void cmdline_append(const char *w, int wlen)
+{
+	int len = strlen(cmdline);
+
+	if (len + 1 + wlen + 1 > CMDLINE_MAX) {
+		printk(KERN_WARNING, "payload: command line full\n");
+		return;
+	}
+	if (len)
+		cmdline[len++] = ' ';
+	memcpy(cmdline + len, w, wlen);
+	cmdline[len + wlen] = 0;
+}
+
+/* Copy the allowed words of the previous bootloader's bootargs */
+static void import_bootargs(const char *args, int args_len)
+{
+	int i = 0, start;
+
+	while (i < args_len && args[i]) {
+		while (i < args_len && args[i] == ' ')
+			i++;
+		start = i;
+		while (i < args_len && args[i] && args[i] != ' ')
+			i++;
+		if (i > start && word_allowed(args + start, i - start))
+			cmdline_append(args + start, i - start);
+	}
+}
+
+static unsigned long fdt_get_addr(const void *fdt, int node, const char *name)
+{
+	const unsigned char *p;
+	int len;
+
+	p = fdt_getprop(fdt, node, name, &len);
+	if (!p)
+		return 0;
+	if (len == 8)
+		return ((unsigned long)fdt32_ld((const fdt32_t *)p) << 32) |
+		       fdt32_ld((const fdt32_t *)(p + 4));
+	if (len == 4)
+		return fdt32_ld((const fdt32_t *)p);
+	return 0;
+}
+
+/* Read initrd and bootargs from the FDT the previous bootloader passed */
+static void read_prev_fdt(unsigned long *initrd, unsigned long *initrd_size)
+{
+	const void *fdt = (const void *)payload_prev_fdt;
+	const char *args;
+	unsigned long start, end;
+	int node, len;
+
+	*initrd = *initrd_size = 0;
+	if (payload_prev_fdt < CONFIG_PAYLOAD_PREV_FDT_MIN ||
+	    payload_prev_fdt >= CONFIG_PAYLOAD_PREV_FDT_MAX ||
+	    (payload_prev_fdt & 7) || !fdt_plausible(fdt)) {
+		printk(KERN_WARNING, "payload: no FDT from the bootloader (x0=0x%lx)\n",
+		       payload_prev_fdt);
+		return;
+	}
+	node = fdt_path_offset(fdt, "/chosen");
+	if (node < 0) {
+		printk(KERN_WARNING, "payload: bootloader FDT has no /chosen\n");
+		return;
+	}
+
+	start = fdt_get_addr(fdt, node, "linux,initrd-start");
+	end = fdt_get_addr(fdt, node, "linux,initrd-end");
+	prev_initrd_start = start;
+	prev_initrd_end = end;
+	if (start && end > start) {
+		*initrd = start;
+		*initrd_size = end - start;
+	}
+	printk(KERN_INFO, "payload: bootloader FDT at 0x%lx, initrd 0x%lx-0x%lx\n",
+	       payload_prev_fdt, start, end);
+
+	args = fdt_getprop(fdt, node, "bootargs", &len);
+	if (args && len > 0)
+		import_bootargs(args, len);
+}
+
+static int set_chosen(void *fdt, unsigned long initrd_size)
+{
+	char info[128];
+	int node, ret;
+
+	node = fdt_path_offset(fdt, "/chosen");
+	if (node < 0)
+		node = fdt_add_subnode(fdt, 0, "chosen");
+	if (node < 0)
+		return node;
+
+	if (initrd_size) {
+		ret = fdt_setprop_u64(fdt, node, "linux,initrd-start",
+				      CONFIG_RAMDISK_ENTRY);
+		if (!ret)
+			ret = fdt_setprop_u64(fdt, node, "linux,initrd-end",
+					      CONFIG_RAMDISK_ENTRY + initrd_size);
+		if (ret)
+			return ret;
+	}
+	/* readable from Linux: /proc/device-tree/chosen/uniloader,payload */
+	npf_snprintf(info, sizeof(info), "prev-fdt=0x%lx initrd=0x%lx-0x%lx",
+		     payload_prev_fdt, prev_initrd_start, prev_initrd_end);
+	ret = fdt_setprop_string(fdt, node, "uniloader,payload", info);
+	if (ret)
+		return ret;
+	if (cmdline[0])
+		return fdt_setprop_string(fdt, node, "bootargs", cmdline);
+	return 0;
+}
+
+static void boot_payload_once(void)
+{
+	const unsigned char *img;
+	unsigned long image_size, text_offset, file_size;
+	unsigned long k_dst, k_len, r_src, r_len;
+	unsigned long self = (unsigned long)_uniloader_start;
+	unsigned long self_len = (unsigned long)_stack_end - self;
+	const void *dtb;
+	void *fdt = fdt_patch_buffer();
+	const char *base;
+	int ret, kernel_first;
+
+	img = (const unsigned char *)(payload_load_start +
+				      ((unsigned long)_bin_end - (unsigned long)_start));
+	if (ld_le(img + 56, 4) != ARM64_IMAGE_MAGIC) {
+		printk(KERN_ERR, "payload: no arm64 Image at %p\n", img);
+		return;
+	}
+	text_offset = ld_le(img + 8, 8);
+	image_size = ld_le(img + 16, 8);
+	file_size = find_appended_dtb(img, image_size);
+	if (!file_size) {
+		printk(KERN_ERR, "payload: no DTB after the Image\n");
+		return;
+	}
+	dtb = img + file_size;
+	printk(KERN_INFO, "payload: Image at %p (%lu bytes), DTB at %p\n",
+	       img, file_size, dtb);
+
+	/* Start from the appended DTB's command line, then import */
+	ret = fdt_path_offset(dtb, "/chosen");
+	base = ret < 0 ? NULL : fdt_getprop(dtb, ret, "bootargs", NULL);
+	if (base)
+		cmdline_append(base, strnlen(base, CMDLINE_MAX - 1));
+	read_prev_fdt(&r_src, &r_len);
+	printk(KERN_INFO, "payload: bootargs \"%s\"\n", cmdline);
+
+	ret = fdt_open_into(dtb, fdt, CONFIG_FDT_BUF_SIZE);
+	if (!ret)
+		ret = set_chosen(fdt, r_len);
+	if (ret) {
+		printk(KERN_ERR, "payload: patching the DTB failed: %s\n",
+		       fdt_strerror(ret));
+		return;
+	}
+
+	/* Destinations must not hit uniLoader itself or each other */
+	k_dst = CONFIG_PAYLOAD_ENTRY + text_offset;
+	k_len = round16(file_size);
+	if (overlaps(k_dst, image_size, self, self_len) ||
+	    (r_len && (overlaps(CONFIG_RAMDISK_ENTRY, r_len, self, self_len) ||
+		       overlaps(CONFIG_RAMDISK_ENTRY, r_len, k_dst, image_size)))) {
+		printk(KERN_ERR, "payload: kernel/initrd do not fit next to uniLoader\n");
+		return;
+	}
+
+	/* Copy in the order that does not overwrite the other source */
+	kernel_first = !r_len || !overlaps(k_dst, k_len, r_src, r_len);
+	if (!kernel_first &&
+	    overlaps(CONFIG_RAMDISK_ENTRY, r_len, (unsigned long)img, k_len)) {
+		printk(KERN_ERR, "payload: kernel and initrd sources collide\n");
+		return;
+	}
+	if (kernel_first)
+		memmove((void *)k_dst, img, k_len);
+	if (r_len && r_src != CONFIG_RAMDISK_ENTRY)
+		memmove((void *)CONFIG_RAMDISK_ENTRY, (void *)r_src, round16(r_len));
+	if (!kernel_first)
+		memmove((void *)k_dst, img, k_len);
+	if (!r_len)
+		printk(KERN_WARNING, "payload: booting without an initrd\n");
+
+	printk(KERN_INFO, "Booting kernel...\n");
+	load_kernel_and_jump(fdt, 0, 0, 0, (void *)k_dst);
+}
+
+void boot_payload(void)
+{
+	boot_payload_once();
+	payload_boot_failed();
+}
diff --git a/main/main.c b/main/main.c
index 579def3..3fe40c5 100644
--- a/main/main.c
+++ b/main/main.c
@@ -36,7 +36,11 @@ void main(void* dt, void* kernel, void* ramdisk)
 
 	INITCALL(board_ops.ops.late_init);
 
+#ifdef CONFIG_APPENDED_PAYLOAD
+	boot_payload();
+#else
 	boot_kernel(dt, kernel, ramdisk);
+#endif
 
 	// todo: reset the board?
 	printk(KERN_EMERG, "Something wrong happened, we shouldn't be here. Hanging....\n");
