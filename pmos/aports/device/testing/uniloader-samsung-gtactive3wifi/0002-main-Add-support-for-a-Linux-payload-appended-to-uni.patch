From 828ecb974e9aa5ac5a479fd5c76ab37c27323263 Mon Sep 17 00:00:00 2001
From: dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>
Date: Wed, 21 Oct 2026 16:03:51 +1100
Subject: [PATCH 2/3] main: Add support for a Linux payload appended to
 uniLoader

With CONFIG_APPENDED_PAYLOAD, uniLoader no longer embeds Linux at build
time. It boots an arm64 Image followed by its DTB that were appended to
the binary afterwards ("cat uniLoader Image board.dtb"), and takes the
initrd from the device tree the previous bootloader passed in x0
(linux,initrd-start/end), moving it to RAMDISK_ENTRY. Words of the
previous bootloader's bootargs that match CONFIG_PAYLOAD_BOOTARGS_ALLOW
are appended to the command line.

This lets distributions pack a generic uniLoader binary with whatever
kernel and initramfs they generate on the device, e.g. with
postmarketOS's boot-deploy (bootimg_override_payload plus an appended
"vmlinuz-dtb"), the ramdisk being the Android boot image's.

The Image size is read from the PE/COFF header of EFI stub kernels; for
other kernels the DTB is searched for after the Image header. Copies are
ordered so that neither source is overwritten, and are refused if a
destination would hit uniLoader itself.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Kconfig                   |  42 +++++
 arch/aarch64/linker.lds.S |  23 +++
 arch/aarch64/reloc.S      |   1 +
 arch/aarch64/start.S      |  17 ++
 include/main/boot-fdt.h   |   3 +
 include/main/boot.h       |   5 +
 main/Makefile             |   1 +
 main/boot-fdt.c           |   5 +
 main/boot-payload.c       | 332 ++++++++++++++++++++++++++++++++++++++
 main/main.c               |   4 +
 10 files changed, 433 insertions(+)
 create mode 100644 main/boot-payload.c

diff --git a/Kconfig b/Kconfig
index be6c890..60c28ca 100644
--- a/Kconfig
+++ b/Kconfig
@@ -66,6 +66,48 @@ menu "Building options"
 		help
 		  Select this if the bootloader copies the ramdisk itself
 
+	config APPENDED_PAYLOAD
+		bool "Boot a Linux Image and device tree appended to uniLoader"
+		depends on !EMBED_LINUX && LIBFDT
+		default n
+		help
+		  Instead of embedding Linux at build time, boot an arm64 Linux
+		  Image followed by its device tree blob, both appended to the
+		  uniLoader binary after the build:
+
+		    cat uniLoader Image board.dtb > payload
+
+		  The initrd is the one the previous bootloader loaded (for an
+		  Android boot image: its ramdisk), as described by
+		  linux,initrd-start/end in the device tree passed in x0. It is
+		  moved to RAMDISK_ENTRY. This way one uniLoader binary works with
+		  any kernel and initramfs, e.g. one generated on the device by a
+		  distribution. Only supported on aarch64.
+
+	config PAYLOAD_BOOTARGS_ALLOW
+		string "Command line words imported from the previous bootloader"
+		depends on APPENDED_PAYLOAD
+		default ""
+		help
+		  Space separated list. A word of the previous bootloader's
+		  /chosen/bootargs is appended to the command line of the
+		  appended device tree if it equals an entry, or if the entry
+		  ends with '=', '.' or '_' and the word starts with it
+		  (e.g. "console=" or "pmos."). Empty imports nothing.
+
+	config PAYLOAD_PREV_FDT_MIN
+		hex "Lowest valid address of the previous bootloader's FDT"
+		depends on APPENDED_PAYLOAD
+		default 0x80000000
+		help
+		  x0 is only dereferenced if it lies in [MIN, MAX), so a garbage
+		  value cannot fault before anything is printed.
+
+	config PAYLOAD_PREV_FDT_MAX
+		hex "End of the valid address range of the previous bootloader's FDT"
+		depends on APPENDED_PAYLOAD
+		default 0x100000000
+
 endmenu
 
 source "drivers/Kconfig"
diff --git a/arch/aarch64/linker.lds.S b/arch/aarch64/linker.lds.S
index de350f1..8dade11 100644
--- a/arch/aarch64/linker.lds.S
+++ b/arch/aarch64/linker.lds.S
@@ -15,15 +15,18 @@ OUTPUT_FORMAT("elf64-littleaarch64")
 OUTPUT_ARCH(aarch64)
 TARGET(binary)
 
+#ifdef CONFIG_EMBED_LINUX
 INPUT(KERNEL_PATH)
 INPUT(DTB_PATH)
 #ifndef CONFIG_RAMDISK_NO_COPY
 INPUT(RAMDISK_PATH)
 #endif
+#endif
 
 SECTIONS
 {
 	. = TEXT_BASE;
+	_uniloader_start = .;
 
 	.text : {
 #ifdef CONFIG_POSITION_INDEPENDENT
@@ -33,6 +36,7 @@ SECTIONS
 		*(.text.*)
 	}
 
+#ifdef CONFIG_EMBED_LINUX
 	.kernel ALIGN(4096) : {
 		kernel = .;
 		KERNEL_PATH
@@ -48,6 +52,7 @@ SECTIONS
 		ramdisk = .;
 		RAMDISK_PATH
 	}
+#endif
 #endif
 
 	.rodata ALIGN(8) : {
@@ -66,6 +71,18 @@ SECTIONS
 		*(.data.*)
 	}
 
+#ifdef CONFIG_APPENDED_PAYLOAD
+	/*
+	 * Last section with contents: pad the binary to 16 bytes so the
+	 * payload appended to it starts at _bin_end, suitably aligned.
+	 */
+	.bin_end : {
+		BYTE(0)
+		. = ALIGN(16);
+	}
+	_bin_end = .;
+#endif
+
 	.bss ALIGN(8) : {
 		__bss_start = .;
 		*(.bss)
@@ -83,12 +100,18 @@ SECTIONS
 #endif
 	}
 
+#ifdef CONFIG_EMBED_LINUX
 	kernel_size = SIZEOF(.kernel);
 #ifdef CONFIG_RAMDISK_NO_COPY
 	ramdisk_size = RAMDISK_SIZE;
 #else
 	ramdisk_size = SIZEOF(.ramdisk);
 #endif
+#else
+	/* nothing embedded; keeps the generic boot path linkable */
+	kernel_size = 0;
+	ramdisk_size = 0;
+#endif
 #ifdef CONFIG_POSITION_INDEPENDENT
 	_reloc_size = _reloc_end - _reloc_start;
 #endif
diff --git a/arch/aarch64/reloc.S b/arch/aarch64/reloc.S
index b6fb485..6a4d71b 100644
--- a/arch/aarch64/reloc.S
+++ b/arch/aarch64/reloc.S
@@ -27,6 +27,7 @@ ENTRY_ALIAS(_rel_stack_size)
 
 ENTRY_ALIAS( _reloc_entry)
 	adr	x4, _start
+	mov	x8, x4		/* load address of _start, see start.S */
 	ldr	x5, _rel_stack_base
 	cmp	x4, x5
 	beq	_entry
diff --git a/arch/aarch64/start.S b/arch/aarch64/start.S
index de454f9..604b499 100644
--- a/arch/aarch64/start.S
+++ b/arch/aarch64/start.S
@@ -23,6 +23,16 @@ _stack_size:
 .align 4
 #endif
 ENTRY(_start)
+#ifdef CONFIG_APPENDED_PAYLOAD
+	/* x0: FDT from the previous bootloader */
+	mov	x19, x0
+	/* where the previous bootloader put _start (reloc.S passes it in x8) */
+#ifdef CONFIG_POSITION_INDEPENDENT
+	mov	x20, x8
+#else
+	adr	x20, _start
+#endif
+#endif
 	/* Set up the base address for the stack */
 	adrp    x0, _stack_end      /* Load page of the _stack_end symbol */
 	add     x0, x0, #:lo12:_stack_end  /* Add the offset within the page */
@@ -43,6 +53,12 @@ ENTRY(_start)
 2:
 
 	/* Fall through */
+#ifdef CONFIG_APPENDED_PAYLOAD
+	adrp	x0, payload_prev_fdt
+	str	x19, [x0, #:lo12:payload_prev_fdt]
+	adrp	x0, payload_load_start
+	str	x20, [x0, #:lo12:payload_load_start]
+#else
 	adrp    x0, dtb             /* Load page of dtb */
 	add     x0, x0, #:lo12:dtb  /* Add offset within the page */
 	adrp    x1, kernel          /* Load page of kernel */
@@ -50,6 +66,7 @@ ENTRY(_start)
 #ifndef CONFIG_RAMDISK_NO_COPY
 	adrp    x2, ramdisk          /* Load page of kernel */
 	add     x2, x2, #:lo12:ramdisk /* Add offset within the page */
+#endif
 #endif
 
 	bl main
