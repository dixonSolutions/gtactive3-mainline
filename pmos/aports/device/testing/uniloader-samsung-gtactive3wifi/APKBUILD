maintainer="dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>"
pkgname=uniloader-samsung-gtactive3wifi
pkgver=0_git20261019
pkgrel=0
_commit="a459fb4c777ad9e1f3a433b14266423916f24e60"
pkgdesc="uniLoader for the Samsung Galaxy Tab Active3, booting an appended Linux payload"
url="https://github.com/ivoszbg/uniLoader"
arch="aarch64"
license="GPL-2.0-only"
options="!check !strip !tracedeps"
source="
	uniLoader-$_commit.tar.gz::https://github.com/ivoszbg/uniLoader/archive/$_commit.tar.gz
	0001-board-Add-support-for-Samsung-Galaxy-Tab-Active3-Wi-.patch
	0002-main-Add-support-for-a-Linux-payload-appended-to-uni.patch
	0003-board-samsung-gtactive3wifi-Add-bring-up-quirks-for-.patch
	uniloader.config
	"
builddir="$srcdir/uniLoader-$_commit"

prepare() {
	default_prepare
	cat configs/gtactive3wifi_defconfig "$srcdir"/uniloader.config \
		> configs/gtactive3wifi_pmos_defconfig
}

build() {
	# CROSS_COMPILE is empty for native builds, as uniLoader expects
	make HOSTCC=gcc ARCH=aarch64 CROSS_COMPILE="$CROSS_COMPILE" \
		gtactive3wifi_pmos_defconfig
	make HOSTCC=gcc ARCH=aarch64 CROSS_COMPILE="$CROSS_COMPILE"
}

package() {
	# mkinitfs copies /usr/share/u-boot/$deviceinfo_uboot_boardname/* into
	# the boot-deploy work dir, where bootimg_override_payload picks it up
	install -Dm644 uniLoader \
		"$pkgdir"/usr/share/u-boot/gtactive3wifi/uniLoader
	# regenerate boot.img when uniLoader changes
	mkdir -p "$pkgdir"/usr/share/mkinitfs-triggers
	touch "$pkgdir"/usr/share/mkinitfs-triggers/$pkgname
}

