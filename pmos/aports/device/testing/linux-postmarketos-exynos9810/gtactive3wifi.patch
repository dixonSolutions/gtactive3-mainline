+/*
+ * Binned mode windows, chosen with bin_crop (the analogue crop to 2048x1536
+ * gave about 740 lost-frame-start receiver errors per frame on the SM-T570,
+ * 2026-10-23):
+ *  0: stock 2064x1548 (x 0x30-0x104f, y 0x14-0xc2b), the default
+ *  1: 2048x1536 from a 4096x3072 analogue window
+ *  2: 2048x1536 output size from the stock window (the sensor drops the
+ *     last 16 columns and 12 rows)
+ */
+static int bin_crop;
+module_param(bin_crop, int, 0444);
+MODULE_PARM_DESC(bin_crop, "binned mode: 0 stock 2064x1548, 1 analogue 2048x1536, 2 output-size 2048x1536");
