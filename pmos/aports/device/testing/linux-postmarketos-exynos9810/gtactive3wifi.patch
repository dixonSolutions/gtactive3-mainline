 	.read_time	= s3c_rtc_gettime,
 	.set_time	= s3c_rtc_settime,
@@ -440,6 +460,8 @@ static int s3c_rtc_probe(struct platform_device *pdev)
 	if (info->data->enable)
 		info->data->enable(info);
 
