@@ -162,6 +163,7 @@ int panfrost_devfreq_init(struct panfrost_device *pfdev)
 	spin_lock_init(&pfdevfreq->lock);
 
 	panfrost_devfreq_reset(pfdevfreq);
+	pfdevfreq->sample_time = pfdevfreq->time_last_update;
 
 	cur_freq = clk_get_rate(pfdev->clock);
 
@@ -286,3 +288,35 @@ void panfrost_devfreq_record_idle(struct panfrost_devfreq *pfdevfreq)
 
 	spin_unlock_irqrestore(&pfdevfreq->lock, irqflags);
 }
+
+/*
+ * GPU load in percent since the previous call (amdgpu's gpu_busy_percent
+ * ABI, read by system monitors such as Resources). The first call reports
+ * the load since probe.
+ */
+int panfrost_devfreq_busy_percent(struct panfrost_devfreq *pfdevfreq)
+{
+	unsigned long irqflags;
+	s64 busy, total;
+	ktime_t now;
+
+	if (!pfdevfreq->devfreq)
+		return -ENODEV;
+
+	spin_lock_irqsave(&pfdevfreq->lock, irqflags);
+
+	panfrost_devfreq_update_utilization(pfdevfreq);
+
+	now = pfdevfreq->time_last_update;
+	busy = ktime_to_ns(ktime_sub(pfdevfreq->busy_total, pfdevfreq->sample_busy));
+	total = ktime_to_ns(ktime_sub(now, pfdevfreq->sample_time));
+	pfdevfreq->sample_busy = pfdevfreq->busy_total;
+	pfdevfreq->sample_time = now;
+
+	spin_unlock_irqrestore(&pfdevfreq->lock, irqflags);
+
+	if (total <= 0)
+		return 0;
+
+	return min_t(s64, div64_s64(busy * 100, total), 100);
+}
