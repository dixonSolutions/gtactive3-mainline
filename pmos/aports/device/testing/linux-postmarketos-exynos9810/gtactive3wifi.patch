+&soc {
+	/*
+	 * DECON0 + the IDMA channel S-Boot scans the panel out from
+	 * (stock decon_f@16030000, idma_* dma regs 0x16071000 + n * 0x1000).
+	 * Takeover driver: flips the buffer, keeps the panel/DSI setup.
+	 * Measured: window 5 (0..1199 x 0..1919) <- IDMA_G0, base 0xca000000,
+	 * SysMMU DPU0 in bypass.
+	 */
+	dpu: display-controller@16030000 {
+		compatible = "samsung,exynos9810-decon-takeover";
+		/* DECON, IDMA_G0 (boot scanout). Not yet: IDMA_VGRF 0x16076000 +
+		 * DPP_VGRF 0x16026000 for the gamma LUT; writing the HDR gamut
+		 * matrix while scanning out broke the panel stream (STATUS.md). */
+		reg = <0x16030000 0x10000>,
+		      <0x16071000 0x1000>;
+		interrupts = <GIC_SPI 182 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 183 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 188 IRQ_TYPE_LEVEL_HIGH>;
+		samsung,window = <5>;	/* S-Boot: window 5 <- IDMA_G0 */
+		width = <1200>;
+		height = <1920>;
+		/* 8.0" 16:10 panel, portrait */
+		width-mm = <108>;
+		height-mm = <172>;
+		refresh-rate = <60>;
+		/* gamma LUT through the panel (exynos9810-dsim-bl) */
+		samsung,panel-gamma;
+		status = "okay";
+	};
+};
+
+&spi_21 {
+	/* Software chip select, as in the stock firmware */
+	cs-gpios = <&gph0 7 GPIO_ACTIVE_LOW>;
+	pinctrl-0 = <&spi21_bus &spi21_cs>;
+	status = "okay";
+
+	/*
+	 * Touch part of the Himax HX83102E TDDI panel controller. It is
+	 * powered with the panel and runs firmware from its own flash.
+	 * Coordinates are reported in the panel's native portrait
+	 * orientation; use touchscreen-swapped-x-y / touchscreen-inverted-x/y
+	 * to match a rotated display.
+	 */
+	touchscreen@0 {
+		compatible = "himax,hx83102e";
+		reg = <0>;
+		spi-max-frequency = <10000000>; /* stock 7 MHz samples MISO a bit late here */
+		spi-cpha;
+		spi-cpol;
+		interrupt-parent = <&gpa1>;
+		interrupts = <0 IRQ_TYPE_EDGE_FALLING>;
+		reset-gpios = <&gpg0 6 GPIO_ACTIVE_LOW>;
+		pinctrl-0 = <&touch_irq &touch_rst>;
+		pinctrl-names = "default";
+		touchscreen-size-x = <1200>;
+		touchscreen-size-y = <1920>;
+	};
+};
+
+&usi_chub01 {
+	/* SPI21: touchscreen */
+	status = "okay";
