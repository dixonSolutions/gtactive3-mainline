+	/* MEMORY_CLUSTER1_CPU{0..3}_OPTION, NONCPU: reset(1) -> retention(2) */
+	{ 0x2114, 0x3, 0x2 },
+	{ 0x2180, 0x3, 0x2 },
+	{ 0x21ec, 0x3, 0x2 },
+	{ 0x2258, 0x3, 0x2 },
+	{ 0x2384, 0x3, 0x2 },
+	/* MEMORY_CLUSTER0_CPU{0..3}_OPTION, NONCPU */
+	{ 0x23c8, 0x3, 0x2 },
+	{ 0x2418, 0x3, 0x2 },
+	{ 0x2468, 0x3, 0x2 },
+	{ 0x24b8, 0x3, 0x2 },
+	{ 0x25a0, 0x3, 0x2 },
+};
