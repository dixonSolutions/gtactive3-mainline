diff --git a/arch/arm64/Kconfig b/arch/arm64/Kconfig
index cab741a695f5231de63b1f5b03cf5e9403cd9168..f29bb2f5ccc3aca3ba4f35f6de11fd2085cec860 100644
--- a/arch/arm64/Kconfig
+++ b/arch/arm64/Kconfig
@@ -546,6 +546,24 @@ config ARM64_ERRATUM_819472
 
 	  If unsure, say Y.
 
+config SAMSUNG_ERRATUM_EXYNOS9810_POU
+	bool "Exynos9810: Mongoose M3: clean the D-cache to PoC for I-cache coherency"
+	default y
+	select ARM64_WORKAROUND_CLEAN_CACHE
+	help
+	  Samsung's kernel for the Exynos9810 uses "dc civac" instead of
+	  "dc cvau" in its I/D cache maintenance (flush_icache_range and
+	  friends), presumably because the big (Samsung Mongoose M3) and
+	  LITTLE (Cortex-A55) clusters do not share a Point of Unification,
+	  so code cleaned to the PoU on one cluster may be fetched stale on
+	  the other.
+
+	  This option does the same, through the alternatives framework,
+	  whenever a Mongoose M3 core is present at boot. Userspace cache
+	  maintenance is trapped and emulated in the same way.
+
+	  If unsure, say Y.
+
 config ARM64_ERRATUM_832075
 	bool "Cortex-A57: 832075: possible deadlock on mixing exclusive memory accesses with device loads"
 	default y
