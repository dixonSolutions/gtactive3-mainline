@@ -0,0 +1,62 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/maxim,max77705-usbc.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Maxim MAX77705 USB-C block input power detection
+
+maintainers:
+  - Sebastian Reichel <sre@kernel.org>
+
+description:
+  The USB-C block of the Maxim MAX77705 (its own I2C address, usually 0x25)
+  runs the Type-C, USB PD and BC1.2 detection. Described here as the USB
+  power supply it detects, for use as the supplier of the MAX77705 charger.
+
+allOf:
+  - $ref: power-supply.yaml#
+
+properties:
+  compatible:
+    const: maxim,max77705-usbc
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  usb-role-switch:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description:
+      USB controller whose data role follows the Type-C state, the host
+      role while the port is the Type-C source and the device role
+      otherwise. Needs interrupts and vbus-supply.
+
+  vbus-supply:
+    description:
+      VBUS output for the host role (the MAX77705 charger's OTG boost)
+
+dependencies:
+  usb-role-switch: [ interrupts, vbus-supply ]
+
+required:
+  - compatible
+  - reg
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        usb-c@25 {
+            compatible = "maxim,max77705-usbc";
+            reg = <0x25>;
+            interrupt-parent = <&max77705>;
+            interrupts = <3>;
+        };
+    };
