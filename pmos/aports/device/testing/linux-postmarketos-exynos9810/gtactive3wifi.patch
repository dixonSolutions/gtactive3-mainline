+static const struct v4l2_ctrl_ops gc5035_ctrl_ops = {
+	.s_ctrl = gc5035_set_ctrl,
+};
+
+static int gc5035_init_controls(struct gc5035 *gc5035)
+{
+	struct v4l2_ctrl_handler *hdl = &gc5035->ctrl_handler;
+	const struct gc5035_mode *mode = gc5035->mode;
+	struct v4l2_fwnode_device_properties props;
+	s64 hblank, vblank;
+	int ret;
+
+	v4l2_ctrl_handler_init(hdl, 9);
+
+	gc5035->link_freq =
+		v4l2_ctrl_new_int_menu(hdl, &gc5035_ctrl_ops, V4L2_CID_LINK_FREQ,
+				       ARRAY_SIZE(gc5035_link_freq_menu) - 1,
+				       mode->link_freq_index,
+				       gc5035_link_freq_menu);
+	if (gc5035->link_freq)
+		gc5035->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	gc5035->pixel_rate = v4l2_ctrl_new_std(hdl, &gc5035_ctrl_ops,
+					       V4L2_CID_PIXEL_RATE, 0,
+					       gc5035_supported_modes[0].pixel_rate,
+					       1, mode->pixel_rate);
+
+	hblank = mode->hts - mode->width;
+	gc5035->hblank = v4l2_ctrl_new_std(hdl, &gc5035_ctrl_ops,
+					   V4L2_CID_HBLANK, hblank, hblank, 1,
+					   hblank);
+	if (gc5035->hblank)
+		gc5035->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	vblank = mode->vts - mode->height;
+	gc5035->vblank = v4l2_ctrl_new_std(hdl, &gc5035_ctrl_ops,
+					   V4L2_CID_VBLANK, vblank,
+					   GC5035_VTS_MAX - mode->height, 1,
+					   vblank);
+
+	v4l2_ctrl_new_std(hdl, &gc5035_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  GC5035_GAIN_MIN, GC5035_GAIN_MAX, 1,
+			  GC5035_GAIN_DEFAULT);
+
+	gc5035->exposure = v4l2_ctrl_new_std(hdl, &gc5035_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     GC5035_EXPOSURE_MIN,
+					     mode->vts - GC5035_EXPOSURE_MARGIN,
+					     1, mode->exposure);
+
+	ret = v4l2_fwnode_device_parse(gc5035->dev, &props);
+	if (ret)
+		goto error;
+	ret = v4l2_ctrl_new_fwnode_properties(hdl, &gc5035_ctrl_ops, &props);
+	if (ret)
+		goto error;
+	if (hdl->error) {
+		ret = hdl->error;
+		goto error;
+	}
+
+	gc5035->sd.ctrl_handler = hdl;
+	return 0;
+
+error:
+	v4l2_ctrl_handler_free(hdl);
+	return ret;
+}
+
+static int gc5035_otp_read(struct gc5035 *gc5035, u16 addr, u64 *val)
+{
+	int ret = 0;
+
+	cci_write(gc5035->regmap, GC5035_REG_OTP_ADDR_H, addr >> 8, &ret);
+	cci_write(gc5035->regmap, GC5035_REG_OTP_ADDR_L, addr & 0xff, &ret);
+	cci_write(gc5035->regmap, GC5035_REG_OTP_CTRL, 0x20, &ret);
+	cci_read(gc5035->regmap, GC5035_REG_OTP_DATA, val, &ret);
+	return ret;
+}
+
+/*
+ * Revision WC1XB keeps a static defect pixel table in OTP: count the
+ * entries and let the sensor load them (sensor_gc5035_cis_dpc_enable()).
+ */
+static int gc5035_dpc_load(struct gc5035 *gc5035)
+{
+	u64 rev = 0, n1 = 0, n2 = 0;
+	unsigned int n;
+	int ret;
+
+	ret = cci_multi_reg_write(gc5035->regmap, gc5035_otp_init_regs,
+				  ARRAY_SIZE(gc5035_otp_init_regs), NULL);
+	cci_write(gc5035->regmap, GC5035_REG_PAGE, 2, &ret);
+	if (!ret)
+		ret = gc5035_otp_read(gc5035, GC5035_OTP_REV_ADDR, &rev);
+	if (ret)
+		return ret;
+	gc5035->dpc = rev == GC5035_REV_WC1XB;
+	if (!gc5035->dpc)
+		return 0;
+
+	cci_write(gc5035->regmap, CCI_REG8(0xbe), 0x00, &ret);
+	cci_write(gc5035->regmap, CCI_REG8(0xa9), 0x01, &ret);
+	if (!ret)
+		ret = gc5035_otp_read(gc5035, 0x0070, &n1);
+	if (!ret)
+		ret = gc5035_otp_read(gc5035, 0x0078, &n2);
+	if (ret)
+		return ret;
+	n = min_t(unsigned int, n1 + n2, 64);
+
+	cci_write(gc5035->regmap, CCI_REG8(0x01), 0x00, &ret);
+	cci_write(gc5035->regmap, CCI_REG8(0x02), n, &ret);
+	cci_write(gc5035->regmap, CCI_REG8(0x03), 0x00, &ret);
+	cci_write(gc5035->regmap, CCI_REG8(0x04), 0x80, &ret);
+	cci_write(gc5035->regmap, CCI_REG8(0x09), 0x33, &ret);
+	cci_write(gc5035->regmap, GC5035_REG_OTP_CTRL, 0x80, &ret);
+	if (ret)
+		return ret;
+	usleep_range(4000, 5000);
+
+	return cci_multi_reg_write(gc5035->regmap, gc5035_dpc_enable_regs,
+				   ARRAY_SIZE(gc5035_dpc_enable_regs), NULL);
+}
+
+static int gc5035_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct gc5035 *gc5035 = to_gc5035(sd);
+	const struct gc5035_mode *mode = gc5035->mode;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(gc5035->dev);
+	if (ret)
+		return ret;
+
+	ret = cci_multi_reg_write(gc5035->regmap, gc5035_init_regs,
+				  ARRAY_SIZE(gc5035_init_regs), NULL);
+	if (!ret)
+		ret = gc5035_dpc_load(gc5035);
+	if (!ret)
+		ret = cci_multi_reg_write(gc5035->regmap, mode->regs,
+					  mode->num_regs, NULL);
+	if (!ret && mode->window) {
+		unsigned int i;
+
+		cci_write(gc5035->regmap, GC5035_REG_PAGE, 1, &ret);
+		for (i = 0; i < 8; i++)
+			cci_write(gc5035->regmap, CCI_REG8(0x91 + i),
+				  mode->window[i], &ret);
+		cci_write(gc5035->regmap, GC5035_REG_PAGE, 0, &ret);
+	}
+	if (ret)
+		goto error;
+
+	ret = __v4l2_ctrl_handler_setup(gc5035->sd.ctrl_handler);
+	if (ret)
+		goto error;
+
+	msleep(50);
+	cci_write(gc5035->regmap, GC5035_REG_PAGE, 0, &ret);
+	cci_write(gc5035->regmap, GC5035_REG_STREAM, GC5035_STREAM_ON, &ret);
+	if (ret)
+		goto error;
+
+	return 0;
+
+error:
+	dev_err(gc5035->dev, "failed to start streaming: %d\n", ret);
+	pm_runtime_put_autosuspend(gc5035->dev);
+	return ret;
+}
+
+static int gc5035_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct gc5035 *gc5035 = to_gc5035(sd);
+	int ret = 0;
+
+	cci_write(gc5035->regmap, GC5035_REG_PAGE, 0, &ret);
+	cci_write(gc5035->regmap, GC5035_REG_STREAM, 0, &ret);
+	if (ret)
+		dev_err(gc5035->dev, "failed to stop streaming: %d\n", ret);
+
+	pm_runtime_put_autosuspend(gc5035->dev);
+	return ret;
+}
+
+static void gc5035_update_pad_format(const struct gc5035_mode *mode,
+				     struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->code = MEDIA_BUS_FMT_SRGGB10_1X10;
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int gc5035_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct gc5035 *gc5035 = to_gc5035(sd);
+	const struct gc5035_mode *mode;
+	s64 hblank, vblank;
+
+	mode = v4l2_find_nearest_size(gc5035->modes, GC5035_NUM_MODES,
+				      width, height,
+				      fmt->format.width, fmt->format.height);
+	gc5035_update_pad_format(mode, &fmt->format);
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY || gc5035->mode == mode)
+		goto set_format;
+
+	__v4l2_ctrl_s_ctrl(gc5035->link_freq, mode->link_freq_index);
+	__v4l2_ctrl_s_ctrl_int64(gc5035->pixel_rate, mode->pixel_rate);
+
+	hblank = mode->hts - mode->width;
+	__v4l2_ctrl_modify_range(gc5035->hblank, hblank, hblank, 1, hblank);
+
+	vblank = mode->vts - mode->height;
+	__v4l2_ctrl_modify_range(gc5035->vblank, vblank,
+				 GC5035_VTS_MAX - mode->height, 1, vblank);
+	__v4l2_ctrl_s_ctrl(gc5035->vblank, vblank);
+
+	__v4l2_ctrl_modify_range(gc5035->exposure, GC5035_EXPOSURE_MIN,
+				 mode->vts - GC5035_EXPOSURE_MARGIN, 1,
+				 mode->exposure);
+	__v4l2_ctrl_s_ctrl(gc5035->exposure, mode->exposure);
+
+	if (gc5035->sd.ctrl_handler->error)
+		return gc5035->sd.ctrl_handler->error;
+
+	gc5035->mode = mode;
+
+set_format:
+	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
+	return 0;
+}
+
+static int gc5035_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = MEDIA_BUS_FMT_SRGGB10_1X10;
+	return 0;
+}
+
+static int gc5035_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *sd_state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	struct gc5035 *gc5035 = to_gc5035(sd);
+
+	if (fse->index >= GC5035_NUM_MODES ||
+	    fse->code != MEDIA_BUS_FMT_SRGGB10_1X10)
+		return -EINVAL;
+
+	fse->min_width = gc5035->modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = gc5035->modes[fse->index].height;
+	fse->max_height = fse->min_height;
+	return 0;
+}
+
+static int gc5035_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *sd_state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = to_gc5035(sd)->modes[0].width;
+		sel->r.height = to_gc5035(sd)->modes[0].height;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int gc5035_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct gc5035 *gc5035 = to_gc5035(sd);
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.pad = 0,
+		.format = {
+			.width = gc5035->mode->width,
+			.height = gc5035->mode->height,
+		},
+	};
+
+	return gc5035_set_pad_format(sd, state, &fmt);
+}
+
+static const struct v4l2_subdev_video_ops gc5035_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops gc5035_pad_ops = {
+	.set_fmt = gc5035_set_pad_format,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.get_selection = gc5035_get_selection,
+	.enum_mbus_code = gc5035_enum_mbus_code,
+	.enum_frame_size = gc5035_enum_frame_size,
+	.enable_streams = gc5035_enable_streams,
+	.disable_streams = gc5035_disable_streams,
+};
+
+static const struct v4l2_subdev_ops gc5035_subdev_ops = {
+	.video = &gc5035_video_ops,
+	.pad = &gc5035_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops gc5035_internal_ops = {
+	.init_state = gc5035_init_state,
+};
+
+static const struct media_entity_operations gc5035_subdev_entity_ops = {
+	.link_validate = v4l2_subdev_link_validate,
+};
+
+static int gc5035_identify_sensor(struct gc5035 *gc5035)
+{
+	u64 hi = 0, lo = 0;
+	int ret = 0;
+
+	cci_read(gc5035->regmap, GC5035_REG_CHIP_ID_H, &hi, &ret);
+	cci_read(gc5035->regmap, GC5035_REG_CHIP_ID_L, &lo, &ret);
+	if (ret)
+		return dev_err_probe(gc5035->dev, ret, "failed to read chip id\n");
+
+	if ((hi << 8 | lo) != GC5035_CHIP_ID)
+		return dev_err_probe(gc5035->dev, -ENODEV,
+				     "chip id mismatch: %04llx\n", hi << 8 | lo);
+	return 0;
+}
+
+static int gc5035_check_hwcfg(struct gc5035 *gc5035)
+{
+	struct fwnode_handle *fwnode = dev_fwnode(gc5035->dev), *ep;
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	unsigned long freq_bitmap;
+	int ret;
+
+	ep = fwnode_graph_get_next_endpoint(fwnode, NULL);
+	if (!ep)
+		return -EINVAL;
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &bus_cfg);
+	fwnode_handle_put(ep);
+	if (ret)
+		return ret;
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != GC5035_DATA_LANES) {
+		dev_err(gc5035->dev, "invalid number of data lanes: %u\n",
+			bus_cfg.bus.mipi_csi2.num_data_lanes);
+		ret = -EINVAL;
+		goto out;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(gc5035->dev, bus_cfg.link_frequencies,
+				       bus_cfg.nr_of_link_frequencies,
+				       gc5035_link_freq_menu,
+				       ARRAY_SIZE(gc5035_link_freq_menu),
+				       &freq_bitmap);
+out:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+	return ret;
+}
+
+static int gc5035_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct gc5035 *gc5035 = to_gc5035(sd);
+	static const unsigned int delay_us[] = { 500, 500, 1000 };
+	unsigned int i;
+	int ret;
+
+	gpiod_set_value_cansleep(gc5035->reset_gpio, 1);
+
+	/* stock order: I/O, core, analogue */
+	for (i = 0; i < GC5035_NUM_SUPPLIES; i++) {
+		ret = regulator_enable(gc5035->supplies[i].consumer);
+		if (ret)
+			goto disable_regulators;
+		usleep_range(delay_us[i], delay_us[i] + 100);
+	}
+
+	gpiod_set_value_cansleep(gc5035->reset_gpio, 0);
+	usleep_range(1000, 1100);
+
+	ret = clk_prepare_enable(gc5035->mclk);
+	if (ret)
+		goto disable_regulators;
+	usleep_range(3000, 3500);
+
+	return 0;
+
+disable_regulators:
+	gpiod_set_value_cansleep(gc5035->reset_gpio, 1);
+	while (i--)
+		regulator_disable(gc5035->supplies[i].consumer);
+	return ret;
+}
+
+static int gc5035_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct gc5035 *gc5035 = to_gc5035(sd);
+	unsigned int i = GC5035_NUM_SUPPLIES;
+
+	clk_disable_unprepare(gc5035->mclk);
+	gpiod_set_value_cansleep(gc5035->reset_gpio, 1);
+	while (i--) {
+		regulator_disable(gc5035->supplies[i].consumer);
+		usleep_range(500, 600);
+	}
+	return 0;
+}
+
+static int gc5035_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct gc5035 *gc5035;
+	unsigned int i;
+	int ret;
+
+	gc5035 = devm_kzalloc(dev, sizeof(*gc5035), GFP_KERNEL);
+	if (!gc5035)
+		return -ENOMEM;
+
+	gc5035->dev = dev;
+	v4l2_i2c_subdev_init(&gc5035->sd, client, &gc5035_subdev_ops);
+
+	gc5035->regmap = devm_cci_regmap_init_i2c(client, 8);
+	if (IS_ERR(gc5035->regmap))
+		return dev_err_probe(dev, PTR_ERR(gc5035->regmap),
+				     "failed to init CCI\n");
+
+	gc5035->mclk = devm_v4l2_sensor_clk_get(dev, NULL);
+	if (IS_ERR(gc5035->mclk))
+		return dev_err_probe(dev, PTR_ERR(gc5035->mclk),
+				     "failed to get MCLK\n");
+	if (clk_get_rate(gc5035->mclk) != GC5035_MCLK_FREQ)
+		return dev_err_probe(dev, -EINVAL, "MCLK must be 26 MHz\n");
+
+	ret = gc5035_check_hwcfg(gc5035);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to check HW configuration\n");
+
+	gc5035->reset_gpio = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(gc5035->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(gc5035->reset_gpio),
+				     "cannot get reset GPIO\n");
+
+	for (i = 0; i < GC5035_NUM_SUPPLIES; i++)
+		gc5035->supplies[i].supply = gc5035_supply_names[i];
+	ret = devm_regulator_bulk_get(dev, GC5035_NUM_SUPPLIES, gc5035->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get supplies\n");
+
+	ret = gc5035_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = gc5035_identify_sensor(gc5035);
+	if (ret)
+		goto power_off;
+
+	gc5035->modes = &gc5035_supported_modes[crop ? 0 : GC5035_NUM_MODES];
+	gc5035->mode = &gc5035->modes[0];
+	ret = gc5035_init_controls(gc5035);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to init controls\n");
+		goto power_off;
+	}
+
+	gc5035->sd.state_lock = gc5035->ctrl_handler.lock;
+	gc5035->sd.internal_ops = &gc5035_internal_ops;
+	gc5035->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	gc5035->sd.entity.ops = &gc5035_subdev_entity_ops;
+	gc5035->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	gc5035->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&gc5035->sd.entity, 1, &gc5035->pad);
+	if (ret)
+		goto free_ctrls;
+
+	ret = v4l2_subdev_init_finalize(&gc5035->sd);
+	if (ret)
+		goto cleanup_entity;
+
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&gc5035->sd);
+	if (ret)
+		goto cleanup_subdev;
+
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+	pm_runtime_idle(dev);
+	return 0;
+
+cleanup_subdev:
+	v4l2_subdev_cleanup(&gc5035->sd);
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+cleanup_entity:
+	media_entity_cleanup(&gc5035->sd.entity);
+free_ctrls:
+	v4l2_ctrl_handler_free(gc5035->sd.ctrl_handler);
+power_off:
+	gc5035_power_off(dev);
+	return ret;
+}
+
+static void gc5035_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct gc5035 *gc5035 = to_gc5035(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(sd->ctrl_handler);
+	pm_runtime_disable(gc5035->dev);
+	if (!pm_runtime_status_suspended(gc5035->dev)) {
+		gc5035_power_off(gc5035->dev);
+		pm_runtime_set_suspended(gc5035->dev);
+	}
+}
+
+static const struct dev_pm_ops gc5035_pm_ops = {
+	SET_RUNTIME_PM_OPS(gc5035_power_off, gc5035_power_on, NULL)
+};
+
+static const struct of_device_id gc5035_of_match[] = {
+	{ .compatible = "galaxycore,gc5035" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, gc5035_of_match);
+
+static struct i2c_driver gc5035_i2c_driver = {
+	.driver = {
+		.name = "gc5035",
+		.pm = &gc5035_pm_ops,
+		.of_match_table = gc5035_of_match,
+	},
+	.probe = gc5035_probe,
+	.remove = gc5035_remove,
+};
+module_i2c_driver(gc5035_i2c_driver);
+
+MODULE_DESCRIPTION("GalaxyCore GC5035 image sensor driver");
+MODULE_LICENSE("GPL");
diff --git a/drivers/media/i2c/s5k3l6.c b/drivers/media/i2c/s5k3l6.c
new file mode 100644
index 0000000000000000000000000000000000000000..1752887ca682329189f6a6c14882f3d5190c22ab
--- /dev/null
+++ b/drivers/media/i2c/s5k3l6.c
@@ -0,0 +1,1003 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Samsung S5K3L6 13 MP image sensor (4128x3096, 4-lane MIPI CSI-2, RAW10)
+ *
+ * The register settings (3L6 EVT1 setfile 2.4A, 26 MHz input, 1196 Mbps
+ * per lane) and the stream-on sequence come from Samsung's GPL camera
+ * driver (fimc-is-cis-3l6.c, fimc-is-cis-3l6-setB.h). Structure after the
+ * s5k3m5 driver.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+#include <linux/units.h>
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+
+#define S5K3L6_LINK_FREQ		(598 * HZ_PER_MHZ)	/* 1196 Mbps/lane */
+#define S5K3L6_PIXEL_RATE		(480 * HZ_PER_MHZ)	/* VT pixel clock */
+#define S5K3L6_MCLK_FREQ		(26 * HZ_PER_MHZ)
+#define S5K3L6_DATA_LANES		4
+
+/*
+ * Pixel array. The full mode reads the stock 4128x3096 window less 16
+ * columns and 12 rows on each side (4096x3072), so that its MIPI-packed
+ * lines are a multiple of 64 bytes and the GPU can import the raw
+ * buffers as they are; even offsets keep GRBG. The binned mode's window
+ * is chosen with bin_crop (below).
+ */
+#define S5K3L6_NATIVE_WIDTH		4208
+#define S5K3L6_NATIVE_HEIGHT		3120
+
+#define S5K3L6_REG_CHIP_ID		CCI_REG16(0x0000)
+#define S5K3L6_CHIP_ID			0x30c6
+
+/* mode_select (0x0100) and image_orientation (0x0101) together */
+#define S5K3L6_REG_CTRL_MODE		CCI_REG16(0x0100)
+#define S5K3L6_MODE_STREAMING		BIT(8)
+#define S5K3L6_VFLIP			BIT(1)
+#define S5K3L6_HFLIP			BIT(0)
+
+#define S5K3L6_REG_EXPOSURE		CCI_REG16(0x0202)
+#define S5K3L6_EXPOSURE_MIN		2
+#define S5K3L6_EXPOSURE_STEP		1
+#define S5K3L6_EXPOSURE_MARGIN		4
+
+/* analogue gain code / 32 = gain, 1x .. 16x */
+#define S5K3L6_REG_AGAIN		CCI_REG16(0x0204)
+#define S5K3L6_AGAIN_MIN		0x20
+#define S5K3L6_AGAIN_MAX		0x200
+#define S5K3L6_AGAIN_STEP		1
+#define S5K3L6_AGAIN_DEFAULT		0x20
+
+#define S5K3L6_REG_VTS			CCI_REG16(0x0340)
+#define S5K3L6_VTS_MAX			0xffff
+
+#define S5K3L6_REG_TEST_PATTERN		CCI_REG16(0x0600)
+#define S5K3L6_REG_PLL_POWER		CCI_REG16(0x3c1e)
+
+#define to_s5k3l6(_sd)			container_of(_sd, struct s5k3l6, sd)
+
+static const s64 s5k3l6_link_freq_menu[] = {
+	S5K3L6_LINK_FREQ,
+};
+
+/* native order GRBG, then hflip, vflip, both */
+static const u32 s5k3l6_mbus_formats[] = {
+	MEDIA_BUS_FMT_SGRBG10_1X10,	MEDIA_BUS_FMT_SRGGB10_1X10,
+	MEDIA_BUS_FMT_SBGGR10_1X10,	MEDIA_BUS_FMT_SGBRG10_1X10,
+};
+
+struct s5k3l6_mode {
+	u32 width;
+	u32 height;
+	u32 hts;
+	u32 vts;
+	u32 exposure;
+	const struct cci_reg_sequence *regs;
+	unsigned int num_regs;
+	/* written after regs: another window for the same mode table */
+	const struct cci_reg_sequence *fix;
+	unsigned int num_fix;
+	/* analogue crop rectangle (V4L2_SEL_TGT_CROP) */
+	struct v4l2_rect crop;
+};
+
+static const char * const s5k3l6_test_pattern_menu[] = {
+	"Disabled",
+	"Solid colour",
+	"Colour bars",
+	"Fade to grey colour bars",
+	"PN9",
+};
+
+/* power-up order of the stock module: I/O, analogue, core, autofocus */
+static const char * const s5k3l6_supply_names[] = {
+	"vddio",
+	"vdda",
+	"vddd",
+	"afvdd",
+};
+
+#define S5K3L6_NUM_SUPPLIES	ARRAY_SIZE(s5k3l6_supply_names)
+
+struct s5k3l6 {
+	struct device *dev;
+	struct regmap *regmap;
+	struct clk *mclk;
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data supplies[S5K3L6_NUM_SUPPLIES];
+
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct v4l2_ctrl_handler ctrl_handler;
+	struct v4l2_ctrl *link_freq;
+	struct v4l2_ctrl *pixel_rate;
+	struct v4l2_ctrl *hblank;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *vflip;
+	struct v4l2_ctrl *hflip;
+
+	const struct s5k3l6_mode *mode;
+	const struct s5k3l6_mode *modes;	/* S5K3L6_NUM_MODES of them */
+};
