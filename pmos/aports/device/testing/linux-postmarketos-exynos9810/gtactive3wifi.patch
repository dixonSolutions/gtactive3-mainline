index 0000000000000000000000000000000000000000..00be8aad768ccdf4926cc48c20fe761b7e7a6e2c
--- /dev/null
+++ b/drivers/video/backlight/exynos9810-dsim-bl.c
@@ -0,0 +1,1448 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Backlight through MIPI DCS on a bootloader-initialised Exynos9810 DSIM
+ *
+ * Until there is a DECON/DSIM DRM driver for Exynos9810, the display keeps
+ * running in the video mode set up by the bootloader and the kernel only
+ * scans out its framebuffer (simple-framebuffer). Panels such as the Himax
+ * HX83102E in the Galaxy Tab Active3 take their brightness over DSI
+ * (DCS SET_DISPLAY_BRIGHTNESS, 0x51) and generate the LED PWM themselves,
+ * so the only way to dim them is to push DCS packets through the DSIM
+ * command (SFR) FIFOs of the running links.
+ *
+ * This driver does exactly that and nothing else: it never touches clocks,
+ * the PHY, timings or the link state. A packet is queued into the header and
+ * payload FIFOs and the link inserts it into the vertical front porch.
+ *
+ * Register layout from Samsung's dpu_9810 driver (regs-dsim.h, DSIM v2.1).
+ *
+ * With "samsung,hx83102e-dgc" it also drives the panel's digital gamma for
+ * the DPU's gamma LUT (Night Light): the HX83102E keeps one 46-point 10-bit
+ * curve per colour (command 0xC1 in banks 1-3, selected with 0xBD, behind
+ * the 0xB9 password), loaded by Samsung's init sequence (panels/
+ * hx83102e_gtactive3_param.h, SEQ_LCD_21-29). Each curve is scaled by the
+ * channel's factor and sent back. Packing: 46 high bytes, then the 2 low
+ * bits of every point MSB first (4 zero pad bits); this reproduces
+ * Samsung's three tables byte for byte.
+ *
+ * Screen blank: the DPU driver calls the panel hooks in
+ * exynos9810-panel-gamma.h, and the power_off_level parameter says how
+ * far the panel goes down (sequences from Samsung's dsim_reg.c,
+ * dsim_drv.c and the hx83102e_gtactive3 panel driver):
+ *  0  backlight off (DCS brightness 0), everything keeps running;
+ *  1  + DISPLAY_OFF and SLEEP_IN, the video stream keeps running;
+ *  2  + DECON stopped (DPU driver), the links' HS clocks stopped: lanes
+ *     in LP-11, or in ULPS with link_ulps=1; PLLs and configuration are
+ *     kept (the default);
+ *  3  + Samsung's exit sequence, then as stock's dsim_reg_stop(): lanes
+ *     disabled, escape clocks and D-PHY PLLs off, but no link reset (the
+ *     bootloader's configuration stays); panel reset held, BUCK_EN and
+ *     LDO_EN low. On unblank the rails come back, the PLLs lock, the lanes
+ *     come up in LP-11, the panel is reset and gets Samsung's whole init
+ *     sequence. Needs the three GPIOs in the DT.
+ * Stock uses ULPS only for command mode panels; the HX83102E runs in
+ * video mode, so level 3 switches the lanes off instead.
+ * The touch part of the TDDI follows through the DPU's panel notifier.
+ * A wake-up that fails is retried once with a full power cycle (link
+ * function reset, lanes and PLLs off, rails off, panel reset and init).
+ * If that fails too, the panel is left powered and the next blank takes
+ * it all the way down again; after three failures in a row blanking falls
+ * back to level 0 until the driver is reloaded.
+ */
+
+#include <linux/backlight.h>
+#include <linux/bitfield.h>
+#include <linux/bits.h>
+#include <linux/clk.h>
+#include <linux/debugfs.h>
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/gpio/consumer.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/kernel.h>
+#include <linux/kstrtox.h>
+#include <linux/ktime.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/platform_device.h>
+#include <linux/property.h>
+#include <linux/slab.h>
+#include <linux/sysfs.h>
+#include <linux/workqueue.h>
+#include <soc/samsung/exynos9810-panel-gamma.h>
+#include <video/mipi_display.h>
+
+#define DSIM_VERSION			0x00
+#define DSIM_SWRST			0x04
+#define DSIM_SWRST_FUNCRST		BIT(8)
+#define DSIM_LINK_STATUS0		0x08
+#define DSIM_LINK_STATUS0_VIDEO_MODE	BIT(24)
+#define DSIM_LINK_STATUS3		0x14
+#define DSIM_LINK_STATUS3_PLL_STABLE	BIT(0)
+#define DSIM_DPHY_STATUS		0x1c
+#define DSIM_DPHY_STATUS_TX_READY_HS_CLK	BIT(10)
+#define DSIM_DPHY_STATUS_ULPS_CLK	BIT(9)
+#define DSIM_DPHY_STATUS_STOP_STATE_CLK	BIT(8)
+#define DSIM_DPHY_STATUS_ULPS_DAT	GENMASK(7, 4)
+#define DSIM_DPHY_STATUS_STOP_STATE_DAT	GENMASK(3, 0)
+#define DSIM_CLK_CTRL			0x20
+#define DSIM_CLK_CTRL_CLOCK_SEL		BIT(26)	/* link clock: word clock, not OSC */
+#define DSIM_CLK_CTRL_NONCONT_CLOCK_LANE	BIT(25)
+#define DSIM_CLK_CTRL_TX_REQUEST_HSCLK	BIT(20)
+#define DSIM_CLK_CTRL_WORDCLK_EN	BIT(17)
+#define DSIM_CLK_CTRL_ESCCLK_EN		BIT(16)
+#define DSIM_CLK_CTRL_LANE_ESCCLK_EN	GENMASK(12, 8)
+#define DSIM_CLK_CTRL_ESC_PRESCALER	GENMASK(7, 0)
+#define DSIM_ESCMODE			0x2c
+#define DSIM_ESCMODE_TX_ULPS_DATA	BIT(3)
+#define DSIM_ESCMODE_TX_ULPS_DATA_EXIT	BIT(2)
+#define DSIM_ESCMODE_TX_ULPS_CLK	BIT(1)
+#define DSIM_ESCMODE_TX_ULPS_CLK_EXIT	BIT(0)
+#define DSIM_ESCMODE_ULPS_ALL		GENMASK(3, 0)
+#define DSIM_CONFIG			0x4c
+/* bit 0 clock lane, bits 1-4 data lanes 0-3 */
+#define DSIM_CONFIG_LANES_EN		GENMASK(4, 0)
+#define DSIM_INTSRC			0x50
+#define DSIM_INTSRC_PLL_STABLE		BIT(31)
+#define DSIM_INTSRC_SFR_PL_FIFO_EMPTY	BIT(29)
+#define DSIM_INTSRC_SFR_PH_FIFO_EMPTY	BIT(28)
+#define DSIM_PKTHDR			0x58
+#define DSIM_PKTHDR_DATA1(x)		((x) << 16)
+#define DSIM_PKTHDR_DATA0(x)		((x) << 8)
+#define DSIM_PKTHDR_ID(x)		((x) << 0)
