+
+static int dsim_bl_wait_not_full(void __iomem *base, u32 full)
+{
+	u32 val;
+
+	return readl_poll_timeout(base + DSIM_FIFOCTRL, val, !(val & full),
+				  20, DSIM_CMD_TIMEOUT_US);
+}
+
+static int dsim_bl_queue(void __iomem *base, const u8 *buf, size_t len)
+{
+	size_t i;
+	int ret;
+
+	ret = dsim_bl_wait_not_full(base, DSIM_FIFOCTRL_FULL_PH_SFR);
+	if (ret)
+		return ret;
+
+	writel(DSIM_INTSRC_SFR_PH_FIFO_EMPTY | DSIM_INTSRC_SFR_PL_FIFO_EMPTY,
+	       base + DSIM_INTSRC);
+
+	/* payload first, little-endian words, then the header releases it */
+	for (i = 0; i < len; i += 4) {
+		u32 word = 0;
+		size_t j;
+
+		for (j = 0; j < 4 && i + j < len; j++)
+			word |= (u32)buf[i + j] << (8 * j);
+
+		ret = dsim_bl_wait_not_full(base, DSIM_FIFOCTRL_FULL_PL_SFR);
+		if (ret)
+			return ret;
+		writel(word, base + DSIM_PAYLOAD);
+	}
+
+	writel(DSIM_PKTHDR_ID(MIPI_DSI_DCS_LONG_WRITE) |
+	       DSIM_PKTHDR_DATA0(len & 0xff) |
+	       DSIM_PKTHDR_DATA1((len >> 8) & 0xff),
+	       base + DSIM_PKTHDR);
+
+	return 0;
+}
+
+/*
+ * Send one DCS long write to every link. As in Samsung's
+ * dsim_write_data_dual(), the packet is queued on all links first and the
+ * header FIFOs are then drained, so both halves of a dual-DSI panel get it
+ * in the same frame.
+ */
+static int dsim_bl_dcs_write(struct dsim_bl *bl, const u8 *buf, size_t len)
+{
+	unsigned int i;
+	u32 val;
+	int ret;
+
+	if (!len || len > DSIM_MAX_PAYLOAD)
+		return -EINVAL;
+
+	mutex_lock(&bl->lock);
+
+	for (i = 0; i < bl->nlinks; i++) {
+		ret = dsim_bl_queue(bl->link[i], buf, len);
+		if (ret) {
+			dev_err(bl->dev, "link %u: command FIFO stuck (%#x)\n",
+				i, readl(bl->link[i] + DSIM_FIFOCTRL));
+			goto out;
+		}
+	}
+
+	for (i = 0; i < bl->nlinks; i++) {
+		ret = readl_poll_timeout(bl->link[i] + DSIM_FIFOCTRL, val,
+					 val & DSIM_FIFOCTRL_EMPTY_PH_SFR,
+					 100, DSIM_CMD_TIMEOUT_US);
+		if (ret) {
+			dev_err(bl->dev, "link %u: DCS %#04x not sent (%#x)\n",
+				i, buf[0], val);
+			goto out;
+		}
+	}
+
+out:
+	mutex_unlock(&bl->lock);
+	return ret;
+}
+
+/* one curve scaled, in the panel's packing, with the 0xC1 command byte */
+static void dsim_bl_dgc_pack(u8 out[DGC_LEN], const u16 *curve, u16 scale)
+{
+	unsigned int i;
+	u16 v;
+
+	memset(out, 0, DGC_LEN);
+	out[0] = 0xc1;
+	for (i = 0; i < DGC_POINTS; i++) {
+		v = DIV_ROUND_CLOSEST((u32)curve[i] * scale, 0xffff);
+		out[1 + i] = v >> 2;
+		/* low bits: point i at bit pair 2i of the tail, MSB first */
+		out[1 + DGC_POINTS + i / 4] |= (v & 3) << (6 - 2 * (i % 4));
+	}
+}
+
+static void dsim_bl_dgc_work(struct work_struct *work)
+{
+	struct dsim_bl *bl = container_of(work, struct dsim_bl, dgc_work);
+	static const u8 unlock[] = { 0xb9, 0x83, 0x10, 0x2e };
+	static const u8 lock[] = { 0xb9, 0x00, 0x00, 0x00 };
+	u8 bank[2] = { 0xbd, 0 }, cmd[DGC_LEN];
+	u16 want[3];
+	unsigned int c;
+	int ret;
+
+	guard(mutex)(&bl->seq_lock);
+	/* a blanked panel gets the curves when it wakes up */
+	if (bl->state != DSIM_BL_ON)
+		return;
+
+	spin_lock_irq(&bl->dgc_slock);
+	memcpy(want, bl->dgc_want, sizeof(want));
+	spin_unlock_irq(&bl->dgc_slock);
+	if (!memcmp(want, bl->dgc_sent, sizeof(want)))
+		return;
+
+	ret = dsim_bl_dcs_write(bl, unlock, sizeof(unlock));
+	for (c = 0; c < 3 && !ret; c++) {
+		bank[1] = c + 1;
+		dsim_bl_dgc_pack(cmd, hx83102e_dgc[c], want[c]);
+		ret = dsim_bl_dcs_write(bl, bank, sizeof(bank));
+		if (!ret)
+			ret = dsim_bl_dcs_write(bl, cmd, sizeof(cmd));
+	}
+	bank[1] = 0;
+	dsim_bl_dcs_write(bl, bank, sizeof(bank));
+	dsim_bl_dcs_write(bl, lock, sizeof(lock));
+	if (ret) {
+		dev_err(bl->dev, "digital gamma not loaded: %d\n", ret);
+		return;
+	}
+	memcpy(bl->dgc_sent, want, sizeof(want));
+	dev_dbg(bl->dev, "digital gamma scales %04x %04x %04x\n",
+		want[0], want[1], want[2]);
+}
+
+static int dsim_bl_send_brightness(struct dsim_bl *bl, int brightness)
+{
+	u8 cmd[3] = { MIPI_DCS_SET_DISPLAY_BRIGHTNESS };
+
+	if (bl->brightness_bytes == 2) {
+		cmd[1] = brightness >> 8;
+		cmd[2] = brightness & 0xff;
+	} else {
+		cmd[1] = brightness;
+	}
+
+	return dsim_bl_dcs_write(bl, cmd, 1 + bl->brightness_bytes);
+}
+
+/* ---- screen blank: panel and link power ---- */
+
+static int dsim_bl_dcs(struct dsim_bl *bl, const u8 *cmd, size_t len,
+		       unsigned int delay_ms)
+{
+	int ret = dsim_bl_dcs_write(bl, cmd, len);
+
+	if (!ret && delay_ms)
+		msleep(delay_ms);
+	return ret;
+}
+
+#define dsim_bl_dcs_seq(bl, delay_ms, ...) ({				\
+	static const u8 _cmd[] = { __VA_ARGS__ };			\
+	dsim_bl_dcs(bl, _cmd, sizeof(_cmd), delay_ms);			\
+})
+
+/* stuck command FIFOs: Samsung resets the link's function logic */
+static void dsim_bl_function_reset(struct dsim_bl *bl)
+{
+	unsigned int i;
+	u32 val;
+
+	for (i = 0; i < bl->nlinks; i++) {
+		void __iomem *base = bl->link[i];
+
+		writel(readl(base + DSIM_SWRST) | DSIM_SWRST_FUNCRST,
+		       base + DSIM_SWRST);
+		if (readl_poll_timeout(base + DSIM_SWRST, val,
+				       !(val & DSIM_SWRST_FUNCRST), 10,
+				       DSIM_LANE_TIMEOUT_US))
+			dev_err(bl->dev, "link %u: function reset stuck\n", i);
+	}
+}
+
+/* hx83102e_exit(): optionally Samsung's power-off preamble, then sleep */
+static int dsim_bl_panel_sleep(struct dsim_bl *bl, bool power_off)
+{
+	int ret = 0;
+
+	if (power_off) {
+		/* SEQ_PW_OPEN, SEQ_SET_VCOM1..3, SEQ_PW_CLOSE */
+		ret = dsim_bl_dcs_seq(bl, 0, 0xb9, 0x83, 0x10, 0x2e);
+		if (!ret)
+			ret = dsim_bl_dcs_seq(bl, 0, 0xe9, 0xff);
+		if (!ret)
+			ret = dsim_bl_dcs_seq(bl, 0, 0xe9, 0x00);
+		if (!ret)
+			ret = dsim_bl_dcs_seq(bl, 0, 0xb9, 0x00, 0x00, 0x00);
+		if (!ret)
+			ret = dsim_bl_dcs_seq(bl, 0, 0xb9, 0x00, 0x00, 0x00);
+	}
+	if (!ret)
+		ret = dsim_bl_dcs_seq(bl, 0, MIPI_DCS_SET_DISPLAY_OFF, 0x00, 0x00);
+	/* > 2 frames + 5 ms */
+	if (!ret)
+		ret = dsim_bl_dcs_seq(bl, 40, MIPI_DCS_ENTER_SLEEP_MODE, 0x00, 0x00);
+	return ret;
+}
+
+static int dsim_bl_sleep_out(struct dsim_bl *bl)
+{
+	/* > 120 ms */
+	return dsim_bl_dcs_seq(bl, 121, MIPI_DCS_EXIT_SLEEP_MODE);
+}
+
+/* LCD_SEQ_INIT_1, with the digital gamma for the current scales */
+static int dsim_bl_panel_init(struct dsim_bl *bl)
+{
+	u8 cmd[DGC_LEN];
+	unsigned int i = 0, bank = 0;
+	u16 want[3];
+	int ret;
+
+	spin_lock_irq(&bl->dgc_slock);
+	memcpy(want, bl->dgc_want, sizeof(want));
+	spin_unlock_irq(&bl->dgc_slock);
+
+	bl->cabc_lost = true;
+	while (i < ARRAY_SIZE(hx83102e_init)) {
+		unsigned int len = hx83102e_init[i];
+		const u8 *data = &hx83102e_init[i + 1];
+
+		if (data[0] == 0xbd && len == 2)
+			bank = data[1];
+		if (data[0] == 0xc1 && len == 1) {
+			if (WARN_ON(bank < 1 || bank > 3))
+				return -EINVAL;
+			dsim_bl_dgc_pack(cmd, hx83102e_dgc[bank - 1],
+					 want[bank - 1]);
+			ret = dsim_bl_dcs_write(bl, cmd, sizeof(cmd));
+		} else {
+			ret = dsim_bl_dcs_write(bl, data, len);
+		}
+		if (ret)
+			return ret;
+		i += 1 + len;
+	}
+	memcpy(bl->dgc_sent, want, sizeof(want));
+	return 0;
+}
+
+/* the data lanes, in the bit order of DSIM_DPHY_STATUS */
+static u32 dsim_bl_data_lanes(struct dsim_bl *bl, unsigned int i)
+{
+	return bl->lanes[i] >> 1;
+}
+
+/* the clock lane and all data lanes in the stop state (LP-11) */
+static int dsim_bl_wait_lp11(struct dsim_bl *bl, unsigned int i)
+{
+	u32 data = dsim_bl_data_lanes(bl, i);
+	u32 val;
+	int ret;
+
+	ret = readl_poll_timeout(bl->link[i] + DSIM_DPHY_STATUS, val,
+				 (val & DSIM_DPHY_STATUS_STOP_STATE_CLK) &&
+				 FIELD_GET(DSIM_DPHY_STATUS_STOP_STATE_DAT, val) == data,
+				 10, DSIM_LANE_TIMEOUT_US);
+	if (ret)
+		dev_err(bl->dev, "link %u: lanes not in LP-11 (%#x)\n", i, val);
+	return ret;
+}
+
+/* dsim_reg_set_hs_clock(.., 0): HS clock off, the clock lane to LP-11 */
+static int dsim_bl_hs_off(struct dsim_bl *bl, unsigned int i)
+{
+	void __iomem *base = bl->link[i];
+	u32 val;
+	int ret;
+
+	writel(readl(base + DSIM_CLK_CTRL) & ~DSIM_CLK_CTRL_TX_REQUEST_HSCLK,
+	       base + DSIM_CLK_CTRL);
+	ret = readl_poll_timeout(base + DSIM_DPHY_STATUS, val,
+				 val & DSIM_DPHY_STATUS_STOP_STATE_CLK, 10,
+				 DSIM_LANE_TIMEOUT_US);
+	if (ret)
+		dev_warn(bl->dev, "link %u: clock lane not in stop state (%#x)\n",
+			 i, val);
+	return ret;
+}
+
+/* dsim_reg_start(): HS clock on */
+static int dsim_bl_link_hs_on(struct dsim_bl *bl, unsigned int i)
+{
+	void __iomem *base = bl->link[i];
+	u32 val, clk;
+	int ret;
+
+	clk = readl(base + DSIM_CLK_CTRL);
+	writel(clk | DSIM_CLK_CTRL_TX_REQUEST_HSCLK, base + DSIM_CLK_CTRL);
+	if (clk & DSIM_CLK_CTRL_NONCONT_CLOCK_LANE)
+		return 0;
+	ret = readl_poll_timeout(base + DSIM_DPHY_STATUS, val,
+				 val & DSIM_DPHY_STATUS_TX_READY_HS_CLK,
+				 10, DSIM_LANE_TIMEOUT_US);
+	if (ret)
+		dev_err(bl->dev, "link %u: HS clock not ready (%#x)\n", i, val);
+	return ret;
+}
+
+/*
+ * dsim_reg_set_ulps(.., 1, ..): request ULPS on the clock and the data
+ * lanes and wait until all of them are in it. The request stays set until
+ * the exit sequence, which from here on is the only way back.
+ */
+static int dsim_bl_ulps_enter(struct dsim_bl *bl, unsigned int i)
+{
+	void __iomem *base = bl->link[i];
+	u32 data = dsim_bl_data_lanes(bl, i);
+	u32 val;
+	int ret;
+
+	writel(readl(base + DSIM_ESCMODE) | DSIM_ESCMODE_TX_ULPS_CLK |
+	       DSIM_ESCMODE_TX_ULPS_DATA, base + DSIM_ESCMODE);
+	bl->ulps[i] = true;
+	ret = readl_poll_timeout(base + DSIM_DPHY_STATUS, val,
+				 (val & DSIM_DPHY_STATUS_ULPS_CLK) &&
+				 FIELD_GET(DSIM_DPHY_STATUS_ULPS_DAT, val) == data,
+				 10, DSIM_LANE_TIMEOUT_US);
+	if (ret)
+		dev_warn(bl->dev, "link %u: lanes did not enter ULPS (%#x)\n",
+			 i, val);
+	return ret;
+}
+
+/*
+ * dsim_reg_set_ulps(.., 0, ..): with the enter request still set, request
+ * the exit and wait until no lane is in ULPS, hold Mark-1 for Twakeup
+ * (at least 1 ms), then drop both requests: the lanes go to LP-11.
+ */
+static int dsim_bl_ulps_exit(struct dsim_bl *bl, unsigned int i)
+{
+	void __iomem *base = bl->link[i];
+	u32 val;
+	int ret;
+
+	writel(readl(base + DSIM_ESCMODE) | DSIM_ESCMODE_TX_ULPS_CLK_EXIT |
+	       DSIM_ESCMODE_TX_ULPS_DATA_EXIT, base + DSIM_ESCMODE);
+	ret = readl_poll_timeout(base + DSIM_DPHY_STATUS, val,
+				 !(val & (DSIM_DPHY_STATUS_ULPS_CLK |
+					  DSIM_DPHY_STATUS_ULPS_DAT)),
+				 10, DSIM_LANE_TIMEOUT_US);
+	usleep_range(DSIM_ULPS_WAKEUP_US, DSIM_ULPS_WAKEUP_US + 100);
+	writel(readl(base + DSIM_ESCMODE) & ~DSIM_ESCMODE_ULPS_ALL,
+	       base + DSIM_ESCMODE);
+	if (ret) {
+		dev_err(bl->dev, "link %u: lanes stuck in ULPS (%#x)\n", i, val);
+		return ret;
+	}
+	bl->ulps[i] = false;
+	return dsim_bl_wait_lp11(bl, i);
+}
+
+/*
+ * Level 3, after the HS clock: stock's dsim_reg_stop() without the link
+ * software reset, which would lose the bootloader's configuration that
+ * nothing here can program again. Link clock back to OSC, the lanes
+ * disabled (the D-PHY stops driving them, so nothing feeds the panel while
+ * its rails are off), lane escape clocks, escape clock and D-PHY PLL off.
+ */
+static void dsim_bl_lanes_off(struct dsim_bl *bl, unsigned int i)
+{
+	void __iomem *base = bl->link[i];
+	u32 clk;
+
+	clk = readl(base + DSIM_CLK_CTRL) &
+	      ~(DSIM_CLK_CTRL_TX_REQUEST_HSCLK | DSIM_CLK_CTRL_CLOCK_SEL);
+	writel(clk, base + DSIM_CLK_CTRL);
+	writel(readl(base + DSIM_CONFIG) & ~DSIM_CONFIG_LANES_EN,
+	       base + DSIM_CONFIG);
+	usleep_range(DSIM_LANE_ENABLE_US, DSIM_LANE_ENABLE_US + 100);
+	/* the lanes must not come back into a pending ULPS request */
+	writel(readl(base + DSIM_ESCMODE) & ~DSIM_ESCMODE_ULPS_ALL,
+	       base + DSIM_ESCMODE);
+	clk &= ~(DSIM_CLK_CTRL_LANE_ESCCLK_EN | DSIM_CLK_CTRL_ESCCLK_EN);
+	writel(clk, base + DSIM_CLK_CTRL);
+	if (bl->pll[i])
+		writel(readl(base + DSIM_PLLCTRL) & ~DSIM_PLLCTRL_PLL_EN,
+		       base + DSIM_PLLCTRL);
+	bl->ulps[i] = false;
+	bl->lanes_off[i] = true;
+}
+
+/*
+ * _dsim_enable() without the resets and the configuration, which were
+ * kept: escape clock, D-PHY PLL (until it locks), lanes enabled, link
+ * clock back on the word clock, lane escape clocks. The lanes then come
+ * up in LP-11.
+ */
+static int dsim_bl_lanes_on(struct dsim_bl *bl, unsigned int i)
+{
+	void __iomem *base = bl->link[i];
+	u32 boot = bl->clk_ctrl[i];
+	u32 clk, val;
+	int ret;
+
+	clk = readl(base + DSIM_CLK_CTRL) &
+	      ~(DSIM_CLK_CTRL_TX_REQUEST_HSCLK | DSIM_CLK_CTRL_ESC_PRESCALER);
+	clk |= boot & (DSIM_CLK_CTRL_ESCCLK_EN | DSIM_CLK_CTRL_ESC_PRESCALER);
+	writel(clk, base + DSIM_CLK_CTRL);
+
+	if (bl->pll[i]) {
+		writel(DSIM_INTSRC_PLL_STABLE, base + DSIM_INTSRC);
+		writel(readl(base + DSIM_PLLCTRL) | DSIM_PLLCTRL_PLL_EN,
+		       base + DSIM_PLLCTRL);
+		/* the lock time (PLLTMR) is about 1 ms in Samsung's setup */
+		usleep_range(1000, 1100);
+		ret = readl_poll_timeout(base + DSIM_LINK_STATUS3, val,
+					 val & DSIM_LINK_STATUS3_PLL_STABLE,
+					 10, DSIM_PLL_TIMEOUT_US);
+		if (ret) {
+			dev_err(bl->dev, "link %u: PLL does not lock (%#x)\n",
+				i, val);
+			return ret;
+		}
+	}
+
+	writel(readl(base + DSIM_CONFIG) | bl->lanes[i], base + DSIM_CONFIG);
+	usleep_range(DSIM_LANE_ENABLE_US, DSIM_LANE_ENABLE_US + 100);
+	clk |= boot & (DSIM_CLK_CTRL_CLOCK_SEL | DSIM_CLK_CTRL_LANE_ESCCLK_EN |
+		       DSIM_CLK_CTRL_WORDCLK_EN);
+	writel(clk, base + DSIM_CLK_CTRL);
+	bl->lanes_off[i] = false;
+	return dsim_bl_wait_lp11(bl, i);
+}
+
+/*
+ * Level 2 with link_ulps. A link whose lanes do not all reach ULPS is
+ * taken back to LP-11 (Samsung would leave it half way, which is what kept
+ * the clock lane of link 0 in ULPS after a wake-up); one that does not get
+ * there either has its lanes switched off and on at wake-up.
+ */
+static void dsim_bl_link_ulps(struct dsim_bl *bl, unsigned int i)
+{
+	if (!dsim_bl_ulps_enter(bl, i))
+		return;
+	if (dsim_bl_ulps_exit(bl, i))
+		dsim_bl_lanes_off(bl, i);
+	else
+		dev_info(bl->dev, "link %u stays in LP-11\n", i);
+}
+
+/* dsim_set_panel_power(0): "dsim_set_panel_power_disable" in the stock DT */
+static void dsim_bl_rails_off(struct dsim_bl *bl)
+{
+	gpiod_set_value_cansleep(bl->reset_gpio, 1);
+	usleep_range(1000, 1100);
+	gpiod_set_value_cansleep(bl->buck_gpio, 0);
+	usleep_range(5000, 5500);
+	gpiod_set_value_cansleep(bl->ldo_gpio, 0);
+}
+
+/* "dsim_set_panel_power_enable" */
+static void dsim_bl_rails_on(struct dsim_bl *bl)
+{
+	gpiod_set_value_cansleep(bl->ldo_gpio, 1);
+	usleep_range(2000, 2200);
+	gpiod_set_value_cansleep(bl->buck_gpio, 1);
+	usleep_range(2000, 2200);
+}
+
+/* "dsim_reset_panel", after the lanes are back in LP-11 */
+static void dsim_bl_panel_reset(struct dsim_bl *bl)
+{
+	gpiod_set_value_cansleep(bl->reset_gpio, 0);
+	usleep_range(2000, 2200);
+	gpiod_set_value_cansleep(bl->reset_gpio, 1);
+	usleep_range(1000, 1100);
+	gpiod_set_value_cansleep(bl->reset_gpio, 0);
+	usleep_range(6000, 6600);
+}
+
+static bool dsim_bl_has_rails(struct dsim_bl *bl)
+{
+	return bl->reset_gpio && bl->ldo_gpio && bl->buck_gpio;
+}
+
+/*
+ * Out of unprepare(), in the order of _dsim_enable() for both links,
+ * dsim_reg_start_dual() and hx83102e_init(): rails, lanes to LP-11 (the
+ * panel must see LP-11 when it leaves reset), panel reset, HS clocks
+ * (link 0 first), init sequence, sleep out. @full: the panel was (or is
+ * to be treated as) unpowered, so reset and initialise it.
+ */
+static int dsim_bl_wake(struct dsim_bl *bl, bool full)
+{
+	unsigned int i;
+	int ret;
+
+	if (full && dsim_bl_has_rails(bl))
+		dsim_bl_rails_on(bl);
+	for (i = 0; i < bl->nlinks; i++) {
+		/* a link that does not leave ULPS cleanly is switched off */
+		if (bl->ulps[i] && dsim_bl_ulps_exit(bl, i))
+			dsim_bl_lanes_off(bl, i);
+		if (bl->lanes_off[i]) {
+			ret = dsim_bl_lanes_on(bl, i);
+			if (ret)
+				return ret;
+		}
+	}
+	if (full && bl->reset_gpio)
+		dsim_bl_panel_reset(bl);
+	for (i = 0; i < bl->nlinks; i++) {
+		ret = dsim_bl_link_hs_on(bl, i);
+		if (ret)
+			return ret;
+	}
+	bl->state = DSIM_BL_ASLEEP;
+	if (full) {
+		ret = dsim_bl_panel_init(bl);
+		if (ret)
+			return ret;
+	}
+	return dsim_bl_sleep_out(bl);
+}
+
+/*
+ * Recovery: a link function reset (Samsung's answer to a stuck link), all
+ * the way down as for level 3, then a full wake-up with panel reset and
+ * init sequence. Without the rails the panel is only held in reset.
+ */
+static int dsim_bl_power_cycle(struct dsim_bl *bl)
+{
+	unsigned int i;
+
+	dsim_bl_function_reset(bl);
+	for (i = 0; i < bl->nlinks; i++) {
+		dsim_bl_hs_off(bl, i);
+		dsim_bl_lanes_off(bl, i);
+	}
+	if (dsim_bl_has_rails(bl))
+		dsim_bl_rails_off(bl);
+	else if (bl->reset_gpio)
+		gpiod_set_value_cansleep(bl->reset_gpio, 1);
+	bl->state = DSIM_BL_POWER_OFF;
+	msleep(DSIM_BL_POWER_CYCLE_MS);
+	return dsim_bl_wake(bl, true);
+}
+
+/*
+ * After a wake-up. One that failed leaves the panel powered, out of reset
+ * and the links as far up as they go (rather than dark and unpowered), and
+ * the next blank takes the panel all the way down so that the unblank
+ * after it initialises it from scratch.
+ */
+static void dsim_bl_wake_done(struct dsim_bl *bl, int err)
+{
+	void __iomem *base;
+	unsigned int i;
+
+	if (!err) {
+		if (bl->failed)
+			dev_info(bl->dev, "panel is back\n");
+		bl->failed = false;
+		bl->failures = 0;
+		return;
+	}
+
+	if (dsim_bl_has_rails(bl))
+		dsim_bl_rails_on(bl);
+	if (bl->reset_gpio)
+		gpiod_set_value_cansleep(bl->reset_gpio, 0);
+	for (i = 0; i < bl->nlinks; i++) {
+		base = bl->link[i];
+		if (bl->lanes_off[i])
+			dsim_bl_lanes_on(bl, i);
+		writel(readl(base + DSIM_CLK_CTRL) |
+		       DSIM_CLK_CTRL_TX_REQUEST_HSCLK, base + DSIM_CLK_CTRL);
+	}
+
+	bl->failed = true;
+	if (++bl->failures >= DSIM_BL_MAX_FAILURES) {
+		bl->broken = true;
+		dev_err(bl->dev,
+			"panel did not wake up (%d), blanking keeps it on from now\n",
+			err);
+	} else {
+		dev_err(bl->dev,
+			"panel did not wake up (%d), the next blank power cycles it\n",
+			err);
+	}
+}
+
+/* DPU: CRTC off, the video stream still runs */
+static unsigned int dsim_bl_disable(void *priv, unsigned int max_level)
+{
+	struct dsim_bl *bl = priv;
+	unsigned int level = READ_ONCE(power_off_level);
+	int ret;
+
+	guard(mutex)(&bl->seq_lock);
+	/* after a failed wake-up: down to the rails, the unblank inits */
+	if (bl->failed)
+		level = EXYNOS9810_PANEL_POWER_OFF;
+	if (bl->broken)
+		level = EXYNOS9810_PANEL_BACKLIGHT_OFF;
+	level = min3(level, max_level, bl->max_level);
+
+	bl->blanked = true;
+	dsim_bl_send_brightness(bl, 0);
+	if (level >= EXYNOS9810_PANEL_SLEEP) {
+		ret = dsim_bl_panel_sleep(bl, level >= EXYNOS9810_PANEL_POWER_OFF);
+		if (ret) {
+			/* drop the commands stuck in the FIFOs */
+			dsim_bl_function_reset(bl);
+			/* the panel may still be on: go no further */
+			if (!bl->failed) {
+				dev_err(bl->dev, "panel did not go to sleep: %d\n",
+					ret);
+				level = EXYNOS9810_PANEL_BACKLIGHT_OFF;
+			}
+		}
+		if (level >= EXYNOS9810_PANEL_SLEEP)
+			bl->state = DSIM_BL_ASLEEP;
+	}
+	dev_dbg(bl->dev, "blank, level %u\n", level);
+	return level;
+}
+
+/* DPU: DECON stopped (level >= LINK_OFF) */
+static void dsim_bl_unprepare(void *priv, unsigned int level)
+{
+	struct dsim_bl *bl = priv;
+	bool power_off = level >= EXYNOS9810_PANEL_POWER_OFF;
+	unsigned int i;
+
+	guard(mutex)(&bl->seq_lock);
+	if (level < EXYNOS9810_PANEL_LINK_OFF)
+		return;
+
+	/* link by link, as each stock DSIM device stops its own */
+	for (i = 0; i < bl->nlinks; i++) {
+		if (dsim_bl_hs_off(bl, i) && !power_off)
+			continue;
+		if (power_off)
+			dsim_bl_lanes_off(bl, i);
+		else if (link_ulps)
+			dsim_bl_link_ulps(bl, i);
+	}
+	bl->state = DSIM_BL_LINK_OFF;
+
+	if (power_off) {
+		dsim_bl_rails_off(bl);
+		bl->state = DSIM_BL_POWER_OFF;
+	}
+	dev_dbg(bl->dev, "links down, level %u\n", level);
+}
+
+/* DPU: before DECON starts again (level >= LINK_OFF) */
+static int dsim_bl_prepare(void *priv, unsigned int level)
+{
+	struct dsim_bl *bl = priv;
+	ktime_t start = ktime_get();
+	int ret;
+
+	guard(mutex)(&bl->seq_lock);
+	ret = dsim_bl_wake(bl, level >= EXYNOS9810_PANEL_POWER_OFF ||
+			   bl->failed);
+	if (ret) {
+		dev_warn(bl->dev, "panel wake-up failed (%d), power cycling it\n",
+			 ret);
+		ret = dsim_bl_power_cycle(bl);
+	}
+	dsim_bl_wake_done(bl, ret);
+	dev_dbg(bl->dev, "panel up in %lld ms (%d)\n",
+		ktime_ms_delta(ktime_get(), start), ret);
+	return ret;
+}
+
+/* DPU: DECON runs (again) */
+static void dsim_bl_enable(void *priv, unsigned int level)
+{
+	struct dsim_bl *bl = priv;
+	u8 cabc[2] = { MIPI_DCS_WRITE_POWER_SAVE };
+	int ret;
+
+	scoped_guard(mutex, &bl->seq_lock) {
+		if (level == EXYNOS9810_PANEL_SLEEP) {
+			ret = dsim_bl_sleep_out(bl);
+			if (ret) {
+				dev_warn(bl->dev, "SLEEP_OUT failed: %d\n", ret);
+				dsim_bl_function_reset(bl);
+				ret = dsim_bl_sleep_out(bl);
+			}
+			if (ret && bl->reset_gpio) {
+				/* last resort: reset and init the panel */
+				dsim_bl_panel_reset(bl);
+				ret = dsim_bl_panel_init(bl);
+				if (!ret)
+					ret = dsim_bl_sleep_out(bl);
+			}
+			dsim_bl_wake_done(bl, ret);
+		}
+		/* even after a failure: the panel may well be up */
+		if (level >= EXYNOS9810_PANEL_SLEEP) {
+			/* > 20 ms */
+			ret = dsim_bl_dcs_seq(bl, 21, MIPI_DCS_SET_DISPLAY_ON);
+			if (ret)
+				dev_err(bl->dev, "DISPLAY_ON failed: %d\n", ret);
+		}
+		/* the init sequence selected CABC mode 1 again */
+		if (bl->cabc_lost && bl->cabc >= 0) {
+			cabc[1] = bl->cabc;
+			dsim_bl_dcs_write(bl, cabc, sizeof(cabc));
+		}
+		bl->cabc_lost = false;
+		bl->state = DSIM_BL_ON;
+		bl->blanked = false;
+		if (!bl->removing)
+			dsim_bl_send_brightness(bl,
+						backlight_get_brightness(bl->bd));
+	}
+	dev_dbg(bl->dev, "unblank, level %u\n", level);
+
+	/* Night Light changed while blanked */
+	if (bl->dgc)
+		schedule_work(&bl->dgc_work);
+}
+
+/* from the DPU's commit: keep only the newest request, send it from a work */
+static void dsim_bl_set_gamma(void *priv, const u16 scale[3])
+{
+	struct dsim_bl *bl = priv;
+	unsigned long flags;
+
+	spin_lock_irqsave(&bl->dgc_slock, flags);
+	memcpy(bl->dgc_want, scale, sizeof(bl->dgc_want));
+	spin_unlock_irqrestore(&bl->dgc_slock, flags);
+	schedule_work(&bl->dgc_work);
+}
+
+static const struct exynos9810_panel_ops dsim_bl_panel_ops = {
+	.set_gamma = dsim_bl_set_gamma,
+	.disable = dsim_bl_disable,
+	.unprepare = dsim_bl_unprepare,
+	.prepare = dsim_bl_prepare,
+	.enable = dsim_bl_enable,
+};
+
+static const struct exynos9810_panel_ops dsim_bl_panel_ops_nogamma = {
+	.disable = dsim_bl_disable,
+	.unprepare = dsim_bl_unprepare,
+	.prepare = dsim_bl_prepare,
+	.enable = dsim_bl_enable,
+};
+
+/* the DPU brings a blanked panel back up before we go */
+static void dsim_bl_panel_remove(void *data)
+{
+	struct dsim_bl *bl = data;
+
+	bl->removing = true;
+	exynos9810_dpu_set_panel(NULL, NULL);
+	if (bl->dgc)
+		cancel_work_sync(&bl->dgc_work);
+}
+
+static int dsim_bl_update_status(struct backlight_device *bd)
+{
+	struct dsim_bl *bl = bl_get_data(bd);
+
+	guard(mutex)(&bl->seq_lock);
+	/* while the screen is blanked the level is only remembered */
+	if (bl->blanked)
+		return 0;
+	return dsim_bl_send_brightness(bl, backlight_get_brightness(bd));
+}
+
+static const struct backlight_ops dsim_bl_ops = {
+	.options = BL_CORE_SUSPENDRESUME,
+	.update_status = dsim_bl_update_status,
+};
+
+/*
+ * Content adaptive backlight control (DCS 0x55): 0 off, 1 user interface,
+ * 2 still picture, 3 moving image. Samsung's HX83102E init selects 1, which
+ * makes the visible brightness depend on the picture.
+ */
+static ssize_t cabc_mode_show(struct device *dev, struct device_attribute *attr,
+			      char *buf)
+{
+	struct dsim_bl *bl = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "%d\n", bl->cabc);
+}
+
+static ssize_t cabc_mode_store(struct device *dev, struct device_attribute *attr,
+			       const char *buf, size_t count)
+{
+	struct dsim_bl *bl = dev_get_drvdata(dev);
+	u8 cmd[2] = { MIPI_DCS_WRITE_POWER_SAVE };
+	unsigned int mode;
+	int ret;
+
+	ret = kstrtouint(buf, 0, &mode);
+	if (ret)
+		return ret;
+	if (mode > DCS_CABC_MAX)
+		return -EINVAL;
+
+	guard(mutex)(&bl->seq_lock);
+	/* a sleeping panel gets it on wake-up (level 3 re-inits it) */
+	if (bl->state == DSIM_BL_ON) {
+		cmd[1] = mode;
+		ret = dsim_bl_dcs_write(bl, cmd, sizeof(cmd));
+		if (ret)
+			return ret;
+	}
+
+	bl->cabc = mode;
+	return count;
+}
+static DEVICE_ATTR_RW(cabc_mode);
+
+/*
+ * "on", "asleep", "link-off" or "power-off"; "ulps" while a link is in
+ * ULPS, "failed" after a failed wake-up, "broken" after too many
+ */
+static ssize_t panel_state_show(struct device *dev,
+				struct device_attribute *attr, char *buf)
+{
+	struct dsim_bl *bl = dev_get_drvdata(dev);
+	bool ulps = false;
+	unsigned int i;
+
+	guard(mutex)(&bl->seq_lock);
+	for (i = 0; i < bl->nlinks; i++)
+		ulps |= bl->ulps[i];
+	return sysfs_emit(buf, "%s%s%s%s\n", dsim_bl_state_names[bl->state],
+			  ulps ? " ulps" : "", bl->failed ? " failed" : "",
+			  bl->broken ? " broken" : "");
+}
+static DEVICE_ATTR_RO(panel_state);
+
+static struct attribute *dsim_bl_attrs[] = {
+	&dev_attr_cabc_mode.attr,
+	&dev_attr_panel_state.attr,
+	NULL
+};
+ATTRIBUTE_GROUPS(dsim_bl);
+
+/* debugfs "dcs": write hex bytes "51 04 00" to send one DCS long write */
+static ssize_t dsim_bl_dcs_debugfs_write(struct file *file,
+					 const char __user *ubuf,
+					 size_t count, loff_t *ppos)
+{
+	struct dsim_bl *bl = file->private_data;
+	u8 cmd[DSIM_MAX_PAYLOAD];
+	char *kbuf, *p, *tok;
+	size_t len = 0;
+	int ret;
+
+	if (count > 4 * DSIM_MAX_PAYLOAD)
+		return -E2BIG;
+
+	kbuf = memdup_user_nul(ubuf, count);
+	if (IS_ERR(kbuf))
+		return PTR_ERR(kbuf);
+
+	p = kbuf;
+	while ((tok = strsep(&p, " \t\n,")) != NULL) {
+		if (!*tok)
+			continue;
+		if (len == ARRAY_SIZE(cmd)) {
+			ret = -E2BIG;
+			goto out;
+		}
+		ret = kstrtou8(tok, 16, &cmd[len++]);
+		if (ret)
+			goto out;
+	}
+
+	ret = dsim_bl_dcs_write(bl, cmd, len);
+out:
+	kfree(kbuf);
+	return ret ? ret : count;
+}
+
+static const struct file_operations dsim_bl_dcs_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.write = dsim_bl_dcs_debugfs_write,
+	.llseek = noop_llseek,
+};
+
+static void dsim_bl_debugfs_remove(void *data)
+{
+	debugfs_remove_recursive(data);
+}
+
+static int dsim_bl_check_link(struct dsim_bl *bl, unsigned int i)
+{
+	void __iomem *base = bl->link[i];
+	u32 ver = readl(base + DSIM_VERSION);
+	u32 fifo = readl(base + DSIM_FIFOCTRL);
+	u32 status = readl(base + DSIM_LINK_STATUS0);
+
+	dev_dbg(bl->dev, "link %u: version %#x config %#x status %#x fifo %#x\n",
+		i, ver, readl(base + DSIM_CONFIG), status, fifo);
+
+	if (!ver || ver == ~0U ||
+	    (fifo & DSIM_FIFOCTRL_INIT_ALL) != DSIM_FIFOCTRL_INIT_ALL)
+		return dev_err_probe(bl->dev, -ENODEV,
+				     "link %u is not running (version %#x, fifo %#x)\n",
+				     i, ver, fifo);
+
+	if (!(status & DSIM_LINK_STATUS0_VIDEO_MODE))
+		dev_info(bl->dev, "link %u is not in video mode\n", i);
+
+	return 0;
+}
+
+/* what level 3 restores: the bootloader's lanes, clocks and PLL */
+static bool dsim_bl_save_link(struct dsim_bl *bl, unsigned int i)
+{
+	void __iomem *base = bl->link[i];
+	u32 lanes = readl(base + DSIM_CONFIG) & DSIM_CONFIG_LANES_EN;
+
+	bl->lanes[i] = lanes;
+	bl->clk_ctrl[i] = readl(base + DSIM_CLK_CTRL) &
+			  ~DSIM_CLK_CTRL_TX_REQUEST_HSCLK;
+	bl->pll[i] = (readl(base + DSIM_PLLCTRL) & DSIM_PLLCTRL_PLL_EN) &&
+		     (readl(base + DSIM_LINK_STATUS3) &
+		      DSIM_LINK_STATUS3_PLL_STABLE);
+	dev_dbg(bl->dev, "link %u: lanes %#x clk_ctrl %#x pll %#x dphy %#x\n",
+		i, lanes, bl->clk_ctrl[i], readl(base + DSIM_PLLCTRL),
+		readl(base + DSIM_DPHY_STATUS));
+
+	/* the clock lane and at least one data lane */
+	return (lanes & BIT(0)) && (lanes >> 1);
+}
+
+static int dsim_bl_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.scale = BACKLIGHT_SCALE_LINEAR,
+	};
+	struct dentry *dir;
+	struct dsim_bl *bl;
+	unsigned int i;
+	u32 max, val;
+	int ret;
+
+	bl = devm_kzalloc(dev, sizeof(*bl), GFP_KERNEL);
+	if (!bl)
+		return -ENOMEM;
+
+	bl->dev = dev;
+	bl->cabc = -1;
+	ret = devm_mutex_init(dev, &bl->lock);
+	if (ret)
+		return ret;
+	ret = devm_mutex_init(dev, &bl->seq_lock);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < DSIM_MAX_LINKS; i++) {
+		if (!platform_get_resource(pdev, IORESOURCE_MEM, i))
+			break;
+		bl->link[i] = devm_platform_ioremap_resource(pdev, i);
+		if (IS_ERR(bl->link[i]))
+			return PTR_ERR(bl->link[i]);
+	}
+	bl->nlinks = i;
+	if (!bl->nlinks)
+		return dev_err_probe(dev, -EINVAL, "no DSIM registers\n");
+
+	/* none today: the bootloader leaves the display clocks running */
+	ret = devm_clk_bulk_get_all_enabled(dev, NULL);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "failed to enable clocks\n");
+
+	bl->max_level = EXYNOS9810_PANEL_POWER_OFF;
+	for (i = 0; i < bl->nlinks; i++) {
+		ret = dsim_bl_check_link(bl, i);
+		if (ret)
+			return ret;
+		if (!dsim_bl_save_link(bl, i)) {
+			dev_warn(dev, "link %u: unexpected lanes %#x, blanking keeps the links up\n",
+				 i, bl->lanes[i]);
+			bl->max_level = EXYNOS9810_PANEL_SLEEP;
+		}
+	}
+
+	/*
+	 * Panel power for power_off_level 3. The bootloader left the panel
+	 * running, so the rails are on and reset is released: request them
+	 * in that state.
+	 */
+	bl->reset_gpio = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(bl->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(bl->reset_gpio),
+				     "failed to get the reset GPIO\n");
+	bl->ldo_gpio = devm_gpiod_get_optional(dev, "ldo-enable", GPIOD_OUT_HIGH);
+	if (IS_ERR(bl->ldo_gpio))
+		return dev_err_probe(dev, PTR_ERR(bl->ldo_gpio),
+				     "failed to get the LDO enable GPIO\n");
+	bl->buck_gpio = devm_gpiod_get_optional(dev, "buck-enable", GPIOD_OUT_HIGH);
+	if (IS_ERR(bl->buck_gpio))
+		return dev_err_probe(dev, PTR_ERR(bl->buck_gpio),
+				     "failed to get the BUCK enable GPIO\n");
+
+	if (!dsim_bl_has_rails(bl))
+		bl->max_level = min_t(unsigned int, bl->max_level,
+				      EXYNOS9810_PANEL_LINK_OFF);
+
+	max = 4095;
+	device_property_read_u32(dev, "max-brightness", &max);
+	if (!max || max > 0xffff)
+		return dev_err_probe(dev, -EINVAL, "invalid max-brightness %u\n",
+				     max);
+	bl->brightness_bytes = max > 0xff ? 2 : 1;
+
+	val = max;
+	device_property_read_u32(dev, "default-brightness", &val);
+	props.max_brightness = max;
+	props.brightness = min(val, max);
+
+	platform_set_drvdata(pdev, bl);
+
+	bl->bd = devm_backlight_device_register(dev, dev_name(dev), dev, bl,
+						&dsim_bl_ops, &props);
+	if (IS_ERR(bl->bd))
+		return dev_err_probe(dev, PTR_ERR(bl->bd),
+				     "failed to register backlight\n");
+
+	/* the bootloader's level is unknown: start from a known one */
+	ret = backlight_update_status(bl->bd);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to set brightness\n");
+
+	dir = debugfs_create_dir(dev_name(dev), NULL);
+	debugfs_create_file("dcs", 0200, dir, bl, &dsim_bl_dcs_fops);
+	ret = devm_add_action_or_reset(dev, dsim_bl_debugfs_remove, dir);
+	if (ret)
+		return ret;
+
+	bl->dgc = device_property_read_bool(dev, "samsung,hx83102e-dgc");
+	INIT_WORK(&bl->dgc_work, dsim_bl_dgc_work);
+	spin_lock_init(&bl->dgc_slock);
+	/* the bootloader loaded Samsung's curves */
+	bl->dgc_sent[0] = bl->dgc_sent[1] = bl->dgc_sent[2] = 0xffff;
+	memcpy(bl->dgc_want, bl->dgc_sent, sizeof(bl->dgc_want));
+	ret = devm_add_action_or_reset(dev, dsim_bl_panel_remove, bl);
+	if (ret)
+		return ret;
+	exynos9810_dpu_set_panel(bl->dgc ? &dsim_bl_panel_ops :
+				 &dsim_bl_panel_ops_nogamma, bl);
+
+	dev_info(dev, "%u DSI link(s), brightness %u/%u%s%s, blank levels up to %u\n",
+		 bl->nlinks, props.brightness, props.max_brightness,
+		 bl->dgc ? ", panel digital gamma" : "",
+		 dsim_bl_has_rails(bl) ? ", panel power control" : "",
+		 bl->max_level);
+
+	return 0;
+}
+
+static const struct of_device_id dsim_bl_of_match[] = {
+	{ .compatible = "samsung,exynos9810-dsim-backlight" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, dsim_bl_of_match);
+
+static struct platform_driver dsim_bl_driver = {
+	.probe = dsim_bl_probe,
+	.driver = {
+		.name = "exynos9810-dsim-bl",
+		.of_match_table = dsim_bl_of_match,
+		.dev_groups = dsim_bl_groups,
+	},
+};
+module_platform_driver(dsim_bl_driver);
+
+MODULE_DESCRIPTION("DCS backlight on a bootloader-initialised Exynos9810 DSIM");
+MODULE_LICENSE("GPL");
