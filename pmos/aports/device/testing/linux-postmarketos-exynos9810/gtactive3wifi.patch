+/**
+ * brcmf_proto_msgbuf_h2d_mbdata() - send host-to-dongle mailbox data.
+ *
+ * @dev: device of the bus.
+ * @mbdata: mailbox bits (D3 inform, deep sleep ack, ...).
+ *
+ * PCIe IPC rev 6+ firmware that does not ask for the legacy mailbox takes
+ * the mailbox data as a message on the control submission ring.
+ */
+int brcmf_proto_msgbuf_h2d_mbdata(struct device *dev, u32 mbdata)
+{
+	struct brcmf_bus *bus_if = dev_get_drvdata(dev);
+	struct brcmf_pub *drvr = bus_if->drvr;
+	struct brcmf_msgbuf *msgbuf = (struct brcmf_msgbuf *)drvr->proto->pd;
+	struct msgbuf_h2d_mailbox_data *request;
+	struct brcmf_commonring *commonring;
+	void *ret_ptr;
+	int err;
+
+	commonring = msgbuf->commonrings[BRCMF_H2D_MSGRING_CONTROL_SUBMIT];
+	brcmf_commonring_lock(commonring);
+	ret_ptr = brcmf_commonring_reserve_for_write(commonring);
+	if (!ret_ptr) {
+		bphy_err(drvr, "Failed to reserve space in commonring\n");
+		brcmf_commonring_unlock(commonring);
+		return -ENOMEM;
+	}
+
+	request = (struct msgbuf_h2d_mailbox_data *)ret_ptr;
+	memset(request, 0, sizeof(*request));
+	request->msg.msgtype = MSGBUF_TYPE_H2D_MAILBOX_DATA;
+	request->mailbox_data = cpu_to_le32(mbdata);
+
+	err = brcmf_commonring_write_complete(commonring);
+	brcmf_commonring_unlock(commonring);
+
+	return err;
+}
