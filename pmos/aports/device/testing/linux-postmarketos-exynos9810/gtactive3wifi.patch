index 0000000000000000000000000000000000000000..2770b209b0807ab5714f93db6b2c94efae96f057
--- /dev/null
+++ b/drivers/iio/common/bcm4775_shub/tl.c
@@ -0,0 +1,910 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * BCM4775 sensor hub: Broadcom packet layer ("transport layer") and the
+ * RPC records inside it.
+ *
+ * Unstuffed packet: [seq][size][flags][flag details...][payload][crc]
+ *  - one detail byte per set flag bit, in increasing bit order; flag bit 7
+ *    (EXTENDED) carries flag bits 15:8, flag bit 6 (SIZE_EXT) size bits 15:8;
+ *  - CRC-8, polynomial 0x4d, initial 0, over everything but seq and crc,
+ *    sent with its nibbles swapped.
+ * On the wire the packet is framed by ESC SOP / ESC EOP and the bytes ESC,
+ * XON and XOFF are escaped. Raw XON/XOFF are dropped by the receiver.
+ *
+ * Both ends keep a packet sequence number and a separate sequence number
+ * for "reliable" packets, which are acknowledged (RELIABLE_ACK) and
+ * retransmitted until they are. Plain payload packets are acknowledged
+ * lazily: an ACK detail rides on the next packet we send anyway, and a
+ * bare ACK goes out after 200 unacknowledged packets. Before talking to a
+ * freshly started peer (ROM or application) the host asks for the peer's
+ * sequence numbers with a transport-internal packet ("sync").
+ */
+
+#include <linux/crc8.h>
+#include <linux/device.h>
+#include <linux/jiffies.h>
+#include <linux/slab.h>
+#include <linux/unaligned.h>
+
+#include "bcm4775_shub.h"
+
+enum {
+	TL_WAIT_ESC_SOP,
+	TL_WAIT_SOP,
+	TL_IN_PACKET,
+	TL_WAIT_ESC_CODE,
+};
+
+DECLARE_CRC8_TABLE(shub_crc8_table);
+
+static u8 tl_crc(const u8 *buf, size_t len)
+{
+	u8 crc = crc8(shub_crc8_table, buf, len, 0);
+
+	return (crc << 4) | (crc >> 4);
+}
+
+static size_t tl_stuff(u8 *dst, const u8 *src, size_t len)
+{
+	size_t n = 0, i;
+
+	for (i = 0; i < len; i++) {
+		switch (src[i]) {
+		case TL_ESC:
+			dst[n++] = TL_ESC;
+			dst[n++] = TL_ESC_ESC;
+			break;
+		case TL_XON:
+			dst[n++] = TL_ESC;
+			dst[n++] = TL_ESC_XON;
+			break;
+		case TL_XOFF:
+			dst[n++] = TL_ESC;
+			dst[n++] = TL_ESC_XOFF;
+			break;
+		default:
+			dst[n++] = src[i];
+		}
+	}
+
+	return n;
+}
+
+/*
+ * Build one packet and queue it. Caller holds tl->lock. ACK, MSG_LOST,
+ * GARBAGE, SIZE_EXT and EXTENDED are added here as needed. Returns the
+ * packet sequence number used, or a negative error.
+ */
+static int tl_send_locked(struct bcm4775_shub *shub, u16 flags,
+			  const u8 *payload, size_t len, u8 rseq)
+{
+	struct shub_tl *tl = &shub->tl;
+	u8 hdr[TL_MAX_HDR];
+	u8 *pkt, *wire;
+	size_t plen, n;
+	u32 lost, garbage;
+	int i, ret;
+	u8 seq;
+
+	if (len > TL_MAX_PAYLOAD)
+		return -EMSGSIZE;
+
+	if (tl->ack_pending)
+		flags |= TL_F_ACK;
+	if (tl->stats.rx_lost != tl->lost_reported)
+		flags |= TL_F_MSG_LOST;
+	if (tl->stats.rx_garbage != tl->garbage_reported)
+		flags |= TL_F_GARBAGE;
+	if (len > 0xff)
+		flags |= TL_F_SIZE_EXT;
+	if (flags & 0xff00)
+		flags |= TL_F_EXTENDED;
+
+	plen = 0;
+	hdr[plen++] = len & 0xff;
+	hdr[plen++] = flags & 0xff;
+	for (i = 0; i < 16; i++) {
+		u8 d = 0;
+
+		if (!(flags & BIT(i)))
+			continue;
+		switch (BIT(i)) {
+		case TL_F_ACK:
+			d = tl->rx_seq;
+			tl->ack_pending = 0;
+			break;
+		case TL_F_RELIABLE:
+			d = rseq;
+			break;
+		case TL_F_RELIABLE_ACK:
+		case TL_F_RELIABLE_NACK:
+			d = tl->rel_rx;
+			break;
+		case TL_F_MSG_LOST:
+			lost = tl->stats.rx_lost - tl->lost_reported;
+			d = min(lost, 255U);
+			tl->lost_reported += d;
+			break;
+		case TL_F_GARBAGE:
+			garbage = tl->stats.rx_garbage - tl->garbage_reported;
+			d = min(garbage, 255U);
+			tl->garbage_reported += d;
+			break;
+		case TL_F_SIZE_EXT:
+			d = len >> 8;
+			break;
+		case TL_F_EXTENDED:
+			d = flags >> 8;
+			break;
+		default:
+			d = 0;	/* INTERNAL, IGNORE_SEQ */
+		}
+		hdr[plen++] = d;
+	}
+
+	pkt = kmalloc(1 + plen + len + 1, GFP_KERNEL);
+	wire = kmalloc(2 * (1 + plen + len + 1) + 4, GFP_KERNEL);
+	if (!pkt || !wire) {
+		ret = -ENOMEM;
+		goto out;
+	}
+
+	seq = tl->tx_seq;
+	pkt[0] = seq;
+	memcpy(pkt + 1, hdr, plen);
+	if (len)
+		memcpy(pkt + 1 + plen, payload, len);
+	pkt[1 + plen + len] = tl_crc(pkt + 1, plen + len);
+
+	n = 0;
+	wire[n++] = TL_ESC;
+	wire[n++] = TL_SOP;
+	n += tl_stuff(wire + n, pkt, 1 + plen + len + 1);
+	wire[n++] = TL_ESC;
+	wire[n++] = TL_EOP;
+
+	ret = shub_queue_tx(shub, wire, n);
+	if (!ret) {
+		tl->tx_seq++;
+		tl->stats.tx_packets++;
+		ret = seq;
+	}
+
+out:
+	kfree(wire);
+	kfree(pkt);
+	return ret;
+}
+
+static void tl_schedule_tick(struct shub_tl *tl, unsigned int ms)
+{
+	mod_delayed_work(system_dfl_wq, &tl->tick, msecs_to_jiffies(ms));
+}
+
+static int tl_send_reliable_locked(struct bcm4775_shub *shub,
+				   const u8 *payload, size_t len)
+{
+	struct shub_tl *tl = &shub->tl;
+	struct shub_tl_rel *rel;
+	int ret;
+
+	rel = kmalloc(struct_size(rel, data, len), GFP_KERNEL);
+	if (!rel)
+		return -ENOMEM;
+
+	rel->rseq = tl->rel_tx_next;
+	rel->tries = 0;
+	rel->resend = false;
+	rel->len = len;
+	memcpy(rel->data, payload, len);
+
+	ret = tl_send_locked(shub, TL_F_RELIABLE, payload, len, rel->rseq);
+	if (ret < 0) {
+		kfree(rel);
+		return ret;
+	}
+
+	rel->sent = jiffies;
+	tl->rel_tx_next++;
+	tl->rel_bytes += len;
+	tl->stats.tx_reliable++;
+	list_add_tail(&rel->node, &tl->rel_queue);
+	tl_schedule_tick(tl, TL_REL_RETRY_MS);
+
+	return 0;
+}
+
+/* Send a payload made of RPC records. */
+int shub_tl_send_rpcs(struct bcm4775_shub *shub, const u8 *payload,
+		      size_t len, bool reliable)
+{
+	struct shub_tl *tl = &shub->tl;
+	int ret;
+
+	mutex_lock(&tl->lock);
+	if (tl->syncing)
+		ret = -EBUSY;
+	else if (reliable)
+		ret = tl_send_reliable_locked(shub, payload, len);
+	else
+		ret = tl_send_locked(shub, 0, payload, len, 0);
+	mutex_unlock(&tl->lock);
+
+	return ret < 0 ? ret : 0;
+}
+
+/*
+ * Append one RPC record [id][len][data]: id and len are one byte, or two
+ * bytes big-endian with bit 15 set when they do not fit in 7 bits.
+ */
+size_t shub_rpc_put(u8 *dst, u16 id, const u8 *data, size_t len)
+{
+	size_t n = 0;
+
+	if (id > 0x7f) {
+		dst[n++] = 0x80 | (id >> 8);
+		dst[n++] = id & 0xff;
+	} else {
+		dst[n++] = id;
+	}
+	if (len > 0x7f) {
+		dst[n++] = 0x80 | (len >> 8);
+		dst[n++] = len & 0xff;
+	} else {
+		dst[n++] = len;
+	}
+	if (len)
+		memcpy(dst + n, data, len);
+
+	return n + len;
+}
+
+int shub_tl_send_rpc(struct bcm4775_shub *shub, u16 id, const u8 *data,
+		     size_t len, bool reliable)
+{
+	u8 *buf;
+	size_t n;
+	int ret;
+
+	if (len > TL_MAX_PAYLOAD - 4)
+		return -EMSGSIZE;
+
+	buf = kmalloc(len + 4, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+
+	n = shub_rpc_put(buf, id, data, len);
+	ret = shub_tl_send_rpcs(shub, buf, n, reliable);
+	kfree(buf);
+
+	return ret;
+}
+
+/* Wait until every reliable packet has been acknowledged. */
+int shub_tl_wait_idle(struct bcm4775_shub *shub, unsigned int timeout_ms)
+{
+	struct shub_tl *tl = &shub->tl;
+	long ret;
+
+	ret = wait_event_timeout(tl->rel_wait,
+				 READ_ONCE(tl->failed) ||
+				 list_empty_careful(&tl->rel_queue),
+				 msecs_to_jiffies(timeout_ms));
+	if (READ_ONCE(tl->failed))
+		return -EIO;
+	return ret ? 0 : -ETIMEDOUT;
+}
+
+/* Wait until @len more reliable payload bytes fit into the window. */
+int shub_tl_wait_room(struct bcm4775_shub *shub, size_t len,
+		      unsigned int timeout_ms)
+{
+	struct shub_tl *tl = &shub->tl;
+	long ret;
+
+	ret = wait_event_timeout(tl->rel_wait,
+				 READ_ONCE(tl->failed) ||
+				 READ_ONCE(tl->rel_bytes) + len <= TL_REL_WINDOW,
+				 msecs_to_jiffies(timeout_ms));
+	if (READ_ONCE(tl->failed))
+		return -EIO;
+	return ret ? 0 : -ETIMEDOUT;
+}
+
+static void tl_free_rel_queue(struct shub_tl *tl)
+{
+	struct shub_tl_rel *rel, *tmp;
+
+	list_for_each_entry_safe(rel, tmp, &tl->rel_queue, node) {
+		list_del(&rel->node);
+		kfree(rel);
+	}
+	tl->rel_bytes = 0;
+	wake_up_all(&tl->rel_wait);
+}
+
+static void tl_send_sync_req(struct bcm4775_shub *shub)
+{
+	struct shub_tl *tl = &shub->tl;
+	u8 req[2] = { TL_INT_SEQ_REQ, ++tl->sync_n };
+
+	tl->sync_sent = jiffies;
+	tl_send_locked(shub, TL_F_INTERNAL | TL_F_IGNORE_SEQ, req, sizeof(req),
+		       0);
+}
+
+/*
+ * Ask the peer for its sequence numbers and adopt them. Up to six
+ * requests, 100 ms apart, like the stock host.
+ */
+int shub_tl_sync(struct bcm4775_shub *shub)
+{
+	struct shub_tl *tl = &shub->tl;
+	unsigned long left;
+
+	mutex_lock(&tl->lock);
+	/* nothing reliable may be in flight across a sync */
+	tl_free_rel_queue(tl);
+	tl->failed = false;
+	tl->syncing = true;
+	tl->sync_ok = false;
+	tl->sync_n = 0;
+	reinit_completion(&tl->synced);
+	tl_send_sync_req(shub);
+	tl_schedule_tick(tl, TL_SYNC_RETRY_MS);
+	mutex_unlock(&tl->lock);
+
+	left = wait_for_completion_timeout(&tl->synced,
+					   msecs_to_jiffies(TL_SYNC_RETRY_MS *
+							    (TL_SYNC_TRIES + 2)));
+
+	mutex_lock(&tl->lock);
+	if (!left)
+		tl->syncing = false;
+	left = tl->sync_ok;
+	mutex_unlock(&tl->lock);
+
+	return left ? 0 : -ETIMEDOUT;
+}
+
+static void tl_tick(struct work_struct *work)
+{
+	struct shub_tl *tl = container_of(to_delayed_work(work),
+					  struct shub_tl, tick);
+	struct bcm4775_shub *shub = container_of(tl, struct bcm4775_shub, tl);
+	struct shub_tl_rel *rel;
+	unsigned int next = 0;
+	bool failed = false;
+
+	mutex_lock(&tl->lock);
+
+	if (tl->syncing) {
+		if (time_after_eq(jiffies, tl->sync_sent +
+				  msecs_to_jiffies(TL_SYNC_RETRY_MS))) {
+			if (tl->sync_n < TL_SYNC_TRIES) {
+				tl_send_sync_req(shub);
+			} else {
+				tl->syncing = false;
+				tl->sync_ok = false;
+				complete(&tl->synced);
+			}
+		}
+		if (tl->syncing)
+			next = TL_SYNC_RETRY_MS;
+	}
+
+	list_for_each_entry(rel, &tl->rel_queue, node) {
+		unsigned long due = rel->sent + msecs_to_jiffies(TL_REL_RETRY_MS);
+
+		if (!rel->resend && time_before(jiffies, due))
+			continue;
+		if (rel->tries >= TL_REL_TRIES) {
+			failed = true;
+			break;
+		}
+		rel->tries++;
+		rel->resend = false;
+		rel->sent = jiffies;
+		tl->stats.tx_retries++;
+		tl_send_locked(shub, TL_F_RELIABLE, rel->data, rel->len,
+			       rel->rseq);
+	}
+	if (!list_empty(&tl->rel_queue) && !failed)
+		next = next ? min(next, 100U) : 100;
+
+	if (failed && !tl->failed) {
+		tl->failed = true;
+		wake_up_all(&tl->rel_wait);
+	}
+
+	if (next)
+		tl_schedule_tick(tl, next);
+
+	mutex_unlock(&tl->lock);
+
+	if (failed)
+		shub_request_reset(shub, "reliable packet not acknowledged");
+}
+
+/* RELIABLE_ACK: everything up to and including @rseq arrived. */
+static void tl_rel_ack(struct shub_tl *tl, u8 rseq)
+{
+	struct shub_tl_rel *rel, *tmp;
+	bool found = false;
+
+	list_for_each_entry(rel, &tl->rel_queue, node)
+		if (rel->rseq == rseq)
+			found = true;
+	if (!found)
+		return;
+
+	list_for_each_entry_safe(rel, tmp, &tl->rel_queue, node) {
+		u8 r = rel->rseq;
+
+		tl->rel_tx_acked = r;
+		tl->rel_bytes -= rel->len;
+		list_del(&rel->node);
+		kfree(rel);
+		if (r == rseq)
+			break;
+	}
+	wake_up_all(&tl->rel_wait);
+}
+
+/* RELIABLE_NACK: @rseq is the last good one; resend all after it. */
+static void tl_rel_nack(struct bcm4775_shub *shub, u8 rseq)
+{
+	struct shub_tl *tl = &shub->tl;
+	struct shub_tl_rel *rel;
+
+	tl_rel_ack(tl, rseq);
+	list_for_each_entry(rel, &tl->rel_queue, node)
+		rel->resend = true;
+	if (!list_empty(&tl->rel_queue))
+		tl_schedule_tick(tl, 0);
+}
+
+static void tl_internal_reply(struct bcm4775_shub *shub, u8 type,
+			      const u8 *data, size_t len)
+{
+	u8 buf[1 + 44];
+
+	buf[0] = type;
+	memcpy(buf + 1, data, len);
+	tl_send_locked(shub, TL_F_INTERNAL, buf, len + 1, 0);
+}
+
+static void tl_internal(struct bcm4775_shub *shub, const u8 *p, size_t len)
+{
+	struct shub_tl *tl = &shub->tl;
+	u8 resp[11 * 4];
+	int i;
+
+	tl->stats.rx_internal++;
+	if (!len)
+		return;
+
+	switch (p[0]) {
+	case TL_INT_SEQ_REQ:
+		if (len != 2)
+			break;
+		resp[0] = p[1];
+		resp[1] = tl->rx_seq;
+		resp[2] = tl->rx_ack;
+		resp[3] = tl->rel_rx;
+		resp[4] = tl->tx_seq;
+		resp[5] = tl->rel_tx_next;
+		resp[6] = tl->rel_tx_acked;
+		tl_internal_reply(shub, TL_INT_SEQ_RESP, resp, 7);
+		break;
+
+	case TL_INT_SEQ_RESP:
+		/*
+		 * [n][peer: last seq received][last ACK detail][last
+		 * reliable seq received][next seq][next reliable seq]
+		 * [last reliable seq acknowledged]
+		 */
+		if (len != 8 || !tl->syncing || p[1] != tl->sync_n)
+			break;
+		tl->tx_seq = p[2] + 1;
+		tl->rel_tx_next = p[4] + 1;
+		tl->rel_tx_acked = p[4];
+		tl->rx_seq = p[5];
+		tl->rel_rx = p[6] - 1;
+		tl->rel_rx_crc = 0;
+		tl->rel_rx_len = 0;
+		tl->syncing = false;
+		tl->sync_ok = true;
+		complete(&tl->synced);
+		break;
+
+	case TL_INT_STATS_REQ:
+		for (i = 0; i < 11; i++)
+			put_unaligned_le32(0, resp + 4 * i);
+		put_unaligned_le32(tl->stats.rx_garbage, resp + 0);
+		put_unaligned_le32(tl->stats.rx_lost, resp + 4);
+		put_unaligned_le32(tl->stats.remote_lost, resp + 8);
+		put_unaligned_le32(tl->stats.remote_garbage, resp + 12);
+		put_unaligned_le32(tl->stats.tx_packets, resp + 16);
+		put_unaligned_le32(tl->stats.rx_packets, resp + 20);
+		put_unaligned_le32(tl->stats.tx_reliable, resp + 32);
+		put_unaligned_le32(tl->stats.rx_reliable, resp + 36);
+		tl_internal_reply(shub, TL_INT_STATS_RESP, resp, 44);
+		break;
+
+	case TL_INT_SETTINGS_REQ:
+		put_unaligned_le16(TL_MAX_PAYLOAD, resp + 0);
+		put_unaligned_le16(TL_MAX_PAYLOAD, resp + 2);
+		put_unaligned_le16(TL_REL_RETRY_MS, resp + 4);
+		put_unaligned_le16(TL_REL_TRIES, resp + 6);
+		put_unaligned_le16(150, resp + 8);
+		tl_internal_reply(shub, TL_INT_SETTINGS_RESP, resp, 10);
+		break;
+
+	default:
+		break;
+	}
+}
+
+static int rpc_get_varlen(const u8 **p, const u8 *end, u16 *v)
+{
+	if (*p >= end)
+		return -EINVAL;
+	*v = *(*p)++;
+	if (*v & 0x80) {
+		if (*p >= end)
+			return -EINVAL;
+		*v = ((*v & 0x7f) << 8) | *(*p)++;
+	}
+	return 0;
+}
+
+static void rpc_text(struct bcm4775_shub *shub, const char *what,
+		     const u8 *p, size_t len)
+{
+	while (len && (p[len - 1] == '\0' || p[len - 1] == '\n'))
+		len--;
+	dev_info(shub->dev, "hub %s: %.*s\n", what, (int)len, p);
+}
+
+static void tl_rpc(struct bcm4775_shub *shub, u16 id, const u8 *p, u16 len)
+{
+	u16 n;
+
+	switch (id) {
+	case RPC_SENSOR_RESPONSE:
+		if (len < 2)
+			break;
+		n = get_unaligned_le16(p);
+		if (n != len - 2)
+			dev_warn_ratelimited(shub->dev,
+					     "sensor RPC: %u bytes in a %u-byte record\n",
+					     n, len);
+		shub_ssp_rx(shub, p + 2, min_t(u16, n, len - 2));
+		break;
+
+	case RPC_VERSION:
+	case RPC_VERSION_EXT:
+		if (len < 12)
+			break;
+		shub_on_version(shub, get_unaligned_le32(p),
+				get_unaligned_le32(p + 4),
+				get_unaligned_le32(p + 8));
+		break;
+
+	case RPC_PRINT:
+	case RPC_CONSOLE:
+		if (len < 2)
+			break;
+		n = get_unaligned_le16(p);
+		rpc_text(shub, "log", p + 2, min_t(u16, n, len - 2));
+		break;
+
+	case RPC_EXCEPTION:
+		if (len < 5)
+			break;
+		n = p[4];
+		dev_err(shub->dev, "hub exception, line %u\n",
+			get_unaligned_le32(p));
+		rpc_text(shub, "exception", p + 5, min_t(u16, n, len - 5));
+		break;
+
+	case RPC_EXCEPTION_ARGS:
+		if (len < 21)
+			break;
+		n = p[20];
+		dev_err(shub->dev, "hub exception (%d %d %d %d %d)\n",
+			get_unaligned_le32(p), get_unaligned_le32(p + 4),
+			get_unaligned_le32(p + 8), get_unaligned_le32(p + 12),
+			get_unaligned_le32(p + 16));
+		rpc_text(shub, "exception", p + 21, min_t(u16, n, len - 21));
+		break;
+
+	default:
+		shub->tl.stats.rpc_unknown++;
+		dev_dbg(shub->dev, "RPC %#x, %u bytes\n", id, len);
+		break;
+	}
+}
+
+static void tl_rpcs(struct bcm4775_shub *shub, const u8 *p, size_t len)
+{
+	const u8 *end = p + len;
+	u16 id, rlen;
+
+	/* the records must exactly fill the payload */
+	for (const u8 *q = p; q < end; q += rlen)
+		if (rpc_get_varlen(&q, end, &id) ||
+		    rpc_get_varlen(&q, end, &rlen) || rlen > end - q) {
+			shub->tl.stats.rx_bad_format++;
+			return;
+		}
+
+	while (p < end) {
+		rpc_get_varlen(&p, end, &id);
+		rpc_get_varlen(&p, end, &rlen);
+		tl_rpc(shub, id, p, rlen);
+		p += rlen;
+	}
+}
+
+/* One unstuffed packet is in tl->msg. Runs in the transfer work only. */
+static void tl_packet(struct bcm4775_shub *shub)
+{
+	struct shub_tl *tl = &shub->tl;
+	const u8 *p = tl->msg;
+	unsigned int left;
+	u8 seq, crc, rseq = 0, rack = 0, rnack = 0;
+	u16 size, flags, all;
+	bool deliver = false;
+	u16 reply = 0;
+	int i;
+
+	if (tl->len < 4) {
+		tl->stats.rx_bad_format++;
+		return;
+	}
+
+	crc = tl_crc(tl->msg + 1, tl->len - 2);
+	if (crc != tl->msg[tl->len - 1]) {
+		tl->stats.rx_bad_crc++;
+		return;
+	}
+
+	seq = *p++;
+	size = *p++;
+	flags = *p++;
+	all = flags;
+	left = tl->len - 4;		/* minus seq, size, flags, crc */
+
+	for (i = 0; i < 16 && flags && left; i++) {
+		u16 bit = BIT(i);
+		u8 d;
+
+		if (!(flags & bit))
+			continue;
+		flags &= ~bit;
+		d = *p++;
+		left--;
+
+		switch (bit) {
+		case TL_F_ACK:
+			tl->rx_ack = d;
+			break;
+		case TL_F_RELIABLE:
+			rseq = d;
+			break;
+		case TL_F_RELIABLE_ACK:
+			rack = d;
+			break;
+		case TL_F_RELIABLE_NACK:
+			rnack = d;
+			break;
+		case TL_F_MSG_LOST:
+			tl->stats.remote_lost += d;
+			break;
+		case TL_F_GARBAGE:
+			tl->stats.remote_garbage += d;
+			break;
+		case TL_F_SIZE_EXT:
+			size |= d << 8;
+			break;
+		case TL_F_EXTENDED:
+			flags |= d << 8;
+			all |= d << 8;
+			break;
+		default:
+			break;	/* INTERNAL, IGNORE_SEQ: detail is 0 */
+		}
+	}
+
+	if (flags || size != left) {
+		tl->stats.rx_bad_format++;
+		return;
+	}
+
+	mutex_lock(&tl->lock);
+
+	tl->stats.rx_packets++;
+	if (!(all & TL_F_IGNORE_SEQ) && !tl->syncing &&
+	    seq != (u8)(tl->rx_seq + 1))
+		tl->stats.rx_lost += (u8)(seq - tl->rx_seq - 1);
+	tl->rx_seq = seq;
+
+	if (!left && (all & TL_F_ACK)) {
+		/* a bare acknowledgment */
+		deliver = false;
+	} else {
+		deliver = left != 0;
+		if (!(all & TL_F_RELIABLE) && ++tl->ack_pending > TL_ACK_EVERY)
+			reply = TL_F_ACK;
+	}
+
+	if (all & TL_F_RELIABLE) {
+		tl->stats.rx_reliable++;
+		if (rseq == tl->rel_rx && crc == tl->rel_rx_crc &&
+		    left == tl->rel_rx_len) {
+			/* duplicate: our acknowledgment got lost */
+			tl->stats.rx_dup++;
+			deliver = false;
+			reply = TL_F_ACK | TL_F_RELIABLE_ACK;
+		} else if (rseq == (u8)(tl->rel_rx + 1)) {
+			tl->rel_rx = rseq;
+			tl->rel_rx_crc = crc;
+			tl->rel_rx_len = left;
+			reply = TL_F_ACK | TL_F_RELIABLE_ACK;
+		} else {
+			deliver = false;
+			reply = TL_F_ACK | TL_F_RELIABLE_NACK;
+		}
+	}
+
+	if (reply)
+		tl_send_locked(shub, reply, NULL, 0, 0);
+
+	if (all & TL_F_RELIABLE_ACK)
+		tl_rel_ack(tl, rack);
+	if (all & TL_F_RELIABLE_NACK)
+		tl_rel_nack(shub, rnack);
+
+	if (deliver && (all & TL_F_INTERNAL)) {
+		tl_internal(shub, p, left);
+		deliver = false;
+	}
+
+	mutex_unlock(&tl->lock);
+
+	if (deliver)
+		tl_rpcs(shub, p, left);
+}
+
+static void tl_put(struct shub_tl *tl, u8 c)
+{
+	if (tl->len < sizeof(tl->msg)) {
+		tl->msg[tl->len++] = c;
+		tl->state = TL_IN_PACKET;
+	} else {
+		tl->stats.rx_bad_format++;
+		tl->state = TL_WAIT_ESC_SOP;
+	}
+}
+
+/* Bytes from the chip. Runs in the transfer work only. */
+void shub_tl_rx(struct bcm4775_shub *shub, const u8 *buf, size_t len)
+{
+	struct shub_tl *tl = &shub->tl;
+	size_t i;
+
+	for (i = 0; i < len; i++) {
+		u8 c = buf[i];
+
+		if (c == TL_XON || c == TL_XOFF)
+			continue;
+
+		switch (tl->state) {
+		case TL_WAIT_ESC_SOP:
+			if (c == TL_ESC)
+				tl->state = TL_WAIT_SOP;
+			else
+				tl->stats.rx_garbage++;
+			break;
+		case TL_WAIT_SOP:
+			if (c == TL_SOP) {
+				tl->state = TL_IN_PACKET;
+				tl->len = 0;
+			} else if (c != TL_ESC) {
+				tl->stats.rx_garbage += 2;
+				tl->state = TL_WAIT_ESC_SOP;
+			}
+			break;
+		case TL_IN_PACKET:
+			if (c == TL_ESC)
+				tl->state = TL_WAIT_ESC_CODE;
+			else
+				tl_put(tl, c);
+			break;
+		case TL_WAIT_ESC_CODE:
+			switch (c) {
+			case TL_EOP:
+				tl->state = TL_WAIT_ESC_SOP;
+				tl_packet(shub);
+				break;
+			case TL_ESC_ESC:
+				tl_put(tl, TL_ESC);
+				break;
+			case TL_ESC_XON:
+				tl_put(tl, TL_XON);
+				break;
+			case TL_ESC_XOFF:
+				tl_put(tl, TL_XOFF);
+				break;
+			case TL_SOP:
+				/* missed an EOP: a new packet starts here */
+				tl->stats.rx_bad_format++;
+				tl->len = 0;
+				tl->state = TL_IN_PACKET;
+				break;
+			case TL_ESC:
+				tl->stats.rx_bad_format++;
+				tl->state = TL_WAIT_SOP;
+				break;
+			default:
+				tl->stats.rx_bad_format++;
+				tl->state = TL_WAIT_ESC_SOP;
+			}
+			break;
+		}
+	}
+}
+
+/* Forget all sequence state, as for a peer that was just reset. */
+void shub_tl_reset(struct bcm4775_shub *shub)
+{
+	struct shub_tl *tl = &shub->tl;
+
+	mutex_lock(&tl->lock);
+	tl_free_rel_queue(tl);
+	tl->state = TL_WAIT_ESC_SOP;
+	tl->len = 0;
+	tl->tx_seq = 0;
+	tl->rx_seq = 0xff;
+	tl->rx_ack = 0;
+	tl->rel_tx_next = 0;
+	tl->rel_tx_acked = 0xff;
+	tl->rel_rx = 0xff;
+	tl->rel_rx_crc = 0;
+	tl->rel_rx_len = 0;
+	tl->ack_pending = 0;
+	tl->lost_reported = tl->stats.rx_lost;
+	tl->garbage_reported = tl->stats.rx_garbage;
+	tl->failed = false;
+	tl->syncing = false;
+	mutex_unlock(&tl->lock);
+}
+
+void shub_tl_stop(struct bcm4775_shub *shub)
+{
+	struct shub_tl *tl = &shub->tl;
+
+	cancel_delayed_work_sync(&tl->tick);
+	mutex_lock(&tl->lock);
+	tl_free_rel_queue(tl);
+	if (tl->syncing) {
+		tl->syncing = false;
+		complete(&tl->synced);
+	}
+	mutex_unlock(&tl->lock);
+}
+
+void shub_tl_init(struct bcm4775_shub *shub)
+{
+	struct shub_tl *tl = &shub->tl;
+
+	crc8_populate_msb(shub_crc8_table, 0x4d);
+	mutex_init(&tl->lock);
+	INIT_LIST_HEAD(&tl->rel_queue);
+	init_waitqueue_head(&tl->rel_wait);
+	INIT_DELAYED_WORK(&tl->tick, tl_tick);
+	init_completion(&tl->synced);
+	shub_tl_reset(shub);
+}
