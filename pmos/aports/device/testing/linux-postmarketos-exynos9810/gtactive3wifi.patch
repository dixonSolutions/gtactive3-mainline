@@ -0,0 +1,17 @@
+// SPDX-License-Identifier: GPL-2.0 OR BSD-3-Clause
+/*
+ * Bring-up variant: enable the HSI2C bus in CMGP USI_CMGP00, SW_CONF 0x14212000, for the A96T3x6 grip sensor.
+ * The base DTB keeps it disabled until the bus has been tested, because
+ * the USI driver programs the bus's SW_CONF register at boot.
+ */
+
+/dts-v1/;
+/plugin/;
+
+&usi_cmgp00 {
+	status = "okay";
+};
+
+&hsi2c_34 {
+	status = "okay";
+};
diff --git a/arch/arm64/boot/dts/exynos/exynos9810-gtactive3wifi-i2cgpio.dtso b/arch/arm64/boot/dts/exynos/exynos9810-gtactive3wifi-i2cgpio.dtso
new file mode 100644
index 0000000000000000000000000000000000000000..9c6dfc7eb8e11c97de45e35b8b6dbeb265a45b45
--- /dev/null
+++ b/arch/arm64/boot/dts/exynos/exynos9810-gtactive3wifi-i2cgpio.dtso
@@ -0,0 +1,77 @@
+// SPDX-License-Identifier: GPL-2.0 OR BSD-3-Clause
+/*
+ * Bring-up variant: reach the MAX77705 through a bit-banged I2C bus on the
+ * HSI2C_40 pins (SDA = gpm15-0, SCL = gpm14-0, found by the init.c probe)
+ * while the HSI2C_40 controller still times out. The board has external
+ * pull-ups on both lines.
+ */
+
+/dts-v1/;
+/plugin/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include "exynos-pinctrl.h"
+
+&hsi2c_40 {
+	status = "disabled";
+};
+
+&pinctrl_cmgp {
+	i2c40_gpio_pins: i2c40-gpio-pins {
+		samsung,pins = "gpm14-0", "gpm15-0";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_INPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
+	};
+};
+
+&{/} {
+	i2c-40 {
+		compatible = "i2c-gpio";
+		sda-gpios = <&gpm15 0 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		scl-gpios = <&gpm14 0 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		/* 5 us half period, about 100 kHz */
+		i2c-gpio,delay-us = <5>;
+		pinctrl-0 = <&i2c40_gpio_pins>;
+		pinctrl-names = "default";
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		gpio_max77705: pmic@66 {
+			compatible = "maxim,max77705";
+			reg = <0x66>;
+			interrupts-extended = <&gpa1 6 IRQ_TYPE_LEVEL_LOW>;
+			interrupt-controller;
+			#interrupt-cells = <1>;
+			pinctrl-0 = <&max77705_irq>;
+			pinctrl-names = "default";
+		};
+
+		gpio_max77705_charger: charger@69 {
+			compatible = "maxim,max77705-charger";
+			reg = <0x69>;
+			interrupt-parent = <&gpio_max77705>;
+			interrupts = <0>;
+			monitored-battery = <&battery>;
+			power-supplies = <&gpio_max77705_usbc>;
+		};
+
+		gpio_max77705_usbc: usb-c@25 {
+			compatible = "maxim,max77705-usbc";
+			reg = <0x25>;
+			interrupt-parent = <&gpio_max77705>;
+			interrupts = <3>;
+		};
+
+		fuel-gauge@36 {
+			compatible = "maxim,max77705-battery";
+			reg = <0x36>;
+			interrupt-parent = <&gpio_max77705>;
+			interrupts = <2>;
+			monitored-battery = <&battery>;
+			shunt-resistor-micro-ohms = <5000>;
+			power-supplies = <&gpio_max77705_charger>;
+		};
+	};
+};
diff --git a/arch/arm64/boot/dts/exynos/exynos9810-gtactive3wifi-nfc.dtso b/arch/arm64/boot/dts/exynos/exynos9810-gtactive3wifi-nfc.dtso
