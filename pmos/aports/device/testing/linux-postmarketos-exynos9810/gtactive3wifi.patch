@@ -0,0 +1,883 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Exynos9810 DPU (DECON + IDMA) takeover KMS driver.
+ *
+ * The bootloader powers the panel, runs both DSI links in video mode and
+ * leaves DECON0 scanning out one window from a framebuffer through one IDMA
+ * channel. This driver keeps that configuration and only flips the scanout
+ * buffer: it writes the channel's IDMA_IN_BASE_ADDR_Y and asks DECON for a
+ * shadow register update, which the hardware latches at the next frame
+ * start. Vblank comes from the DECON frame start interrupt.
+ *
+ * Register layout from Samsung's GPL dpu_9810 driver (regs-decon.h,
+ * regs-dpp.h): DECON at 0x16030000, IDMA channel n at 0x16071000 +
+ * n * 0x1000, DPP n at 0x16021000 + n * 0x1000.
+ *
+ * Screen blank (DPMS off, system sleep) goes as far down as the panel
+ * driver allows (its power_off_level parameter): backlight off, panel
+ * asleep, then DECON stopped with the DSI links' HS clocks off, then the
+ * lanes and the panel rails off. DECON is only stopped and restarted,
+ * never reset, so the bootloader's configuration survives; the DPU power
+ * domain stays on. If DECON gives no frames after an unblank (a DSI link
+ * that did not come back stalls it), vblank comes from a timer until the
+ * next blank, so that DRM clients do not wait for vblanks forever.
+ *
+ * The CRTC gamma LUT (GNOME's Night Light) is not applied in the DPU: the
+ * VGRF HDR block garbled the picture. With "samsung,panel-gamma" it is
+ * reduced to per-channel scales (Night Light ramps are linear per channel)
+ * and handed to the panel driver, which loads them into the panel's own
+ * digital gamma tables (see exynos9810-panel-gamma.h).
+ *
+ * The DRM driver is called "exynos" so that Mesa's kmsro loader pairs it
+ * with the Mali (panfrost) render node: GNOME then renders on the GPU and
+ * scans out the result directly.
+ */
+
+#include <linux/aperture.h>
+#include <linux/debugfs.h>
+#include <linux/dma-mapping.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/module.h>
+#include <linux/notifier.h>
+#include <linux/of.h>
+#include <linux/of_reserved_mem.h>
+#include <linux/platform_device.h>
+#include <linux/spinlock.h>
+#include <linux/wait.h>
+
+#include <drm/clients/drm_client_setup.h>
+#include <drm/drm_atomic_helper.h>
+#include <drm/drm_color_mgmt.h>
+#include <drm/drm_drv.h>
+#include <drm/drm_fb_dma_helper.h>
+#include <drm/drm_fbdev_dma.h>
+#include <drm/drm_fourcc.h>
+#include <drm/drm_framebuffer.h>
+#include <drm/drm_gem_atomic_helper.h>
+#include <drm/drm_gem_dma_helper.h>
+#include <drm/drm_gem_framebuffer_helper.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_modeset_lock.h>
+#include <drm/drm_prime.h>
+#include <drm/drm_probe_helper.h>
+#include <drm/drm_simple_kms_helper.h>
+#include <drm/drm_vblank.h>
+
+#include <soc/samsung/exynos9810-panel-gamma.h>
+
+/* DECON */
+#define DECON_GLOBAL_CONTROL		0x0000
+#define GLOBAL_CONTROL_RUN_STATUS	BIT(4)
+#define GLOBAL_CONTROL_DECON_EN		BIT(1)
+#define GLOBAL_CONTROL_DECON_EN_F	BIT(0)
+#define DECON_INTERRUPT_ENABLE		0x0040
+#define DPU_FRAME_DONE_INT_EN		BIT(13)
+#define DPU_FRAME_START_INT_EN		BIT(12)
+#define DPU_INT_EN			BIT(0)
+#define DECON_INTERRUPT_PENDING		0x004c
+#define DPU_FRAME_DONE_INT_PEND		BIT(13)
+#define DPU_FRAME_START_INT_PEND	BIT(12)
+#define DPU_EXTRA_INT_PEND		BIT(4)
+#define DECON_EXTRA_INTERRUPT_PENDING	0x0050
+#define DECON_SHADOW_REG_UPDATE_REQ	0x0060
+#define SHADOW_REG_UPDATE_REQ_GLOBAL	BIT(31)
+#define SHADOW_REG_UPDATE_REQ_WIN(w)	BIT(w)
+
+/* IDMA channel */
+#define IDMA_SRC_SIZE			0x0010
+#define IDMA_IN_BASE_ADDR_Y		0x0040
+#define E9810_GAMMA_SIZE		256
+
+struct e9810_dpu {
+	struct drm_device drm;
+	struct drm_simple_display_pipe pipe;
+	struct drm_connector conn;
+
+	void __iomem *decon;
+	void __iomem *idma;
+	u32 win;
+	bool panel_gamma;
+
+	u32 width, height, width_mm, height_mm, refresh;
+	u32 boot_addr;
+	bool irq_ok;
+	/* shutdown/unbind: blank with the backlight only */
+	bool going_down;
+
+	/* DECON_INTERRUPT_ENABLE, and the frame count below */
+	spinlock_t int_lock;
+	/* frame starts counted by e9810_frames_flow() */
+	wait_queue_head_t frame_wq;
+	unsigned int frames;
+	bool counting;
+	/* no frames from DECON since the last unblank: vblank from a timer */
+	bool vblank_timer;
+};
+
+static inline struct e9810_dpu *to_dpu(struct drm_device *drm)
+{
+	return container_of(drm, struct e9810_dpu, drm);
+}
+
+/* one opaque window: no blending is set up, so no alpha formats */
+static const u32 e9810_formats[] = {
+	DRM_FORMAT_XRGB8888,
+};
+
+/* ---- connector: the fixed panel mode ---- */
+
+static int e9810_conn_get_modes(struct drm_connector *conn)
+{
+	struct e9810_dpu *dpu = to_dpu(conn->dev);
+	struct drm_display_mode *mode;
+	/* blanking as in the stock panel timing, only the totals matter here */
+	u32 htotal = dpu->width + 32 + 32 + 2;
+	u32 vtotal = dpu->height + 16 + 16 + 2;
+
+	mode = drm_mode_create(conn->dev);
+	if (!mode)
+		return 0;
+	mode->hdisplay = dpu->width;
+	mode->hsync_start = dpu->width + 32;
+	mode->hsync_end = dpu->width + 34;
+	mode->htotal = htotal;
+	mode->vdisplay = dpu->height;
+	mode->vsync_start = dpu->height + 16;
+	mode->vsync_end = dpu->height + 18;
+	mode->vtotal = vtotal;
+	mode->clock = DIV_ROUND_UP(htotal * vtotal * dpu->refresh, 1000);
+	mode->type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+	drm_mode_set_name(mode);
+	drm_mode_probed_add(conn, mode);
+
+	conn->display_info.width_mm = dpu->width_mm;
+	conn->display_info.height_mm = dpu->height_mm;
+	return 1;
+}
+
+static const struct drm_connector_helper_funcs e9810_conn_helper_funcs = {
+	.get_modes = e9810_conn_get_modes,
+};
+
+static const struct drm_connector_funcs e9810_conn_funcs = {
+	.fill_modes = drm_helper_probe_single_connector_modes,
+	.destroy = drm_connector_cleanup,
+	.reset = drm_atomic_helper_connector_reset,
+	.atomic_duplicate_state = drm_atomic_helper_connector_duplicate_state,
+	.atomic_destroy_state = drm_atomic_helper_connector_destroy_state,
+};
+
+/* ---- the pipe ---- */
+
+static void e9810_flip(struct e9810_dpu *dpu, dma_addr_t addr)
+{
+	writel(lower_32_bits(addr), dpu->idma + IDMA_IN_BASE_ADDR_Y);
+	writel(SHADOW_REG_UPDATE_REQ_WIN(dpu->win) | SHADOW_REG_UPDATE_REQ_GLOBAL,
+	       dpu->decon + DECON_SHADOW_REG_UPDATE_REQ);
+}
+
+/* frame start interrupt on/off, for vblank and e9810_frames_flow() */
+static void e9810_frame_start_irq(struct e9810_dpu *dpu, bool on)
+{
+	unsigned long flags;
+	u32 v;
+
+	spin_lock_irqsave(&dpu->int_lock, flags);
+	v = readl(dpu->decon + DECON_INTERRUPT_ENABLE);
+	if (on)
+		v |= DPU_FRAME_START_INT_EN | DPU_INT_EN;
+	else
+		v &= ~DPU_FRAME_START_INT_EN;
+	writel(v, dpu->decon + DECON_INTERRUPT_ENABLE);
+	spin_unlock_irqrestore(&dpu->int_lock, flags);
+}
+
+/*
+ * After an unblank, before vblank is switched on: does DECON give frames?
+ * A DSI link that did not come back stalls DECON within its first frame,
+ * so wait for two frame starts (four frame times at most).
+ */
+static bool e9810_frames_flow(struct e9810_dpu *dpu)
+{
+	long timeout = msecs_to_jiffies(4 * 1000 / dpu->refresh + 1);
+	bool ok;
+
+	spin_lock_irq(&dpu->int_lock);
+	dpu->frames = 0;
+	dpu->counting = true;
+	spin_unlock_irq(&dpu->int_lock);
+	/* one latched before the unblank does not count */
+	writel(DPU_FRAME_START_INT_PEND, dpu->decon + DECON_INTERRUPT_PENDING);
+	e9810_frame_start_irq(dpu, true);
+	ok = wait_event_timeout(dpu->frame_wq, READ_ONCE(dpu->frames) >= 2,
+				timeout);
+	e9810_frame_start_irq(dpu, false);
+	spin_lock_irq(&dpu->int_lock);
+	dpu->counting = false;
+	spin_unlock_irq(&dpu->int_lock);
+	return ok;
+}
+
+/* ---- DECON stop/start (screen blank) ---- */
+
+/*
+ * Per-frame stop as in Samsung's decon_reg_stop_perframe(): DECON finishes
+ * the frame and goes idle. Unlike Samsung we do not soft-reset DECON
+ * afterwards, which would lose the bootloader's configuration.
+ */
+static int e9810_decon_stop(struct e9810_dpu *dpu)
+{
+	/* one frame plus 20 % and 5 ms, as Samsung waits */
+	u32 timeout_us = (1000000 / dpu->refresh) * 12 / 10 + 5000;
+	u32 val;
+	int ret;
+
+	val = readl(dpu->decon + DECON_GLOBAL_CONTROL);
+	writel(val & ~GLOBAL_CONTROL_DECON_EN_F,
+	       dpu->decon + DECON_GLOBAL_CONTROL);
+	writel(SHADOW_REG_UPDATE_REQ_GLOBAL,
+	       dpu->decon + DECON_SHADOW_REG_UPDATE_REQ);
+	ret = readl_poll_timeout(dpu->decon + DECON_GLOBAL_CONTROL, val,
+				 !(val & GLOBAL_CONTROL_RUN_STATUS),
+				 200, timeout_us);
+	if (!ret)
+		return 0;
+
+	/* instant stop, Samsung's fallback */
+	dev_warn(dpu->drm.dev, "DECON did not stop at frame end, stopping now\n");
+	val = readl(dpu->decon + DECON_GLOBAL_CONTROL);
+	writel(val & ~(GLOBAL_CONTROL_DECON_EN | GLOBAL_CONTROL_DECON_EN_F),
+	       dpu->decon + DECON_GLOBAL_CONTROL);
+	writel(SHADOW_REG_UPDATE_REQ_GLOBAL,
+	       dpu->decon + DECON_SHADOW_REG_UPDATE_REQ);
+	ret = readl_poll_timeout(dpu->decon + DECON_GLOBAL_CONTROL, val,
+				 !(val & GLOBAL_CONTROL_RUN_STATUS),
+				 200, timeout_us);
+	if (ret) {
+		/* still scanning out: leave it running and say so */
+		val = readl(dpu->decon + DECON_GLOBAL_CONTROL);
+		writel(val | GLOBAL_CONTROL_DECON_EN | GLOBAL_CONTROL_DECON_EN_F,
+		       dpu->decon + DECON_GLOBAL_CONTROL);
+		writel(SHADOW_REG_UPDATE_REQ_GLOBAL,
+		       dpu->decon + DECON_SHADOW_REG_UPDATE_REQ);
+		dev_err(dpu->drm.dev, "DECON does not stop (%#x)\n", val);
+	}
+	return ret;
+}
+
+/* decon_reg_start(): enable, request a global shadow update, wait for run */
+static int e9810_decon_start(struct e9810_dpu *dpu)
+{
+	u32 val;
+	int ret, try;
+
+	for (try = 0; try < 2; try++) {
+		val = readl(dpu->decon + DECON_GLOBAL_CONTROL);
+		writel(val | GLOBAL_CONTROL_DECON_EN | GLOBAL_CONTROL_DECON_EN_F,
+		       dpu->decon + DECON_GLOBAL_CONTROL);
+		writel(SHADOW_REG_UPDATE_REQ_WIN(dpu->win) |
+		       SHADOW_REG_UPDATE_REQ_GLOBAL,
+		       dpu->decon + DECON_SHADOW_REG_UPDATE_REQ);
+		ret = readl_poll_timeout(dpu->decon + DECON_GLOBAL_CONTROL, val,
+					 val & GLOBAL_CONTROL_RUN_STATUS,
+					 200, 20000);
+		if (!ret)
+			return 0;
+	}
+	dev_err(dpu->drm.dev, "DECON does not start again (%#x)\n", val);
+	return ret;
+}
+
+/* ---- panel hooks: gamma LUT -> panel digital gamma, screen blank ---- */
+
+static DEFINE_MUTEX(e9810_panel_lock);
+static const struct exynos9810_panel_ops *e9810_panel_ops;
+static void *e9810_panel_priv;
+static u16 e9810_gamma_scale[3] = { 0xffff, 0xffff, 0xffff };
+static struct e9810_dpu *e9810_dpu_inst;
+static bool e9810_panel_on = true;
+/* while blanked: how far down the panel went, and whether DECON stopped */
+static unsigned int e9810_off_level;
+static bool e9810_decon_stopped;
+static BLOCKING_NOTIFIER_HEAD(e9810_panel_nh);
+
+/* for touch controllers inside the panel, see exynos9810-panel-gamma.h */
+int exynos9810_panel_register_notifier(struct notifier_block *nb)
+{
+	return blocking_notifier_chain_register(&e9810_panel_nh, nb);
+}
+EXPORT_SYMBOL_GPL(exynos9810_panel_register_notifier);
+
+int exynos9810_panel_unregister_notifier(struct notifier_block *nb)
+{
+	return blocking_notifier_chain_unregister(&e9810_panel_nh, nb);
+}
+EXPORT_SYMBOL_GPL(exynos9810_panel_unregister_notifier);
+
+/* screen blank, with e9810_panel_lock held */
+static void e9810_panel_blank(struct e9810_dpu *dpu, unsigned int max_level)
+{
+	const struct exynos9810_panel_ops *ops = e9810_panel_ops;
+	unsigned int level = EXYNOS9810_PANEL_BACKLIGHT_OFF;
+
+	if (!e9810_panel_on)
+		return;
+	e9810_panel_on = false;
+
+	if (ops && ops->disable)
+		level = ops->disable(e9810_panel_priv, max_level);
+	if (level >= EXYNOS9810_PANEL_LINK_OFF) {
+		if (e9810_decon_stop(dpu))
+			/* DECON still feeds the links: keep them up */
+			level = EXYNOS9810_PANEL_SLEEP;
+		else
+			e9810_decon_stopped = true;
+	}
+	if (level >= EXYNOS9810_PANEL_LINK_OFF && ops->unprepare)
+		ops->unprepare(e9810_panel_priv, level);
+	e9810_off_level = level;
+
+	blocking_notifier_call_chain(&e9810_panel_nh, EXYNOS9810_PANEL_BLANK,
+				     &level);
+}
+
+/* screen unblank, with e9810_panel_lock held */
+static void e9810_panel_unblank(struct e9810_dpu *dpu)
+{
+	const struct exynos9810_panel_ops *ops = e9810_panel_ops;
+	unsigned int level = e9810_off_level;
+
+	if (e9810_panel_on)
+		return;
+
+	/* the panel driver logs and retries itself; DECON must run anyway */
+	if (level >= EXYNOS9810_PANEL_LINK_OFF && ops && ops->prepare)
+		ops->prepare(e9810_panel_priv, level);
+	if (e9810_decon_stopped) {
+		e9810_decon_start(dpu);
+		e9810_decon_stopped = false;
+	}
+	if (ops && ops->enable)
+		ops->enable(e9810_panel_priv, level);
+
+	e9810_off_level = EXYNOS9810_PANEL_BACKLIGHT_OFF;
+	e9810_panel_on = true;
+
+	blocking_notifier_call_chain(&e9810_panel_nh, EXYNOS9810_PANEL_UNBLANK,
+				     &level);
+}
+
+/*
+ * Called by the panel driver (NULL to unregister). It gets the current
+ * state at once, so it may load after the first commit. A panel driver
+ * that goes away while the screen is blanked first gets the panel and
+ * DECON back up (it keeps its backlight off), so that nothing is left
+ * stopped without a driver to restart it.
+ */
+void exynos9810_dpu_set_panel(const struct exynos9810_panel_ops *ops, void *priv)
+{
+	mutex_lock(&e9810_panel_lock);
+	if (!e9810_panel_on && e9810_dpu_inst && e9810_panel_ops) {
+		/* back to "blanked with the backlight only" */
+		if (e9810_off_level >= EXYNOS9810_PANEL_LINK_OFF &&
+		    e9810_panel_ops->prepare)
+			e9810_panel_ops->prepare(e9810_panel_priv,
+						 e9810_off_level);
+		if (e9810_decon_stopped) {
+			e9810_decon_start(e9810_dpu_inst);
+			e9810_decon_stopped = false;
+		}
+		if (e9810_off_level >= EXYNOS9810_PANEL_SLEEP &&
+		    e9810_panel_ops->enable)
+			e9810_panel_ops->enable(e9810_panel_priv,
+						e9810_off_level);
+		e9810_off_level = EXYNOS9810_PANEL_BACKLIGHT_OFF;
+		blocking_notifier_call_chain(&e9810_panel_nh,
+					     EXYNOS9810_PANEL_UNBLANK,
+					     &e9810_off_level);
+	}
+
+	e9810_panel_ops = ops;
+	e9810_panel_priv = priv;
+	if (ops && ops->set_gamma)
+		ops->set_gamma(priv, e9810_gamma_scale);
+	/* registered while blanked: backlight off only, DECON keeps running */
+	if (ops && ops->disable && !e9810_panel_on)
+		ops->disable(priv, EXYNOS9810_PANEL_BACKLIGHT_OFF);
+	mutex_unlock(&e9810_panel_lock);
+}
+EXPORT_SYMBOL_GPL(exynos9810_dpu_set_panel);
+
+/* each channel's top LUT entry: exact for GNOME's linear Night Light ramps */
+static void e9810_set_gamma(struct e9810_dpu *dpu, struct drm_property_blob *blob)
+{
+	const struct drm_color_lut *lut;
+	u16 scale[3] = { 0xffff, 0xffff, 0xffff };
+	unsigned int n;
+
+	if (!dpu->panel_gamma)
+		return;
+	if (blob) {
+		lut = blob->data;
+		n = drm_color_lut_size(blob);
+		if (n) {
+			scale[0] = lut[n - 1].red;
+			scale[1] = lut[n - 1].green;
+			scale[2] = lut[n - 1].blue;
+		}
+	}
+
+	mutex_lock(&e9810_panel_lock);
+	if (memcmp(scale, e9810_gamma_scale, sizeof(scale))) {
+		memcpy(e9810_gamma_scale, scale, sizeof(scale));
+		if (e9810_panel_ops && e9810_panel_ops->set_gamma)
+			e9810_panel_ops->set_gamma(e9810_panel_priv,
+						   e9810_gamma_scale);
+	}
+	mutex_unlock(&e9810_panel_lock);
+}
+
+static int e9810_check(struct drm_simple_display_pipe *pipe,
+		       struct drm_plane_state *pstate,
+		       struct drm_crtc_state *cstate)
+{
+	struct e9810_dpu *dpu = to_dpu(pipe->crtc.dev);
+	struct drm_framebuffer *fb = pstate->fb;
+
+	if (!fb)
+		return 0;
+	/* the IDMA keeps the bootloader's source size, stride and format */
+	if (fb->width != dpu->width || fb->height != dpu->height ||
+	    fb->pitches[0] != dpu->width * 4 || fb->offsets[0])
+		return -EINVAL;
+	return 0;
+}
+
+static void e9810_send_event(struct drm_crtc *crtc, bool vblank_ok)
+{
+	struct drm_pending_vblank_event *event = crtc->state->event;
+
+	if (!event)
+		return;
+	crtc->state->event = NULL;
+
+	spin_lock_irq(&crtc->dev->event_lock);
+	if (vblank_ok && drm_crtc_vblank_get(crtc) == 0)
+		drm_crtc_arm_vblank_event(crtc, event);
+	else
+		drm_crtc_send_vblank_event(crtc, event);
+	spin_unlock_irq(&crtc->dev->event_lock);
+}
+
+static void e9810_update(struct drm_simple_display_pipe *pipe,
+			 struct drm_plane_state *old)
+{
+	struct e9810_dpu *dpu = to_dpu(pipe->crtc.dev);
+	struct drm_plane_state *pstate = pipe->plane.state;
+
+	if (pipe->crtc.state->color_mgmt_changed)
+		e9810_set_gamma(dpu, pipe->crtc.state->gamma_lut);
+	if (pstate->fb && pstate->fb != old->fb)
+		e9810_flip(dpu, drm_fb_dma_get_gem_addr(pstate->fb, pstate, 0));
+
+	e9810_send_event(&pipe->crtc, dpu->irq_ok);
+}
+
+static void e9810_enable(struct drm_simple_display_pipe *pipe,
+			 struct drm_crtc_state *cstate,
+			 struct drm_plane_state *pstate)
+{
+	struct e9810_dpu *dpu = to_dpu(pipe->crtc.dev);
+
+	e9810_set_gamma(dpu, cstate->gamma_lut);
+	/* the first frame after a DECON restart shows the new buffer */
+	if (pstate->fb)
+		e9810_flip(dpu, drm_fb_dma_get_gem_addr(pstate->fb, pstate, 0));
+
+	mutex_lock(&e9810_panel_lock);
+	e9810_panel_unblank(dpu);
+	mutex_unlock(&e9810_panel_lock);
+
+	if (dpu->irq_ok) {
+		/*
+		 * Without frames DRM would wait for vblanks that never come:
+		 * every atomic commit times out and the compositor stalls.
+		 * The next blank and unblank try the panel again.
+		 */
+		WRITE_ONCE(dpu->vblank_timer, !e9810_frames_flow(dpu));
+		if (dpu->vblank_timer)
+			dev_warn(dpu->drm.dev,
+				 "no frames from DECON, vblank from a timer until the next blank\n");
+		drm_crtc_vblank_on(&pipe->crtc);
+	}
+	e9810_send_event(&pipe->crtc, dpu->irq_ok);
+}
+
+static void e9810_disable(struct drm_simple_display_pipe *pipe)
+{
+	struct e9810_dpu *dpu = to_dpu(pipe->crtc.dev);
+
+	mutex_lock(&e9810_panel_lock);
+	e9810_panel_blank(dpu, dpu->going_down ? EXYNOS9810_PANEL_BACKLIGHT_OFF :
+			  EXYNOS9810_PANEL_POWER_OFF);
+	mutex_unlock(&e9810_panel_lock);
+
+	/*
+	 * Userspace may free the buffer now: point the IDMA back at the boot
+	 * framebuffer (latched at the next frame, or when DECON restarts).
+	 */
+	if (dpu->boot_addr)
+		e9810_flip(dpu, dpu->boot_addr);
+	if (dpu->irq_ok)
+		drm_crtc_vblank_off(&pipe->crtc);
+}
+
+/* vblank_timer only changes while vblank is off (see e9810_enable()) */
+static int e9810_enable_vblank(struct drm_simple_display_pipe *pipe)
+{
+	struct e9810_dpu *dpu = to_dpu(pipe->crtc.dev);
+
+	if (dpu->vblank_timer)
+		return drm_crtc_vblank_start_timer(&pipe->crtc);
+	e9810_frame_start_irq(dpu, true);
+	return 0;
+}
+
+static void e9810_disable_vblank(struct drm_simple_display_pipe *pipe)
+{
+	struct e9810_dpu *dpu = to_dpu(pipe->crtc.dev);
+
+	if (dpu->vblank_timer)
+		drm_crtc_vblank_cancel_timer(&pipe->crtc);
+	else
+		e9810_frame_start_irq(dpu, false);
+}
+
+static const struct drm_simple_display_pipe_funcs e9810_pipe_funcs = {
+	.check = e9810_check,
+	.enable = e9810_enable,
+	.disable = e9810_disable,
+	.update = e9810_update,
+	.enable_vblank = e9810_enable_vblank,
+	.disable_vblank = e9810_disable_vblank,
+};
+
+static irqreturn_t e9810_irq(int irq, void *data)
+{
+	struct e9810_dpu *dpu = data;
+	u32 pend = readl(dpu->decon + DECON_INTERRUPT_PENDING);
+	u32 ext;
+
+	if (!pend)
+		return IRQ_NONE;
+	writel(pend, dpu->decon + DECON_INTERRUPT_PENDING);
+	if (pend & DPU_EXTRA_INT_PEND) {
+		ext = readl(dpu->decon + DECON_EXTRA_INTERRUPT_PENDING);
+		writel(ext, dpu->decon + DECON_EXTRA_INTERRUPT_PENDING);
+	}
+	if (!(pend & DPU_FRAME_START_INT_PEND))
+		return IRQ_HANDLED;
+
+	spin_lock(&dpu->int_lock);
+	if (dpu->counting) {
+		dpu->frames++;
+		wake_up(&dpu->frame_wq);
+	}
+	spin_unlock(&dpu->int_lock);
+	if (dpu->irq_ok && !READ_ONCE(dpu->vblank_timer))
+		drm_crtc_handle_vblank(&dpu->pipe.crtc);
+	return IRQ_HANDLED;
+}
+
+/*
+ * debugfs "scanout": the pixels of the buffer on screen (XRGB8888, width x
+ * height x 4), for screenshots over the debug console without a compositor
+ * API. Only buffers with a kernel mapping (dumb/DMA GEM) can be read.
+ */
+static ssize_t e9810_scanout_read(struct file *file, char __user *buf,
+				  size_t len, loff_t *ppos)
+{
+	struct e9810_dpu *dpu = file->private_data;
+	struct drm_plane *plane = &dpu->pipe.plane;
+	struct drm_gem_dma_object *gem;
+	size_t size = dpu->width * dpu->height * 4;
+	ssize_t ret;
+
+	drm_modeset_lock(&plane->mutex, NULL);
+	if (!plane->state || !plane->state->fb) {
+		ret = -ENODATA;
+		goto out;
+	}
+	gem = drm_fb_dma_get_gem_obj(plane->state->fb, 0);
+	if (!gem || !gem->vaddr) {
+		ret = -EIO;
+		goto out;
+	}
+	ret = simple_read_from_buffer(buf, len, ppos, gem->vaddr, size);
+out:
+	drm_modeset_unlock(&plane->mutex);
+	return ret;
+}
+
+static const struct file_operations e9810_scanout_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.read = e9810_scanout_read,
+	.llseek = default_llseek,
+};
+
+static void e9810_debugfs_init(struct drm_minor *minor)
+{
+	struct e9810_dpu *dpu = to_dpu(minor->dev);
+
+	debugfs_create_file("scanout", 0400, minor->debugfs_root, dpu,
+			    &e9810_scanout_fops);
+}
+
+static const struct drm_mode_config_funcs e9810_mode_config_funcs = {
+	.fb_create = drm_gem_fb_create,
+	.atomic_check = drm_atomic_helper_check,
+	.atomic_commit = drm_atomic_helper_commit,
+};
+
+DEFINE_DRM_GEM_DMA_FOPS(e9810_fops);
+
+/*
+ * The IDMA takes one 32-bit address and the DPU has no IOMMU (SysMMU in
+ * bypass), so only physically contiguous buffers below 4 GiB can be
+ * scanned out: our own CMA dumb buffers (Mesa's kmsro allocates the
+ * compositor's buffers here). Mutter still offers client buffers
+ * (panfrost shmem, mostly above 4 GiB and scattered) for direct scanout;
+ * mapping those for a device with a 32-bit DMA mask bounces them through
+ * swiotlb ("swiotlb buffer is full", CPU copies of megabytes, slots taken
+ * from UFS, which also has a 32-bit mask) only for the import to fail on
+ * contiguity afterwards. Refuse foreign buffers before anything is mapped.
+ */
+static struct drm_gem_object *e9810_gem_prime_import(struct drm_device *drm,
+						     struct dma_buf *dma_buf)
+{
+	if (!drm_gem_is_prime_exported_dma_buf(drm, dma_buf))
+		return ERR_PTR(-EOPNOTSUPP);
+	return drm_gem_prime_import(drm, dma_buf);
+}
+
+static const struct drm_driver e9810_drm_driver = {
+	.driver_features = DRIVER_MODESET | DRIVER_GEM | DRIVER_ATOMIC,
+	/* "exynos": Mesa's kmsro pairs it with the panfrost render node */
+	.name = "exynos",
+	.desc = "Exynos9810 DPU (bootloader takeover)",
+	.major = 1,
+	.minor = 0,
+	.fops = &e9810_fops,
+	DRM_GEM_DMA_DRIVER_OPS,
+	.gem_prime_import = e9810_gem_prime_import,
+	DRM_FBDEV_DMA_DRIVER_OPS,
+	.debugfs_init = e9810_debugfs_init,
+};
+
+static int e9810_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct e9810_dpu *dpu;
+	struct drm_device *drm;
+	int ret, i, nirq;
+	u32 cur;
+
+	dpu = devm_drm_dev_alloc(dev, &e9810_drm_driver, struct e9810_dpu, drm);
+	if (IS_ERR(dpu))
+		return PTR_ERR(dpu);
+	drm = &dpu->drm;
+
+	spin_lock_init(&dpu->int_lock);
+	init_waitqueue_head(&dpu->frame_wq);
+
+	dpu->decon = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(dpu->decon))
+		return PTR_ERR(dpu->decon);
+	dpu->idma = devm_platform_ioremap_resource(pdev, 1);
+	if (IS_ERR(dpu->idma))
+		return PTR_ERR(dpu->idma);
+
+	of_property_read_u32(dev->of_node, "samsung,window", &dpu->win);
+	if (of_property_read_u32(dev->of_node, "width", &dpu->width) ||
+	    of_property_read_u32(dev->of_node, "height", &dpu->height))
+		return dev_err_probe(dev, -EINVAL, "no width/height\n");
+	of_property_read_u32(dev->of_node, "width-mm", &dpu->width_mm);
+	of_property_read_u32(dev->of_node, "height-mm", &dpu->height_mm);
+	dpu->refresh = 60;
+	of_property_read_u32(dev->of_node, "refresh-rate", &dpu->refresh);
+
+	cur = readl(dpu->idma + IDMA_IN_BASE_ADDR_Y);
+	dpu->boot_addr = cur;
+	dev_info(dev, "window %u, IDMA base 0x%08x, src size 0x%08x, %ux%u@%u\n",
+		 dpu->win, cur, readl(dpu->idma + IDMA_SRC_SIZE),
+		 dpu->width, dpu->height, dpu->refresh);
+	if (!cur)
+		return dev_err_probe(dev, -ENODEV,
+				     "IDMA channel is not scanning out\n");
+
+	dpu->panel_gamma = of_property_read_bool(dev->of_node,
+						 "samsung,panel-gamma");
+
+	/* take the scanout over from simpledrm on the boot framebuffer */
+	ret = aperture_remove_conflicting_devices(cur, dpu->width * dpu->height * 4,
+						  e9810_drm_driver.name);
+	if (ret)
+		return ret;
+	/* and keep it: simpledrm probing after us then backs off */
+	ret = devm_aperture_acquire_for_platform_device(pdev, cur,
+							dpu->width * dpu->height * 4);
+	if (ret)
+		dev_warn(dev, "could not claim the boot framebuffer: %d\n", ret);
+
+	/* the IDMA takes 32-bit addresses (no SysMMU in use) */
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (ret)
+		return ret;
+	ret = of_reserved_mem_device_init(dev);
+	if (ret && ret != -ENODEV)
+		return ret;
+
+	ret = drmm_mode_config_init(drm);
+	if (ret)
+		return ret;
+	drm->mode_config.min_width = dpu->width;
+	drm->mode_config.max_width = dpu->width;
+	drm->mode_config.min_height = dpu->height;
+	drm->mode_config.max_height = dpu->height;
+	drm->mode_config.preferred_depth = 24;
+	drm->mode_config.funcs = &e9810_mode_config_funcs;
+
+	drm_connector_helper_add(&dpu->conn, &e9810_conn_helper_funcs);
+	ret = drm_connector_init(drm, &dpu->conn, &e9810_conn_funcs,
+				 DRM_MODE_CONNECTOR_DSI);
+	if (ret)
+		return ret;
+
+	ret = drm_simple_display_pipe_init(drm, &dpu->pipe, &e9810_pipe_funcs,
+					   e9810_formats,
+					   ARRAY_SIZE(e9810_formats),
+					   NULL, &dpu->conn);
+	if (ret)
+		return ret;
+	if (dpu->panel_gamma) {
+		drm_mode_crtc_set_gamma_size(&dpu->pipe.crtc, E9810_GAMMA_SIZE);
+		drm_crtc_enable_color_mgmt(&dpu->pipe.crtc, 0, false,
+					   E9810_GAMMA_SIZE);
+	}
+
+	/*
+	 * All DECON interrupts share one status register. Vblank is set up
+	 * before the handler can run: S-Boot left the interrupts enabled.
+	 * Frame done (also from S-Boot) is not used: it fired about 50 times
+	 * a second with vblank off, so mask it. Frame start is enabled only
+	 * while DRM wants vblank events.
+	 */
+	writel(readl(dpu->decon + DECON_INTERRUPT_ENABLE) &
+	       ~(DPU_FRAME_DONE_INT_EN | DPU_FRAME_START_INT_EN),
+	       dpu->decon + DECON_INTERRUPT_ENABLE);
+	writel(DPU_FRAME_DONE_INT_PEND | DPU_FRAME_START_INT_PEND,
+	       dpu->decon + DECON_INTERRUPT_PENDING);
+	nirq = platform_irq_count(pdev);
+	if (nirq > 0) {
+		ret = drm_vblank_init(drm, 1);
+		if (ret)
+			return ret;
+	}
+	for (i = 0; i < nirq; i++) {
+		int irq = platform_get_irq(pdev, i);
+
+		if (irq < 0)
+			continue;
+		ret = devm_request_irq(dev, irq, e9810_irq, IRQF_SHARED,
+				       dev_name(dev), dpu);
+		if (!ret)
+			dpu->irq_ok = true;
+	}
+	if (!dpu->irq_ok)
+		dev_warn(dev, "no DECON interrupt, flips complete at once\n");
+
+	drm_mode_config_reset(drm);
+	platform_set_drvdata(pdev, drm);
+
+	mutex_lock(&e9810_panel_lock);
+	e9810_dpu_inst = dpu;
+	mutex_unlock(&e9810_panel_lock);
+
+	ret = drm_dev_register(drm, 0);
+	if (ret)
+		return ret;
+	drm_client_setup(drm, NULL);
+	return 0;
+}
+
+static void e9810_remove(struct platform_device *pdev)
+{
+	struct drm_device *drm = platform_get_drvdata(pdev);
+	struct e9810_dpu *dpu = to_dpu(drm);
+
+	dpu->going_down = true;
+	drm_dev_unplug(drm);
+	drm_atomic_helper_shutdown(drm);
+
+	/* leave the pipe running as the bootloader did, backlight aside */
+	mutex_lock(&e9810_panel_lock);
+	if (!e9810_panel_on && e9810_decon_stopped) {
+		if (e9810_panel_ops && e9810_panel_ops->prepare)
+			e9810_panel_ops->prepare(e9810_panel_priv,
+						 e9810_off_level);
+		e9810_decon_start(dpu);
+		e9810_decon_stopped = false;
+	}
+	e9810_dpu_inst = NULL;
+	mutex_unlock(&e9810_panel_lock);
+}
+
+/* reboot/poweroff: backlight off only, as before (the bootloader re-inits) */
+static void e9810_shutdown(struct platform_device *pdev)
+{
+	struct drm_device *drm = platform_get_drvdata(pdev);
+
+	to_dpu(drm)->going_down = true;
+	drm_atomic_helper_shutdown(drm);
+}
+
+/*
+ * System sleep: switch the pipe off like a screen blank (as far down as
+ * the panel driver's power_off_level allows, see e9810_panel_blank()) and
+ * restore the state on resume.
+ */
+static int e9810_pm_suspend(struct device *dev)
+{
+	return drm_mode_config_helper_suspend(dev_get_drvdata(dev));
+}
+
+static int e9810_pm_resume(struct device *dev)
+{
+	return drm_mode_config_helper_resume(dev_get_drvdata(dev));
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(e9810_pm_ops, e9810_pm_suspend, e9810_pm_resume);
+
+static const struct of_device_id e9810_of_match[] = {
+	{ .compatible = "samsung,exynos9810-decon-takeover" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, e9810_of_match);
+
+static struct platform_driver e9810_driver = {
+	.probe = e9810_probe,
+	.remove = e9810_remove,
+	.shutdown = e9810_shutdown,
+	.driver = {
+		.name = "exynos9810-dpu",
+		.of_match_table = e9810_of_match,
+		.pm = pm_sleep_ptr(&e9810_pm_ops),
+	},
+};
+module_platform_driver(e9810_driver);
+
+MODULE_DESCRIPTION("Exynos9810 DPU bootloader-takeover KMS driver");
+MODULE_LICENSE("GPL");
