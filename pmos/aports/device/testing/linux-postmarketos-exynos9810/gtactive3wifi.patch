+
+&pinctrl_peric0 {
+	touch_rst: touch-rst-pins {
+		samsung,pins = "gpg0-6";
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+	};
+
+	nfc_pd: nfc-pd-pins {
+		samsung,pins = "gpg1-0";
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
