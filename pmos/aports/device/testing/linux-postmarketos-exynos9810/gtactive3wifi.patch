+static int gc5035_write_gain(struct gc5035 *gc5035, u32 gain)
+{
+	u32 permille = DIV_ROUND_CLOSEST(gain * 1000, 256);
+	unsigned int i = ARRAY_SIZE(gc5035_again) - 1;
+	u32 dgain;
+	int ret = 0;
+
+	/* largest analogue step not above the request, digital for the rest */
+	while (i && gc5035_again[i].permille > permille)
+		i--;
+	dgain = DIV_ROUND_CLOSEST(permille * 256, gc5035_again[i].permille);
+
+	cci_write(gc5035->regmap, GC5035_REG_PAGE, 0, &ret);
+	cci_write(gc5035->regmap, GC5035_REG_AGAIN, gc5035_again[i].code, &ret);
+	cci_write(gc5035->regmap, GC5035_REG_DGAIN_INT, (dgain >> 8) & 0x0f, &ret);
+	cci_write(gc5035->regmap, GC5035_REG_DGAIN_FRAC, dgain & 0xfc, &ret);
+	return ret;
+}
+
+static int gc5035_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct gc5035 *gc5035 = container_of(ctrl->handler, struct gc5035,
+					     ctrl_handler);
+	const struct gc5035_mode *mode = gc5035->mode;
+	s64 exposure_max;
+	u32 val;
+	int ret = 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		exposure_max = mode->height + ctrl->val - GC5035_EXPOSURE_MARGIN;
+		__v4l2_ctrl_modify_range(gc5035->exposure,
+					 gc5035->exposure->minimum,
+					 exposure_max,
+					 gc5035->exposure->step,
+					 gc5035->exposure->default_value);
+	}
+
+	if (!pm_runtime_get_if_active(gc5035->dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = gc5035_write_gain(gc5035, ctrl->val);
+		break;
+	case V4L2_CID_EXPOSURE:
+		/* the stock driver keeps the integration time a multiple of 4 */
+		val = ctrl->val & ~3;
+		cci_write(gc5035->regmap, GC5035_REG_PAGE, 0, &ret);
+		cci_write(gc5035->regmap, GC5035_REG_EXPOSURE_H, (val >> 8) & 0x3f, &ret);
+		cci_write(gc5035->regmap, GC5035_REG_EXPOSURE_L, val & 0xff, &ret);
+		break;
+	case V4L2_CID_VBLANK:
+		/* frame length lines, a multiple of 4 */
+		val = min_t(u32, mode->height + ctrl->val, GC5035_VTS_MAX);
+		cci_write(gc5035->regmap, GC5035_REG_PAGE, 0, &ret);
+		cci_write(gc5035->regmap, GC5035_REG_VTS_H, (val >> 8) & 0x3f, &ret);
+		cci_write(gc5035->regmap, GC5035_REG_VTS_L, val & 0xfc, &ret);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put(gc5035->dev);
+
+	return ret;
+}
