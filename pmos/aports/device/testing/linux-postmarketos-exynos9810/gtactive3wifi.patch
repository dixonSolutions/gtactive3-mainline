+/* -----------------------------------------------------------------------------
+ * Sensor binding
+ */
+
+static int csis_notify_bound(struct v4l2_async_notifier *n,
+			     struct v4l2_subdev *sd,
+			     struct v4l2_async_connection *asc)
+{
+	struct csis_device *csis = container_of(n, struct csis_device, notifier);
+	int pad;
+
+	pad = media_entity_get_fwnode_pad(&sd->entity, asc->match.fwnode,
+					  MEDIA_PAD_FL_SOURCE);
+	if (pad < 0)
+		return pad;
+
+	csis->sensor = sd;
+	csis->sensor_pad = pad;
+	return media_create_pad_link(&sd->entity, pad, &csis->vdev.entity, 0,
+				     MEDIA_LNK_FL_ENABLED | MEDIA_LNK_FL_IMMUTABLE);
+}
+
+static int csis_notify_complete(struct v4l2_async_notifier *n)
+{
+	struct csis_device *csis = container_of(n, struct csis_device, notifier);
+	int ret;
+
+	ret = v4l2_device_register_subdev_nodes(&csis->v4l2_dev);
+	if (ret)
+		return ret;
+	return media_device_register(&csis->mdev);
+}
+
+static const struct v4l2_async_notifier_operations csis_notify_ops = {
+	.bound		= csis_notify_bound,
+	.complete	= csis_notify_complete,
+};
+
+static int csis_parse_endpoint(struct csis_device *csis)
+{
+	struct v4l2_fwnode_endpoint vep = { .bus_type = V4L2_MBUS_CSI2_DPHY };
+	struct v4l2_async_connection *asc;
+	struct fwnode_handle *ep;
+	int ret;
+
+	ep = fwnode_graph_get_endpoint_by_id(dev_fwnode(csis->dev), 0, 0,
+					     FWNODE_GRAPH_ENDPOINT_NEXT);
+	if (!ep)
+		return dev_err_probe(csis->dev, -ENODEV, "no endpoint\n");
+
+	ret = v4l2_fwnode_endpoint_parse(ep, &vep);
+	if (ret) {
+		fwnode_handle_put(ep);
+		return dev_err_probe(csis->dev, ret, "bad endpoint\n");
+	}
+	csis->bus = vep.bus.mipi_csi2;
+	if (csis->bus.num_data_lanes < 1 || csis->bus.num_data_lanes > 4) {
+		fwnode_handle_put(ep);
+		return dev_err_probe(csis->dev, -EINVAL, "%u data lanes\n",
+				     csis->bus.num_data_lanes);
+	}
+
+	asc = v4l2_async_nf_add_fwnode_remote(&csis->notifier, ep,
+					      struct v4l2_async_connection);
+	fwnode_handle_put(ep);
+	return PTR_ERR_OR_ZERO(asc);
+}
