@@ -0,0 +1,18 @@
+# SPDX-License-Identifier: GPL-2.0-only
+config VIDEO_EXYNOS9810_CSIS
+	tristate "Samsung Exynos9810 MIPI CSI-2 receiver (raw capture)"
+	depends on V4L_PLATFORM_DRIVERS
+	depends on VIDEO_DEV && OF
+	depends on ARCH_EXYNOS || COMPILE_TEST
+	select MEDIA_CONTROLLER
+	select VIDEO_V4L2_SUBDEV_API
+	select V4L2_FWNODE
+	select VIDEOBUF2_DMA_CONTIG
+	select MFD_SYSCON
+	help
+	  MIPI CSI-2 receiver (CSIS v5.1) of the Exynos9810 with its virtual
+	  channel DMA: captures the raw Bayer stream of a camera sensor to
+	  memory, bypassing the camera ISP. Use with libcamera's software ISP.
+
+	  To compile this driver as a module, choose M here: the module will
+	  be called exynos9810-csis.
