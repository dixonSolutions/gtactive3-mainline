diff --git a/Documentation/devicetree/bindings/iio/brcm,bcm4775.yaml b/Documentation/devicetree/bindings/iio/brcm,bcm4775.yaml
new file mode 100644
index 0000000000000000000000000000000000000000..2d55e3c1f09000cb9b2409c3ca0c873b9df2064d
--- /dev/null
+++ b/Documentation/devicetree/bindings/iio/brcm,bcm4775.yaml
@@ -0,0 +1,120 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/iio/brcm,bcm4775.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Broadcom BCM4775 GNSS chip with sensor hub
+
+maintainers:
+  - dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>
+
+description: |
+  The BCM4775 GNSS receiver contains a microcontroller that Samsung uses
+  as a sensor hub: the accelerometer, light/proximity sensor and
+  magnetometer of the Galaxy Tab Active3 are wired to the chip, not to the
+  application processor. The host talks to it over SPI with Broadcom's
+  stream protocol: a wake handshake on two GPIOs (MCU_REQ out, MCU_RESP
+  in) and a level "data pending" line (HOST_REQ) used as the interrupt.
+  The hub application is downloaded into the chip's RAM by the host after
+  every power-up.
+
+allOf:
+  - $ref: /schemas/spi/spi-peripheral-props.yaml#
+
+properties:
+  compatible:
+    const: brcm,bcm4775
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+    description: HOST_REQ, high while the chip has data for the host.
+
+  spi-cpol: true
+  spi-cpha: true
+
+  host-req-gpios:
+    maxItems: 1
+    description: HOST_REQ, the interrupt line read as a GPIO.
+
+  mcu-req-gpios:
+    maxItems: 1
+    description: MCU_REQ, host to chip "wake up" request.
+
+  mcu-resp-gpios:
+    maxItems: 1
+    description: MCU_RESP, chip to host "awake" answer.
+
+  enable-gpios:
+    maxItems: 1
+    description: NSTDBY, takes the chip out of standby.
+
+  ap-sleep-gpios:
+    maxItems: 1
+    description: Tells the hub whether the host is suspended; active means
+      asleep.
+
+  vdd-mcu-supply:
+    description: Supply of the sensor-hub microcontroller (1.8 V).
+
+  firmware-name:
+    maxItems: 1
+    description: Broadcom patch file with the hub application.
+
+  mount-matrix:
+    description: Orientation of the accelerometer axes as reported by the
+      hub, see iio/mount-matrix.txt.
+
+  samsung,acc-position:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    maximum: 7
+    description: Accelerometer mounting, passed to the hub firmware, which
+      rotates the axes accordingly.
+
+  samsung,mag-position:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    maximum: 7
+    description: Magnetometer mounting, passed to the hub firmware.
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - host-req-gpios
+  - mcu-req-gpios
+  - mcu-resp-gpios
+  - enable-gpios
+  - vdd-mcu-supply
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    spi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        sensorhub@0 {
+            compatible = "brcm,bcm4775";
+            reg = <0>;
+            spi-max-frequency = <12500000>;
+            spi-cpol;
+            spi-cpha;
+            interrupt-parent = <&gpa2>;
+            interrupts = <1 IRQ_TYPE_LEVEL_HIGH>;
+            host-req-gpios = <&gpa2 1 GPIO_ACTIVE_HIGH>;
+            mcu-req-gpios = <&gpp2 1 GPIO_ACTIVE_HIGH>;
+            mcu-resp-gpios = <&gpp2 0 GPIO_ACTIVE_HIGH>;
+            enable-gpios = <&gpg0 4 GPIO_ACTIVE_HIGH>;
+            ap-sleep-gpios = <&gpa2 0 GPIO_ACTIVE_LOW>;
+            vdd-mcu-supply = <&ldo37_reg>;
+            samsung,acc-position = <5>;
+            samsung,mag-position = <0>;
+        };
+    };
diff --git a/Documentation/devicetree/bindings/iio/proximity/abov,a96t3x6.yaml b/Documentation/devicetree/bindings/iio/proximity/abov,a96t3x6.yaml
