+/*
+ * SPI20: Broadcom BCM4775 GNSS chip with its sensor-hub MCU (stock
+ * "ssp,BCM4773" node, DTBO hw_rev 4 fragments 92-95). On this board the
+ * accelerometer (ICM-42605M), light/proximity (TMD3725) and magnetometer
+ * (AK09916) hang off the hub, not off the AP. Pin settings as in the
+ * stock overlay: no pull on SCLK/MOSI/CS, pull-down on MISO, drive 3.
+ */
+&pinctrl_chub {
+	shub_spi_bus: shub-spi-bus-pins {
+		samsung,pins = "gph0-0", "gph0-1";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV4>;
+	};
+
+	shub_spi_miso: shub-spi-miso-pins {
+		samsung,pins = "gph0-2";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV4>;
+	};
+
+	shub_spi_cs: shub-spi-cs-pins {
+		samsung,pins = "gph0-3";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV4>;
+	};
+};
+
+&pinctrl_alive {
+	/* hub -> AP "data pending", level high */
+	shub_host_req: shub-host-req-pins {
+		samsung,pins = "gpa2-1";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV4>;
+	};
+
+	/* stock "ssp-batch-wake-irq": really an AP -> hub "AP awake" output */
+	shub_ap_sleep: shub-ap-sleep-pins {
+		samsung,pins = "gpa2-0";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+	};
+};
+
+&pinctrl_peric0 {
+	shub_mcu_resp: shub-mcu-resp-pins {
+		samsung,pins = "gpp2-0";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_INPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV4>;
+	};
+
+	shub_mcu_req: shub-mcu-req-pins {
+		samsung,pins = "gpp2-1";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV4>;
+	};
+
+	/* GPS_PWR_EN = BCM4775 NSTDBY, pulled down: chip held in standby */
+	shub_nstdby: shub-nstdby-pins {
+		samsung,pins = "gpg0-4";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV4>;
+	};
+};
+
+&spi_20 {
+	/* Software chip select, as in the stock firmware */
+	cs-gpios = <&gph0 3 GPIO_ACTIVE_LOW>;
+	pinctrl-0 = <&shub_spi_bus &shub_spi_miso &shub_spi_cs>;
+	status = "okay";
+
+	sensorhub@0 {
+		compatible = "brcm,bcm4775";
+		reg = <0>;
+		/* stock: 25 MHz, mode 3 */
+		spi-max-frequency = <12500000>;
+		spi-cpol;
+		spi-cpha;
+
+		interrupt-parent = <&gpa2>;
+		interrupts = <1 IRQ_TYPE_LEVEL_HIGH>;
+		host-req-gpios = <&gpa2 1 GPIO_ACTIVE_HIGH>;
+		mcu-req-gpios = <&gpp2 1 GPIO_ACTIVE_HIGH>;
+		mcu-resp-gpios = <&gpp2 0 GPIO_ACTIVE_HIGH>;
+		enable-gpios = <&gpg0 4 GPIO_ACTIVE_HIGH>;
+		ap-sleep-gpios = <&gpa2 0 GPIO_ACTIVE_LOW>;
+		vdd-mcu-supply = <&s2mps18_ldo37>;
+
+		pinctrl-0 = <&shub_host_req &shub_ap_sleep &shub_mcu_resp
+			     &shub_mcu_req &shub_nstdby>;
+		pinctrl-names = "default";
+
+		/*
+		 * The hub turns the accelerometer axes into Android's frame
+		 * of the portrait panel (x right, y up, z out of the screen;
+		 * +1 g along the axis pointing up). iio-sensor-proxy wants
+		 * the direction of gravity instead: -1 g on y when upright.
+		 */
+		mount-matrix = "-1", "0", "0",
+			       "0", "-1", "0",
+			       "0", "0", "1";
+
+		/* passed to the hub firmware (SSP "sensor formation") */
+		samsung,acc-position = <5>;
+		samsung,mag-position = <0>;
+	};
+};
