+static int csis_link_validate(struct media_link *link)
+{
+	struct csis_device *csis =
+		container_of(link->sink->entity, struct csis_device, vdev.entity);
+	struct v4l2_subdev_format sfmt = {
+		.which = V4L2_SUBDEV_FORMAT_ACTIVE,
+		.pad = link->source->index,
+	};
+	const struct csis_format *fmt;
+	int ret;
+
+	ret = v4l2_subdev_call_state_active(csis->sensor, pad, get_fmt, &sfmt);
+	if (ret)
+		return ret;
+
+	fmt = csis_find_code(sfmt.format.code);
+	if (!fmt || fmt->code != csis->fmt->code ||
+	    sfmt.format.width != csis->pix.width ||
+	    sfmt.format.height != csis->pix.height) {
+		dev_dbg(csis->dev, "sensor %ux%u %04x, video node %ux%u %p4cc\n",
+			sfmt.format.width, sfmt.format.height, sfmt.format.code,
+			csis->pix.width, csis->pix.height, &csis->pix.pixelformat);
+		return -EPIPE;
+	}
+	return 0;
+}
+
+static const struct media_entity_operations csis_entity_ops = {
+	.link_validate = csis_link_validate,
+};
