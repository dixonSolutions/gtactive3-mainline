+struct iio_trigger;
+struct regulator;
+struct spi_device;
+
+/* --- SSI ---------------------------------------------------------- */
+
+#define SSI_MODE_DEBUG		0x80	/* register access instead of stream */
+#define SSI_FULL_DUPLEX		0x40
+#define SSI_READ		0x20
+#define SSI_LEN_2B		0x10
+#define SSI_FLOW_CONTROL	0x08
+
+/* full duplex, 2-byte length, flow control: the mode the stock uses */
+#define SSI_CTRL_TX	(SSI_FULL_DUPLEX | SSI_LEN_2B | SSI_FLOW_CONTROL)
+#define SSI_CTRL_RX	(SSI_FULL_DUPLEX | SSI_LEN_2B)
+
+#define SSI_HDR_LEN		3	/* control/status byte + 2-byte length */
+#define SSI_FC_LEN		2	/* "bytes accepted" field after TX data */
+#define SSI_FRAME_MAX		8192
+#define SSI_TX_MAX		(SSI_FRAME_MAX - SSI_HDR_LEN - SSI_FC_LEN)
+#define SSI_RX_LEN_UNKNOWN	254	/* read this much when the chip says 0 */
+#define SSI_FC_TRIES		3
+
+/* status byte: free space in the chip RX ring and a protocol-error bit */
+#define SSI_STAT_CNT		GENMASK(2, 0)
+#define SSI_STAT_SIZE		GENMASK(4, 3)
+#define SSI_STAT_PE		BIT(6)
+
+/* --- TL ----------------------------------------------------------- */
+
+#define TL_ESC			0xb0
+#define TL_SOP			0x00
+#define TL_EOP			0x01
+#define TL_ESC_ESC		0x03
+#define TL_ESC_XON		0x04
+#define TL_ESC_XOFF		0x05
+#define TL_XON			0x11
+#define TL_XOFF			0x13
+
+#define TL_F_ACK		BIT(0)	/* detail: last sequence number received */
+#define TL_F_RELIABLE		BIT(1)	/* detail: reliable sequence number */
+#define TL_F_RELIABLE_ACK	BIT(2)	/* detail: last reliable seq received */
+#define TL_F_RELIABLE_NACK	BIT(3)	/* detail: last good reliable seq */
+#define TL_F_MSG_LOST		BIT(4)	/* detail: packets lost since last report */
+#define TL_F_GARBAGE		BIT(5)	/* detail: garbage bytes since last report */
+#define TL_F_SIZE_EXT		BIT(6)	/* detail: size bits 15:8 */
+#define TL_F_EXTENDED		BIT(7)	/* detail: flag bits 15:8 */
+#define TL_F_INTERNAL		BIT(8)	/* detail 0: transport-internal packet */
+#define TL_F_IGNORE_SEQ		BIT(9)	/* detail 0: not counted in seq gaps */
+
+#define TL_MAX_PAYLOAD		1024
+#define TL_RX_MAX		2048
+#define TL_MAX_HDR		14
+#define TL_ACK_EVERY		200	/* payload packets per unsolicited ACK */
+#define TL_REL_RETRY_MS		500
+#define TL_REL_TRIES		10
+#define TL_REL_WINDOW		(8 * 1024) /* reliable payload bytes in flight */
+#define TL_SYNC_RETRY_MS	100
+#define TL_SYNC_TRIES		6
+
+/* transport-internal packet types (first payload byte) */
+#define TL_INT_SEQ_REQ		0
+#define TL_INT_SEQ_RESP		1
+#define TL_INT_STATS_REQ	2
+#define TL_INT_STATS_RESP	3
+#define TL_INT_SETTINGS_REQ	4
+#define TL_INT_SETTINGS_RESP	5
+
+/* RPC ids */
+#define RPC_GET_VERSION		0x00
+#define RPC_VERSION		0x03	/* u32 asic, u32 rom, u32 patch level */
+#define RPC_MEM_WRITE		0x05	/* u32 addr, u16 len, data */
+#define RPC_MEM_MASKED_WRITE	0x06	/* u32 addr, u32 mask, u32 value */
+#define RPC_MEM_READ		0x07
+#define RPC_EXCEPTION		0x17	/* u32 line, u8 len, text */
+#define RPC_EXCEPTION_ARGS	0x18
+#define RPC_PRINT		0x19	/* u16 len, text, u8 */
+#define RPC_RESET		0x1a	/* u8 */
+#define RPC_SENSOR_REQUEST	0x20	/* u16 len, SSP bytes */
+#define RPC_SENSOR_RESPONSE	0x21	/* u16 len, SSP bytes */
+#define RPC_START_SCRATCH_APP	0x2e	/* u32 entry */
+#define RPC_SERVICE_START	0x37	/* u32 entry, 4 x u32 args */
+#define RPC_VERSION_EXT		0x3b
+#define RPC_CONSOLE		0x402	/* u16 len, text, u8 */
+
+struct shub_tl_stats {
+	u32 rx_packets;
+	u32 rx_bad_crc;
+	u32 rx_bad_format;
+	u32 rx_garbage;
+	u32 rx_lost;
+	u32 rx_internal;
+	u32 rx_reliable;
+	u32 rx_dup;
+	u32 tx_packets;
+	u32 tx_reliable;
+	u32 tx_retries;
+	u32 remote_lost;
+	u32 remote_garbage;
+	u32 rpc_unknown;
+};
+
+/* one reliable packet waiting for its RELIABLE_ACK */
+struct shub_tl_rel {
+	struct list_head node;
+	unsigned long sent;	/* jiffies */
+	u8 rseq;		/* reliable sequence number */
+	u8 tries;
+	bool resend;
+	u16 len;
+	u8 data[];
+};
+
+struct shub_tl {
+	struct mutex lock;		/* everything below */
+
+	/* RX parser */
+	unsigned int state;
+	unsigned int len;
+	u8 msg[TL_RX_MAX + TL_MAX_HDR];
+
+	/* sequence state, names as in the protocol description */
+	u8 tx_seq;			/* next packet sequence number */
+	u8 rx_seq;			/* last packet sequence number received */
+	u8 rx_ack;			/* last ACK detail received */
+	u8 rel_tx_next;			/* next reliable seq to send */
+	u8 rel_tx_acked;		/* last reliable seq acknowledged */
+	u8 rel_rx;			/* last reliable seq received */
+	u8 rel_rx_crc;
+	u16 rel_rx_len;
+	u8 ack_pending;			/* payload packets not acknowledged */
+	u32 lost_reported;
+	u32 garbage_reported;
+
+	struct list_head rel_queue;	/* struct shub_tl_rel, oldest first */
+	unsigned int rel_bytes;
+	wait_queue_head_t rel_wait;	/* room in the window / queue empty */
+	struct delayed_work tick;
+	bool failed;			/* a reliable packet ran out of tries */
+
+	/* sequence-number handshake */
+	bool syncing;
+	u8 sync_n;
+	unsigned long sync_sent;
+	struct completion synced;
+	bool sync_ok;
+
+	struct shub_tl_stats stats;
+};
+
+/* --- loader ------------------------------------------------------- */
+
+#define PATCH_REC_MASKED_WRITE	0xf0
+#define PATCH_REC_WRITE		0xf1
+#define PATCH_REC_CRC8		0xf2
+#define PATCH_REC_CSUM32	0xf3
+#define PATCH_REC_SERVICE	0xf4
+#define PATCH_REC_MASKED_VERIFY	0xf5
+
+struct shub_version {
+	u32 asic;
+	u32 rom;
+	u32 patch_level;
+};
+
+/* --- SSP ---------------------------------------------------------- */
+
+#define SSP_AP2HUB_READ		0
+#define SSP_AP2HUB_WRITE	1
+#define SSP_HUB2AP_WRITE	2
+#define SSP_TYPE_MASK		0x3
+#define SSP_RETURN		BIT(2)
+
+#define SSP_HDR_LEN		9
+#define SSP_REPLY_HDR_LEN	4
+#define SSP_RX_MAX		(4 * 4096)
+#define SSP_MAX_WRITE		1000
+
+#define SSP_WHOAMI		0x0f
+#define SSP_WHOAMI_ID		0x55
+#define SSP_SENSOR_ADD		0xa1
+#define SSP_SENSOR_REMOVE	0xa2
+#define SSP_CHANGE_DELAY	0xa4
+#define SSP_CURRENT_TIMESTAMP	0xa7
+#define SSP_AP_STATUS_WAKEUP	0xd1
+#define SSP_AP_STATUS_SLEEP	0xd2
+#define SSP_AP_STATUS_RESUME	0xd3
+#define SSP_AP_STATUS_SUSPEND	0xd4
+#define SSP_GET_ACCEL_RANGE	0xe1
+#define SSP_FIRMWARE_REV	0xf0
+#define SSP_SENSOR_FORMATION	0xf1
+#define SSP_SENSOR_SCANNING	0xf4
+
+/* hub -> AP data frame records */
+#define SSP_REC_DEBUG		0x03
+#define SSP_REC_BIG_DATA	0x04
+#define SSP_REC_META		0x05
+#define SSP_REC_TIME_SYNC	0x06
+#define SSP_REC_GYRO_CAL	0x08
+#define SSP_REC_INIT_DONE	0x0a
+#define SSP_REC_SCONTEXT	0x0c
+#define SSP_REC_SAMPLE		0x37
+#define SSP_REC_PROX_CAL	0x97
+#define SSP_REC_TS_OFFSET	0xa8
+
+#define SSP_ID_ACCEL		0
+#define SSP_ID_PROX		7
+#define SSP_ID_LIGHT		9
+#define SSP_ID_MAX		51
+
+#define SSP_ACCEL_SAMPLE	6
+#define SSP_PROX_SAMPLE		1
+#define SSP_LIGHT_SAMPLE	21
+#define SSP_SAMPLE_MAX		32
+
+enum shub_sensor {
+	SHUB_ACCEL,
+	SHUB_LIGHT,
+	SHUB_PROX,
+	SHUB_NR_SENSORS,
+};
+
+struct shub_sensor_state {
+	struct iio_dev *indio;
+	struct iio_trigger *trig;
+	u8 id;
+	u8 sample_len;
+	bool buffered;		/* IIO buffer enabled */
+	bool polled;		/* enabled for read_raw until idle_work */
+	bool added;		/* SENSOR_ADD sent and not removed */
+	u32 period_ms;
+	unsigned long last_read;
+	struct completion sample;
+	spinlock_t sample_lock;	/* last, last_ts, have_sample */
+	u8 last[SSP_SAMPLE_MAX];
+	s64 last_ts;
+	bool have_sample;
+};
+
+struct shub_ssp {
+	struct mutex xfer_lock;		/* one transaction at a time */
+	spinlock_t lock;		/* pending transaction vs. RX */
+
+	/* pending transaction */
+	u16 pend_opts;
+	u8 *pend_buf;
+	u16 pend_len;
+	const u8 *pend_wdata;		/* data phase of a write */
+	bool pend_active;
+	struct completion pend_done;
+
+	/* RX reassembly of the SSP byte stream */
+	u8 rx[SSP_RX_MAX];
+	u32 rx_len;
+	u32 rx_need;
+	bool rx_body;
+	u16 rx_opts;
+	u8 rx_type;
+	u32 hub2ap_frames;
+
+	struct completion init_done;	/* record 0x0a */
+	struct work_struct ts_work;
+	struct delayed_work idle_work;
+	struct mutex sensor_lock;	/* sensor enable state */
+
+	bool up;			/* initialised after the firmware started */
+	u64 present;			/* SENSOR_SCANNING bitmap */
+	u32 fw_rev;
+	u8 accel_range;
+
+	u32 timeouts;
+	u32 unmatched;
+	u32 bad_frames;
+	u32 samples;
+
+	struct shub_sensor_state sensor[SHUB_NR_SENSORS];
+};
+
+/* --- device ------------------------------------------------------- */
+
+#define SHUB_TXQ_SIZE		65536
+#define SHUB_HELLO_FAIL_MAX	5
+
+enum shub_state {
+	SHUB_OFF,
+	SHUB_BOOTING,
+	SHUB_RUNNING,
+	SHUB_FAILED,
+};
+
+struct bcm4775_shub {
+	struct spi_device *spi;
+	struct device *dev;
+
+	struct gpio_desc *host_req;
+	struct gpio_desc *mcu_req;
+	struct gpio_desc *mcu_resp;
+	struct gpio_desc *nstdby;
+	struct gpio_desc *ap_sleep;
+	struct regulator *vdd;
+	bool vdd_on;
+	int irq;
+	const char *fw_name;
+	u8 acc_position;
+	u8 mag_position;
+
+	/* SSI */
+	struct mutex io_lock;		/* SPI bus + wake handshake */
+	u8 *txb;
+	u8 *rxb;
+	u8 *stage;			/* TX bytes taken from txq, not yet accepted */
+	unsigned int stage_len;
+	struct workqueue_struct *wq;
+	struct work_struct work;
+	spinlock_t irq_lock;		/* irq_enabled */
+	bool irq_enabled;
+	bool powered;
+	unsigned int hello_fails;
+
+	spinlock_t txq_lock;		/* txq */
+	DECLARE_KFIFO_PTR(txq, u8);
+
+	struct shub_tl tl;
+	struct shub_ssp ssp;
+
+	/* boot / recovery */
+	struct mutex state_lock;
+	enum shub_state state;
+	struct work_struct boot_work;
+	struct delayed_work fw_retry;	/* firmware not there yet */
+	unsigned int fw_waits;
+	unsigned int ssp_fails;		/* consecutive SSP start failures */
+	unsigned int boots;
+	struct shub_version rom_ver;
+	struct shub_version app_ver;
+	struct completion ver_done;
+	bool ver_valid;
+	struct shub_version ver;
+
+	struct dentry *debugfs;
+	bool trace;			/* hex dump every SPI transfer */
+
+	struct {
+		u32 rx_frames;
+		u32 rx_bytes;
+		u32 tx_frames;
+		u32 tx_bytes;
+		u32 fc_retries;
+		u32 fc_errors;
+		u32 hello_timeouts;
+		u32 spi_errors;
+		u32 txq_full;
+		u32 status_pe;
+	} stats;
+};
+
+/* core */
+int shub_queue_tx(struct bcm4775_shub *shub, const u8 *buf, size_t len);
+void shub_kick(struct bcm4775_shub *shub);
+int shub_power(struct bcm4775_shub *shub, bool on);
+void shub_request_reset(struct bcm4775_shub *shub, const char *why);
+
+/* tl */
+void shub_tl_init(struct bcm4775_shub *shub);
+void shub_tl_reset(struct bcm4775_shub *shub);
+void shub_tl_stop(struct bcm4775_shub *shub);
+void shub_tl_rx(struct bcm4775_shub *shub, const u8 *buf, size_t len);
+int shub_tl_sync(struct bcm4775_shub *shub);
+int shub_tl_send_rpcs(struct bcm4775_shub *shub, const u8 *payload,
+		      size_t len, bool reliable);
+int shub_tl_send_rpc(struct bcm4775_shub *shub, u16 id, const u8 *data,
+		     size_t len, bool reliable);
+size_t shub_rpc_put(u8 *dst, u16 id, const u8 *data, size_t len);
+int shub_tl_wait_idle(struct bcm4775_shub *shub, unsigned int timeout_ms);
+int shub_tl_wait_room(struct bcm4775_shub *shub, size_t len,
+		      unsigned int timeout_ms);
+
+/* loader */
+void shub_boot_work(struct work_struct *work);
+void shub_fw_retry_work(struct work_struct *work);
+void shub_on_version(struct bcm4775_shub *shub, u32 asic, u32 rom,
+		     u32 patch);
+
+/* ssp */
+void shub_ssp_init(struct bcm4775_shub *shub);
+void shub_ssp_remove(struct bcm4775_shub *shub);
+void shub_ssp_rx(struct bcm4775_shub *shub, const u8 *buf, size_t len);
+void shub_ssp_reset(struct bcm4775_shub *shub);
+int shub_ssp_start(struct bcm4775_shub *shub);
+int shub_ssp_xfer(struct bcm4775_shub *shub, u8 cmd, u16 opts, u32 arg,
+		  void *buf, u16 len, unsigned int timeout_ms);
+int shub_ssp_sensor_enable(struct bcm4775_shub *shub, enum shub_sensor s,
+			   bool buffered, bool on);
+int shub_ssp_read_sample(struct bcm4775_shub *shub, enum shub_sensor s,
+			 u8 *out);
+
+/* iio */
+int shub_iio_register(struct bcm4775_shub *shub);
+void shub_iio_push(struct bcm4775_shub *shub, enum shub_sensor s);
+
+#endif
diff --git a/drivers/iio/common/bcm4775_shub/core.c b/drivers/iio/common/bcm4775_shub/core.c
new file mode 100644
index 0000000000000000000000000000000000000000..d4d53ae854fde59554d4375e558c05bc43be2104
--- /dev/null
+++ b/drivers/iio/common/bcm4775_shub/core.c
@@ -0,0 +1,651 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * BCM4775 sensor hub: SPI link ("SSI"), power, probe.
+ *
+ * Every exchange starts with a wake handshake: the AP raises MCU_REQ and
+ * waits for MCU_RESP. Then, while the chip holds HOST_REQ high or the AP
+ * has bytes queued:
+ *  - RX: [0x50][00 00] -> [status][len lo][len hi], then a second transfer
+ *    of len + 3 bytes returns the same header and len stream bytes;
+ *  - TX: [0x58][M lo][M hi][M bytes][00 00] -> [status][N lo][N hi]
+ *    [stream bytes of the chip][2-byte count of bytes accepted at
+ *    offset 3 + M]; not accepted bytes are sent again.
+ * Finally MCU_REQ drops and the HOST_REQ interrupt (level high) is
+ * re-enabled.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/debugfs.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/interrupt.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+#include <linux/seq_file.h>
+#include <linux/slab.h>
+#include <linux/spi/spi.h>
+#include <linux/unaligned.h>
+
+#include "bcm4775_shub.h"
+
+static bool trace;
+module_param(trace, bool, 0644);
+MODULE_PARM_DESC(trace, "hex dump every SPI transfer");
+
+static bool autoboot = true;
+module_param(autoboot, bool, 0444);
+MODULE_PARM_DESC(autoboot, "download the hub firmware at probe");
+
+static unsigned int spi_hz;
+module_param(spi_hz, uint, 0444);
+MODULE_PARM_DESC(spi_hz, "SPI clock in Hz (default: spi-max-frequency)");
+
+static const unsigned int shub_blk_size[] = { 32, 256, 2048, 16384 };
+
+static void shub_dump(struct bcm4775_shub *shub, const char *what,
+		      const u8 *buf, size_t len)
+{
+	if (!trace && !shub->trace)
+		return;
+	dev_info(shub->dev, "%s %zu\n", what, len);
+	print_hex_dump(KERN_INFO, "  ", DUMP_PREFIX_OFFSET, 32, 1, buf,
+		       min_t(size_t, len, 512), false);
+}
+
+static int shub_spi(struct bcm4775_shub *shub, size_t len)
+{
+	struct spi_transfer xfer = {
+		.tx_buf = shub->txb,
+		.rx_buf = shub->rxb,
+		.len = len,
+	};
+	int ret;
+
+	ret = spi_sync_transfer(shub->spi, &xfer, 1);
+	if (ret) {
+		shub->stats.spi_errors++;
+		dev_err_ratelimited(shub->dev, "SPI transfer failed: %d\n", ret);
+		return ret;
+	}
+	shub_dump(shub, "mosi", shub->txb, len);
+	shub_dump(shub, "miso", shub->rxb, len);
+
+	if (shub->rxb[0] & SSI_STAT_PE)
+		shub->stats.status_pe++;
+
+	return 0;
+}
+
+static bool shub_hello(struct bcm4775_shub *shub)
+{
+	int i;
+
+	gpiod_set_value(shub->mcu_req, 1);
+	for (i = 0; i <= 100; i++) {
+		if (gpiod_get_value(shub->mcu_resp))
+			return true;
+		if (i && i % 20 == 0) {
+			/* nudge it */
+			gpiod_set_value(shub->mcu_req, 0);
+			usleep_range(1000, 1100);
+			gpiod_set_value(shub->mcu_req, 1);
+		}
+		usleep_range(1000, 1100);
+	}
+	gpiod_set_value(shub->mcu_req, 0);
+	shub->stats.hello_timeouts++;
+
+	return false;
+}
+
+static int shub_ssi_rx(struct bcm4775_shub *shub)
+{
+	unsigned int len, len2;
+	int ret;
+
+	memset(shub->txb, 0, SSI_HDR_LEN);
+	shub->txb[0] = SSI_CTRL_RX;
+	ret = shub_spi(shub, SSI_HDR_LEN);
+	if (ret)
+		return ret;
+
+	len = get_unaligned_le16(shub->rxb + 1);
+	if (!len)
+		len = SSI_RX_LEN_UNKNOWN;
+	len = min_t(unsigned int, len, SSI_FRAME_MAX - SSI_HDR_LEN);
+
+	memset(shub->txb, 0, len + SSI_HDR_LEN);
+	shub->txb[0] = SSI_CTRL_RX;
+	ret = shub_spi(shub, len + SSI_HDR_LEN);
+	if (ret)
+		return ret;
+
+	len2 = get_unaligned_le16(shub->rxb + 1);
+	len = min(len, len2);
+
+	shub->stats.rx_frames++;
+	shub->stats.rx_bytes += len;
+	if (len)
+		shub_tl_rx(shub, shub->rxb + SSI_HDR_LEN, len);
+
+	return 0;
+}
+
+static unsigned int shub_txq_fill_stage(struct bcm4775_shub *shub)
+{
+	unsigned int n;
+
+	spin_lock_bh(&shub->txq_lock);
+	n = kfifo_out(&shub->txq, shub->stage + shub->stage_len,
+		      SSI_TX_MAX - shub->stage_len);
+	spin_unlock_bh(&shub->txq_lock);
+	shub->stage_len += n;
+
+	return shub->stage_len;
+}
+
+static bool shub_tx_pending(struct bcm4775_shub *shub)
+{
+	bool pending;
+
+	if (shub->stage_len)
+		return true;
+	spin_lock_bh(&shub->txq_lock);
+	pending = !kfifo_is_empty(&shub->txq);
+	spin_unlock_bh(&shub->txq_lock);
+
+	return pending;
+}
+
+static int shub_ssi_tx(struct bcm4775_shub *shub)
+{
+	unsigned int m, nread, acc, free;
+	int ret, tries;
+
+	for (tries = 0; tries < SSI_FC_TRIES; tries++) {
+		m = shub_txq_fill_stage(shub);
+		if (!m)
+			return 0;
+
+		shub->txb[0] = SSI_CTRL_TX;
+		put_unaligned_le16(m, shub->txb + 1);
+		memcpy(shub->txb + SSI_HDR_LEN, shub->stage, m);
+		put_unaligned_le16(0, shub->txb + SSI_HDR_LEN + m);
+
+		ret = shub_spi(shub, SSI_HDR_LEN + m + SSI_FC_LEN);
+		if (ret)
+			return ret;
+
+		/* the chip's own stream bytes ride along */
+		nread = get_unaligned_le16(shub->rxb + 1);
+		if (nread)
+			shub_tl_rx(shub, shub->rxb + SSI_HDR_LEN, min(nread, m));
+
+		acc = get_unaligned_le16(shub->rxb + SSI_HDR_LEN + m);
+		shub->stats.tx_frames++;
+		if (acc > m) {
+			shub->stats.fc_errors++;
+			acc = m;
+		}
+		shub->stats.tx_bytes += acc;
+		shub->stage_len -= acc;
+		if (!shub->stage_len)
+			continue;
+
+		/* the chip's RX ring was full: retry the rest */
+		memmove(shub->stage, shub->stage + acc, shub->stage_len);
+		shub->stats.fc_retries++;
+		free = shub_blk_size[FIELD_GET(SSI_STAT_SIZE, shub->rxb[0])] *
+		       FIELD_GET(SSI_STAT_CNT, shub->rxb[0]);
+		if (free < shub->stage_len)
+			usleep_range(1000, 1500);
+	}
+
+	return 0;
+}
+
+static void shub_enable_irq(struct bcm4775_shub *shub)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&shub->irq_lock, flags);
+	if (shub->powered && !shub->irq_enabled) {
+		shub->irq_enabled = true;
+		enable_irq(shub->irq);
+	}
+	spin_unlock_irqrestore(&shub->irq_lock, flags);
+}
+
+static void shub_disable_irq(struct bcm4775_shub *shub)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&shub->irq_lock, flags);
+	if (shub->irq_enabled) {
+		shub->irq_enabled = false;
+		disable_irq_nosync(shub->irq);
+	}
+	spin_unlock_irqrestore(&shub->irq_lock, flags);
+}
+
+static void shub_xfer_work(struct work_struct *work)
+{
+	struct bcm4775_shub *shub = container_of(work, struct bcm4775_shub,
+						 work);
+	int ret = 0, loops = 0;
+
+	mutex_lock(&shub->io_lock);
+	if (!shub->powered)
+		goto out;
+
+	if (!shub_hello(shub)) {
+		dev_err_ratelimited(shub->dev, "no MCU_RESP\n");
+		if (++shub->hello_fails >= SHUB_HELLO_FAIL_MAX) {
+			shub->hello_fails = 0;
+			mutex_unlock(&shub->io_lock);
+			shub_request_reset(shub, "chip does not wake up");
+			return;
+		}
+		/* try again a bit later */
+		mutex_unlock(&shub->io_lock);
+		queue_work(shub->wq, &shub->work);
+		return;
+	}
+	shub->hello_fails = 0;
+
+	do {
+		if (gpiod_get_value(shub->host_req)) {
+			ret = shub_ssi_rx(shub);
+			if (ret)
+				break;
+		}
+		if (shub_tx_pending(shub)) {
+			ret = shub_ssi_tx(shub);
+			if (ret)
+				break;
+		}
+		if (++loops > 1000) {
+			/* let others at the bus; we come back */
+			queue_work(shub->wq, &shub->work);
+			break;
+		}
+	} while (gpiod_get_value(shub->host_req) || shub_tx_pending(shub));
+
+	gpiod_set_value(shub->mcu_req, 0);
+out:
+	mutex_unlock(&shub->io_lock);
+	shub_enable_irq(shub);
+}
+
+static irqreturn_t shub_irq(int irq, void *data)
+{
+	struct bcm4775_shub *shub = data;
+
+	spin_lock(&shub->irq_lock);
+	if (shub->irq_enabled) {
+		shub->irq_enabled = false;
+		disable_irq_nosync(irq);
+	}
+	spin_unlock(&shub->irq_lock);
+
+	queue_work(shub->wq, &shub->work);
+
+	return IRQ_HANDLED;
+}
+
+void shub_kick(struct bcm4775_shub *shub)
+{
+	queue_work(shub->wq, &shub->work);
+}
+
+int shub_queue_tx(struct bcm4775_shub *shub, const u8 *buf, size_t len)
+{
+	int ret = 0;
+
+	spin_lock_bh(&shub->txq_lock);
+	if (kfifo_avail(&shub->txq) < len) {
+		shub->stats.txq_full++;
+		ret = -ENOSPC;
+	} else {
+		kfifo_in(&shub->txq, buf, len);
+	}
+	spin_unlock_bh(&shub->txq_lock);
+
+	if (!ret)
+		shub_kick(shub);
+
+	return ret;
+}
+
+/*
+ * Power sequence of the stock host: hub supply on, then NSTDBY high; off
+ * in the reverse order. The chip starts in its ROM bootloader.
+ */
+int shub_power(struct bcm4775_shub *shub, bool on)
+{
+	int ret;
+
+	if (on == shub->powered)
+		return 0;
+
+	if (on) {
+		if (!shub->vdd_on) {
+			ret = regulator_enable(shub->vdd);
+			if (ret) {
+				dev_err(shub->dev, "hub supply: %d\n", ret);
+				return ret;
+			}
+			shub->vdd_on = true;
+		}
+		msleep(20);
+		gpiod_set_value(shub->nstdby, 1);
+		msleep(50);
+
+		mutex_lock(&shub->io_lock);
+		shub->stage_len = 0;
+		spin_lock_bh(&shub->txq_lock);
+		kfifo_reset(&shub->txq);
+		spin_unlock_bh(&shub->txq_lock);
+		shub->powered = true;
+		mutex_unlock(&shub->io_lock);
+		shub_enable_irq(shub);
+		/* HOST_REQ may already be high */
+		shub_kick(shub);
+	} else {
+		shub_disable_irq(shub);
+		mutex_lock(&shub->io_lock);
+		shub->powered = false;
+		mutex_unlock(&shub->io_lock);
+		cancel_work_sync(&shub->work);
+		gpiod_set_value(shub->mcu_req, 0);
+		gpiod_set_value(shub->nstdby, 0);
+		if (shub->vdd_on) {
+			regulator_disable(shub->vdd);
+			shub->vdd_on = false;
+		}
+		/* let the rails drain */
+		msleep(50);
+	}
+
+	return 0;
+}
+
+void shub_request_reset(struct bcm4775_shub *shub, const char *why)
+{
+	mutex_lock(&shub->state_lock);
+	if (shub->state == SHUB_RUNNING) {
+		dev_warn(shub->dev, "restarting the hub: %s\n", why);
+		shub->state = SHUB_BOOTING;
+		queue_work(system_long_wq, &shub->boot_work);
+	}
+	mutex_unlock(&shub->state_lock);
+}
+
+/*
+ * Power the hub off and wait for a running (re)start to give up: the
+ * loader checks for SHUB_OFF between its steps, and stopping the packet
+ * layer ends its waits.
+ */
+static void shub_stop(struct bcm4775_shub *shub)
+{
+	mutex_lock(&shub->state_lock);
+	shub->state = SHUB_OFF;
+	mutex_unlock(&shub->state_lock);
+	shub_tl_stop(shub);
+	cancel_delayed_work_sync(&shub->fw_retry);
+	cancel_work_sync(&shub->boot_work);
+	shub_ssp_reset(shub);
+	shub_tl_stop(shub);
+	shub_power(shub, false);
+}
+
+static const char * const shub_state_names[] = {
+	[SHUB_OFF] = "off",
+	[SHUB_BOOTING] = "booting",
+	[SHUB_RUNNING] = "running",
+	[SHUB_FAILED] = "failed",
+};
+
+static int shub_status_show(struct seq_file *s, void *unused)
+{
+	struct bcm4775_shub *shub = s->private;
+	struct shub_tl_stats *t = &shub->tl.stats;
+	struct shub_ssp *ssp = &shub->ssp;
+	int i;
+
+	seq_printf(s, "state %s, boots %u, powered %d, host_req %d, mcu_resp %d\n",
+		   shub_state_names[shub->state], shub->boots, shub->powered,
+		   gpiod_get_value(shub->host_req),
+		   gpiod_get_value(shub->mcu_resp));
+	seq_printf(s, "rom: asic %#x rom %#x patch %u; app: asic %#x rom %#x patch %u\n",
+		   shub->rom_ver.asic, shub->rom_ver.rom,
+		   shub->rom_ver.patch_level, shub->app_ver.asic,
+		   shub->app_ver.rom, shub->app_ver.patch_level);
+	seq_printf(s, "ssi: rx %u frames %u bytes, tx %u frames %u bytes, fc retries %u errors %u, hello timeouts %u, spi errors %u, txq full %u, PE %u\n",
+		   shub->stats.rx_frames, shub->stats.rx_bytes,
+		   shub->stats.tx_frames, shub->stats.tx_bytes,
+		   shub->stats.fc_retries, shub->stats.fc_errors,
+		   shub->stats.hello_timeouts, shub->stats.spi_errors,
+		   shub->stats.txq_full, shub->stats.status_pe);
+	seq_printf(s, "tl: rx %u (crc %u, format %u, garbage %u, lost %u, internal %u, reliable %u, dup %u), tx %u (reliable %u, retries %u), remote lost %u garbage %u, unknown rpc %u\n",
+		   t->rx_packets, t->rx_bad_crc, t->rx_bad_format,
+		   t->rx_garbage, t->rx_lost, t->rx_internal, t->rx_reliable,
+		   t->rx_dup, t->tx_packets, t->tx_reliable, t->tx_retries,
+		   t->remote_lost, t->remote_garbage, t->rpc_unknown);
+	seq_printf(s, "tl seq: tx %u rx %u, reliable tx next %u acked %u rx %u, in flight %u bytes\n",
+		   shub->tl.tx_seq, shub->tl.rx_seq, shub->tl.rel_tx_next,
+		   shub->tl.rel_tx_acked, shub->tl.rel_rx, shub->tl.rel_bytes);
+	seq_printf(s, "ssp: up %d, present %#llx, fw %u, accel range %u, hub frames %u, samples %u, timeouts %u, unmatched %u, bad frames %u\n",
+		   ssp->up, ssp->present, ssp->fw_rev, ssp->accel_range,
+		   ssp->hub2ap_frames, ssp->samples, ssp->timeouts,
+		   ssp->unmatched, ssp->bad_frames);
+	for (i = 0; i < SHUB_NR_SENSORS; i++) {
+		struct shub_sensor_state *ss = &ssp->sensor[i];
+
+		seq_printf(s, "sensor %u: added %d buffered %d polled %d period %u ms, last %*ph\n",
+			   ss->id, ss->added, ss->buffered, ss->polled,
+			   ss->period_ms, ss->sample_len, ss->last);
+	}
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(shub_status);
+
+static ssize_t shub_boot_write(struct file *file, const char __user *buf,
+			       size_t count, loff_t *ppos)
+{
+	struct bcm4775_shub *shub = file->private_data;
+
+	mutex_lock(&shub->state_lock);
+	if (shub->state != SHUB_BOOTING) {
+		shub->state = SHUB_BOOTING;
+		shub->fw_waits = 0;
+		shub->ssp_fails = 0;
+		queue_work(system_long_wq, &shub->boot_work);
+	}
+	mutex_unlock(&shub->state_lock);
+
+	return count;
+}
+
+static const struct file_operations shub_boot_fops = {
+	.open = simple_open,
+	.write = shub_boot_write,
+};
+
+static ssize_t shub_off_write(struct file *file, const char __user *buf,
+			      size_t count, loff_t *ppos)
+{
+	struct bcm4775_shub *shub = file->private_data;
+
+	shub_stop(shub);
+
+	return count;
+}
+
+static const struct file_operations shub_off_fops = {
+	.open = simple_open,
+	.write = shub_off_write,
+};
+
+static void shub_debugfs_init(struct bcm4775_shub *shub)
+{
+	shub->debugfs = debugfs_create_dir(dev_name(shub->dev), NULL);
+	debugfs_create_file("status", 0444, shub->debugfs, shub,
+			    &shub_status_fops);
+	debugfs_create_file("boot", 0200, shub->debugfs, shub,
+			    &shub_boot_fops);
+	debugfs_create_file("off", 0200, shub->debugfs, shub, &shub_off_fops);
+	debugfs_create_bool("trace", 0644, shub->debugfs, &shub->trace);
+}
+
+static void shub_cleanup(void *data)
+{
+	struct bcm4775_shub *shub = data;
+
+	debugfs_remove_recursive(shub->debugfs);
+	shub_stop(shub);
+	shub_ssp_remove(shub);
+}
+
+static void shub_free_txq(void *data)
+{
+	struct bcm4775_shub *shub = data;
+
+	kfifo_free(&shub->txq);
+}
+
+static int shub_probe(struct spi_device *spi)
+{
+	struct device *dev = &spi->dev;
+	struct bcm4775_shub *shub;
+	u32 val;
+	int ret;
+
+	shub = devm_kzalloc(dev, sizeof(*shub), GFP_KERNEL);
+	if (!shub)
+		return -ENOMEM;
+
+	shub->spi = spi;
+	shub->dev = dev;
+	spi_set_drvdata(spi, shub);
+
+	spi->mode = SPI_MODE_3;
+	spi->bits_per_word = 8;
+	if (spi_hz)
+		spi->max_speed_hz = spi_hz;
+	ret = spi_setup(spi);
+	if (ret)
+		return dev_err_probe(dev, ret, "SPI setup\n");
+
+	shub->host_req = devm_gpiod_get(dev, "host-req", GPIOD_IN);
+	if (IS_ERR(shub->host_req))
+		return dev_err_probe(dev, PTR_ERR(shub->host_req), "host-req\n");
+	shub->mcu_resp = devm_gpiod_get(dev, "mcu-resp", GPIOD_IN);
+	if (IS_ERR(shub->mcu_resp))
+		return dev_err_probe(dev, PTR_ERR(shub->mcu_resp), "mcu-resp\n");
+	shub->mcu_req = devm_gpiod_get(dev, "mcu-req", GPIOD_OUT_LOW);
+	if (IS_ERR(shub->mcu_req))
+		return dev_err_probe(dev, PTR_ERR(shub->mcu_req), "mcu-req\n");
+	shub->nstdby = devm_gpiod_get(dev, "enable", GPIOD_OUT_LOW);
+	if (IS_ERR(shub->nstdby))
+		return dev_err_probe(dev, PTR_ERR(shub->nstdby), "enable\n");
+	/* AP awake indication: keep it high (AP awake) */
+	shub->ap_sleep = devm_gpiod_get_optional(dev, "ap-sleep", GPIOD_OUT_LOW);
+	if (IS_ERR(shub->ap_sleep))
+		return dev_err_probe(dev, PTR_ERR(shub->ap_sleep), "ap-sleep\n");
+
+	shub->vdd = devm_regulator_get(dev, "vdd-mcu");
+	if (IS_ERR(shub->vdd))
+		return dev_err_probe(dev, PTR_ERR(shub->vdd), "vdd-mcu\n");
+
+	shub->fw_name = "samsung/gtactive3wifi/bbd/bcm_sensorhub_a1.patch";
+	device_property_read_string(dev, "firmware-name", &shub->fw_name);
+	if (!device_property_read_u32(dev, "samsung,acc-position", &val))
+		shub->acc_position = val;
+	if (!device_property_read_u32(dev, "samsung,mag-position", &val))
+		shub->mag_position = val;
+
+	shub->irq = spi->irq;
+	if (shub->irq <= 0)
+		return dev_err_probe(dev, -EINVAL, "no interrupt\n");
+
+	mutex_init(&shub->io_lock);
+	mutex_init(&shub->state_lock);
+	spin_lock_init(&shub->irq_lock);
+	spin_lock_init(&shub->txq_lock);
+	INIT_WORK(&shub->work, shub_xfer_work);
+	INIT_WORK(&shub->boot_work, shub_boot_work);
+	INIT_DELAYED_WORK(&shub->fw_retry, shub_fw_retry_work);
+	init_completion(&shub->ver_done);
+
+	shub->txb = devm_kzalloc(dev, SSI_FRAME_MAX, GFP_KERNEL | GFP_DMA);
+	shub->rxb = devm_kzalloc(dev, SSI_FRAME_MAX, GFP_KERNEL | GFP_DMA);
+	shub->stage = devm_kzalloc(dev, SSI_FRAME_MAX, GFP_KERNEL);
+	if (!shub->txb || !shub->rxb || !shub->stage)
+		return -ENOMEM;
+
+	ret = kfifo_alloc(&shub->txq, SHUB_TXQ_SIZE, GFP_KERNEL);
+	if (ret)
+		return ret;
+	ret = devm_add_action_or_reset(dev, shub_free_txq, shub);
+	if (ret)
+		return ret;
+
+	shub->wq = devm_alloc_ordered_workqueue(dev, "bcm4775-shub", WQ_HIGHPRI);
+	if (!shub->wq)
+		return -ENOMEM;
+
+	shub_tl_init(shub);
+	shub_ssp_init(shub);
+
+	/* stays off until the hub is powered */
+	ret = devm_request_irq(dev, shub->irq, shub_irq,
+			       IRQF_NO_AUTOEN, "bcm4775-shub", shub);
+	if (ret)
+		return dev_err_probe(dev, ret, "irq\n");
+
+	ret = shub_iio_register(shub);
+	if (ret)
+		return ret;
+
+	/* nothing runs before this point; on removal it stops first */
+	ret = devm_add_action_or_reset(dev, shub_cleanup, shub);
+	if (ret)
+		return ret;
+
+	shub_debugfs_init(shub);
+
+	if (autoboot) {
+		shub->state = SHUB_BOOTING;
+		queue_work(system_long_wq, &shub->boot_work);
+	}
+
+	return 0;
+}
+
+static const struct of_device_id shub_of_match[] = {
+	{ .compatible = "brcm,bcm4775" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, shub_of_match);
+
+static const struct spi_device_id shub_spi_ids[] = {
+	{ "bcm4775" },
+	{ }
+};
+MODULE_DEVICE_TABLE(spi, shub_spi_ids);
+
+static struct spi_driver shub_driver = {
+	.driver = {
+		.name = "bcm4775-shub",
+		.of_match_table = shub_of_match,
+	},
+	.probe = shub_probe,
+	.id_table = shub_spi_ids,
+};
+module_spi_driver(shub_driver);
+
+MODULE_DESCRIPTION("Broadcom BCM4775 sensor hub (accelerometer, light, proximity)");
+MODULE_LICENSE("GPL");
diff --git a/drivers/iio/common/bcm4775_shub/iio.c b/drivers/iio/common/bcm4775_shub/iio.c
new file mode 100644
index 0000000000000000000000000000000000000000..fb8c8226961800b53ed699044f5c1979c0f78c09
--- /dev/null
+++ b/drivers/iio/common/bcm4775_shub/iio.c
@@ -0,0 +1,277 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * BCM4775 sensor hub: IIO devices.
+ *
+ * accel: x/y/z raw + scale + mount matrix, sysfs reads and a buffer fed
+ *        by a data-ready trigger (one trigger per hub sample);
+ * light: illuminance in lux, computed by the hub;
+ * proximity: the hub's near/far value.
+ *
+ * The hub rotates the accelerometer axes itself ("sensor formation",
+ * samsung,acc-position) into the Android convention for the panel's
+ * natural orientation; mount-matrix in DT corrects whatever remains.
+ */
+
+#include <linux/iio/buffer.h>
+#include <linux/iio/iio.h>
+#include <linux/iio/trigger.h>
+#include <linux/iio/trigger_consumer.h>
+#include <linux/iio/triggered_buffer.h>
+#include <linux/unaligned.h>
+
+#include "bcm4775_shub.h"
+
+/* SSP accelerometer samples: 4096 LSB per g */
+#define SHUB_ACCEL_SCALE_NANO	2394202	/* 9.80665 / 4096 m/s^2 */
+
+struct shub_iio {
+	struct bcm4775_shub *shub;
+	enum shub_sensor sensor;
+	struct iio_mount_matrix orientation;
+};
+
+static const struct iio_mount_matrix *
+shub_get_mount_matrix(const struct iio_dev *indio,
+		      const struct iio_chan_spec *chan)
+{
+	struct shub_iio *si = iio_priv(indio);
+
+	return &si->orientation;
+}
+
+static const struct iio_chan_spec_ext_info shub_accel_ext_info[] = {
+	IIO_MOUNT_MATRIX(IIO_SHARED_BY_TYPE, shub_get_mount_matrix),
+	{ }
+};
+
+#define SHUB_ACCEL_CHANNEL(_axis, _idx) {				\
+	.type = IIO_ACCEL,						\
+	.modified = 1,							\
+	.channel2 = IIO_MOD_##_axis,					\
+	.info_mask_separate = BIT(IIO_CHAN_INFO_RAW),			\
+	.info_mask_shared_by_type = BIT(IIO_CHAN_INFO_SCALE) |		\
+				    BIT(IIO_CHAN_INFO_SAMP_FREQ),	\
+	.ext_info = shub_accel_ext_info,				\
+	.scan_index = _idx,						\
+	.scan_type = {							\
+		.sign = 's',						\
+		.realbits = 16,						\
+		.storagebits = 16,					\
+		.endianness = IIO_LE,					\
+	},								\
+}
+
+static const struct iio_chan_spec shub_accel_channels[] = {
+	SHUB_ACCEL_CHANNEL(X, 0),
+	SHUB_ACCEL_CHANNEL(Y, 1),
+	SHUB_ACCEL_CHANNEL(Z, 2),
+	IIO_CHAN_SOFT_TIMESTAMP(3),
+};
+
+static const unsigned long shub_accel_scan_masks[] = { 0x7, 0 };
+
+static const struct iio_chan_spec shub_light_channels[] = {
+	{
+		.type = IIO_LIGHT,
+		.info_mask_separate = BIT(IIO_CHAN_INFO_PROCESSED),
+		.scan_index = -1,
+	},
+};
+
+static const struct iio_chan_spec shub_prox_channels[] = {
+	{
+		.type = IIO_PROXIMITY,
+		.info_mask_separate = BIT(IIO_CHAN_INFO_RAW),
+		.scan_index = -1,
+	},
+};
+
+static int shub_read_raw(struct iio_dev *indio, struct iio_chan_spec const *chan,
+			 int *val, int *val2, long mask)
+{
+	struct shub_iio *si = iio_priv(indio);
+	struct bcm4775_shub *shub = si->shub;
+	u8 sample[SSP_SAMPLE_MAX];
+	int ret;
+
+	switch (mask) {
+	case IIO_CHAN_INFO_SCALE:
+		*val = 0;
+		*val2 = SHUB_ACCEL_SCALE_NANO;
+		return IIO_VAL_INT_PLUS_NANO;
+
+	case IIO_CHAN_INFO_SAMP_FREQ:
+		*val = 1000 / shub->ssp.sensor[si->sensor].period_ms;
+		return IIO_VAL_INT;
+
+	case IIO_CHAN_INFO_RAW:
+	case IIO_CHAN_INFO_PROCESSED:
+		ret = shub_ssp_read_sample(shub, si->sensor, sample);
+		if (ret)
+			return ret;
+		switch (chan->type) {
+		case IIO_ACCEL:
+			*val = (s16)get_unaligned_le16(sample + 2 * chan->scan_index);
+			break;
+		case IIO_LIGHT:
+			*val = (s32)get_unaligned_le32(sample);
+			break;
+		case IIO_PROXIMITY:
+			*val = sample[0];
+			break;
+		default:
+			return -EINVAL;
+		}
+		return IIO_VAL_INT;
+
+	default:
+		return -EINVAL;
+	}
+}
+
+static const struct iio_info shub_iio_info = {
+	.read_raw = shub_read_raw,
+};
+
+static const struct iio_info shub_accel_info = {
+	.read_raw = shub_read_raw,
+	.validate_trigger = iio_validate_own_trigger,
+};
+
+static irqreturn_t shub_accel_trigger_handler(int irq, void *p)
+{
+	struct iio_poll_func *pf = p;
+	struct iio_dev *indio = pf->indio_dev;
+	struct shub_iio *si = iio_priv(indio);
+	struct shub_sensor_state *ss = &si->shub->ssp.sensor[si->sensor];
+	struct {
+		__le16 axis[3];
+		aligned_s64 ts;
+	} scan = { };
+	unsigned long flags;
+	s64 ts;
+
+	spin_lock_irqsave(&ss->sample_lock, flags);
+	memcpy(scan.axis, ss->last, sizeof(scan.axis));
+	ts = ss->last_ts;
+	spin_unlock_irqrestore(&ss->sample_lock, flags);
+
+	iio_push_to_buffers_with_ts(indio, &scan, sizeof(scan), ts);
+	iio_trigger_notify_done(indio->trig);
+
+	return IRQ_HANDLED;
+}
+
+static int shub_buffer_postenable(struct iio_dev *indio)
+{
+	struct shub_iio *si = iio_priv(indio);
+
+	return shub_ssp_sensor_enable(si->shub, si->sensor, true, true);
+}
+
+static int shub_buffer_predisable(struct iio_dev *indio)
+{
+	struct shub_iio *si = iio_priv(indio);
+
+	return shub_ssp_sensor_enable(si->shub, si->sensor, true, false);
+}
+
+static const struct iio_buffer_setup_ops shub_buffer_ops = {
+	.postenable = shub_buffer_postenable,
+	.predisable = shub_buffer_predisable,
+};
+
+static const struct iio_trigger_ops shub_trigger_ops = {
+	.validate_device = iio_trigger_validate_own_device,
+};
+
+/* A new sample arrived (transfer work context). */
+void shub_iio_push(struct bcm4775_shub *shub, enum shub_sensor s)
+{
+	struct shub_sensor_state *ss = &shub->ssp.sensor[s];
+
+	if (ss->trig)
+		iio_trigger_poll_nested(ss->trig);
+}
+
+static struct iio_dev *shub_iio_alloc(struct bcm4775_shub *shub,
+				      enum shub_sensor s, const char *name)
+{
+	struct iio_dev *indio;
+	struct shub_iio *si;
+
+	indio = devm_iio_device_alloc(shub->dev, sizeof(*si));
+	if (!indio)
+		return NULL;
+
+	si = iio_priv(indio);
+	si->shub = shub;
+	si->sensor = s;
+	indio->name = name;
+	indio->modes = INDIO_DIRECT_MODE;
+	indio->info = &shub_iio_info;
+	shub->ssp.sensor[s].indio = indio;
+
+	return indio;
+}
+
+int shub_iio_register(struct bcm4775_shub *shub)
+{
+	struct device *dev = shub->dev;
+	struct shub_sensor_state *ss = &shub->ssp.sensor[SHUB_ACCEL];
+	struct iio_dev *indio;
+	struct shub_iio *si;
+	int ret;
+
+	/* accelerometer */
+	indio = shub_iio_alloc(shub, SHUB_ACCEL, "bcm4775-accel");
+	if (!indio)
+		return -ENOMEM;
+	si = iio_priv(indio);
+	ret = iio_read_mount_matrix(dev, &si->orientation);
+	if (ret)
+		return ret;
+	indio->info = &shub_accel_info;
+	indio->channels = shub_accel_channels;
+	indio->num_channels = ARRAY_SIZE(shub_accel_channels);
+	indio->available_scan_masks = shub_accel_scan_masks;
+
+	ss->trig = devm_iio_trigger_alloc(dev, "%s-dev%d", indio->name,
+					  iio_device_id(indio));
+	if (!ss->trig)
+		return -ENOMEM;
+	ss->trig->ops = &shub_trigger_ops;
+	iio_trigger_set_drvdata(ss->trig, indio);
+	ret = devm_iio_trigger_register(dev, ss->trig);
+	if (ret)
+		return ret;
+	indio->trig = iio_trigger_get(ss->trig);
+
+	ret = devm_iio_triggered_buffer_setup(dev, indio, NULL,
+					      shub_accel_trigger_handler,
+					      &shub_buffer_ops);
+	if (ret)
+		return ret;
+	ret = devm_iio_device_register(dev, indio);
+	if (ret)
+		return ret;
+
+	/* ambient light */
+	indio = shub_iio_alloc(shub, SHUB_LIGHT, "bcm4775-light");
+	if (!indio)
+		return -ENOMEM;
+	indio->channels = shub_light_channels;
+	indio->num_channels = ARRAY_SIZE(shub_light_channels);
+	ret = devm_iio_device_register(dev, indio);
+	if (ret)
+		return ret;
+
+	/* proximity */
+	indio = shub_iio_alloc(shub, SHUB_PROX, "bcm4775-proximity");
+	if (!indio)
+		return -ENOMEM;
+	indio->channels = shub_prox_channels;
+	indio->num_channels = ARRAY_SIZE(shub_prox_channels);
+
+	return devm_iio_device_register(dev, indio);
+}
diff --git a/drivers/iio/common/bcm4775_shub/loader.c b/drivers/iio/common/bcm4775_shub/loader.c
new file mode 100644
index 0000000000000000000000000000000000000000..76960885c64cb3dc61974b9300fc40e2a8b2fbd8
--- /dev/null
+++ b/drivers/iio/common/bcm4775_shub/loader.c
@@ -0,0 +1,442 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * BCM4775 sensor hub: bring the hub application up.
+ *
+ * After power-up the chip runs its ROM bootloader, which speaks the
+ * normal packet layer. The host
+ *  1. sends an "autobaud" burst (0x80 bytes) and synchronises sequence
+ *     numbers with the ROM,
+ *  2. asks for the version (RPC 0x00 -> RPC 0x03: ASIC id, ROM version,
+ *     patch level),
+ *  3. replays the patch file: its blob is a stream of records
+ *     [type u8][len u16 LE][body]; type 0xf1 = memory write (u32 address
+ *     + data) becomes reliable RPC 0x05 [u32 addr][u16 len][data],
+ *  4. once every reliable packet is acknowledged, starts the image: RPC
+ *     0x2e [u32 entry] for an "Application" patch (unreliable),
+ *  5. waits a little, sends the autobaud burst again, synchronises with
+ *     the application and asks for its version.
+ *
+ * The patch file (as served by the stock kernel as /dev/bbd_patch) is
+ * text: <Key=Value> lines, then <Blob=...> with the image as hex digits.
+ */
+
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/firmware.h>
+#include <linux/hex.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/unaligned.h>
+
+#include "bcm4775_shub.h"
+
+#define SHUB_BOOT_TRIES		3
+#define SHUB_SYNC_TRIES		5
+#define SHUB_VERSION_TRIES	5
+#define SHUB_FW_WAITS		120	/* x SHUB_FW_WAIT_MS: 10 minutes */
+#define SHUB_FW_WAIT_MS		5000
+#define SHUB_SSP_RESTARTS	3
+
+struct shub_patch {
+	u32 asic;
+	u32 entry;
+	char type;
+	u8 *blob;
+	size_t len;
+};
+
+static const u8 shub_autobaud[36] = {
+	[0 ... 35] = 0x80,
+};
+
+/* the hub is being switched off: give up the (re)start */
+static bool shub_stopping(struct bcm4775_shub *shub)
+{
+	return READ_ONCE(shub->state) == SHUB_OFF;
+}
+
+static int patch_key(const char *text, size_t size, const char *key,
+		     const char **val, size_t *vlen)
+{
+	const char *p = strnstr(text, key, size);
+	const char *end;
+
+	if (!p)
+		return -ENOENT;
+	p += strlen(key);
+	end = memchr(p, '>', size - (p - text));
+	if (!end)
+		return -EINVAL;
+	*val = p;
+	*vlen = end - p;
+
+	return 0;
+}
+
+static int patch_u32(const char *text, size_t size, const char *key,
+		     unsigned int base, u32 *out)
+{
+	char buf[16];
+	const char *v;
+	size_t n;
+	int ret;
+
+	ret = patch_key(text, size, key, &v, &n);
+	if (ret)
+		return ret;
+	if (n >= sizeof(buf))
+		return -EINVAL;
+	memcpy(buf, v, n);
+	buf[n] = '\0';
+
+	return kstrtou32(buf, base, out);
+}
+
+static int shub_patch_parse(struct bcm4775_shub *shub,
+			    const struct firmware *fw, struct shub_patch *pt)
+{
+	const char *text = (const char *)fw->data;
+	const char *v;
+	size_t n, i;
+	u32 blen;
+	int ret, hi = -1;
+
+	ret = patch_u32(text, fw->size, "<AsicVersion=0x", 16, &pt->asic) ?:
+	      patch_u32(text, fw->size, "<PatchAddress=0x", 16, &pt->entry) ?:
+	      patch_u32(text, fw->size, "<BlobLength=", 10, &blen) ?:
+	      patch_key(text, fw->size, "<Type=", &v, &n);
+	if (ret) {
+		dev_err(shub->dev, "%s: bad header\n", shub->fw_name);
+		return -EINVAL;
+	}
+	pt->type = n ? v[0] : 0;
+
+	ret = patch_key(text, fw->size, "<Blob=", &v, &n);
+	if (ret)
+		return -EINVAL;
+
+	pt->blob = kvmalloc(blen, GFP_KERNEL);
+	if (!pt->blob)
+		return -ENOMEM;
+
+	pt->len = 0;
+	for (i = 0; i < n; i++) {
+		int d = hex_to_bin(v[i]);
+
+		if (d < 0)
+			continue;	/* line breaks */
+		if (hi < 0) {
+			hi = d;
+			continue;
+		}
+		if (pt->len >= blen)
+			break;
+		pt->blob[pt->len++] = (hi << 4) | d;
+		hi = -1;
+	}
+	if (pt->len != blen) {
+		dev_err(shub->dev, "%s: blob is %zu bytes, header says %u\n",
+			shub->fw_name, pt->len, blen);
+		kvfree(pt->blob);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+void shub_on_version(struct bcm4775_shub *shub, u32 asic, u32 rom, u32 patch)
+{
+	shub->ver.asic = asic;
+	shub->ver.rom = rom;
+	shub->ver.patch_level = patch;
+	shub->ver_valid = true;
+	complete(&shub->ver_done);
+}
+
+static int shub_get_version(struct bcm4775_shub *shub,
+			    struct shub_version *ver)
+{
+	int i, ret;
+
+	for (i = 0; i < SHUB_VERSION_TRIES && !shub_stopping(shub); i++) {
+		reinit_completion(&shub->ver_done);
+		shub->ver_valid = false;
+		ret = shub_tl_send_rpc(shub, RPC_GET_VERSION, NULL, 0, true);
+		if (ret)
+			return ret;
+		if (wait_for_completion_timeout(&shub->ver_done,
+						msecs_to_jiffies(250)) &&
+		    shub->ver_valid) {
+			*ver = shub->ver;
+			return 0;
+		}
+	}
+
+	return -ETIMEDOUT;
+}
+
+/* Autobaud burst, then the sequence-number handshake. */
+static int shub_connect(struct bcm4775_shub *shub)
+{
+	int i, ret = -ETIMEDOUT;
+
+	for (i = 0; i < SHUB_SYNC_TRIES && !shub_stopping(shub); i++) {
+		ret = shub_queue_tx(shub, shub_autobaud, sizeof(shub_autobaud));
+		if (ret)
+			return ret;
+		msleep(100);
+		ret = shub_tl_sync(shub);
+		if (!ret)
+			return 0;
+		dev_dbg(shub->dev, "no sync (try %d)\n", i + 1);
+	}
+
+	return ret;
+}
+
+static int shub_download(struct bcm4775_shub *shub, struct shub_patch *pt)
+{
+	u8 *pkt;
+	size_t off = 0, n = 0;
+	unsigned int records = 0;
+	int ret = 0;
+
+	pkt = kmalloc(TL_MAX_PAYLOAD, GFP_KERNEL);
+	if (!pkt)
+		return -ENOMEM;
+
+	while (off < pt->len) {
+		u8 type;
+		u16 len;
+		const u8 *body;
+		u8 rpc[TL_MAX_PAYLOAD];
+		size_t rlen;
+
+		if (shub_stopping(shub)) {
+			ret = -ECANCELED;
+			break;
+		}
+		if (pt->len - off < 3) {
+			ret = -EINVAL;
+			break;
+		}
+		type = pt->blob[off];
+		len = get_unaligned_le16(pt->blob + off + 1);
+		body = pt->blob + off + 3;
+		if (len > pt->len - off - 3) {
+			ret = -EINVAL;
+			break;
+		}
+
+		switch (type) {
+		case PATCH_REC_WRITE:
+			if (len < 5 || len + 2 > TL_MAX_PAYLOAD - 8) {
+				ret = -EINVAL;
+				break;
+			}
+			/* [u32 addr][u16 len][data] */
+			memcpy(rpc, body, 4);
+			put_unaligned_le16(len - 4, rpc + 4);
+			memcpy(rpc + 6, body + 4, len - 4);
+			rlen = len + 2;
+			break;
+		case PATCH_REC_MASKED_WRITE:
+			if (len != 12) {
+				ret = -EINVAL;
+				break;
+			}
+			memcpy(rpc, body, 12);
+			rlen = 12;
+			break;
+		default:
+			/* verification and service records: not in our patch */
+			dev_err(shub->dev, "patch record %#x at %zu not supported\n",
+				type, off);
+			ret = -EOPNOTSUPP;
+			break;
+		}
+		if (ret)
+			break;
+
+		/* pack records into packets of up to TL_MAX_PAYLOAD bytes */
+		if (n && n + rlen + 4 > TL_MAX_PAYLOAD) {
+			ret = shub_tl_wait_room(shub, n, 5000) ?:
+			      shub_tl_send_rpcs(shub, pkt, n, true);
+			if (ret)
+				break;
+			n = 0;
+		}
+		n += shub_rpc_put(pkt + n, type == PATCH_REC_WRITE ?
+				  RPC_MEM_WRITE : RPC_MEM_MASKED_WRITE,
+				  rpc, rlen);
+		off += 3 + len;
+		records++;
+	}
+
+	if (!ret && n)
+		ret = shub_tl_wait_room(shub, n, 5000) ?:
+		      shub_tl_send_rpcs(shub, pkt, n, true);
+	if (!ret)
+		ret = shub_tl_wait_idle(shub, 5000);
+
+	kfree(pkt);
+	if (!ret)
+		dev_info(shub->dev, "downloaded %u records\n", records);
+
+	return ret;
+}
+
+static int shub_start_app(struct bcm4775_shub *shub, struct shub_patch *pt)
+{
+	u8 args[20] = { };
+
+	put_unaligned_le32(pt->entry, args);
+	if (pt->type == 'A')
+		return shub_tl_send_rpc(shub, RPC_START_SCRATCH_APP, args, 4,
+					false);
+
+	return shub_tl_send_rpc(shub, RPC_SERVICE_START, args, sizeof(args),
+				false);
+}
+
+static int shub_boot_once(struct bcm4775_shub *shub, struct shub_patch *pt)
+{
+	ktime_t t0 = ktime_get();
+	int ret;
+
+	shub_ssp_reset(shub);
+	shub_tl_stop(shub);
+	shub_power(shub, false);
+	shub_tl_reset(shub);
+
+	ret = shub_power(shub, true);
+	if (ret)
+		return ret;
+
+	ret = shub_connect(shub);
+	if (ret) {
+		dev_err(shub->dev, "ROM does not answer (sync)\n");
+		return ret;
+	}
+
+	ret = shub_get_version(shub, &shub->rom_ver);
+	if (ret) {
+		dev_err(shub->dev, "ROM does not answer (version)\n");
+		return ret;
+	}
+	dev_info(shub->dev, "ROM: asic %#x, rom %#x, patch level %u\n",
+		 shub->rom_ver.asic, shub->rom_ver.rom,
+		 shub->rom_ver.patch_level);
+	if ((shub->rom_ver.asic & 0xffffff) != (pt->asic & 0xffffff))
+		dev_warn(shub->dev, "patch is for asic %#x\n", pt->asic);
+
+	ret = shub_download(shub, pt);
+	if (ret) {
+		dev_err(shub->dev, "download failed: %d\n", ret);
+		return ret;
+	}
+
+	ret = shub_start_app(shub, pt);
+	if (ret)
+		return ret;
+	msleep(40);
+
+	ret = shub_connect(shub);
+	if (ret) {
+		dev_err(shub->dev, "application does not answer (sync)\n");
+		return ret;
+	}
+	ret = shub_get_version(shub, &shub->app_ver);
+	if (ret) {
+		dev_err(shub->dev, "application does not answer (version)\n");
+		return ret;
+	}
+	dev_info(shub->dev, "hub application up in %lld ms (asic %#x, patch level %u)\n",
+		 ktime_ms_delta(ktime_get(), t0), shub->app_ver.asic,
+		 shub->app_ver.patch_level);
+
+	return 0;
+}
+
+void shub_fw_retry_work(struct work_struct *work)
+{
+	struct bcm4775_shub *shub = container_of(to_delayed_work(work),
+						 struct bcm4775_shub, fw_retry);
+
+	if (READ_ONCE(shub->state) == SHUB_BOOTING)
+		queue_work(system_long_wq, &shub->boot_work);
+}
+
+void shub_boot_work(struct work_struct *work)
+{
+	struct bcm4775_shub *shub = container_of(work, struct bcm4775_shub,
+						 boot_work);
+	const struct firmware *fw;
+	struct shub_patch pt = { };
+	int i, ret;
+
+	/*
+	 * The patch is not redistributable, so it may live on a file system
+	 * that is mounted after the driver probes (e.g. an encrypted root):
+	 * keep looking for a while.
+	 */
+	ret = firmware_request_nowarn(&fw, shub->fw_name, shub->dev);
+	if (ret == -ENOENT && shub->fw_waits < SHUB_FW_WAITS &&
+	    !shub_stopping(shub)) {
+		if (!shub->fw_waits++)
+			dev_info(shub->dev, "waiting for firmware %s\n",
+				 shub->fw_name);
+		queue_delayed_work(system_long_wq, &shub->fw_retry,
+				   msecs_to_jiffies(SHUB_FW_WAIT_MS));
+		return;
+	}
+	if (ret) {
+		dev_err(shub->dev, "firmware %s: %d\n", shub->fw_name, ret);
+		goto fail;
+	}
+	ret = shub_patch_parse(shub, fw, &pt);
+	release_firmware(fw);
+	if (ret)
+		goto fail;
+
+	for (i = 0; i < SHUB_BOOT_TRIES; i++) {
+		shub->boots++;
+		ret = shub_boot_once(shub, &pt);
+		if (!ret)
+			break;
+		if (shub_stopping(shub))
+			break;
+	}
+	kvfree(pt.blob);
+	if (ret)
+		goto fail;
+
+	mutex_lock(&shub->state_lock);
+	if (shub->state == SHUB_OFF) {
+		mutex_unlock(&shub->state_lock);
+		return;
+	}
+	shub->state = SHUB_RUNNING;
+	mutex_unlock(&shub->state_lock);
+
+	ret = shub_ssp_start(shub);
+	if (!ret) {
+		shub->ssp_fails = 0;
+		return;
+	}
+	dev_err(shub->dev, "SSP start failed: %d\n", ret);
+	if (++shub->ssp_fails <= SHUB_SSP_RESTARTS) {
+		shub_request_reset(shub, "SSP start failed");
+		return;
+	}
+	dev_err(shub->dev, "giving up after %u restarts\n", SHUB_SSP_RESTARTS);
+	shub_ssp_reset(shub);
+
+fail:
+	mutex_lock(&shub->state_lock);
+	if (shub->state != SHUB_OFF)
+		shub->state = SHUB_FAILED;
+	mutex_unlock(&shub->state_lock);
+	shub_tl_stop(shub);
+	shub_power(shub, false);
+}
diff --git a/drivers/iio/common/bcm4775_shub/ssp.c b/drivers/iio/common/bcm4775_shub/ssp.c
new file mode 100644
index 0000000000000000000000000000000000000000..dad80cb1de017071b66d3c8c49748a618acac833
--- /dev/null
+++ b/drivers/iio/common/bcm4775_shub/ssp.c
@@ -0,0 +1,641 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * BCM4775 sensor hub: Samsung sensor protocol (SSP).
+ *
+ * AP -> hub: a 9-byte instruction [cmd][u16 len][u16 opts][u32 arg] in
+ * RPC 0x20. opts bits 1:0 give the type: READ (the hub answers with a
+ * 4-byte header [u16 opts][u16 len] and len bytes), WRITE (the hub
+ * answers with a 4-byte header, then the AP sends the len data bytes; with
+ * the RETURN bit the hub then sends a READ|RETURN header and one result
+ * byte). len 0 means a header-only command without answer. Answers are
+ * matched by their opts value, so one transaction runs at a time.
+ *
+ * Hub -> AP data frames: header with type HUB2AP_WRITE, then records
+ * [instruction][...]; 0x37 = one sample [sensor id][sample][u64 time].
+ */
+
+#include <linux/delay.h>
+#include <linux/iio/iio.h>
+#include <linux/slab.h>
+#include <linux/unaligned.h>
+
+#include "bcm4775_shub.h"
+
+#define SSP_TIMEOUT_MS		1000
+#define SSP_INIT_DONE_MS	1000
+#define SSP_IDLE_MS		5000	/* stop a polled-only sensor after this */
+#define SSP_POLL_PERIOD_MS	20
+#define SSP_SCAN_TRIES		30
+#define SSP_SCAN_WAIT_MS	100
+
+/* sample bytes per sensor id (0 = unknown: the frame cannot be parsed) */
+static const u8 ssp_sample_len[SSP_ID_MAX] = {
+	[0] = 6, [1] = 12, [2] = 13, [3] = 6, [4] = 8, [5] = 6,
+	[7] = 1, [9] = 21, [10] = 4, [13] = 1, [14] = 1, [15] = 24,
+	[16] = 17, [17] = 17, [18] = 4, [24] = 13, [26] = 1, [27] = 1,
+	[29] = 3, [30] = 2, [31] = 25, [33] = 12, [34] = 3, [35] = 3,
+	[36] = 1, [37] = 1, [38] = 1, [40] = 21, [42] = 1, [43] = 5,
+	[48] = 1, [50] = 1,
+};
+
+static int ssp_send(struct bcm4775_shub *shub, const u8 *buf, size_t len)
+{
+	u8 rpc[SSP_MAX_WRITE + 2];
+
+	if (len > SSP_MAX_WRITE)
+		return -EMSGSIZE;
+	put_unaligned_le16(len, rpc);
+	memcpy(rpc + 2, buf, len);
+
+	return shub_tl_send_rpc(shub, RPC_SENSOR_REQUEST, rpc, len + 2, false);
+}
+
+int shub_ssp_xfer(struct bcm4775_shub *shub, u8 cmd, u16 opts, u32 arg,
+		  void *buf, u16 len, unsigned int timeout_ms)
+{
+	struct shub_ssp *ssp = &shub->ssp;
+	u8 hdr[SSP_HDR_LEN];
+	int ret;
+
+	hdr[0] = cmd;
+	put_unaligned_le16(len, hdr + 1);
+	put_unaligned_le16(opts, hdr + 3);
+	put_unaligned_le32(arg, hdr + 5);
+
+	mutex_lock(&ssp->xfer_lock);
+
+	spin_lock_bh(&ssp->lock);
+	ssp->pend_opts = opts;
+	ssp->pend_len = len;
+	ssp->pend_buf = (opts & SSP_TYPE_MASK) == SSP_AP2HUB_READ ? buf : NULL;
+	ssp->pend_wdata = (opts & SSP_TYPE_MASK) == SSP_AP2HUB_WRITE ? buf : NULL;
+	ssp->pend_active = len != 0;
+	reinit_completion(&ssp->pend_done);
+	spin_unlock_bh(&ssp->lock);
+
+	ret = ssp_send(shub, hdr, sizeof(hdr));
+	if (ret || !len)
+		goto out;
+
+	if (!wait_for_completion_timeout(&ssp->pend_done,
+					 msecs_to_jiffies(timeout_ms))) {
+		ssp->timeouts++;
+		ret = -ETIMEDOUT;
+	}
+
+out:
+	spin_lock_bh(&ssp->lock);
+	ssp->pend_active = false;
+	ssp->pend_buf = NULL;
+	ssp->pend_wdata = NULL;
+	spin_unlock_bh(&ssp->lock);
+	mutex_unlock(&ssp->xfer_lock);
+
+	return ret;
+}
+
+static int ssp_read(struct bcm4775_shub *shub, u8 cmd, void *buf, u16 len)
+{
+	return shub_ssp_xfer(shub, cmd, SSP_AP2HUB_READ, 0, buf, len,
+			     SSP_TIMEOUT_MS);
+}
+
+static int ssp_write(struct bcm4775_shub *shub, u8 cmd, const void *buf,
+		     u16 len)
+{
+	return shub_ssp_xfer(shub, cmd, SSP_AP2HUB_WRITE, 0, (void *)buf, len,
+			     SSP_TIMEOUT_MS);
+}
+
+/* --- hub -> AP ---------------------------------------------------- */
+
+static enum shub_sensor ssp_sensor_of(u8 id)
+{
+	switch (id) {
+	case SSP_ID_ACCEL:
+		return SHUB_ACCEL;
+	case SSP_ID_LIGHT:
+		return SHUB_LIGHT;
+	case SSP_ID_PROX:
+		return SHUB_PROX;
+	default:
+		return SHUB_NR_SENSORS;
+	}
+}
+
+static void ssp_sample(struct bcm4775_shub *shub, u8 id, const u8 *sample)
+{
+	struct shub_ssp *ssp = &shub->ssp;
+	enum shub_sensor s = ssp_sensor_of(id);
+	struct shub_sensor_state *ss;
+	unsigned long flags;
+
+	ssp->samples++;
+	if (s == SHUB_NR_SENSORS)
+		return;
+
+	ss = &ssp->sensor[s];
+	spin_lock_irqsave(&ss->sample_lock, flags);
+	memcpy(ss->last, sample, ss->sample_len);
+	ss->last_ts = ss->indio ? iio_get_time_ns(ss->indio) : 0;
+	ss->have_sample = true;
+	spin_unlock_irqrestore(&ss->sample_lock, flags);
+	complete_all(&ss->sample);
+
+	if (READ_ONCE(ss->buffered))
+		shub_iio_push(shub, s);
+}
+
+static void ssp_dataframe(struct bcm4775_shub *shub, const u8 *p, size_t len)
+{
+	struct shub_ssp *ssp = &shub->ssp;
+	size_t i = 0;
+	u16 n;
+	u8 id;
+
+	while (i < len) {
+		u8 inst = p[i++];
+
+		switch (inst) {
+		case SSP_REC_SAMPLE:
+			if (i >= len)
+				goto bad;
+			id = p[i++];
+			if (id >= SSP_ID_MAX || !ssp_sample_len[id] ||
+			    i + ssp_sample_len[id] + 8 > len)
+				goto bad;
+			ssp_sample(shub, id, p + i);
+			i += ssp_sample_len[id] + 8;
+			break;
+		case SSP_REC_INIT_DONE:
+			complete(&ssp->init_done);
+			break;
+		case SSP_REC_TS_OFFSET:
+			i += 8;
+			break;
+		case SSP_REC_BIG_DATA:
+			/* [type][u32 len][u32 hub address]: not fetched */
+			i += 9;
+			break;
+		case SSP_REC_META:
+			i += 2;
+			break;
+		case SSP_REC_TIME_SYNC:
+			break;
+		case SSP_REC_GYRO_CAL:
+			i += 12;
+			break;
+		case SSP_REC_SCONTEXT:
+			i += 72;
+			break;
+		case SSP_REC_PROX_CAL:
+			i += 8;
+			break;
+		case SSP_REC_DEBUG:
+			if (i + 2 > len)
+				goto bad;
+			n = get_unaligned_le16(p + i);
+			i += 2;
+			if (!n || n > len - i)
+				goto bad;
+			dev_info(shub->dev, "hub: %.*s\n",
+				 (int)strnlen((const char *)p + i, n), p + i);
+			i += n;
+			break;
+		default:
+			goto bad;
+		}
+	}
+	return;
+
+bad:
+	ssp->bad_frames++;
+	dev_dbg_ratelimited(shub->dev, "bad data frame (record %#x at %zu/%zu)\n",
+			    p[i ? i - 1 : 0], i, len);
+}
+
+static void ssp_rx_reset(struct shub_ssp *ssp)
+{
+	ssp->rx_len = 0;
+	ssp->rx_need = SSP_REPLY_HDR_LEN;
+	ssp->rx_body = false;
+}
+
+static void ssp_header(struct bcm4775_shub *shub)
+{
+	struct shub_ssp *ssp = &shub->ssp;
+	u16 opts = get_unaligned_le16(ssp->rx);
+	u16 len = get_unaligned_le16(ssp->rx + 2);
+	const u8 *wdata = NULL;
+	u16 wlen = 0;
+	bool done = false;
+
+	ssp->rx_opts = opts;
+	ssp->rx_type = opts & SSP_TYPE_MASK;
+	ssp_rx_reset(ssp);
+
+	switch (ssp->rx_type) {
+	case SSP_HUB2AP_WRITE:
+		ssp->hub2ap_frames++;
+		if (ssp->hub2ap_frames % 3 == 0)
+			schedule_work(&ssp->ts_work);
+		if (!len || len > SSP_RX_MAX) {
+			if (len)
+				ssp->bad_frames++;
+			return;
+		}
+		ssp->rx_need = len;
+		ssp->rx_body = true;
+		return;
+
+	case SSP_AP2HUB_READ:
+		spin_lock_bh(&ssp->lock);
+		if (ssp->pend_active && ssp->pend_opts == opts && ssp->pend_buf) {
+			ssp->rx_need = ssp->pend_len;
+			ssp->rx_body = true;
+		} else {
+			ssp->unmatched++;
+		}
+		spin_unlock_bh(&ssp->lock);
+		return;
+
+	case SSP_AP2HUB_WRITE:
+		spin_lock_bh(&ssp->lock);
+		if (ssp->pend_active && ssp->pend_opts == opts && ssp->pend_wdata) {
+			wdata = ssp->pend_wdata;
+			wlen = ssp->pend_len;
+			if (opts & SSP_RETURN) {
+				/* one result byte follows */
+				ssp->pend_opts = SSP_AP2HUB_READ | SSP_RETURN;
+				ssp->pend_len = 1;
+				ssp->pend_buf = NULL;
+				ssp->pend_wdata = NULL;
+			} else {
+				done = true;
+			}
+		} else {
+			ssp->unmatched++;
+		}
+		spin_unlock_bh(&ssp->lock);
+
+		/* the data phase */
+		if (wdata && ssp_send(shub, wdata, wlen))
+			dev_err_ratelimited(shub->dev, "SSP data phase failed\n");
+		if (done)
+			complete(&ssp->pend_done);
+		return;
+
+	default:
+		ssp->unmatched++;
+		return;
+	}
+}
+
+static void ssp_body(struct bcm4775_shub *shub)
+{
+	struct shub_ssp *ssp = &shub->ssp;
+
+	if (ssp->rx_type == SSP_HUB2AP_WRITE) {
+		ssp_dataframe(shub, ssp->rx, ssp->rx_len);
+	} else {
+		spin_lock_bh(&ssp->lock);
+		if (ssp->pend_active && ssp->pend_opts == ssp->rx_opts) {
+			if (ssp->pend_buf)
+				memcpy(ssp->pend_buf, ssp->rx, ssp->rx_len);
+			complete(&ssp->pend_done);
+		}
+		spin_unlock_bh(&ssp->lock);
+	}
+	ssp_rx_reset(ssp);
+}
+
+/* SSP byte stream from RPC 0x21 records; runs in the transfer work. */
+void shub_ssp_rx(struct bcm4775_shub *shub, const u8 *buf, size_t len)
+{
+	struct shub_ssp *ssp = &shub->ssp;
+
+	while (len) {
+		size_t n = min_t(size_t, len, ssp->rx_need);
+
+		memcpy(ssp->rx + ssp->rx_len, buf, n);
+		ssp->rx_len += n;
+		ssp->rx_need -= n;
+		buf += n;
+		len -= n;
+
+		if (ssp->rx_need)
+			continue;
+		if (ssp->rx_body)
+			ssp_body(shub);
+		else
+			ssp_header(shub);
+	}
+}
+
+/* Current AP time for the hub's sample time stamps, sent unprompted. */
+static void ssp_ts_work(struct work_struct *work)
+{
+	struct shub_ssp *ssp = container_of(work, struct shub_ssp, ts_work);
+	struct bcm4775_shub *shub = container_of(ssp, struct bcm4775_shub, ssp);
+	u8 msg[SSP_HDR_LEN + 8] = { SSP_CURRENT_TIMESTAMP };
+
+	if (!READ_ONCE(ssp->up))
+		return;
+	put_unaligned_le16(8, msg + 1);
+	put_unaligned_le16(SSP_AP2HUB_WRITE, msg + 3);
+	put_unaligned_le64(ktime_get_boottime_ns(), msg + SSP_HDR_LEN);
+	ssp_send(shub, msg, sizeof(msg));
+}
+
+/* --- sensors ------------------------------------------------------ */
+
+static int ssp_add(struct bcm4775_shub *shub, struct shub_sensor_state *ss,
+		   u8 cmd)
+{
+	u8 buf[10];
+
+	buf[0] = ss->id;
+	put_unaligned_le32(ss->period_ms, buf + 1);
+	put_unaligned_le32(0, buf + 5);	/* no batching */
+	buf[9] = 0;
+
+	return ssp_write(shub, cmd, buf, sizeof(buf));
+}
+
+static int ssp_remove(struct bcm4775_shub *shub, struct shub_sensor_state *ss)
+{
+	u8 buf[5];
+
+	buf[0] = ss->id;
+	put_unaligned_le32(ss->period_ms, buf + 1);
+
+	return ssp_write(shub, SSP_SENSOR_REMOVE, buf, sizeof(buf));
+}
+
+/* Make the hub state of one sensor match buffered || polled. */
+static int ssp_sync_sensor(struct bcm4775_shub *shub,
+			   struct shub_sensor_state *ss)
+{
+	struct shub_ssp *ssp = &shub->ssp;
+	bool want = ss->buffered || ss->polled;
+	int ret = 0;
+
+	/* before the hub is up: done by shub_ssp_start() */
+	if (!ssp->up)
+		return 0;
+	if (!(ssp->present & BIT_ULL(ss->id)))
+		return want ? -ENODEV : 0;
+
+	if (want && !ss->added) {
+		ret = ssp_add(shub, ss, SSP_SENSOR_ADD);
+		if (!ret)
+			ss->added = true;
+	} else if (!want && ss->added) {
+		ret = ssp_remove(shub, ss);
+		ss->added = false;
+		ss->have_sample = false;
+	}
+
+	return ret;
+}
+
+int shub_ssp_sensor_enable(struct bcm4775_shub *shub, enum shub_sensor s,
+			   bool buffered, bool on)
+{
+	struct shub_ssp *ssp = &shub->ssp;
+	struct shub_sensor_state *ss = &ssp->sensor[s];
+	int ret;
+
+	mutex_lock(&ssp->sensor_lock);
+	if (buffered) {
+		WRITE_ONCE(ss->buffered, on);
+	} else {
+		ss->polled = on;
+		ss->last_read = jiffies;
+	}
+	ret = ssp_sync_sensor(shub, ss);
+	mutex_unlock(&ssp->sensor_lock);
+
+	if (!buffered && on)
+		mod_delayed_work(system_dfl_wq, &ssp->idle_work,
+				 msecs_to_jiffies(SSP_IDLE_MS));
+
+	return ret;
+}
+
+/*
+ * Latest sample for read_raw; turns the sensor on for a while if needed.
+ * Fails at once while the hub is not running, so that pollers such as
+ * iio-sensor-proxy do not block on a hub that is booting or failed.
+ */
+int shub_ssp_read_sample(struct bcm4775_shub *shub, enum shub_sensor s,
+			 u8 *out)
+{
+	struct shub_ssp *ssp = &shub->ssp;
+	struct shub_sensor_state *ss = &ssp->sensor[s];
+	unsigned long flags;
+	int ret;
+
+	if (!READ_ONCE(ssp->up))
+		return -EAGAIN;
+
+	mutex_lock(&ssp->sensor_lock);
+	ss->last_read = jiffies;
+	if (!ss->added || !ss->have_sample)
+		reinit_completion(&ss->sample);
+	if (!ss->polled && !ss->buffered) {
+		ss->polled = true;
+		ret = ssp_sync_sensor(shub, ss);
+		if (ret) {
+			ss->polled = false;
+			mutex_unlock(&ssp->sensor_lock);
+			return ret;
+		}
+		mod_delayed_work(system_dfl_wq, &ssp->idle_work,
+				 msecs_to_jiffies(SSP_IDLE_MS));
+	}
+	mutex_unlock(&ssp->sensor_lock);
+
+	if (!READ_ONCE(ss->have_sample) &&
+	    !wait_for_completion_timeout(&ss->sample, msecs_to_jiffies(1000)))
+		return -ETIMEDOUT;
+
+	spin_lock_irqsave(&ss->sample_lock, flags);
+	memcpy(out, ss->last, ss->sample_len);
+	spin_unlock_irqrestore(&ss->sample_lock, flags);
+
+	return 0;
+}
+
+static void ssp_idle_work(struct work_struct *work)
+{
+	struct shub_ssp *ssp = container_of(to_delayed_work(work),
+					    struct shub_ssp, idle_work);
+	struct bcm4775_shub *shub = container_of(ssp, struct bcm4775_shub, ssp);
+	unsigned long next = 0;
+	int i;
+
+	mutex_lock(&ssp->sensor_lock);
+	for (i = 0; i < SHUB_NR_SENSORS; i++) {
+		struct shub_sensor_state *ss = &ssp->sensor[i];
+		unsigned long idle = ss->last_read + msecs_to_jiffies(SSP_IDLE_MS);
+
+		if (!ss->polled)
+			continue;
+		if (time_after_eq(jiffies, idle)) {
+			ss->polled = false;
+			ssp_sync_sensor(shub, ss);
+		} else if (!next || time_before(idle, next)) {
+			next = idle;
+		}
+	}
+	mutex_unlock(&ssp->sensor_lock);
+
+	if (next)
+		mod_delayed_work(system_dfl_wq, &ssp->idle_work,
+				 max_t(long, next - jiffies, 1));
+}
+
+/* --- bring-up ----------------------------------------------------- */
+
+int shub_ssp_start(struct bcm4775_shub *shub)
+{
+	struct shub_ssp *ssp = &shub->ssp;
+	u8 whoami = 0, pos[3];
+	__le64 present = 0;
+	__le32 rev = 0;
+	int i, ret;
+
+	ssp_rx_reset(ssp);
+
+	if (!wait_for_completion_timeout(&ssp->init_done,
+					 msecs_to_jiffies(SSP_INIT_DONE_MS)))
+		dev_info(shub->dev, "no 'sensor init done' from the hub\n");
+
+	for (i = 0; i < 3; i++) {
+		ret = ssp_read(shub, SSP_WHOAMI, &whoami, 1);
+		if (!ret && whoami == SSP_WHOAMI_ID)
+			break;
+		usleep_range(5000, 6000);
+	}
+	if (ret)
+		return ret;
+	if (whoami != SSP_WHOAMI_ID) {
+		dev_err(shub->dev, "WHOAMI %#x\n", whoami);
+		return -ENODEV;
+	}
+
+	pos[0] = shub->acc_position;
+	pos[1] = shub->acc_position;
+	pos[2] = shub->mag_position;
+	ret = ssp_write(shub, SSP_SENSOR_FORMATION, pos, sizeof(pos));
+	if (ret)
+		return ret;
+
+	/*
+	 * The hub powers and probes its sensors from its main task, which
+	 * starts after the application and takes ~0.7 s of delays before
+	 * the first probe: the bitmap stays empty until then.
+	 */
+	for (i = 0; i < SSP_SCAN_TRIES; i++) {
+		ret = ssp_read(shub, SSP_SENSOR_SCANNING, &present,
+			       sizeof(present));
+		if (ret)
+			return ret;
+		ssp->present = le64_to_cpu(present);
+		if (ssp->present)
+			break;
+		msleep(SSP_SCAN_WAIT_MS);
+	}
+	if (!ssp->present) {
+		dev_err(shub->dev, "the hub found no sensors\n");
+		return -ENODEV;
+	}
+	dev_dbg(shub->dev, "sensor scan: %d tries\n", i + 1);
+
+	if (!ssp_read(shub, SSP_FIRMWARE_REV, &rev, sizeof(rev)))
+		ssp->fw_rev = le32_to_cpu(rev);
+	ssp_read(shub, SSP_GET_ACCEL_RANGE, &ssp->accel_range, 1);
+
+	dev_info(shub->dev, "SSP up: sensors %#llx, firmware %u, accel range %u\n",
+		 ssp->present, ssp->fw_rev, ssp->accel_range);
+
+	shub_ssp_xfer(shub, SSP_AP_STATUS_WAKEUP, SSP_AP2HUB_WRITE, 0, NULL, 0,
+		      0);
+
+	mutex_lock(&ssp->sensor_lock);
+	WRITE_ONCE(ssp->up, true);
+	/* sensors enabled before a (re)start */
+	for (i = 0; i < SHUB_NR_SENSORS; i++) {
+		ssp->sensor[i].added = false;
+		ssp_sync_sensor(shub, &ssp->sensor[i]);
+	}
+	mutex_unlock(&ssp->sensor_lock);
+
+	return 0;
+}
+
+void shub_ssp_reset(struct bcm4775_shub *shub)
+{
+	struct shub_ssp *ssp = &shub->ssp;
+	int i;
+
+	mutex_lock(&ssp->sensor_lock);
+	WRITE_ONCE(ssp->up, false);
+	for (i = 0; i < SHUB_NR_SENSORS; i++) {
+		ssp->sensor[i].added = false;
+		ssp->sensor[i].have_sample = false;
+	}
+	mutex_unlock(&ssp->sensor_lock);
+
+	spin_lock_bh(&ssp->lock);
+	if (ssp->pend_active)
+		complete(&ssp->pend_done);
+	ssp->pend_active = false;
+	spin_unlock_bh(&ssp->lock);
+
+	reinit_completion(&ssp->init_done);
+	ssp_rx_reset(ssp);
+}
+
+void shub_ssp_init(struct bcm4775_shub *shub)
+{
+	struct shub_ssp *ssp = &shub->ssp;
+	static const struct {
+		u8 id, len;
+		u32 period;
+	} cfg[SHUB_NR_SENSORS] = {
+		[SHUB_ACCEL] = { SSP_ID_ACCEL, SSP_ACCEL_SAMPLE, 50 },
+		[SHUB_LIGHT] = { SSP_ID_LIGHT, SSP_LIGHT_SAMPLE, 200 },
+		[SHUB_PROX] = { SSP_ID_PROX, SSP_PROX_SAMPLE, 200 },
+	};
+	int i;
+
+	mutex_init(&ssp->xfer_lock);
+	mutex_init(&ssp->sensor_lock);
+	spin_lock_init(&ssp->lock);
+	init_completion(&ssp->pend_done);
+	init_completion(&ssp->init_done);
+	INIT_WORK(&ssp->ts_work, ssp_ts_work);
+	INIT_DELAYED_WORK(&ssp->idle_work, ssp_idle_work);
+	ssp_rx_reset(ssp);
+
+	for (i = 0; i < SHUB_NR_SENSORS; i++) {
+		struct shub_sensor_state *ss = &ssp->sensor[i];
+
+		ss->id = cfg[i].id;
+		ss->sample_len = cfg[i].len;
+		ss->period_ms = cfg[i].period;
+		spin_lock_init(&ss->sample_lock);
+		init_completion(&ss->sample);
+	}
+}
+
+void shub_ssp_remove(struct bcm4775_shub *shub)
+{
+	struct shub_ssp *ssp = &shub->ssp;
+
+	cancel_delayed_work_sync(&ssp->idle_work);
+	cancel_work_sync(&ssp->ts_work);
+	shub_ssp_reset(shub);
+}
diff --git a/drivers/iio/common/bcm4775_shub/tl.c b/drivers/iio/common/bcm4775_shub/tl.c
