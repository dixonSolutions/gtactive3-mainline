diff --git a/drivers/soc/samsung/exynos9810-cpucl1.c b/drivers/soc/samsung/exynos9810-cpucl1.c
new file mode 100644
index 0000000000000000000000000000000000000000..93e11d55d3d08e283b565a0d1765f619af86c2a7
--- /dev/null
+++ b/drivers/soc/samsung/exynos9810-cpucl1.c
@@ -0,0 +1,765 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Exynos9810 big (Samsung Mongoose M3) cluster bring-up helper.
+ *
+ * On the Exynos9810 the APM firmware (ACPM, flexPMU) owns CPU power. A core
+ * is powered up when its PSCI CPU_ON raises a pmu-intr-gen GRP1 wake event
+ * *and* that core's GRP1 wake enable is set; the APM sets the enable itself
+ * when it powers a core down (C2, hotplug), and clears it when it powers the
+ * core up. S-Boot powers the big cluster off directly (not through the APM)
+ * and leaves GRP1_INTR_BID_ENABLE = 0, so CPU_ON of CPUs 4-7 never reaches
+ * the APM. Arming the wake enable is the missing trigger: measured, the APM
+ * then runs its cluster-1 and core power-up sequences. (EL3's CPU_ON only
+ * sets CLUSTER1_CPUn_CONFIGURATION[3:0]; it never powers the cluster.)
+ *
+ * The cluster's coherent request port on the SCI is left disconnected by
+ * S-Boot (CRP_PM_CC1_0[1:0] = 3); the APM's cluster1_off sequence does the
+ * same, and its cluster1_on sequence never writes the port. Measured on
+ * 2026-10-23: when a big core actually runs, the port reads 0 (connected)
+ * without anybody on the AP side writing it, i.e. the cluster's own power-up
+ * (or the EL3 warm boot code on the core) connects it. Writing it from the
+ * AP while the cluster was powered but its core could not run hung the SoC
+ * so hard that the watchdog did not reset it: this driver never writes it.
+ *
+ * Samsung's kernel applies its pmucal "lpm_init" sequence at time_init
+ * (cal_if_init(), so before the secondary CPUs are started). Mainline's
+ * exynos-pmu programs its CPU subset (CPU_QCH_CLUSTER1_NONCPU top byte 0x8d,
+ * MEMORY_CLUSTER*_OPTION = 2) only at its postcore_initcall probe, after
+ * smp_init(). Three measurements line up with that:
+ *  - late online, kernel without that exynos-pmu code (2026-10-22): the APM
+ *    powers cluster and core, the core never fetches, the port stays 3;
+ *  - late online after the probe (2026-10-23): same power-up, the port
+ *    connects by itself and the core enters the kernel;
+ *  - CPU_ON in smp_init() (2026-10-23): as the first case.
+ * The ACPM IPC stack was up in the first case, so it is not what matters.
+ * LPM_PMU programs the lpm_init PMU subset before the first big-core CPU_ON.
+ *
+ * Everything here is OFF unless asked for with exynos9810_cpucl1.enable=,
+ * a bit mask (also writable at runtime under /sys/module/.../parameters):
+ *
+ *   BIT(0) ARM_WAKE     arm the GRP1 wake enable of a big core right before
+ *                       its CPU_ON (stale pending bits cleared first)
+ *   BIT(1) LPM_PMU      stock lpm_init's CPU and reset subset, once, before
+ *                       the first big-core CPU_ON (PMU space only):
+ *                       CPU_QCH_CLUSTER1_NONCPU, MEMORY_CLUSTER{0,1}_*_OPTION,
+ *                       RESET_LPI_TIMEOUT and WDTRESET_LPI
+ *   BIT(2)              (was SCI_CONNECT: removed, ignored)
+ *   BIT(3) DEBUG_PCSR   in the report, read the stuck core's external debug
+ *                       EDPRSR/EDPCSR (only while the PMU says it is powered)
+ *   BIT(4) WATCHDOG     before the first big-core CPU_ON, arm the cluster-0
+ *                       watchdog (~82 s) and make any reset enter Download
+ *                       mode (RECOVERY with wdt_to_recovery=1), unless the
+ *                       watchdog is already armed. Also programs the reset
+ *                       LPI timeout of LPM_PMU, so that the reset sequence
+ *                       cannot wait forever for the LPI handshake of a hung
+ *                       bus port. For tests only: it rewrites the reboot
+ *                       reason of every later reset
+ *   BIT(5) REPORT_PLL   in the report, read PLL_CON0_PLL_CPUCL1 while the
+ *                       PMU says cluster 1 is on (with 0x09 the report hung
+ *                       the SoC on 26102302: this read or the debug one)
+ *   BIT(6) PMU_HINTS    before each big-core CPU_ON, what exynos-pmu's CPU
+ *                       hotplug prepare callback does for that core (it is
+ *                       not registered yet in smp_init): CPU_INFORM = 0, GRP2
+ *                       wake enable and PMU_EVENT_INTERRUPT_ENABLE_GRP2 bit
+ *                       cleared, stale GRP2 pending bit cleared. Only ever
+ *                       masks GRP2; it never unmasks it
+ *   BIT(7) LPM_CMU      stock lpm_init's CMU_CPUCL1 / CPUCL1 bus writes, once
+ *                       (unproven with the cluster off)
+ *
+ * A boot of all eight CPUs wants ARM_WAKE | LPM_PMU | PMU_HINTS (0x43); test
+ * kernels add WATCHDOG (0x53). A read-only line with the PMU state that
+ * differs between a boot and a late online (QCH, memory option, CPU_INFORM,
+ * GRP2, event masks, LPI reset settings) is printed before each armed CPU_ON.
+ *
+ * Each armed CPU_ON is followed by a report a few seconds later (PMU core and
+ * cluster status, GRP1 state, CRP_PM_CC1_0, optionally the CPUCL1 PLL and
+ * the core's debug registers: both sit behind the cluster's bus port). The
+ * secondary boot trace (CONFIG_ARM64_DEBUG_SECONDARY_BOOT) tells how far the
+ * core got.
+ *
+ * Boot-attempt record: the first big-core CPU_ON of a boot writes a record
+ * into DRAM that survives warm resets (the last page of the "uboot-log"
+ * no-map reserved region, which uniLoader and the bring-up init only use at
+ * its start and its last 16 bytes); late_initcall_sync clears it. Finding
+ * it at the next boot means that boot hung while starting the big cores:
+ * with wdt_fallback=1 (default) this boot then leaves them off, so a bad
+ * setup cannot loop, and the boot after it tries again. PMU RST_STAT is not
+ * used for this: its watchdog bits survive a following software reset.
+ *
+ * Independently of enable=, every CPU that comes online is checked against
+ * the MPIDR hash the suspend code uses (arm64 sleep.S drops one affinity
+ * level for MT MPIDRs): a big core whose live MPIDR does not hash like its
+ * DT "reg" would corrupt another core's context in C2.
+ *
+ * Note on cpu4-7 and maxcpus=: the Mongoose cores lack ARMv8.1+ features the
+ * Cortex-A55s have (LSE atomics, PAN, LDAPR, XNX, ...) and need errata
+ * handling the A55s do not (KPTI, Spectre-v2/v4/BHB). A big core onlined
+ * after an A55-only boot dies at its first LSE atomic (measured: cstep 0x20,
+ * mmgrab()), and without LSE it would still be rejected by those local
+ * errata, which a late CPU may not add. For real use all eight CPUs must be
+ * started at boot (no maxcpus=4), so the system features are the common
+ * subset. A late online is still the safest first test of the power-up.
+ *
+ * Big cores going down: offlining CPU4 on an eight-CPU boot (2026-10-23)
+ * hung the SoC; exynos-pmu now gives their CPU_OFF/C2 hint the way Samsung's
+ * kernel does (at the end of the hotplug teardown, stale GRP2 request
+ * dropped first), but that is unproven. Until it is, a big core refuses to
+ * go offline (-EBUSY, also for suspend's freeze_secondary_cpus(), which then
+ * aborts cleanly) unless big_hotplug=1 (runtime writable), and its C2 idle
+ * state (exynos9810_c2=1 enables it for every CPU) stays disabled unless
+ * big_c2=1; it can be enabled per CPU at runtime through cpuidle's sysfs
+ * "disable" files. kexec from an eight-CPU kernel offlines the secondaries
+ * too: with big_hotplug=0 it stops at a BUG_ON() instead of hanging.
+ */
+
+#define pr_fmt(fmt) "exynos9810-cpucl1: " fmt
+
+#include <linux/align.h>
+#include <linux/bitfield.h>
+#include <linux/bits.h>
+#include <linux/cleanup.h>
+#include <linux/cpu.h>
+#include <linux/cpuidle.h>
+#include <linux/cpuhotplug.h>
+#include <linux/delay.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/ktime.h>
+#include <linux/moduleparam.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/printk.h>
+#include <linux/sched.h>
+#include <linux/sizes.h>
+#include <linux/workqueue.h>
+
+#include <asm/cputype.h>
+#include <asm/smp_plat.h>
+
+#define CPUCL1_ARM_WAKE		BIT(0)
+#define CPUCL1_LPM_PMU		BIT(1)
+#define CPUCL1_SCI_REMOVED	BIT(2)
+#define CPUCL1_DEBUG_PCSR	BIT(3)
+#define CPUCL1_WATCHDOG		BIT(4)
+#define CPUCL1_REPORT_PLL	BIT(5)
+#define CPUCL1_PMU_HINTS	BIT(6)
+#define CPUCL1_LPM_CMU		BIT(7)
+
+static unsigned int enable;
+module_param(enable, uint, 0644);
+MODULE_PARM_DESC(enable, "big cluster bring-up steps (bit mask, see source)");
+
+static bool wdt_to_recovery;
+module_param(wdt_to_recovery, bool, 0644);
+MODULE_PARM_DESC(wdt_to_recovery,
+		 "WATCHDOG bit: a reset re-enters RECOVERY instead of Download mode");
+
+static bool big_c2;
+module_param(big_c2, bool, 0444);
+MODULE_PARM_DESC(big_c2, "Leave the big cores' C2 idle state enabled (exynos9810_c2=1)");
+
+static bool big_hotplug;
+module_param(big_hotplug, bool, 0644);
+MODULE_PARM_DESC(big_hotplug, "Let the big cores go offline (CPU hotplug, deep sleep)");
+
+static bool wdt_fallback = true;
+module_param(wdt_fallback, bool, 0444);
+MODULE_PARM_DESC(wdt_fallback,
+		 "After a boot that hung while starting the big cores, leave them off for one boot");
+
+/* PMU (samsung,exynos9810-pmu) */
+#define PMU_RST_STAT			0x0404
+#define PMU_WDTRESET_LPI		0x0418
+#define PMU_RESET_LPI_TIMEOUT		0x0420
+#define PMU_LPI_TIMEOUT_EN		BIT(0)
+#define PMU_LPI_TIMEOUT_DUR		GENMASK(31, 16)
+#define PMU_WDT_DISABLE			0x0408
+#define PMU_WDT_MASK_RESET		0x040c
+#define PMU_CL0_WDTRESET		BIT(24)
+#define PMU_INFORM2			0x0808
+#define PMU_INFORM3			0x080c
+#define PMU_SEC_POWER_RESET		0x12345678
+#define PMU_SEC_RESET_DOWNLOAD		0x12345671
+#define PMU_SEC_RESET_RECOVERY		0x12345674
+#define PMU_CPU_INFORM(cpu)		(0x0860 + ((cpu) & 7) * 4)
+#define PMU_CPU_QCH_CL1_NONCPU		0x1088
+#define PMU_CL1_CPU_CONFIG(n)		(0x2000 + 8 * (n))
+#define PMU_CL1_CPU_STATUS(n)		(0x2004 + 8 * (n))
+#define PMU_CL1_NONCPU_CONFIG		0x2040
+#define PMU_CL1_NONCPU_STATUS		0x2044
+#define PMU_MEM_CL1_NONCPU_OPT		0x2384
+#define PMU_RESET_CL1_DBG_CONFIG	0x2600	/* + 4: status */
+#define PMU_CPUCL1_CONFIG		0x4090	/* CPUCL1 block domain */
+#define PMU_DISABLE_PLL_CPUCL1_CONFIG	0x4d4c
+#define PMU_EVT_EN_GRP1			0x7f04
+#define PMU_EVT_EN_GRP2			0x7f08
+#define PMU_PWR_ON			0xf
+
+/* pmu-intr-gen (samsung,exynos9810-pmu-intr-gen): GRP1 = APM core wake */
+#define INTR_GRP1_ENABLE		0x0100
+#define INTR_GRP1_UPEND			0x0108
+#define INTR_GRP1_CLEAR			0x010c
+#define INTR_GRP2_ENABLE		0x0200
+#define INTR_GRP2_UPEND			0x0208
+#define INTR_GRP2_CLEAR			0x020c
+
+/* Blocks without a DT node (Samsung cmucal-sfr.c / flexpmu tables) */
+#define CMU_CPUCL1_BASE			0x1d100000
+#define CMU_CPUCL1_PLL_CON0		0x0120
+#define CMU_CPUCL1_SHORTSTOP		0x0820
+#define CMU_CPUCL1_CTRL_EXT_EVENT	0x0838
+#define CMU_CPUCL1_HCHGEN_CLKMUX	0x0850
+#define CPUCL1_BUS_BASE			0x1d110000
+#define CPUCL1_BUS_DRCG_EN		0x0104
+#define SCI_BASE			0x1a000000
+#define SCI_CRP_PM_CC1_0		0x01a4
+#define SCI_CRP_PM_PORT1		0x01cc
+#define SCI_CRP_PM_PORT2		0x01f4
+/* CoreSight per-core external debug (stock DT coresight@1e000000) */
+#define DBG_CL1_CPU(n)			(0x1e410000 + 0x100000 * (n))
+#define DBG_EDPCSR_LO			0x0a0
+#define DBG_EDPCSR_HI			0x0ac
+#define DBG_EDPRSR			0x314
+
+/* Cluster-0 watchdog (watchdog_cl0@10050000), as uniLoader arms it */
+#define WTCON				0x00
+#define WTDAT				0x04
+#define WTCNT				0x08
+#define WTCON_EN_RST			(BIT(5) | BIT(0))
+#define WTCON_ARMED			((0xff << 8) | (3 << 3) | WTCON_EN_RST)
+
+/* Boot-attempt record, in the last page of the "uboot-log" region */
+#define CPUCL1_MARK_PAGE_OFF		0xfc0
+#define CPUCL1_MARK_MAGIC		0x334d4742	/* "BGM3" */
+
+struct cpucl1_mark {
+	u32 magic;
+	u32 enable;
+	u32 rst_stat;
+	u32 boots;	/* consecutive boots that hung while starting them */
+};
+
+#define CPUCL1_REPORT_MS		5500
+#define CPUCL1_POLL_MS			4
+
+struct cpucl1 {
+	void __iomem *pmu;
+	void __iomem *intrgen;
+	void __iomem *wdt;
+	void __iomem *cmu;
+	void __iomem *bus;
+	void __iomem *sci;
+	void __iomem *dbg[4];
+	struct cpucl1_mark *mark;
+	struct mutex lock;		/* armed, *_done, mark_set */
+	struct delayed_work work;
+	ktime_t armed_at[4];
+	unsigned long armed;		/* big cores waiting for a report */
+	u32 hung_boots;			/* from the record found at boot */
+	bool lpm_pmu_done;
+	bool lpm_cmu_done;
+	bool lpi_done;
+	bool wdt_done;
+	bool mark_set;
+};
+
+static struct cpucl1 cl1;
+
+/* DT reg of the big cores is 0x100 | core (Samsung's EL3 CPU numbering) */
+static int cpucl1_core(unsigned int cpu)
+{
+	u64 hwid = cpu_logical_map(cpu);
+
+	if (MPIDR_AFFINITY_LEVEL(hwid, 1) != 1)
+		return -1;
+	return MPIDR_AFFINITY_LEVEL(hwid, 0) & 3;
+}
+
+static void cpucl1_rmw(void __iomem *reg, u32 mask, u32 val)
+{
+	writel((readl(reg) & ~mask) | (val & mask), reg);
+}
+
+/*
+ * Stock lpm_init: bound the bus quiesce (LPI) handshake of the reset
+ * sequence (RESET_LPI_TIMEOUT enable, duration 0x20) and set WDTRESET_LPI.
+ * Without the timeout a hung interconnect port can keep a watchdog reset
+ * from completing.
+ */
+static void cpucl1_reset_lpi(void)
+{
+	u32 lpi = readl(cl1.pmu + PMU_WDTRESET_LPI);
+	u32 to = readl(cl1.pmu + PMU_RESET_LPI_TIMEOUT);
+
+	if (cl1.lpi_done)
+		return;
+	cl1.lpi_done = true;
+	cpucl1_rmw(cl1.pmu + PMU_RESET_LPI_TIMEOUT,
+		   PMU_LPI_TIMEOUT_EN | PMU_LPI_TIMEOUT_DUR,
+		   PMU_LPI_TIMEOUT_EN | FIELD_PREP(PMU_LPI_TIMEOUT_DUR, 0x20));
+	cpucl1_rmw(cl1.pmu + PMU_WDTRESET_LPI, BIT(0), BIT(0));
+	pr_info("reset LPI: WDTRESET_LPI %08x -> %08x, RESET_LPI_TIMEOUT %08x -> %08x\n",
+		lpi, readl(cl1.pmu + PMU_WDTRESET_LPI),
+		to, readl(cl1.pmu + PMU_RESET_LPI_TIMEOUT));
+}
+
+/*
+ * Samsung pmucal lpm_init, the CPU entries mainline's exynos-pmu programs
+ * at its (postcore) probe (same table as exynos9810_cpu_pd_options there),
+ * plus the reset LPI timeout.
+ */
+static void cpucl1_lpm_pmu(void)
+{
+	static const u16 mem_opt[] = {
+		0x2114, 0x2180, 0x21ec, 0x2258, 0x2384,	/* cluster 1 */
+		0x23c8, 0x2418, 0x2468, 0x24b8, 0x25a0,	/* cluster 0 */
+	};
+	u32 qch = readl(cl1.pmu + PMU_CPU_QCH_CL1_NONCPU);
+	u32 mem = readl(cl1.pmu + PMU_MEM_CL1_NONCPU_OPT);
+	int i;
+
+	cpucl1_rmw(cl1.pmu + PMU_CPU_QCH_CL1_NONCPU, 0xffU << 24, 0x8dU << 24);
+	for (i = 0; i < ARRAY_SIZE(mem_opt); i++)
+		cpucl1_rmw(cl1.pmu + mem_opt[i], 0x3, 0x2);
+
+	pr_info("lpm_pmu: QCH %08x -> %08x, MEMORY_CLUSTER1_NONCPU_OPTION %08x -> %08x\n",
+		qch, readl(cl1.pmu + PMU_CPU_QCH_CL1_NONCPU),
+		mem, readl(cl1.pmu + PMU_MEM_CL1_NONCPU_OPT));
+	cpucl1_reset_lpi();
+}
+
+/* Samsung pmucal lpm_init, the CMU_CPUCL1 and CPUCL1 bus entries */
+static void cpucl1_lpm_cmu(void)
+{
+	cpucl1_rmw(cl1.cmu + CMU_CPUCL1_HCHGEN_CLKMUX, 0x7f, 0);
+	cpucl1_rmw(cl1.cmu + CMU_CPUCL1_CTRL_EXT_EVENT, 0x3ff, 0x201);
+	writel(0xffffffff, cl1.cmu + CMU_CPUCL1_SHORTSTOP);
+	writel(0xffffffff, cl1.bus + CPUCL1_BUS_DRCG_EN);
+
+	pr_info("lpm_cmu: EXT_EVENT %08x SHORTSTOP %08x DRCG %08x\n",
+		readl(cl1.cmu + CMU_CPUCL1_CTRL_EXT_EVENT),
+		readl(cl1.cmu + CMU_CPUCL1_SHORTSTOP),
+		readl(cl1.bus + CPUCL1_BUS_DRCG_EN));
+}
+
+/*
+ * exynos-pmu's CPU hotplug prepare callback (__gs101_cpu_pmu_online()) for
+ * @cpu, which a late online gets and smp_init() does not: clear the C2 hint
+ * and mask (never unmask) the core's GRP2 wake.
+ */
+static void cpucl1_pmu_hints(unsigned int cpu, unsigned int core)
+{
+	u32 bit = BIT(core);
+
+	writel(0, cl1.pmu + PMU_CPU_INFORM(cpu));
+	cpucl1_rmw(cl1.intrgen + INTR_GRP2_ENABLE, bit, 0);
+	writel(readl(cl1.intrgen + INTR_GRP2_UPEND) & bit,
+	       cl1.intrgen + INTR_GRP2_CLEAR);
+	cpucl1_rmw(cl1.pmu + PMU_EVT_EN_GRP2, bit, 0);
+}
+
+/* Read-only: the PMU state that differs between a boot and a late online */
+static void cpucl1_state(unsigned int cpu)
+{
+	pr_info("cpu%u: state: QCH %08x MEMOPT %08x INFORM %08x GRP2 en %08x pend %08x EVT1 %08x EVT2 %08x LPI %08x/%08x\n",
+		cpu, readl(cl1.pmu + PMU_CPU_QCH_CL1_NONCPU),
+		readl(cl1.pmu + PMU_MEM_CL1_NONCPU_OPT),
+		readl(cl1.pmu + PMU_CPU_INFORM(cpu)),
+		readl(cl1.intrgen + INTR_GRP2_ENABLE),
+		readl(cl1.intrgen + INTR_GRP2_UPEND),
+		readl(cl1.pmu + PMU_EVT_EN_GRP1),
+		readl(cl1.pmu + PMU_EVT_EN_GRP2),
+		readl(cl1.pmu + PMU_WDTRESET_LPI),
+		readl(cl1.pmu + PMU_RESET_LPI_TIMEOUT));
+	pr_info("cpu%u: state: CPUCL1 %08x/%08x DISABLE_PLL_CPUCL1 %08x/%08x RESET_CL1_DBG %08x/%08x\n",
+		cpu, readl(cl1.pmu + PMU_CPUCL1_CONFIG),
+		readl(cl1.pmu + PMU_CPUCL1_CONFIG + 4),
+		readl(cl1.pmu + PMU_DISABLE_PLL_CPUCL1_CONFIG),
+		readl(cl1.pmu + PMU_DISABLE_PLL_CPUCL1_CONFIG + 4),
+		readl(cl1.pmu + PMU_RESET_CL1_DBG_CONFIG),
+		readl(cl1.pmu + PMU_RESET_CL1_DBG_CONFIG + 4));
+}
+
+static bool cpucl1_wdt_armed(void)
+{
+	u32 wtcon = readl(cl1.wdt + WTCON);
+
+	return (wtcon & WTCON_EN_RST) == WTCON_EN_RST &&
+	       !(readl(cl1.pmu + PMU_WDT_DISABLE) & PMU_CL0_WDTRESET) &&
+	       !(readl(cl1.pmu + PMU_WDT_MASK_RESET) & PMU_CL0_WDTRESET);
+}
+
+/* Same sequence as uniLoader's chain guard: ~82 s, then a reset */
+static void cpucl1_wdt_arm(void)
+{
+	const char *to = wdt_to_recovery ? "RECOVERY" : "Download";
+
+	if (!cl1.wdt) {
+		pr_warn("no watchdog node, not arming\n");
+		return;
+	}
+	writel(PMU_SEC_POWER_RESET, cl1.pmu + PMU_INFORM2);
+	writel(wdt_to_recovery ? PMU_SEC_RESET_RECOVERY : PMU_SEC_RESET_DOWNLOAD,
+	       cl1.pmu + PMU_INFORM3);
+	cpucl1_reset_lpi();
+	if (cpucl1_wdt_armed()) {
+		pr_info("watchdog already armed (WTCON %08x), reset -> %s\n",
+			readl(cl1.wdt + WTCON), to);
+		return;
+	}
+	writel(0, cl1.wdt + WTCON);
+	writel(0xffff, cl1.wdt + WTDAT);
+	writel(0xffff, cl1.wdt + WTCNT);
+	writel(WTCON_ARMED, cl1.wdt + WTCON);
+	cpucl1_rmw(cl1.pmu + PMU_WDT_DISABLE, PMU_CL0_WDTRESET, 0);
+	cpucl1_rmw(cl1.pmu + PMU_WDT_MASK_RESET, PMU_CL0_WDTRESET, 0);
+	pr_info("watchdog armed (~82 s, WTCON %08x), reset -> %s\n",
+		readl(cl1.wdt + WTCON), to);
+}
+
+/* The record lives in DRAM mapped write-combined: push it out */
+static void cpucl1_mark_write(u32 magic)
+{
+	struct cpucl1_mark *m = cl1.mark;
+
+	WRITE_ONCE(m->enable, READ_ONCE(enable));
+	WRITE_ONCE(m->rst_stat, readl(cl1.pmu + PMU_RST_STAT));
+	WRITE_ONCE(m->boots, magic ? cl1.hung_boots + 1 : 0);
+	WRITE_ONCE(m->magic, magic);
+	/* in DRAM before the CPU_ON (or the hang) that may follow */
+	mb();
+}
+
+static void __init cpucl1_mark_map(void)
+{
+	struct device_node *rmem __free(device_node) =
+		of_find_node_by_path("/reserved-memory");
+	struct resource res;
+
+	if (!rmem)
+		return;
+	for_each_child_of_node_scoped(rmem, np) {
+		if (!of_node_name_eq(np, "uboot-log"))
+			continue;
+		if (of_address_to_resource(np, 0, &res) ||
+		    resource_size(&res) < SZ_4K)
+			return;
+		cl1.mark = memremap(ALIGN_DOWN(res.end, SZ_4K) + CPUCL1_MARK_PAGE_OFF,
+				    sizeof(*cl1.mark), MEMREMAP_WC);
+		return;
+	}
+}
+
+/*
+ * Before smp_init(): did the previous boot hang while starting the big
+ * cores? Returns true when they must stay off for this boot.
+ */
+static bool __init cpucl1_mark_check(void)
+{
+	struct cpucl1_mark *m = cl1.mark;
+	bool off;
+
+	if (!m) {
+		pr_info("no \"uboot-log\" reserved region: no boot-attempt record\n");
+		return false;
+	}
+	if (READ_ONCE(m->magic) != CPUCL1_MARK_MAGIC)
+		return false;
+
+	cl1.hung_boots = READ_ONCE(m->boots);
+	off = enable && wdt_fallback;
+	pr_warn("the previous boot hung while starting the big cores (enable=%#x, RST_STAT then %08x, now %08x, %u in a row)%s\n",
+		READ_ONCE(m->enable), READ_ONCE(m->rst_stat),
+		readl(cl1.pmu + PMU_RST_STAT), cl1.hung_boots,
+		off ? ": big cores stay off this boot" : "");
+	cpucl1_mark_write(0);
+	return off;
+}
+
+static void cpucl1_report(unsigned int core, unsigned int cpu)
+{
+	u32 st = readl(cl1.pmu + PMU_CL1_CPU_STATUS(core));
+	bool cl_on = (readl(cl1.pmu + PMU_CL1_NONCPU_STATUS) & PMU_PWR_ON) ==
+		     PMU_PWR_ON;
+
+	pr_info("cpu%u: %s: CPU cfg %08x st %08x NONCPU cfg %08x st %08x GRP1 en %08x pend %08x\n",
+		cpu, cpu_online(cpu) ? "online" : "NOT online",
+		readl(cl1.pmu + PMU_CL1_CPU_CONFIG(core)), st,
+		readl(cl1.pmu + PMU_CL1_NONCPU_CONFIG),
+		readl(cl1.pmu + PMU_CL1_NONCPU_STATUS),
+		readl(cl1.intrgen + INTR_GRP1_ENABLE),
+		readl(cl1.intrgen + INTR_GRP1_UPEND));
+	pr_info("cpu%u: SCI CRP PM: CC1 %08x, ports +0x28 %08x, +0x50 %08x\n",
+		cpu, readl(cl1.sci + SCI_CRP_PM_CC1_0),
+		readl(cl1.sci + SCI_CRP_PM_PORT1),
+		readl(cl1.sci + SCI_CRP_PM_PORT2));
+
+	/* CMU_CPUCL1 and the core's debug APB sit in the cluster power domain */
+	if (!cl_on)
+		return;
+	if (READ_ONCE(enable) & CPUCL1_REPORT_PLL)
+		pr_info("cpu%u: PLL_CON0_PLL_CPUCL1 %08x\n", cpu,
+			readl(cl1.cmu + CMU_CPUCL1_PLL_CON0));
+
+	if ((READ_ONCE(enable) & CPUCL1_DEBUG_PCSR) && cl1.dbg[core] &&
+	    (st & PMU_PWR_ON) == PMU_PWR_ON) {
+		void __iomem *d = cl1.dbg[core];
+		u32 prsr = readl(d + DBG_EDPRSR);
+		u32 lo = readl(d + DBG_EDPCSR_LO);
+		u32 hi = readl(d + DBG_EDPCSR_HI);
+		u32 lo2 = readl(d + DBG_EDPCSR_LO);
+
+		pr_info("cpu%u: EDPRSR %08x EDPCSR %08x%08x (again %08x)\n",
+			cpu, prsr, hi, lo, lo2);
+	}
+}
+
+static void cpucl1_work_fn(struct work_struct *work)
+{
+	unsigned int cpu, core;
+	bool pending = false;
+	ktime_t now = ktime_get();
+
+	mutex_lock(&cl1.lock);
+	for_each_possible_cpu(cpu) {
+		int c = cpucl1_core(cpu);
+
+		if (c < 0 || !test_bit(c, &cl1.armed))
+			continue;
+		core = c;
+		if (cpu_online(cpu) ||
+		    ktime_ms_delta(now, cl1.armed_at[core]) > CPUCL1_REPORT_MS) {
+			cpucl1_report(core, cpu);
+			clear_bit(core, &cl1.armed);
+		} else {
+			pending = true;
+		}
+	}
+	if (pending)
+		schedule_delayed_work(&cl1.work, msecs_to_jiffies(CPUCL1_POLL_MS));
+	mutex_unlock(&cl1.lock);
+}
+
+/* CPUHP_BP_PREPARE_DYN: on the boot CPU, before PSCI CPU_ON of @cpu */
+static int cpucl1_prepare(unsigned int cpu)
+{
+	unsigned int en = READ_ONCE(enable) & ~CPUCL1_SCI_REMOVED;
+	int core = cpucl1_core(cpu);
+	u32 bit;
+
+	if (core < 0 || !en)
+		return 0;
+
+	mutex_lock(&cl1.lock);
+	if (cl1.mark && !cl1.mark_set && system_state < SYSTEM_RUNNING) {
+		cpucl1_mark_write(CPUCL1_MARK_MAGIC);
+		cl1.mark_set = true;
+	}
+	cpucl1_state(cpu);
+	if ((en & CPUCL1_WATCHDOG) && !cl1.wdt_done) {
+		cpucl1_wdt_arm();
+		cl1.wdt_done = true;
+	}
+	if ((en & CPUCL1_LPM_PMU) && !cl1.lpm_pmu_done) {
+		cpucl1_lpm_pmu();
+		cl1.lpm_pmu_done = true;
+	}
+	if ((en & CPUCL1_LPM_CMU) && !cl1.lpm_cmu_done) {
+		cpucl1_lpm_cmu();
+		cl1.lpm_cmu_done = true;
+	}
+	if (en & CPUCL1_PMU_HINTS)
+		cpucl1_pmu_hints(cpu, core);
+	if (en & CPUCL1_ARM_WAKE) {
+		bit = BIT(core);
+		pr_info("cpu%u: arming the APM wake (GRP1 en %08x pend %08x NONCPU st %08x CPU st %08x)\n",
+			cpu, readl(cl1.intrgen + INTR_GRP1_ENABLE),
+			readl(cl1.intrgen + INTR_GRP1_UPEND),
+			readl(cl1.pmu + PMU_CL1_NONCPU_STATUS),
+			readl(cl1.pmu + PMU_CL1_CPU_STATUS(core)));
+		writel(readl(cl1.intrgen + INTR_GRP1_UPEND) & bit,
+		       cl1.intrgen + INTR_GRP1_CLEAR);
+		cpucl1_rmw(cl1.intrgen + INTR_GRP1_ENABLE, bit, bit);
+	}
+	cl1.armed_at[core] = ktime_get();
+	set_bit(core, &cl1.armed);
+	schedule_delayed_work(&cl1.work, msecs_to_jiffies(CPUCL1_POLL_MS));
+	mutex_unlock(&cl1.lock);
+
+	return 0;
+}
+
+/* CPUHP_AP_ONLINE_DYN: on the CPU that just came up */
+static int cpucl1_ap_online(unsigned int cpu)
+{
+	u64 mpidr = read_cpuid_mpidr();
+	u64 hashed = (mpidr & MPIDR_MT_BITMASK) ? mpidr >> MPIDR_LEVEL_BITS : mpidr;
+	u64 hwid = cpu_logical_map(cpu);
+	bool ok = !((hashed ^ hwid) & mpidr_hash.mask);
+
+	if (!ok)
+		pr_err("cpu%u: MPIDR %#llx does not hash like DT reg %#llx (mask %#llx): keep C2 off\n",
+		       cpu, mpidr, hwid, mpidr_hash.mask);
+	else if (cpucl1_core(cpu) >= 0)
+		pr_info("cpu%u: MIDR %08x MPIDR %#llx (DT reg %#llx), suspend hash ok\n",
+			cpu, read_cpuid_id(), mpidr, hwid);
+	return 0;
+}
+
+/*
+ * CPUHP_AP_ONLINE_DYN teardown, on the CPU going down. Registered after
+ * exynos-pmu's state, so it runs (and can refuse) before that one marks
+ * the CPU as in hotplug.
+ */
+static int cpucl1_ap_offline(unsigned int cpu)
+{
+	if (cpucl1_core(cpu) < 0)
+		return 0;
+	if (!READ_ONCE(big_hotplug)) {
+		pr_warn_ratelimited("cpu%u: big core stays online (big_hotplug=0)\n",
+				    cpu);
+		return -EBUSY;
+	}
+	pr_info("cpu%u: going offline: INFORM %08x GRP1 en %08x pend %08x GRP2 en %08x pend %08x EVT2 %08x\n",
+		cpu, readl(cl1.pmu + PMU_CPU_INFORM(cpu)),
+		readl(cl1.intrgen + INTR_GRP1_ENABLE),
+		readl(cl1.intrgen + INTR_GRP1_UPEND),
+		readl(cl1.intrgen + INTR_GRP2_ENABLE),
+		readl(cl1.intrgen + INTR_GRP2_UPEND),
+		readl(cl1.pmu + PMU_EVT_EN_GRP2));
+	return 0;
+}
+
+static void __iomem *cpucl1_map_compat(const char *compat)
+{
+	struct device_node *np = of_find_compatible_node(NULL, NULL, compat);
+	void __iomem *base;
+
+	if (!np)
+		return NULL;
+	base = of_iomap(np, 0);
+	of_node_put(np);
+	return base;
+}
+
+/*
+ * early_initcall: before smp_init() starts the secondary CPUs, so the same
+ * callbacks run for a boot without maxcpus=4 and for a later online.
+ */
+static int __init exynos9810_cpucl1_init(void)
+{
+	int i, ret;
+
+	if (!of_machine_is_compatible("samsung,exynos9810"))
+		return 0;
+
+	cl1.pmu = cpucl1_map_compat("samsung,exynos9810-pmu");
+	cl1.intrgen = cpucl1_map_compat("samsung,exynos9810-pmu-intr-gen");
+	cl1.wdt = cpucl1_map_compat("samsung,exynos9810-wdt");
+	cl1.cmu = ioremap(CMU_CPUCL1_BASE, SZ_4K);
+	cl1.bus = ioremap(CPUCL1_BUS_BASE, SZ_4K);
+	cl1.sci = ioremap(SCI_BASE, SZ_4K);
+	for (i = 0; i < ARRAY_SIZE(cl1.dbg); i++)
+		cl1.dbg[i] = ioremap(DBG_CL1_CPU(i), SZ_4K);
+	if (!cl1.pmu || !cl1.intrgen || !cl1.cmu || !cl1.bus || !cl1.sci) {
+		pr_err("cannot map the PMU / CMU_CPUCL1 / SCI\n");
+		return -ENOMEM;
+	}
+
+	mutex_init(&cl1.lock);
+	INIT_DELAYED_WORK(&cl1.work, cpucl1_work_fn);
+
+	if (enable & CPUCL1_SCI_REMOVED)
+		pr_warn("enable bit 0x4 (SCI_CONNECT) was removed and is ignored\n");
+
+	/*
+	 * smp_init() has not run yet: a big core that is not present is simply
+	 * not started. The record is read (and cleared) whatever enable= is,
+	 * so the RECOVERY kernel after a hung test kernel says so.
+	 */
+	cpucl1_mark_map();
+	if (cpucl1_mark_check()) {
+		unsigned int cpu;
+
+		enable = 0;
+		for_each_present_cpu(cpu)
+			if (cpucl1_core(cpu) >= 0)
+				set_cpu_present(cpu, false);
+	}
+
+	ret = cpuhp_setup_state_nocalls(CPUHP_BP_PREPARE_DYN,
+					"soc/exynos9810-cpucl1:prepare",
+					cpucl1_prepare, NULL);
+	if (ret < 0)
+		return ret;
+	ret = cpuhp_setup_state_nocalls(CPUHP_AP_ONLINE_DYN,
+					"soc/exynos9810-cpucl1:online",
+					cpucl1_ap_online, NULL);
+	if (ret < 0)
+		return ret;
+
+	if (enable)
+		pr_info("enable=%#x\n", enable);
+	return 0;
+}
+early_initcall(exynos9810_cpucl1_init);
+
+/* The boot got through starting the big cores: drop the attempt record */
+static int __init exynos9810_cpucl1_mark_done(void)
+{
+	unsigned int cpu, n = 0;
+
+	mutex_lock(&cl1.lock);
+	if (cl1.mark_set) {
+		for_each_online_cpu(cpu)
+			n += cpucl1_core(cpu) >= 0;
+		cpucl1_mark_write(0);
+		cl1.mark_set = false;
+		pr_info("big cores started at boot: %u online\n", n);
+	}
+	mutex_unlock(&cl1.lock);
+	return 0;
+}
+late_initcall_sync(exynos9810_cpucl1_mark_done);
+
+/* After exynos-pmu (postcore) registered its CPU hotplug states */
+static int __init exynos9810_cpucl1_offline_gate(void)
+{
+	int ret;
+
+	if (!cl1.pmu)
+		return 0;
+	ret = cpuhp_setup_state_nocalls(CPUHP_AP_ONLINE_DYN,
+					"soc/exynos9810-cpucl1:offline",
+					NULL, cpucl1_ap_offline);
+	return ret < 0 ? ret : 0;
+}
+late_initcall(exynos9810_cpucl1_offline_gate);
+
+#ifdef CONFIG_CPU_IDLE
+/* After cpuidle-psci (device_initcall) registered the per-CPU devices */
+static int __init exynos9810_cpucl1_c2_gate(void)
+{
+	unsigned int cpu, n = 0;
+	int i;
+
+	if (big_c2 || !cl1.pmu)
+		return 0;
+
+	for_each_present_cpu(cpu) {
+		struct cpuidle_device *dev = per_cpu(cpuidle_devices, cpu);
+
+		if (cpucl1_core(cpu) < 0 || !dev)
+			continue;
+		for (i = 1; i < CPUIDLE_STATE_MAX; i++)
+			dev->states_usage[i].disable |= CPUIDLE_STATE_DISABLED_BY_USER;
+		n++;
+	}
+	if (n)
+		pr_info("idle states beyond WFI off on %u big cores (big_c2=1 keeps them)\n",
+			n);
+	return 0;
+}
+late_initcall(exynos9810_cpucl1_c2_gate);
+#endif
