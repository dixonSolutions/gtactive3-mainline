diff --git a/drivers/media/platform/samsung/exynos9810-csis/exynos9810-csis.c b/drivers/media/platform/samsung/exynos9810-csis/exynos9810-csis.c
new file mode 100644
index 0000000000000000000000000000000000000000..e8dab7c87df34ce06ee40958120bf416b3fda158
--- /dev/null
+++ b/drivers/media/platform/samsung/exynos9810-csis/exynos9810-csis.c
@@ -0,0 +1,1301 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Samsung Exynos9810 MIPI CSI-2 receiver (CSIS v5.1) with its VC DMA
+ *
+ * Captures the raw Bayer stream of a sensor straight to memory, without
+ * the camera ISP (whose image processing is proprietary firmware). Each
+ * CSIS instance is one platform device with one video capture node;
+ * virtual channel 0 only. Register layout and programming sequence
+ * follow Samsung's GPL fimc-is2 driver (fimc-is-hw-csi-v5_1.c,
+ * fimc-is-device-csi_v4.c).
+ *
+ * Pipeline: sensor (source pad) -> CSIS video node.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/clk.h>
+#include <linux/dma-mapping.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/mfd/syscon.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/property.h>
+#include <linux/regmap.h>
+#include <linux/slab.h>
+
+#include <media/media-device.h>
+#include <media/mipi-csi2.h>
+#include <media/v4l2-async.h>
+#include <media/v4l2-common.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-ioctl.h>
+#include <media/v4l2-mc.h>
+#include <media/v4l2-subdev.h>
+#include <media/videobuf2-dma-contig.h>
+
+#define CSIS_DRV_NAME		"exynos9810-csis"
+
+/*
+ * Bring-up aid: the media device driver name reported to user space.
+ * libcamera's simple pipeline matches media devices by driver name, so
+ * until it knows this driver, e.g. mc_driver_name=qcom-camss (a receiver
+ * it runs with the software ISP) lets an unpatched libcamera use it.
+ */
+static char *mc_driver_name;
+module_param(mc_driver_name, charp, 0444);
+MODULE_PARM_DESC(mc_driver_name, "media device driver name override");
+
+/*
+ * Bring-up aid: override the shared DMA SRAM split and CSIS-to-SRAM
+ * matrix (COMMON_DMA_SRAM_SPLIT / COMMON_DMA_MATRIX) for experiments.
+ */
+static uint cdma_split = 640 << 16 | 640;
+module_param(cdma_split, uint, 0644);
+MODULE_PARM_DESC(cdma_split, "COMMON_DMA_SRAM_SPLIT value (SRAM1 entries << 16 | SRAM0 entries)");
+static uint dvfs_settle_ms = 10;
+module_param(dvfs_settle_ms, uint, 0644);
+MODULE_PARM_DESC(dvfs_settle_ms, "wait after the streaming DVFS request before the receiver starts");
+static bool cdma_init = true;
+module_param(cdma_init, bool, 0444);
+MODULE_PARM_DESC(cdma_init, "reset and set up the common DMA at probe");
+static int cdma_matrix = -1;
+module_param(cdma_matrix, int, 0644);
+MODULE_PARM_DESC(cdma_matrix, "COMMON_DMA_MATRIX value (0, 2, 5, 14, 16, 17, 22, 23), -1: the streaming receiver on SRAM0_0");
+
+/* CSIS core */
+#define CSIS_VERSION		0x0000
+#define CSIS_CMN_CTRL		0x0004
+#define  CMN_CTRL_PHY_SEL		BIT(21)
+#define  CMN_CTRL_QCHANNEL_EN		BIT(20)
+#define  CMN_CTRL_UPDATE_SHADOW		GENMASK(19, 16)
+#define  CMN_CTRL_INTERLEAVE_MODE	GENMASK(11, 10)
+#define  CMN_CTRL_INTERLEAVE_VC_ONLY	2
+#define  CMN_CTRL_LANE_NUMBER		GENMASK(9, 8)
+#define  CMN_CTRL_SW_RESET		BIT(1)
+#define  CMN_CTRL_CSI_EN		BIT(0)
+#define CSIS_INT_MSK0		0x0010
+#define CSIS_INT_SRC0		0x0014
+#define  INT0_FRAMESTART(vc)		BIT(24 + (vc))
+#define  INT0_FRAMEEND(vc)		BIT(20 + (vc))
+#define  INT0_ERR_SOT_HS(vc)		BIT(16 + (vc))
+#define  INT0_ERR_LOST_FS(vc)		BIT(12 + (vc))
+#define  INT0_ERR_LOST_FE(vc)		BIT(8 + (vc))
+#define  INT0_ERR_OVER			BIT(4)
+#define  INT0_ERR_WRONG_CFG		BIT(3)
+#define  INT0_ERR_ECC			BIT(2)
+#define  INT0_ERR_CRC			BIT(1)
+#define  INT0_ERR_ID			BIT(0)
+#define  INT0_ERRORS			0x000fff1f
+#define CSIS_INT_MSK1		0x0018
+#define CSIS_INT_SRC1		0x001c
+#define  INT1_ERRORS			0x0000fff0
+#define CSIS_ISP_CONFIG(vc)	(0x0040 + 0x10 * (vc))
+#define  ISP_CONFIG_PIXEL_MODE		GENMASK(13, 12)
+#define  ISP_CONFIG_PIXEL_MODE_DUAL	1
+#define  ISP_CONFIG_DATAFORMAT		GENMASK(7, 2)
+#define  ISP_CONFIG_VC			GENMASK(1, 0)
+#define CSIS_ISP_RESOL(vc)	(0x0044 + 0x10 * (vc))
+#define CSIS_FRM_CNT(vc)	(0x0100 + 4 * (vc))
+#define CSIS_PHY_STATUS		0x0700
+#define CSIS_PHY_CMN_CTRL	0x0704
+#define  PHY_CMN_ENABLE_DAT		GENMASK(4, 1)
+#define  PHY_CMN_ENABLE_CLK		BIT(0)
+
+/* VC DMA, one register window per virtual channel */
+#define DMA_CTRL		0x00
+#define  DMA_CTRL_UPDT_FRAMEPTR		GENMASK(4, 2)
+#define  DMA_CTRL_UPDT_PTR_EN		BIT(1)
+#define  DMA_CTRL_ENABLE		BIT(0)	/* "DMA_N_DISABLE" in the GPL code */
+#define DMA_FMT			0x04
+#define  DMA_FMT_DIM_1D			BIT(5)
+#define  DMA_FMT_PACKET_MODE		BIT(4)
+#define  DMA_FMT_PACK12			BIT(3)	/* 12-bit containers, else 16-bit */
+#define  DMA_FMT_DATAFORMAT		GENMASK(1, 0)
+#define DMA_ADDR(n)		(0x10 + 4 * (n))
+#define DMA_NR_ADDR		8
+#define DMA_ACT_CTRL		0x30
+#define DMA_RESOL		0x40
+
+/* VC DMA common window */
+#define DMA_DATA_CTRL		0x00
+#define DMA_INT_MASK		0x04
+#define DMA_INT_SRC		0x08
+#define  DMA_INT_OTF_OVERLAP(vc)	BIT(20 + (vc))
+#define  DMA_INT_ABORT_DONE		BIT(16)
+#define  DMA_INT_ERROR			BIT(12)
+#define  DMA_INT_FRM_END(vc)		BIT(8 + (vc))
+#define  DMA_INT_FRM_START(vc)		BIT(4 + (vc))
+#define DMA_CMN_CTRL		0x14
+#define  DMA_CMN_CTRL_ABORT_REQ		BIT(0)
+#define DMA_ERR_CODE		0x18
+#define DMA_OTF_FORMAT		0x1c
+
+/* CSIS common DMA (shared by all instances) */
+#define CDMA_ARB_PRI		0x00
+#define CDMA_CTRL		0x08
+#define  CDMA_CTRL_IP_PROCESSING	BIT(1)
+#define  CDMA_CTRL_SW_RESET		BIT(0)
+#define CDMA_SRAM_SPLIT		0x0c
+#define  CDMA_SRAM_ENTRIES		640	/* 16 bytes each, per bank */
+#define CDMA_MATRIX		0x10
+
+/* D-PHY slave (M4S4 variants) */
+#define PHY_BIAS_CTRL(n)	(0x0400 + 4 * (n))
+#define PHY_ACTRL_SC_06		0x2418
+#define PHY_DCTRL_SC_02		0x2484
+#define PHY_ACTRL_SD_08(l)	(0x283c + 0x400 * (l))
+#define PHY_DCTRL_SD_05(l)	(0x28ac + 0x400 * (l))
+#define PHY_DCTRL_SD_06(l)	(0x28b0 + 0x400 * (l))
+#define PHY_DCTRL_SD_13(l)	(0x28e0 + 0x400 * (l))
+
+/* SYSREG_ISPPRE: D-PHY reset (1 = out of reset) */
+#define SYSREG_PHY_RESET	0x500
+
+#define CSIS_MIN_SIZE		64
+/* a line has to fit the 10 KiB SRAM bank of the DMA, at 2 bytes a pixel */
+#define CSIS_MAX_WIDTH		(CDMA_SRAM_ENTRIES * 16 / 2)
+#define CSIS_MAX_HEIGHT		8192
+
+/*
+ * Camera DVFS levels (ACPM domains intcam and cam) in kHz: the stock
+ * devfreq maximum while streaming, its floor otherwise.
+ */
+struct csis_soc_data {
+	unsigned long intcam_on, intcam_off;
+	unsigned long cam_on, cam_off;
+	/* CSIS instances: register base of the first, stride */
+	phys_addr_t csis0_base;
+	u32 csis_stride;
+	/* COMMON_DMA_MATRIX value putting CSIS<n>'s DMA on SRAM0_0 */
+	u8 matrix_sram0[4];
+};
+
+/*
+ * Matrix values from the GPL driver (csi_hw_s_dma_common()):
+ *       CSIS0    CSIS1    CSIS2    CSIS3
+ *  0 :  SRAM0_0  SRAM0_0  SRAM1_0  SRAM1_1
+ * 14 :  SRAM1_0  SRAM0_1  SRAM0_0  SRAM1_1
+ * 17 :  SRAM1_0  SRAM1_1  SRAM0_1  SRAM0_0
+ */
+static const struct csis_soc_data exynos9810_csis_data = {
+	.intcam_on = 690000, .intcam_off = 630000,
+	.cam_on = 690000, .cam_off = 590000,
+	.csis0_base = 0x16230000,
+	.csis_stride = 0x10000,
+	.matrix_sram0 = { 0, 0, 14, 17 },
+};
+
+/* the receiver whose DMA has SRAM0_0, while it streams */
+static DEFINE_MUTEX(csis_sram_lock);
+static struct csis_device *csis_sram_owner;
+
+struct csis_format {
+	u32 code;
+	u32 fourcc;
+	u8 dt;
+	u8 bpp;		/* bits per pixel on the bus */
+	bool packed;	/* DMA packet mode: the CSI-2 payload as received */
+};
+
+/*
+ * The VC DMA in legacy storage mode stores each RAW10 pixel LSB-aligned
+ * in a 16-bit little endian word (DMA_FMT PACK12 clear, the stock
+ * SBGGR16 path; Samsung's FIMC-LITE driver in mainline exposes the same
+ * mode as V4L2_PIX_FMT_SGRBG10), each line padded to 16 bytes. With
+ * PACK12 set it would use 12-bit little endian containers (2 pixels in
+ * 3 bytes), a layout V4L2 and libcamera have no format for.
+ */
+static const struct csis_format csis_formats[] = {
+	{ MEDIA_BUS_FMT_SBGGR10_1X10, V4L2_PIX_FMT_SBGGR10, MIPI_CSI2_DT_RAW10, 10 },
+	{ MEDIA_BUS_FMT_SGBRG10_1X10, V4L2_PIX_FMT_SGBRG10, MIPI_CSI2_DT_RAW10, 10 },
+	{ MEDIA_BUS_FMT_SGRBG10_1X10, V4L2_PIX_FMT_SGRBG10, MIPI_CSI2_DT_RAW10, 10 },
+	{ MEDIA_BUS_FMT_SRGGB10_1X10, V4L2_PIX_FMT_SRGGB10, MIPI_CSI2_DT_RAW10, 10 },
+	/*
+	 * DMA packet storage mode stores the CSI-2 payload bytes unchanged:
+	 * MIPI RAW10 packed, 4 pixels in 5 bytes (stride to be confirmed).
+	 */
+	{ MEDIA_BUS_FMT_SBGGR10_1X10, V4L2_PIX_FMT_SBGGR10P, MIPI_CSI2_DT_RAW10, 10, true },
+	{ MEDIA_BUS_FMT_SGBRG10_1X10, V4L2_PIX_FMT_SGBRG10P, MIPI_CSI2_DT_RAW10, 10, true },
+	{ MEDIA_BUS_FMT_SGRBG10_1X10, V4L2_PIX_FMT_SGRBG10P, MIPI_CSI2_DT_RAW10, 10, true },
+	{ MEDIA_BUS_FMT_SRGGB10_1X10, V4L2_PIX_FMT_SRGGB10P, MIPI_CSI2_DT_RAW10, 10, true },
+};
+
+struct csis_buffer {
+	struct vb2_v4l2_buffer vb;
+	struct list_head list;
+	dma_addr_t addr;
+};
+
+struct csis_device {
+	struct device *dev;
+	void __iomem *regs;
+	void __iomem *phy;
+	void __iomem *vcdma;
+	void __iomem *dmacmn;
+	void __iomem *cdma;
+	struct regmap *sysreg;
+	u32 phy_reset_bit;
+	bool phy_bias;
+	struct clk *dvfs_cam;
+	struct clk *dvfs_intcam;
+	const struct csis_soc_data *soc;
+	u8 matrix;			/* COMMON_DMA_MATRIX for this receiver */
+
+	struct media_device mdev;
+	struct v4l2_device v4l2_dev;
+	struct video_device vdev;
+	struct media_pad vpad;
+	struct vb2_queue queue;
+	struct mutex lock;		/* serialises the video node */
+
+	struct v4l2_async_notifier notifier;
+	struct v4l2_subdev *sensor;
+	u16 sensor_pad;
+	struct v4l2_mbus_config_mipi_csi2 bus;
+
+	struct v4l2_pix_format pix;
+	const struct csis_format *fmt;
+
+	spinlock_t slock;		/* protects the buffer state below */
+	struct list_head queued;
+	struct csis_buffer *active;	/* being written */
+	struct csis_buffer *next;	/* programmed, latched at frame start */
+	void *scratch;			/* frames with no queued buffer */
+	dma_addr_t scratch_addr;
+	size_t scratch_size;
+	u32 sequence;
+
+	/* per stream, reported when it stops */
+	u32 cnt_fs;			/* receiver frame starts */
+	u32 cnt_dma_fs;			/* DMA frame starts */
+	u32 err_csis;
+	u32 err_dma;
+	u32 last_err0, last_err1;
+	u32 dma_err_src;		/* error bits of DMA_INT_SRC, ORed */
+	u32 dma_err_code;		/* DMA_ERR_CODE at the last error */
+};
+
+static inline struct csis_buffer *to_csis_buffer(struct vb2_v4l2_buffer *vb)
+{
+	return container_of(vb, struct csis_buffer, vb);
+}
+
+static void csis_rmw(void __iomem *base, u32 off, u32 mask, u32 val)
+{
+	writel((readl(base + off) & ~mask) | (val & mask), base + off);
+}
+
+/*
+ * Only MIPI-packed RAW10 by default: libcamera's GPU debayer (SoftISP with
+ * EGL) takes 8-bit and CSI-2 packed Bayer only. With 16-bit words the
+ * SoftISP falls back to debayering on the CPU, which the A55 cores do at a
+ * few frames per second, and the lines are 8/5 the size.
+ */
+static bool unpacked16;
+module_param(unpacked16, bool, 0444);
+MODULE_PARM_DESC(unpacked16, "also offer RAW10 in 16-bit words");
+
+static bool csis_format_usable(const struct csis_format *fmt)
+{
+	return fmt->packed || unpacked16;
+}
+
+static const struct csis_format *csis_default_format(void)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(csis_formats); i++)
+		if (csis_format_usable(&csis_formats[i]))
+			return &csis_formats[i];
+	return &csis_formats[0];
+}
+
+static const struct csis_format *csis_find_code(u32 code)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(csis_formats); i++)
+		if (csis_formats[i].code == code &&
+		    csis_format_usable(&csis_formats[i]))
+			return &csis_formats[i];
+	return NULL;
+}
+
+static const struct csis_format *csis_find_fourcc(u32 fourcc)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(csis_formats); i++)
+		if (csis_formats[i].fourcc == fourcc &&
+		    csis_format_usable(&csis_formats[i]))
+			return &csis_formats[i];
+	return NULL;
+}
+
+/* -----------------------------------------------------------------------------
+ * Hardware
+ */
+
+/*
+ * HS settle in byte clocks, fitted to Samsung's 10 nm LPP table
+ * (fimc-is-hw-settle-10nm-lpp.h): 49 per Gbps below 1.5 Gbps per lane
+ * (HS mode select, e.g. 1196 Mbps -> 59), and from 7 at 1.5 Gbps up by 6
+ * per Gbps with skew calibration above it.
+ */
+static u32 csis_settle(u32 mbps)
+{
+	if (mbps >= 1500)
+		return 7 + (mbps - 1500) * 6 / 1000;
+	return DIV_ROUND_CLOSEST(mbps * 49, 1000);
+}
+
+static void csis_phy_config(struct csis_device *csis, u32 mbps)
+{
+	unsigned int lanes = csis->bus.num_data_lanes, l;
+	bool slow = mbps < 1500;
+	u32 settle = csis_settle(mbps);
+	u32 dly = mbps >= 3000 ? 1 : mbps >= 2000 ? 2 : 3;
+
+	if (csis->phy_bias) {
+		writel(0x10, csis->phy + PHY_BIAS_CTRL(1));
+		writel(0x05, csis->phy + PHY_BIAS_CTRL(3));
+		writel(0x68, csis->phy + PHY_BIAS_CTRL(5));
+		writel(0x6c, csis->phy + PHY_BIAS_CTRL(6));
+	}
+	writel(0x02, csis->phy + PHY_ACTRL_SC_06);
+	csis_rmw(csis->phy, PHY_DCTRL_SC_02, 0xff, 1);	/* CLKSETTLECTL */
+
+	for (l = 0; l < lanes; l++) {
+		csis_rmw(csis->phy, PHY_DCTRL_SD_13(l), BIT(0), slow ? 0 : BIT(0));
+		csis_rmw(csis->phy, PHY_ACTRL_SD_08(l), GENMASK(6, 5),
+			 slow ? 0 : dly << 5);
+		csis_rmw(csis->phy, PHY_DCTRL_SD_05(l), BIT(2), slow ? BIT(2) : 0);
+		csis_rmw(csis->phy, PHY_DCTRL_SD_06(l), 0xff, settle);
+	}
+
+	dev_dbg(csis->dev, "D-PHY %u lanes, %u Mbps, settle %u\n", lanes, mbps,
+		settle);
+}
+
+static void csis_phy_reset(struct csis_device *csis, bool release)
+{
+	regmap_update_bits(csis->sysreg, SYSREG_PHY_RESET,
+			   BIT(csis->phy_reset_bit),
+			   release ? BIT(csis->phy_reset_bit) : 0);
+}
+
+static int csis_sw_reset(struct csis_device *csis)
+{
+	u32 val;
+	int ret;
+
+	csis_rmw(csis->regs, CSIS_CMN_CTRL, CMN_CTRL_SW_RESET, CMN_CTRL_SW_RESET);
+	ret = readl_poll_timeout(csis->regs + CSIS_CMN_CTRL, val,
+				 !(val & CMN_CTRL_SW_RESET), 10, 1000);
+	if (ret)
+		dev_err(csis->dev, "software reset timed out\n");
+	return ret;
+}
+
+static void csis_dma_set_addr(struct csis_device *csis, dma_addr_t addr)
+{
+	unsigned int i;
+
+	/*
+	 * All eight frame slots get the same address: if the frame pointer
+	 * advances on its own (late interrupt), the DMA never writes to a
+	 * stale address (same workaround as csi_hw_s_dma_addr()).
+	 */
+	for (i = 0; i < DMA_NR_ADDR; i++)
+		writel(lower_32_bits(addr), csis->vcdma + DMA_ADDR(i));
+}
+
+static void csis_cdma_setup(struct csis_device *csis)
+{
+	csis_rmw(csis->cdma, CDMA_ARB_PRI, 0xf, 1 << 2 | 2);
+	csis_rmw(csis->cdma, CDMA_CTRL, CDMA_CTRL_IP_PROCESSING,
+		 CDMA_CTRL_IP_PROCESSING);
+	writel(cdma_split, csis->cdma + CDMA_SRAM_SPLIT);
+	writel(cdma_matrix >= 0 ? cdma_matrix : csis->matrix,
+	       csis->cdma + CDMA_MATRIX);
+}
+
+/*
+ * The first stream after the common DMA is set up loses every frame
+ * (DMA_OTF_OVERLAP), later ones work: set the line buffer up at probe,
+ * after a reset of the block, so that no stream starts on the reset split.
+ */
+static void csis_cdma_init(struct csis_device *csis)
+{
+	csis_rmw(csis->cdma, CDMA_CTRL, CDMA_CTRL_SW_RESET, CDMA_CTRL_SW_RESET);
+	udelay(10);
+	csis_rmw(csis->cdma, CDMA_CTRL, CDMA_CTRL_SW_RESET, 0);
+	csis_cdma_setup(csis);
+}
+
+/*
+ * Stop the VC DMA for good. Turning DMA_CTRL off only takes effect at the
+ * next frame start; a stream stopped in the middle of a frame left the DMA
+ * busy, and the next stream on it got DMA_OTF_OVERLAP on every frame
+ * without one DMA start (SM-T570, camt6, 2026-10-23). Cancel it as the
+ * stock driver does a failed DMA, and wait until it is idle.
+ */
+static int csis_dma_abort(struct csis_device *csis)
+{
+	u32 act;
+	int ret;
+
+	writel(0, csis->vcdma + DMA_CTRL);
+	writel(DMA_CMN_CTRL_ABORT_REQ, csis->dmacmn + DMA_CMN_CTRL);
+	ret = readl_poll_timeout(csis->vcdma + DMA_ACT_CTRL, act,
+				 !(act & DMA_CTRL_ENABLE), 100, 40000);
+	writel(0, csis->dmacmn + DMA_CMN_CTRL);
+	writel(DMA_INT_ABORT_DONE, csis->dmacmn + DMA_INT_SRC);
+	if (ret)
+		dev_warn(csis->dev, "VC DMA still active after abort (%08x)\n",
+			 act);
+	return ret;
+}
+
+static void csis_hw_start(struct csis_device *csis)
+{
+	u32 w = csis->pix.width, h = csis->pix.height;
+	u32 val;
+
+	/* lanes, one VC per stream */
+	val = readl(csis->regs + CSIS_CMN_CTRL);
+	val &= ~(CMN_CTRL_LANE_NUMBER | CMN_CTRL_INTERLEAVE_MODE);
+	val |= FIELD_PREP(CMN_CTRL_LANE_NUMBER, csis->bus.num_data_lanes - 1);
+	val |= FIELD_PREP(CMN_CTRL_INTERLEAVE_MODE, CMN_CTRL_INTERLEAVE_VC_ONLY);
+	writel(val, csis->regs + CSIS_CMN_CTRL);
+	csis_rmw(csis->regs, CSIS_PHY_CMN_CTRL, PHY_CMN_ENABLE_DAT,
+		 FIELD_PREP(PHY_CMN_ENABLE_DAT,
+			    GENMASK(csis->bus.num_data_lanes - 1, 0)));
+
+	writel(FIELD_PREP(ISP_CONFIG_PIXEL_MODE, ISP_CONFIG_PIXEL_MODE_DUAL) |
+	       FIELD_PREP(ISP_CONFIG_DATAFORMAT, csis->fmt->dt) |
+	       FIELD_PREP(ISP_CONFIG_VC, 0), csis->regs + CSIS_ISP_CONFIG(0));
+	writel(h << 16 | w, csis->regs + CSIS_ISP_RESOL(0));
+
+	/* VC0 DMA: 2D; legacy storage (RAW10 in 16-bit words) or packets */
+	writel(csis->fmt->packed ? DMA_FMT_PACKET_MODE :
+	       FIELD_PREP(DMA_FMT_DATAFORMAT, 0), csis->vcdma + DMA_FMT);
+	writel(w, csis->vcdma + DMA_RESOL);
+	writel(0, csis->dmacmn + DMA_OTF_FORMAT);
+	writel(0, csis->dmacmn + DMA_DATA_CTRL);	/* input: OTF */
+
+	/*
+	 * Common DMA arbitration as the GPL driver sets it. The line buffer:
+	 * a line has to fit the SRAM partition of the receiver's DMA, or the
+	 * DMA drops every frame (DMA_OTF_OVERLAP). Measured on the SM-T570
+	 * with the split at 640/640: SRAM0_0 holds 5152-byte lines (CSIS2
+	 * at 2576 pixels, matrix 14) and 4128-byte ones (CSIS0, matrix 0),
+	 * SRAM1_0 not even 4128 bytes (CSIS0, matrix 14), so how the SRAM1
+	 * split counts is not known. The streaming receiver gets SRAM0_0
+	 * through the matrix; one receiver streams at a time.
+	 */
+	csis_cdma_setup(csis);
+
+	/* interrupts: frame start/end per VC and errors */
+	writel(0xffffffff, csis->regs + CSIS_INT_SRC0);
+	writel(0xffffffff, csis->regs + CSIS_INT_SRC1);
+	writel(0xffffffff, csis->dmacmn + DMA_INT_SRC);
+	writel(INT0_ERRORS | INT0_FRAMESTART(0), csis->regs + CSIS_INT_MSK0);
+	writel(INT1_ERRORS, csis->regs + CSIS_INT_MSK1);
+	writel(DMA_INT_FRM_START(0) | DMA_INT_FRM_END(0) | DMA_INT_ERROR |
+	       DMA_INT_OTF_OVERLAP(0), csis->dmacmn + DMA_INT_MASK);
+
+	writel(DMA_CTRL_UPDT_PTR_EN | DMA_CTRL_ENABLE, csis->vcdma + DMA_CTRL);
+
+	/* csi_hw_enable() */
+	csis_rmw(csis->regs, CSIS_CMN_CTRL, CMN_CTRL_UPDATE_SHADOW,
+		 CMN_CTRL_UPDATE_SHADOW);
+	csis_rmw(csis->regs, CSIS_CMN_CTRL, CMN_CTRL_PHY_SEL, 0);
+	csis_rmw(csis->regs, CSIS_PHY_CMN_CTRL, PHY_CMN_ENABLE_CLK,
+		 PHY_CMN_ENABLE_CLK);
+	csis_rmw(csis->regs, CSIS_CMN_CTRL, CMN_CTRL_QCHANNEL_EN, 0);
+	csis_rmw(csis->regs, CSIS_CMN_CTRL, CMN_CTRL_CSI_EN, CMN_CTRL_CSI_EN);
+}
+
+static void csis_hw_stop(struct csis_device *csis)
+{
+	writel(0, csis->vcdma + DMA_CTRL);
+	writel(0, csis->dmacmn + DMA_INT_MASK);
+	writel(0, csis->regs + CSIS_INT_MSK0);
+	writel(0, csis->regs + CSIS_INT_MSK1);
+	csis_rmw(csis->regs, CSIS_PHY_CMN_CTRL,
+		 PHY_CMN_ENABLE_CLK | PHY_CMN_ENABLE_DAT, 0);
+	csis_rmw(csis->regs, CSIS_CMN_CTRL, CMN_CTRL_CSI_EN, 0);
+	csis_rmw(csis->regs, CSIS_CMN_CTRL, CMN_CTRL_QCHANNEL_EN,
+		 CMN_CTRL_QCHANNEL_EN);
+}
+
+/* -----------------------------------------------------------------------------
+ * Interrupts and buffer rotation
+ *
+ * The DMA takes the address of a frame when the frame starts. At each
+ * frame start the buffer that was programmed becomes the active one and
+ * the next queued buffer (or the scratch buffer) is programmed; at frame
+ * end the active buffer is complete.
+ */
+
+static void csis_program_next(struct csis_device *csis)
+{
+	struct csis_buffer *buf;
+
+	buf = list_first_entry_or_null(&csis->queued, struct csis_buffer, list);
+	if (buf)
+		list_del(&buf->list);
+	csis->next = buf;
+	csis_dma_set_addr(csis, buf ? buf->addr : csis->scratch_addr);
+}
+
+static irqreturn_t csis_dma_irq(int irq, void *data)
+{
+	struct csis_device *csis = data;
+	u32 src = readl(csis->dmacmn + DMA_INT_SRC);
+
+	if (!src)
+		return IRQ_NONE;
+	writel(src, csis->dmacmn + DMA_INT_SRC);
+
+	spin_lock(&csis->slock);
+
+	if (src & (DMA_INT_ERROR | DMA_INT_OTF_OVERLAP(0))) {
+		csis->err_dma++;
+		csis->dma_err_src |= src & (DMA_INT_ERROR | DMA_INT_ABORT_DONE |
+					    DMA_INT_OTF_OVERLAP(0));
+		csis->dma_err_code = readl(csis->dmacmn + DMA_ERR_CODE);
+	}
+
+	/* an end and the following start in one interrupt: end first */
+	if (src & DMA_INT_FRM_END(0)) {
+		struct csis_buffer *buf = csis->active;
+
+		csis->active = NULL;
+		if (buf) {
+			buf->vb.vb2_buf.timestamp = ktime_get_ns();
+			buf->vb.sequence = csis->sequence;
+			buf->vb.field = V4L2_FIELD_NONE;
+			vb2_buffer_done(&buf->vb.vb2_buf, VB2_BUF_STATE_DONE);
+		}
+		csis->sequence++;
+	}
+
+	if (src & DMA_INT_FRM_START(0)) {
+		csis->cnt_dma_fs++;
+		if (csis->active) {
+			/* no end seen for the last frame: give it back */
+			list_add(&csis->active->list, &csis->queued);
+			csis->active = NULL;
+		}
+		csis->active = csis->next;
+		csis_program_next(csis);
+	}
+
+	spin_unlock(&csis->slock);
+	return IRQ_HANDLED;
+}
+
+static irqreturn_t csis_irq(int irq, void *data)
+{
+	struct csis_device *csis = data;
+	u32 s0 = readl(csis->regs + CSIS_INT_SRC0);
+	u32 s1 = readl(csis->regs + CSIS_INT_SRC1);
+
+	if (!s0 && !s1)
+		return IRQ_NONE;
+	writel(s0, csis->regs + CSIS_INT_SRC0);
+	writel(s1, csis->regs + CSIS_INT_SRC1);
+
+	if (s0 & INT0_FRAMESTART(0))
+		csis->cnt_fs++;
+	if ((s0 & INT0_ERRORS) || (s1 & INT1_ERRORS)) {
+		csis->err_csis++;
+		csis->last_err0 = s0;
+		csis->last_err1 = s1;
+		dev_dbg_ratelimited(csis->dev, "CSIS error %08x %08x\n", s0, s1);
+	}
+	return IRQ_HANDLED;
+}
+
+/* -----------------------------------------------------------------------------
+ * videobuf2
+ */
+
+static int csis_queue_setup(struct vb2_queue *vq, unsigned int *nbuffers,
+			    unsigned int *nplanes, unsigned int sizes[],
+			    struct device *alloc_devs[])
+{
+	struct csis_device *csis = vb2_get_drv_priv(vq);
+
+	if (*nplanes)
+		return sizes[0] < csis->pix.sizeimage ? -EINVAL : 0;
+
+	*nplanes = 1;
+	sizes[0] = csis->pix.sizeimage;
+	return 0;
+}
+
+static int csis_buf_prepare(struct vb2_buffer *vb)
+{
+	struct csis_device *csis = vb2_get_drv_priv(vb->vb2_queue);
+	dma_addr_t addr = vb2_dma_contig_plane_dma_addr(vb, 0);
+
+	if (vb2_plane_size(vb, 0) < csis->pix.sizeimage)
+		return -EINVAL;
+	/* the VC DMA takes 32-bit addresses */
+	if (upper_32_bits(addr + csis->pix.sizeimage - 1))
+		return -EINVAL;
+
+	vb2_set_plane_payload(vb, 0, csis->pix.sizeimage);
+	to_csis_buffer(to_vb2_v4l2_buffer(vb))->addr = addr;
+	return 0;
+}
+
+static void csis_buf_queue(struct vb2_buffer *vb)
+{
+	struct csis_device *csis = vb2_get_drv_priv(vb->vb2_queue);
+	struct csis_buffer *buf = to_csis_buffer(to_vb2_v4l2_buffer(vb));
+	unsigned long flags;
+
+	spin_lock_irqsave(&csis->slock, flags);
+	list_add_tail(&buf->list, &csis->queued);
+	spin_unlock_irqrestore(&csis->slock, flags);
+}
+
+static void csis_return_buffers(struct csis_device *csis,
+				enum vb2_buffer_state state)
+{
+	struct csis_buffer *buf, *tmp;
+	unsigned long flags;
+
+	spin_lock_irqsave(&csis->slock, flags);
+	if (csis->active)
+		list_add_tail(&csis->active->list, &csis->queued);
+	if (csis->next)
+		list_add_tail(&csis->next->list, &csis->queued);
+	csis->active = NULL;
+	csis->next = NULL;
+	list_for_each_entry_safe(buf, tmp, &csis->queued, list) {
+		list_del(&buf->list);
+		vb2_buffer_done(&buf->vb.vb2_buf, state);
+	}
+	spin_unlock_irqrestore(&csis->slock, flags);
+}
+
+/*
+ * The ISPPRE bus runs from the intcam and cam DVFS domains; until a level
+ * is requested it crawls at 25 MHz, far below a 4-lane sensor's pixel rate.
+ */
+static int csis_dvfs(struct csis_device *csis, bool on)
+{
+	const struct csis_soc_data *l = csis->soc;
+	int ret = 0;
+
+	if (csis->dvfs_intcam)
+		ret = clk_set_rate(csis->dvfs_intcam,
+				   (on ? l->intcam_on : l->intcam_off) * 1000);
+	if (!ret && csis->dvfs_cam)
+		ret = clk_set_rate(csis->dvfs_cam,
+				   (on ? l->cam_on : l->cam_off) * 1000);
+	return ret;
+}
+
+static void csis_free_scratch(struct csis_device *csis)
+{
+	if (csis->scratch)
+		dma_free_attrs(csis->dev, csis->scratch_size, csis->scratch,
+			       csis->scratch_addr, DMA_ATTR_NO_KERNEL_MAPPING);
+	csis->scratch = NULL;
+}
+
+static void csis_release_sram(struct csis_device *csis)
+{
+	mutex_lock(&csis_sram_lock);
+	if (csis_sram_owner == csis)
+		csis_sram_owner = NULL;
+	mutex_unlock(&csis_sram_lock);
+}
+
+static int csis_start_streaming(struct vb2_queue *vq, unsigned int count)
+{
+	struct csis_device *csis = vb2_get_drv_priv(vq);
+	struct media_pad *spad = &csis->sensor->entity.pads[csis->sensor_pad];
+	unsigned long flags;
+	s64 link_freq;
+	u32 mbps;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(csis->dev);
+	if (ret)
+		goto err_return;
+
+	ret = video_device_pipeline_alloc_start(&csis->vdev);
+	if (ret)
+		goto err_pm;
+
+	/*
+	 * The DMA writes a whole frame to the scratch buffer when starved;
+	 * the margin covers a sensor that sends more lines than configured.
+	 */
+	csis->scratch_size = PAGE_ALIGN(csis->pix.sizeimage * 5 / 4);
+	csis->scratch = dma_alloc_attrs(csis->dev, csis->scratch_size,
+					&csis->scratch_addr, GFP_KERNEL,
+					DMA_ATTR_NO_KERNEL_MAPPING);
+	if (!csis->scratch ||
+	    upper_32_bits(csis->scratch_addr + csis->scratch_size - 1)) {
+		ret = -ENOMEM;
+		goto err_pipe;
+	}
+
+	link_freq = v4l2_get_link_freq(spad, csis->fmt->bpp,
+				       2 * csis->bus.num_data_lanes);
+	if (link_freq < 0) {
+		dev_err(csis->dev, "no link frequency from the sensor\n");
+		ret = link_freq;
+		goto err_pipe;
+	}
+	mbps = div_u64(link_freq * 2, 1000000);
+
+	ret = csis_dvfs(csis, true);
+	if (ret)
+		dev_warn(csis->dev, "camera DVFS request failed: %d\n", ret);
+	/* the camera bus has to be at the streaming level before data comes */
+	msleep(dvfs_settle_ms);
+
+	csis->sequence = 0;
+	csis->cnt_fs = 0;
+	csis->cnt_dma_fs = 0;
+	csis->err_csis = 0;
+	csis->err_dma = 0;
+	csis->dma_err_src = 0;
+	csis->dma_err_code = 0;
+
+	mutex_lock(&csis_sram_lock);
+	if (csis_sram_owner && csis_sram_owner != csis) {
+		mutex_unlock(&csis_sram_lock);
+		dev_err(csis->dev,
+			"%s is streaming: one receiver at a time (shared DMA SRAM)\n",
+			dev_name(csis_sram_owner->dev));
+		ret = -EBUSY;
+		goto err_dvfs;
+	}
+	csis_sram_owner = csis;
+	mutex_unlock(&csis_sram_lock);
+
+	csis_phy_reset(csis, true);
+	ret = csis_sw_reset(csis);
+	if (ret)
+		goto err_phy;
+	csis_phy_config(csis, mbps);
+
+	spin_lock_irqsave(&csis->slock, flags);
+	csis->active = NULL;
+	csis_program_next(csis);
+	spin_unlock_irqrestore(&csis->slock, flags);
+
+	/* a DMA left busy by an earlier stream never starts a frame */
+	if (readl(csis->vcdma + DMA_ACT_CTRL) & DMA_CTRL_ENABLE)
+		csis_dma_abort(csis);
+	csis_hw_start(csis);
+
+	ret = v4l2_subdev_enable_streams(csis->sensor, csis->sensor_pad, BIT(0));
+	if (ret) {
+		dev_err(csis->dev, "sensor stream on failed: %d\n", ret);
+		goto err_hw;
+	}
+	return 0;
+
+err_hw:
+	csis_hw_stop(csis);
+err_phy:
+	csis_phy_reset(csis, false);
+	csis_release_sram(csis);
+err_dvfs:
+	csis_dvfs(csis, false);
+err_pipe:
+	csis_free_scratch(csis);
+	video_device_pipeline_stop(&csis->vdev);
+err_pm:
+	pm_runtime_put(csis->dev);
+err_return:
+	csis_return_buffers(csis, VB2_BUF_STATE_QUEUED);
+	return ret;
+}
+
+static void csis_stop_streaming(struct vb2_queue *vq)
+{
+	struct csis_device *csis = vb2_get_drv_priv(vq);
+
+	/*
+	 * DMA off and idle first, so nothing lands in a returned buffer and
+	 * the next stream starts on an idle DMA
+	 */
+	csis_dma_abort(csis);
+	v4l2_subdev_disable_streams(csis->sensor, csis->sensor_pad, BIT(0));
+	csis_hw_stop(csis);
+	csis_phy_reset(csis, false);
+	csis_dvfs(csis, false);
+
+	/* a stream that delivered nothing or had errors is worth a line */
+	if (!csis->sequence || csis->err_csis || csis->err_dma)
+		dev_warn(csis->dev,
+			 "stream: %u frame starts, %u DMA starts, %u frames, %u receiver errors (last %08x %08x), %u DMA errors (status %08x, code %08x), common DMA ctrl %08x split %08x matrix %08x\n",
+			 csis->cnt_fs, csis->cnt_dma_fs, csis->sequence,
+			 csis->err_csis, csis->last_err0, csis->last_err1,
+			 csis->err_dma, csis->dma_err_src, csis->dma_err_code,
+			 readl(csis->cdma + CDMA_CTRL),
+			 readl(csis->cdma + CDMA_SRAM_SPLIT),
+			 readl(csis->cdma + CDMA_MATRIX));
+	csis_release_sram(csis);
+
+	csis_return_buffers(csis, VB2_BUF_STATE_ERROR);
+	csis_free_scratch(csis);
+	video_device_pipeline_stop(&csis->vdev);
+	pm_runtime_put(csis->dev);
+}
+
+static const struct vb2_ops csis_vb2_ops = {
+	.queue_setup		= csis_queue_setup,
+	.buf_prepare		= csis_buf_prepare,
+	.buf_queue		= csis_buf_queue,
+	.start_streaming	= csis_start_streaming,
+	.stop_streaming		= csis_stop_streaming,
+};
