diff --git a/include/soc/samsung/exynos9810-panel-gamma.h b/include/soc/samsung/exynos9810-panel-gamma.h
new file mode 100644
index 0000000000000000000000000000000000000000..583183b5c00159c0559ad793322e767acd1e21c9
--- /dev/null
+++ b/include/soc/samsung/exynos9810-panel-gamma.h
@@ -0,0 +1,75 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Exynos9810 DPU <-> panel hooks, for whoever drives the panel over DSI
+ * (exynos9810-dsim-bl):
+ *  - set_gamma: the CRTC gamma LUT as per-channel scales (0..65535), for
+ *    the panel's own digital gamma;
+ *  - disable/unprepare/prepare/enable: the CRTC was switched off/on (DPMS,
+ *    screen blank, system sleep). The DPU calls them in this order, all
+ *    from process context and serialised:
+ *
+ *      blank:   level = disable(max)  backlight off, panel to sleep while
+ *                                     the video stream still runs
+ *               [DECON stopped, only for level >= LINK_OFF]
+ *               unprepare(level)      DSI links (and panel rails) down
+ *      unblank: prepare(level)        links (and rails) up, panel out of
+ *                                     sleep, for level >= LINK_OFF
+ *               [DECON started, only for level >= LINK_OFF]
+ *               enable(level)         display on, backlight back
+ *
+ *    disable() picks the level (never above max) and returns it; the
+ *    other three get the same value back.
+ *
+ * Touch controllers that live in the panel (TDDI) can listen to the panel
+ * notifier: EXYNOS9810_PANEL_BLANK after the panel went down (data points
+ * to the level), EXYNOS9810_PANEL_UNBLANK once it is up again.
+ */
+#ifndef __SOC_SAMSUNG_EXYNOS9810_PANEL_GAMMA_H
+#define __SOC_SAMSUNG_EXYNOS9810_PANEL_GAMMA_H
+
+#include <linux/errno.h>
+#include <linux/types.h>
+
+struct notifier_block;
+
+/* how far a screen blank takes the panel down */
+enum exynos9810_panel_level {
+	EXYNOS9810_PANEL_BACKLIGHT_OFF,	/* backlight 0, video keeps running */
+	EXYNOS9810_PANEL_SLEEP,		/* + DISPLAY_OFF/SLEEP_IN */
+	EXYNOS9810_PANEL_LINK_OFF,	/* + DECON stopped, DSI HS clocks off */
+	EXYNOS9810_PANEL_POWER_OFF,	/* + DSI lanes, panel rails off */
+};
+
+enum exynos9810_panel_event {
+	EXYNOS9810_PANEL_BLANK,
+	EXYNOS9810_PANEL_UNBLANK,
+};
+
+struct exynos9810_panel_ops {
+	void (*set_gamma)(void *priv, const u16 scale[3]);
+	unsigned int (*disable)(void *priv, unsigned int max_level);
+	void (*unprepare)(void *priv, unsigned int level);
+	int (*prepare)(void *priv, unsigned int level);
+	void (*enable)(void *priv, unsigned int level);
+};
+
+#if IS_ENABLED(CONFIG_DRM_EXYNOS9810_DPU)
+void exynos9810_dpu_set_panel(const struct exynos9810_panel_ops *ops,
+			      void *priv);
+int exynos9810_panel_register_notifier(struct notifier_block *nb);
+int exynos9810_panel_unregister_notifier(struct notifier_block *nb);
+#else
+static inline void exynos9810_dpu_set_panel(const struct exynos9810_panel_ops *ops,
+					    void *priv) { }
+static inline int exynos9810_panel_register_notifier(struct notifier_block *nb)
+{
+	return -ENODEV;
+}
+
+static inline int exynos9810_panel_unregister_notifier(struct notifier_block *nb)
+{
+	return 0;
+}
+#endif
+
+#endif
