+/* -----------------------------------------------------------------------------
+ * Probe
+ */
+
+static int csis_register_video(struct csis_device *csis)
+{
+	struct video_device *vdev = &csis->vdev;
+	struct vb2_queue *q = &csis->queue;
+	int ret;
+
+	q->type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+	q->io_modes = VB2_MMAP | VB2_DMABUF;
+	q->drv_priv = csis;
+	q->buf_struct_size = sizeof(struct csis_buffer);
+	q->ops = &csis_vb2_ops;
+	q->mem_ops = &vb2_dma_contig_memops;
+	q->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_MONOTONIC;
+	q->lock = &csis->lock;
+	q->min_queued_buffers = 1;
+	q->dev = csis->dev;
+	ret = vb2_queue_init(q);
+	if (ret)
+		return ret;
+
+	csis->vpad.flags = MEDIA_PAD_FL_SINK | MEDIA_PAD_FL_MUST_CONNECT;
+	vdev->entity.ops = &csis_entity_ops;
+	ret = media_entity_pads_init(&vdev->entity, 1, &csis->vpad);
+	if (ret)
+		return ret;
+
+	snprintf(vdev->name, sizeof(vdev->name), "%s", dev_name(csis->dev));
+	vdev->fops = &csis_fops;
+	vdev->ioctl_ops = &csis_ioctl_ops;
+	vdev->release = video_device_release_empty;
+	vdev->v4l2_dev = &csis->v4l2_dev;
+	vdev->queue = q;
+	vdev->lock = &csis->lock;
+	vdev->device_caps = V4L2_CAP_VIDEO_CAPTURE | V4L2_CAP_STREAMING |
+			    V4L2_CAP_IO_MC;
+	video_set_drvdata(vdev, csis);
+
+	ret = video_register_device(vdev, VFL_TYPE_VIDEO, -1);
+	if (ret)
+		media_entity_cleanup(&vdev->entity);
+	return ret;
+}
+
+static int csis_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct csis_device *csis;
+	struct resource *res;
+	unsigned int id;
+	int irq, ret;
+
+	csis = devm_kzalloc(dev, sizeof(*csis), GFP_KERNEL);
+	if (!csis)
+		return -ENOMEM;
+	csis->dev = dev;
+	mutex_init(&csis->lock);
+	spin_lock_init(&csis->slock);
+	INIT_LIST_HEAD(&csis->queued);
+	platform_set_drvdata(pdev, csis);
+
+	csis->regs = devm_platform_ioremap_resource_byname(pdev, "csis");
+	if (IS_ERR(csis->regs))
+		return PTR_ERR(csis->regs);
+	csis->phy = devm_platform_ioremap_resource_byname(pdev, "phy");
+	if (IS_ERR(csis->phy))
+		return PTR_ERR(csis->phy);
+	csis->vcdma = devm_platform_ioremap_resource_byname(pdev, "vcdma");
+	if (IS_ERR(csis->vcdma))
+		return PTR_ERR(csis->vcdma);
+	csis->dmacmn = devm_platform_ioremap_resource_byname(pdev, "vcdma-common");
+	if (IS_ERR(csis->dmacmn))
+		return PTR_ERR(csis->dmacmn);
+	/* the common DMA block is shared by every CSIS: map, do not claim */
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "dma-common");
+	if (!res)
+		return -EINVAL;
+	csis->cdma = devm_ioremap(dev, res->start, resource_size(res));
+	if (!csis->cdma)
+		return -ENOMEM;
+
+	csis->sysreg = syscon_regmap_lookup_by_phandle_args(dev->of_node,
+							    "samsung,sysreg", 1,
+							    &csis->phy_reset_bit);
+	if (IS_ERR(csis->sysreg))
+		return dev_err_probe(dev, PTR_ERR(csis->sysreg), "no sysreg\n");
+	csis->phy_bias = of_property_read_bool(dev->of_node, "samsung,phy-bias");
+
+	csis->dvfs_cam = devm_clk_get_optional(dev, "cam");
+	if (IS_ERR(csis->dvfs_cam))
+		return PTR_ERR(csis->dvfs_cam);
+	csis->dvfs_intcam = devm_clk_get_optional(dev, "intcam");
+	if (IS_ERR(csis->dvfs_intcam))
+		return PTR_ERR(csis->dvfs_intcam);
+	csis->soc = device_get_match_data(dev);
+	/*
+	 * Leave the boot level of the camera DVFS domains (ISPPRE bus at
+	 * 25 MHz) for the floor right away, so that no stream starts from it.
+	 */
+	if (csis_dvfs(csis, false))
+		dev_warn(dev, "camera DVFS floor request failed\n");
+
+	/* which CSIS this is, for its SRAM matrix */
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "csis");
+	id = (res->start - csis->soc->csis0_base) / csis->soc->csis_stride;
+	if (res->start < csis->soc->csis0_base ||
+	    id >= ARRAY_SIZE(csis->soc->matrix_sram0))
+		return dev_err_probe(dev, -EINVAL, "unknown CSIS instance\n");
+	csis->matrix = csis->soc->matrix_sram0[id];
+
+	irq = platform_get_irq_byname(pdev, "csis");
+	if (irq < 0)
+		return irq;
+	ret = devm_request_irq(dev, irq, csis_irq, 0, dev_name(dev), csis);
+	if (ret)
+		return ret;
+	irq = platform_get_irq_byname(pdev, "dma");
+	if (irq < 0)
+		return irq;
+	ret = devm_request_irq(dev, irq, csis_dma_irq, 0, dev_name(dev), csis);
+	if (ret)
+		return ret;
+
+	/* the VC DMA takes 32-bit addresses (the SysMMU is left in bypass) */
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (ret)
+		return ret;
+
+	ret = devm_pm_runtime_enable(dev);
+	if (ret)
+		return ret;
+
+	/* default format: the sensor's usual binned mode */
+	csis->pix.width = 2048;
+	csis->pix.height = 1536;
+	csis->fmt = csis_default_format();
+	csis_fill_pix(&csis->pix, csis->fmt);
+
+	dev_info(dev, "CSIS version %08x\n", readl(csis->regs + CSIS_VERSION));
+	if (cdma_init)
+		csis_cdma_init(csis);
+
+	csis->mdev.dev = dev;
+	strscpy(csis->mdev.model, "Exynos9810 CSIS", sizeof(csis->mdev.model));
+	if (mc_driver_name)
+		strscpy(csis->mdev.driver_name, mc_driver_name,
+			sizeof(csis->mdev.driver_name));
+	media_device_init(&csis->mdev);
+	csis->v4l2_dev.mdev = &csis->mdev;
+	ret = v4l2_device_register(dev, &csis->v4l2_dev);
+	if (ret)
+		goto err_mdev;
+
+	ret = csis_register_video(csis);
+	if (ret)
+		goto err_v4l2;
+
+	v4l2_async_nf_init(&csis->notifier, &csis->v4l2_dev);
+	csis->notifier.ops = &csis_notify_ops;
+	ret = csis_parse_endpoint(csis);
+	if (ret)
+		goto err_nf;
+	ret = v4l2_async_nf_register(&csis->notifier);
+	if (ret)
+		goto err_nf;
+	return 0;
+
+err_nf:
+	v4l2_async_nf_cleanup(&csis->notifier);
+	video_unregister_device(&csis->vdev);
+	media_entity_cleanup(&csis->vdev.entity);
+err_v4l2:
+	v4l2_device_unregister(&csis->v4l2_dev);
+err_mdev:
+	media_device_cleanup(&csis->mdev);
+	return ret;
+}
+
+static void csis_remove(struct platform_device *pdev)
+{
+	struct csis_device *csis = platform_get_drvdata(pdev);
+
+	media_device_unregister(&csis->mdev);
+	v4l2_async_nf_unregister(&csis->notifier);
+	v4l2_async_nf_cleanup(&csis->notifier);
+	video_unregister_device(&csis->vdev);
+	media_entity_cleanup(&csis->vdev.entity);
+	v4l2_device_unregister(&csis->v4l2_dev);
+	media_device_cleanup(&csis->mdev);
+}
+
+static const struct of_device_id csis_of_match[] = {
+	{
+		.compatible = "samsung,exynos9810-csis",
+		.data = &exynos9810_csis_data,
+	},
+	{ }
+};
+MODULE_DEVICE_TABLE(of, csis_of_match);
+
+static struct platform_driver csis_driver = {
+	.probe	= csis_probe,
+	.remove	= csis_remove,
+	.driver	= {
+		.name		= CSIS_DRV_NAME,
+		.of_match_table	= csis_of_match,
+	},
+};
+module_platform_driver(csis_driver);
+
+MODULE_DESCRIPTION("Samsung Exynos9810 MIPI CSI-2 receiver and raw capture");
+MODULE_LICENSE("GPL");
