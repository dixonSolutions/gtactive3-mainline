+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Broadcom BCM4775 GNSS chip with sensor-hub MCU (Samsung Galaxy Tab
+ * Active3), AP side of the link.
+ *
+ * Layers, bottom up:
+ *   SSI  - Broadcom's SPI stream protocol with a GPIO wake handshake
+ *          (MCU_REQ/MCU_RESP) and a level "data pending" line (HOST_REQ);
+ *   TL   - Broadcom's packet ("transport") layer: escaped frames,
+ *          sequence numbers, acknowledged ("reliable") packets, CRC-8,
+ *          transport-internal packets for the sequence-number handshake;
+ *   RPC  - [id][len][data] records inside a TL payload;
+ *   SSP  - Samsung's sensor protocol, carried in RPC 0x20 (AP->hub) and
+ *          RPC 0x21 (hub->AP).
+ *
+ * After power-up the chip runs its ROM bootloader, which speaks the same
+ * TL/RPC protocol: the driver downloads the sensor-hub application (a
+ * Broadcom "patch" file: a stream of memory-write records) with reliable
+ * memory-write RPCs and starts it. See docs/re/sensorhub.md in the
+ * gtactive3-mainline repository.
+ */
+
+#ifndef _BCM4775_SHUB_H
+#define _BCM4775_SHUB_H
+
+#include <linux/completion.h>
+#include <linux/kfifo.h>
+#include <linux/list.h>
+#include <linux/mutex.h>
+#include <linux/spinlock.h>
+#include <linux/types.h>
+#include <linux/workqueue.h>
+
