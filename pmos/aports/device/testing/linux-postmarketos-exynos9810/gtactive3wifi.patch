index 0000000000000000000000000000000000000000..0f6132f84b4d058b4d41c1ba12fbe6f6395a37b1
--- /dev/null
+++ b/drivers/clk/samsung/clk-exynos9810.c
@@ -0,0 +1,3345 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Common Clock Framework support for the Exynos9810 SoC.
+ *
+ * The clock tree is taken from Samsung's CMUCAL tables for S5E9810
+ * (drivers/soc/samsung/cal-if/exynos9810/cmucal-{sfr,node}.c in the
+ * downstream kernel).
+ *
+ * The driver is read-only on purpose: the PLLs are owned by the bootloader
+ * and the APM/ACPM firmware, so they have no rate tables, and all muxes and
+ * dividers are registered with CLK_MUX_READ_ONLY / CLK_DIVIDER_READ_ONLY.
+ * The reported rates are therefore exactly what the bootloader programmed.
+ *
+ * Gates come up in hardware auto clock gating (HWACG) mode, where the CG_VAL
+ * bit that the clock framework toggles has no effect. Booting with
+ * clk_exynos9810.manual_gates=1 switches the gates of the leaf CMUs to
+ * manual mode, forcing them on first, so that consumers really control
+ * them. CMU_TOP and CMU_APM are never touched, ACPM relies on them.
+ *
+ * CMU_CHUB is the exception: SPI21 (touchscreen) needs to set its USI
+ * divider, so it is a hand-written, writable CMU registered through the
+ * common exynos_arm64_register_cmu() path.
+ *
+ * The SD card clock is writable too, from the CLKCMU_FSYS1_MMC_CARD divider
+ * in CMU_TOP to the MMC_CARD user mux in CMU_FSYS1: nothing but the SD card
+ * controller uses it, and dw_mmc sets its rate per bus timing, as the
+ * downstream driver does.
+ */
+
+#include <linux/bits.h>
+#include <linux/clk-provider.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+#include <dt-bindings/clock/samsung,exynos9810.h>
+
+#include "clk.h"
+#include "clk-exynos-arm64.h"
+
+#define GATE_MANUAL		BIT(20)
+#define GATE_CG_VAL		BIT(21)
+#define GATE_ENABLE_HWACG	BIT(28)
+
+static bool manual_gates;
+module_param(manual_gates, bool, 0444);
+MODULE_PARM_DESC(manual_gates,
+		 "Switch leaf CMU gates from HWACG to manual mode (forced on)");
+
+/* ---- CMU_TOP --------------------------------------------------------------- */
+
+/* Register Offset definitions for CMU_TOP (0x1a240000) */
+#define PLL_LOCKTIME_PLL_MMC				0x0000
+#define PLL_LOCKTIME_PLL_SHARED0			0x0004
+#define PLL_LOCKTIME_PLL_SHARED1			0x0008
+#define PLL_LOCKTIME_PLL_SHARED2			0x000c
+#define PLL_LOCKTIME_PLL_SHARED3			0x0010
+#define PLL_LOCKTIME_PLL_SHARED4			0x0014
+#define PLL_CON0_PLL_MMC				0x0100
+#define PLL_CON0_PLL_SHARED0				0x0120
+#define PLL_CON0_PLL_SHARED1				0x01a0
+#define PLL_CON0_PLL_SHARED2				0x0220
+#define PLL_CON0_PLL_SHARED3				0x02a0
+#define PLL_CON0_PLL_SHARED4				0x0320
+#define CLK_CON_MUX_CLKCMU_DPU_BUS			0x1000
+#define CLK_CON_MUX_MUX_CLKCMU_APM_BUS			0x1004
+#define CLK_CON_MUX_MUX_CLKCMU_AUD_CPU			0x1008
+#define CLK_CON_MUX_MUX_CLKCMU_BUS1_BUS			0x100c
+#define CLK_CON_MUX_MUX_CLKCMU_BUSC_BUS			0x1010
+#define CLK_CON_MUX_MUX_CLKCMU_CHUB_BUS			0x1014
+#define CLK_CON_MUX_MUX_CLKCMU_CIS_CLK0			0x1018
+#define CLK_CON_MUX_MUX_CLKCMU_CIS_CLK1			0x101c
+#define CLK_CON_MUX_MUX_CLKCMU_CIS_CLK2			0x1020
+#define CLK_CON_MUX_MUX_CLKCMU_CIS_CLK3			0x1024
+#define CLK_CON_MUX_MUX_CLKCMU_CMGP_BUS			0x1028
+#define CLK_CON_MUX_MUX_CLKCMU_CORE_BUS			0x102c
+#define CLK_CON_MUX_MUX_CLKCMU_CPUCL0_DBG_BUS		0x1030
+#define CLK_CON_MUX_MUX_CLKCMU_CPUCL0_SWITCH		0x1034
+#define CLK_CON_MUX_MUX_CLKCMU_CPUCL1_SWITCH		0x1038
+#define CLK_CON_MUX_MUX_CLKCMU_DCF_BUS			0x103c
+#define CLK_CON_MUX_MUX_CLKCMU_DCPOST_BUS		0x1040
+#define CLK_CON_MUX_MUX_CLKCMU_DCRD_BUS			0x1044
+#define CLK_CON_MUX_MUX_CLKCMU_DPU_BUS			0x1048
+#define CLK_CON_MUX_MUX_CLKCMU_DSPM_BUS			0x104c
+#define CLK_CON_MUX_MUX_CLKCMU_DSPS_AUD			0x1050
+#define CLK_CON_MUX_MUX_CLKCMU_FSYS0_BUS		0x1054
