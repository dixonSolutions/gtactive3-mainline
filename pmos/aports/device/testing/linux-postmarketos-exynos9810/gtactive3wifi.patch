+
+	for (i = 0; i < ARRAY_SIZE(exynos9810_cpu_pd_options); i++)
+		regmap_update_bits(pmu_context->pmureg,
+				   exynos9810_cpu_pd_options[i].offset,
+				   exynos9810_cpu_pd_options[i].mask,
+				   exynos9810_cpu_pd_options[i].val);
+}
