diff --git a/Documentation/devicetree/bindings/media/samsung,exynos9810-csis.yaml b/Documentation/devicetree/bindings/media/samsung,exynos9810-csis.yaml
new file mode 100644
index 0000000000000000000000000000000000000000..408725bd24b1dc92a1ebb1a593e38bcb72d18b12
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/samsung,exynos9810-csis.yaml
@@ -0,0 +1,137 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/samsung,exynos9810-csis.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung Exynos9810 MIPI CSI-2 receiver with virtual channel DMA
+
+maintainers:
+  - dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>
+
+description:
+  The Exynos9810 camera front end has four MIPI CSI-2 receivers (CSIS
+  v5.1). Each one has a virtual channel DMA that writes the received
+  stream to memory, next to the on-the-fly path into the camera ISP.
+  The D-PHY of CSIS0 and CSIS2 is shared with a DSI transmitter (M4S4
+  combo PHY); its slave (receive) half is reset through SYSREG_ISPPRE.
+  The DMA blocks of all receivers share one arbitration and SRAM block.
+
+properties:
+  compatible:
+    const: samsung,exynos9810-csis
+
+  reg:
+    items:
+      - description: CSIS registers
+      - description: D-PHY registers
+      - description: virtual channel 0 DMA registers
+      - description: DMA registers common to the virtual channels
+      - description: DMA arbitration block shared by all receivers
+
+  reg-names:
+    items:
+      - const: csis
+      - const: phy
+      - const: vcdma
+      - const: vcdma-common
+      - const: dma-common
+
+  interrupts:
+    items:
+      - description: receiver interrupt
+      - description: DMA interrupt
+
+  interrupt-names:
+    items:
+      - const: csis
+      - const: dma
+
+  clocks:
+    items:
+      - description: camera DVFS domain
+      - description: camera interconnect DVFS domain
+
+  clock-names:
+    items:
+      - const: cam
+      - const: intcam
+
+  power-domains:
+    maxItems: 1
+
+  iommus:
+    maxItems: 1
+
+  samsung,sysreg:
+    $ref: /schemas/types.yaml#/definitions/phandle-array
+    items:
+      - items:
+          - description: phandle to SYSREG_ISPPRE
+          - description: bit of the D-PHY slave reset in its register 0x500
+    description:
+      System register controller and the D-PHY reset bit of this receiver.
+
+  samsung,phy-bias:
+    type: boolean
+    description:
+      The D-PHY of this receiver holds the bias block that the receive
+      path has to program (the M4S4_TOP PHY of CSIS0).
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    unevaluatedProperties: false
+    description: Input port, connected to a CSI-2 transmitter.
+
+    properties:
+      endpoint:
+        $ref: video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          data-lanes:
+            minItems: 1
+            maxItems: 4
+
+        required:
+          - data-lanes
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupts
+  - interrupt-names
+  - samsung,sysreg
+  - port
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/samsung,exynos9810-acpm.h>
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+
+    csis@16230000 {
+        compatible = "samsung,exynos9810-csis";
+        reg = <0x16230000 0x1000>, <0x16160000 0x10000>,
+              <0x162b0000 0x100>, <0x162b0400 0x100>,
+              <0x162f0000 0x100>;
+        reg-names = "csis", "phy", "vcdma", "vcdma-common", "dma-common";
+        interrupts = <GIC_SPI 328 IRQ_TYPE_LEVEL_HIGH>,
+                     <GIC_SPI 334 IRQ_TYPE_LEVEL_HIGH>;
+        interrupt-names = "csis", "dma";
+        clocks = <&acpm_ipc EXYNOS9810_CLK_ACPM_DVFS_CAM>,
+                 <&acpm_ipc EXYNOS9810_CLK_ACPM_DVFS_INTCAM>;
+        clock-names = "cam", "intcam";
+        samsung,sysreg = <&sysreg_isppre 0>;
+        samsung,phy-bias;
+
+        port {
+            endpoint {
+                remote-endpoint = <&rear_camera_out>;
+                data-lanes = <1 2 3 4>;
+            };
+        };
+    };
+...
