+/ {
+	/*
+	 * GPU core clock as left by S-Boot (no CMU_G3D driver yet):
+	 * PLL_CON0_PLL_G3D = 0xa0a00412 -> 26 MHz * 160 / (4 << 2) = 260 MHz,
+	 * MUX_CLK_G3D_BUSD = PLL_G3D, DIV_CLK_G3D_BUSD = 1, GPU user mux on.
+	 * 260 MHz is the stock boot/minimum G3D level, so the ACPM-managed
+	 * vdd_g3d (S2MPS18 BUCK6) is already at a voltage for it. The stock
+	 * DVFS levels are 572/546/455/338/299/260 MHz; their voltages come from
+	 * the ECT/ASV tables, so no OPP table until vdd_g3d can be controlled.
+	 */
+	gpu_clk: clock-gpu {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <260000000>;
+	};
+};
+
+/ {
+	/* G3D DVFS through ACPM (fvmap domain 4: 260-598 MHz, retail max 572) */
+	gpu_opp: opp-table-gpu {
+		compatible = "operating-points-v2";
+
+		opp-260000000 {
+			opp-hz = /bits/ 64 <260000000>;
+		};
+		opp-299000000 {
+			opp-hz = /bits/ 64 <299000000>;
+		};
+		opp-338000000 {
+			opp-hz = /bits/ 64 <338000000>;
+		};
+		opp-385000000 {
+			opp-hz = /bits/ 64 <385000000>;
+		};
+		opp-455000000 {
+			opp-hz = /bits/ 64 <455000000>;
+		};
+		opp-546000000 {
+			opp-hz = /bits/ 64 <546000000>;
+		};
+		opp-572000000 {
+			opp-hz = /bits/ 64 <572000000>;
+		};
+	};
+};
+
+&gpu {
+	/* ACPM sets the G3D clock and BUCK6 voltage together */
+	clocks = <&acpm_ipc EXYNOS9810_CLK_ACPM_DVFS_G3D>;
+	operating-points-v2 = <&gpu_opp>;
+	status = "okay";
+};
+
+&pd_g3d {
+	/*
+	 * S-Boot leaves G3D on; don't power-cycle it until that is tested.
+	 * The GPU still runtime-suspends inside the domain (cores and L2
+	 * off); a kernel without CONFIG_PM does not build this driver, and
+	 * the GPU then waits for the domain forever.
+	 */
+	samsung,bringup-keep-on;
+	status = "okay";
+};
+
+/*
+ * Wi-Fi: Broadcom BCM4375 (stock CONFIG_BCM4375=y) on PCIe channel 0
+ * (stock pcie0@116A0000, enabled by DTBO fragment@73; channel 1 is unused).
+ * Bluetooth: same combo chip on UART_BT (stock serial_1, uart@10840000).
+ * No clock driver yet: the bootloader leaves all CMU_FSYS1 PCIe gates and the
+ * UART_BT gates enabled with their Q-channels held on.
+ */
+/ {
+	/*
+	 * UART_BT IPCLK as left by the bootloader: PLL_SHARED2 (M=400, P=13,
+	 * S=0 from 26 MHz) = 800 MHz, /2 (DIV_PLL_SHARED2_DIV2), /2
+	 * (CLKCMU_PERIC1_IP), /1 (DIV_CLK_PERIC1_UART_BT) = 200 MHz, which
+	 * matches the 200 MHz the vendor CAL tables program.
+	 */
+	clk_uart_bt: clock-uart-bt {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <200000000>;
+	};
+
+	/* WLAN_REG_ON (stock "samsung,brcm-wlan" gpios[0] = gpg0-5) */
+	wlan_reg_on: regulator-wlan-reg-on {
+		compatible = "regulator-fixed";
+		regulator-name = "wlan_reg_on";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&gpg0 5 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		pinctrl-0 = <&wlan_en>;
+		pinctrl-names = "default";
+	};
+};
+
+&pinctrl_alive {
+	/* stock uart1-bus / uart1-bus-rxd: RXD gpq0-0, TXD 1, RTS 2, CTS 3 */
+	uart1_bus: uart1-bus-pins {
+		samsung,pins = "gpq0-3", "gpq0-2", "gpq0-1";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+	};
+
+	uart1_rxd: uart1-rxd-pins {
