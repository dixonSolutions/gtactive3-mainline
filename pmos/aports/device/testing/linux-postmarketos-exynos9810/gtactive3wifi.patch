+/* -----------------------------------------------------------------------------
+ * Video node
+ */
+
+static void csis_fill_pix(struct v4l2_pix_format *pix,
+			  const struct csis_format *fmt)
+{
+	pix->width = clamp_t(u32, ALIGN(pix->width, 4), CSIS_MIN_SIZE, CSIS_MAX_WIDTH);
+	pix->height = clamp_t(u32, pix->height, CSIS_MIN_SIZE, CSIS_MAX_HEIGHT);
+	pix->pixelformat = fmt->fourcc;
+	pix->field = V4L2_FIELD_NONE;
+	pix->bytesperline = ALIGN(fmt->packed ? pix->width * 5 / 4 :
+				  pix->width * 2, 16);
+	pix->sizeimage = pix->bytesperline * pix->height;
+	pix->colorspace = V4L2_COLORSPACE_RAW;
+	pix->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	pix->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	pix->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int csis_querycap(struct file *file, void *fh,
+			 struct v4l2_capability *cap)
+{
+	strscpy(cap->driver, CSIS_DRV_NAME, sizeof(cap->driver));
+	strscpy(cap->card, "Exynos9810 CSIS", sizeof(cap->card));
+	return 0;
+}
+
+static int csis_enum_fmt(struct file *file, void *fh, struct v4l2_fmtdesc *f)
+{
+	unsigned int i, n = 0;
+
+	for (i = 0; i < ARRAY_SIZE(csis_formats); i++) {
+		if (f->mbus_code && csis_formats[i].code != f->mbus_code)
+			continue;
+		if (!csis_format_usable(&csis_formats[i]))
+			continue;
+		if (n++ == f->index) {
+			f->pixelformat = csis_formats[i].fourcc;
+			return 0;
+		}
+	}
+	return -EINVAL;
+}
+
+static int csis_g_fmt(struct file *file, void *fh, struct v4l2_format *f)
+{
+	struct csis_device *csis = video_drvdata(file);
+
+	f->fmt.pix = csis->pix;
+	return 0;
+}
+
+static int csis_try_fmt(struct file *file, void *fh, struct v4l2_format *f)
+{
+	const struct csis_format *fmt = csis_find_fourcc(f->fmt.pix.pixelformat);
+
+	csis_fill_pix(&f->fmt.pix, fmt ?: csis_default_format());
+	return 0;
+}
+
+static int csis_s_fmt(struct file *file, void *fh, struct v4l2_format *f)
+{
+	struct csis_device *csis = video_drvdata(file);
+
+	if (vb2_is_busy(&csis->queue))
+		return -EBUSY;
+	csis_try_fmt(file, fh, f);
+	csis->pix = f->fmt.pix;
+	csis->fmt = csis_find_fourcc(csis->pix.pixelformat);
+	return 0;
+}
+
+static int csis_enum_framesizes(struct file *file, void *fh,
+				struct v4l2_frmsizeenum *fsize)
+{
+	if (fsize->index || !csis_find_fourcc(fsize->pixel_format))
+		return -EINVAL;
+
+	fsize->type = V4L2_FRMSIZE_TYPE_STEPWISE;
+	fsize->stepwise.min_width = CSIS_MIN_SIZE;
+	fsize->stepwise.max_width = CSIS_MAX_WIDTH;
+	fsize->stepwise.step_width = 4;
+	fsize->stepwise.min_height = CSIS_MIN_SIZE;
+	fsize->stepwise.max_height = CSIS_MAX_HEIGHT;
+	fsize->stepwise.step_height = 1;
+	return 0;
+}
