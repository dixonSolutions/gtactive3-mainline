+/*
+ * An RTC that lost its time reads as an invalid date (the Exynos9810 one
+ * comes up cleared at every boot): every read and every alarm then fails
+ * with -EINVAL until user space sets the time, so rtcwake cannot work.
+ * Start such an RTC at the beginning of its range; relative alarms work
+ * at once and the real time can be written later.
+ */
+static void s3c_rtc_init_time(struct s3c_rtc *info)
+{
+	struct rtc_time tm;
+
+	if (!s3c_rtc_gettime(info->dev, &tm) && !rtc_valid_tm(&tm))
+		return;
+
+	rtc_time64_to_tm(RTC_TIMESTAMP_BEGIN_2000, &tm);
+	if (s3c_rtc_settime(info->dev, &tm))
+		return;
+	dev_warn(info->dev, "invalid time, starting at %ptR\n", &tm);
+}
+
