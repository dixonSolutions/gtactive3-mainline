# Maintainer: dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>
# GNOME Shell extension from extensions.gnome.org (the release built for
# GNOME Shell 46-51), installed system-wide for the Galaxy Tab Active3 image.
pkgname=gnome-shell-extension-touchup
pkgver=22
pkgrel=2
pkgdesc="GNOME Shell extension: touchscreen improvements (navigation bar, gestures, keyboard)"
url="https://github.com/mityax/gnome-extension-touchup"
arch="noarch"
license="GPL-3.0-or-later"
makedepends="glib"
options="!check"
_uuid=touchup@mityax
source="$_uuid-$pkgver.zip::https://extensions.gnome.org/download-extension/$_uuid.shell-extension.zip?version_tag=75668"
builddir="$srcdir/ext"

unpack() {
	mkdir -p "$builddir"
	unzip -q "$srcdir/$_uuid-$pkgver.zip" -d "$builddir"
}

package() {
	local d="$pkgdir/usr/share/gnome-shell/extensions/$_uuid"
	mkdir -p "$d"
	cp -r "$builddir"/. "$d"/
	# the extension opens schemas/gschemas.compiled in its own directory;
	# the extensions.gnome.org zip ships only the XML
	glib-compile-schemas --strict "$d"/schemas
	# the schema system-wide, compiled by the glib trigger, so the
	# extension finds it without a per-extension gschemas.compiled
	install -Dm644 "$builddir"/schemas/org.gnome.shell.extensions.touchup.gschema.xml \
		-t "$pkgdir"/usr/share/glib-2.0/schemas/
	find "$d" -type d -exec chmod 755 {} +
	find "$d" -type f -exec chmod 644 {} +
}

sha512sums="
9bffad87a68f05dce933615bbd08f0d6d2a5b11dc26ff1bdfc1270f2f303dea6a9183d17c41941d9ef17aea7746fbd13cbf1b9196ea8a0dcd3f4249cceb7dc32  $_uuid-$pkgver.zip
"
