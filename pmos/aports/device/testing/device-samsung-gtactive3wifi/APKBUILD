# Reference: <https://postmarketos.org/devicepkg>
maintainer="dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>"
pkgname=device-samsung-gtactive3wifi
pkgdesc="Samsung Galaxy Tab Active3 (Wi-Fi)"
pkgver=2
pkgrel=43
url="https://github.com/dixonSolutions/gtactive3-mainline"
license="MIT"
arch="aarch64"
options="!check !archcheck !strip !tracedeps"
depends="
	$pkgname-initramfs=$pkgver-r$pkgrel
	linux-postmarketos-exynos9810
	postmarketos-base
	systemd-boot
	zstd
	"
# vte3 for /usr/libexec/vte-urlencode-cwd, which vte3-profile's
# /etc/profile.d/vte.sh runs at every bash prompt. Everything specific to
# one UI lives in a subpackage that installs itself with that UI (-gnome),
# so the same device package serves every image variant.
depends="$depends vte3"
# iw for Wi-Fi diagnostics, debugfs (e2fsprogs-extra) to read the Wi-Fi MAC
# address from EFS without mounting it
depends="$depends iw e2fsprogs-extra"
# gtactive3wifi-claim-android-space (also uses util-linux and e2fsprogs,
# both in every Duranium image)
depends="$depends cryptsetup"
# The Duranium USB debug layer (main/duranium-usb-debug) is not a
# dependency: development images add it (duranium-usb-debug,
# duranium-usb-debug-adb; build-image.sh CHANNEL=dev), release images leave
# it out, and the bring-up register console (-console) follows it.
# podman for every user, with an Alpine image that works offline
_pmb_recommends="$pkgname-containers"
makedepends="devicepkg-dev linux-headers"
subpackages="
	$pkgname-initramfs:initramfs
	$pkgname-console:console
	$pkgname-containers:containers
	$pkgname-gnome:gnome:noarch
	"
# The preinstalled container image: Alpine's minirootfs, the same tarball
# the docker.io/library/alpine image is made of (not unpacked here: it is
# the image layer as it is)
_alpine=3.24.3
_alpine_created=2026-10-21T21:55:43Z
_alpine_rootfs=alpine-minirootfs-$_alpine-aarch64.tar.gz
source="
	deviceinfo
	kernel-cmdline.conf
	gtactive3wifi-usb-prep.c
	gtactive3wifi-usb-prep.service
	gta3-console.c
	gta3-console-libc.h
	gta3-debug-console.socket
	gta3-debug-console@.service
	gtactive3wifi-initrd-deadline.service
	90_gtactive3wifi.gschema.override
	90_gtactive3wifi-gnome.gschema.override
	sysctl.conf
	gtactive3wifi-reboot.tmpfiles
	firmware-path.tmpfiles
	firmware-import.sh
	gtactive3wifi-firmware-import.service
	ucm/gtactive3.conf
	ucm/HiFi.conf
	modprobe-gtactive3wifi.conf
	90-gtactive3wifi-nested-gpt.rules
	system-watchdog.conf
	sleep.conf
	logind.conf
	suspend-gate.sh
	boot-default.sh
	gtactive3wifi-boot-default.service
	gtactive3wifi-suspend-gate.service
	system-sleep-usb.sh
	system-sleep-wifi.sh
	usb-resume-check.sh
	gtactive3wifi-usb-resume.service
	60-gtactive3wifi-pm.rules
	modprobe-gtactive3wifi-camera.conf
	libcamera-softisp.yaml
	sysupdate-retry.conf
	sysupdate-slot-hygiene.conf
	slot-hygiene.sh
	gtactive3wifi-slot-hygiene.service
	switch-ui.sh
	claim-android-space.sh
	panfrost-environment.conf
	gdm-panfrost.conf
	panfrost-profile.sh
	panfrost-profile.tmpfiles
	nm-wifi-powersave.conf
	80-gtactive3wifi-wlan-mac.rules
	wlan-efs-mac
	61-gtactive3wifi-sensors.rules
	gtactive3wifi-typing-booster-defaults.sh
	gtactive3wifi-typing-booster-defaults.service
	80-device-samsung-gtactive3wifi.preset
	80-device-samsung-gtactive3wifi.user-preset
	oomd-avoid.conf
	tuned/powersave.conf
	tuned/throughput-performance.conf
	fast-animations/extension.js
	fast-animations/metadata.json
	useradd-defaults
	gtactive3wifi-extensions-link.sh
	gtactive3wifi-extensions-link.service
	boot.mount
	boot.automount
	$_alpine_rootfs.layer::https://dl-cdn.alpinelinux.org/alpine/v${_alpine%.*}/releases/aarch64/$_alpine_rootfs
	mkoci.sh
	container-images.sh
	containers-selftest.sh
	gtactive3wifi-container-images.service
	gtactive3wifi-container-images.user.service
	README
	"

builddir="$srcdir"

build() {
	devicepkg_build $startdir $pkgname
	${CC:-gcc} $CFLAGS -O2 -Wall -static -o "$srcdir"/gtactive3wifi-usb-prep \
		"$srcdir"/gtactive3wifi-usb-prep.c $LDFLAGS
	# cross-native build: abuild's strip is the host one, so strip here
	${CROSS_COMPILE:-}strip "$srcdir"/gtactive3wifi-usb-prep
	# The bring-up debug console (gtactive3-mainline initramfs/init.c built
	# with CONSOLE_STDIO; refresh both copies from that repository)
	${CC:-gcc} $CFLAGS -O2 -Wall -Wno-unused-function -Wno-unused-variable \
		-static -DCONSOLE_STDIO -include "$srcdir"/gta3-console-libc.h \
		-o "$srcdir"/gta3-console "$srcdir"/gta3-console.c $LDFLAGS
	${CROSS_COMPILE:-}strip "$srcdir"/gta3-console

	ln -sf $_alpine_rootfs.layer "$srcdir"/$_alpine_rootfs
	rm -rf "$srcdir"/alpine-oci
	sh "$srcdir"/mkoci.sh "$srcdir"/$_alpine_rootfs "$srcdir"/alpine-oci \
		docker.io/library/alpine:${_alpine%.*} $_alpine_created arm64
}

package() {
	devicepkg_package $startdir $pkgname

	# Suspend to idle only (PSCI 0.1), off until the wake-up path has been
	# proven on the tablet: the gate allows it per boot (a sleep the user
	# cannot end strands the tablet)
	install -Dm644 "$srcdir"/sleep.conf \
		"$pkgdir"/usr/lib/systemd/sleep.conf.d/50-gtactive3wifi.conf
	install -Dm644 "$srcdir"/logind.conf \
		"$pkgdir"/usr/lib/systemd/logind.conf.d/50-gtactive3wifi.conf
	install -Dm755 "$srcdir"/suspend-gate.sh \
		"$pkgdir"/usr/libexec/gtactive3wifi/suspend-gate
	install -Dm644 "$srcdir"/gtactive3wifi-suspend-gate.service \
		"$srcdir"/gtactive3wifi-usb-resume.service \
		-t "$pkgdir"/usr/lib/systemd/system/
	mkdir -p "$pkgdir"/usr/lib/systemd/system/sysinit.target.wants
	ln -s ../gtactive3wifi-suspend-gate.service \
		"$pkgdir"/usr/lib/systemd/system/sysinit.target.wants/
	# boot the owner's UI by default, whatever else is on the ESP
	install -Dm755 "$srcdir"/boot-default.sh \
		"$pkgdir"/usr/libexec/gtactive3wifi/boot-default
	install -Dm644 "$srcdir"/gtactive3wifi-boot-default.service \
		-t "$pkgdir"/usr/lib/systemd/system/
	mkdir -p "$pkgdir"/usr/lib/systemd/system/multi-user.target.wants
	ln -s ../gtactive3wifi-boot-default.service \
		"$pkgdir"/usr/lib/systemd/system/multi-user.target.wants/
	# the USB debug link must come back after a sleep
	install -Dm755 "$srcdir"/system-sleep-usb.sh \
		"$pkgdir"/usr/lib/systemd/system-sleep/gtactive3wifi-usb
	# Wi-Fi out of the way while asleep (brcmfmac's PCIe D3 fails)
	install -Dm755 "$srcdir"/system-sleep-wifi.sh \
		"$pkgdir"/usr/lib/systemd/system-sleep/gtactive3wifi-wifi
	install -Dm755 "$srcdir"/usb-resume-check.sh \
		"$pkgdir"/usr/libexec/gtactive3wifi/usb-resume-check
	install -Dm644 "$srcdir"/60-gtactive3wifi-pm.rules \
		-t "$pkgdir"/usr/lib/udev/rules.d/
	# another UI (phosh, gnome, ...) through the A/B update
	install -Dm755 "$srcdir"/switch-ui.sh \
		"$pkgdir"/usr/bin/gtactive3wifi-switch-ui
	# opt-in: Android's unused super (and prism) partitions as encrypted
	# storage, unlocked at boot with a key file on the root
	install -Dm755 "$srcdir"/claim-android-space.sh \
		"$pkgdir"/usr/bin/gtactive3wifi-claim-android-space
	# automatic updates retry a download that broke off
	install -Dm644 "$srcdir"/sysupdate-retry.conf \
		"$pkgdir"/usr/lib/systemd/system/systemd-sysupdate.service.d/50-gtactive3wifi-retry.conf
	# an A/B slot of another UI never counts as an installed version
	install -Dm755 "$srcdir"/slot-hygiene.sh \
		"$pkgdir"/usr/libexec/gtactive3wifi/slot-hygiene
	local u
	for u in systemd-sysupdate systemd-sysupdated; do
		install -Dm644 "$srcdir"/sysupdate-slot-hygiene.conf \
			"$pkgdir"/usr/lib/systemd/system/$u.service.d/40-gtactive3wifi-slot-hygiene.conf
	done
	install -Dm644 "$srcdir"/gtactive3wifi-slot-hygiene.service \
		-t "$pkgdir"/usr/lib/systemd/system/
	ln -s ../gtactive3wifi-slot-hygiene.service \
		"$pkgdir"/usr/lib/systemd/system/multi-user.target.wants/
	# cameras: libcamera's simple pipeline + SoftISP
	install -Dm644 "$srcdir"/modprobe-gtactive3wifi-camera.conf \
		"$pkgdir"/usr/lib/modprobe.d/gtactive3wifi-camera.conf
	local s
	for s in s5k3l6 gc5035; do
		install -Dm644 "$srcdir"/libcamera-softisp.yaml \
			"$pkgdir"/usr/share/libcamera/ipa/simple/$s.yaml
	done
	install -Dm644 "$srcdir"/80-device-samsung-gtactive3wifi.preset \
		"$pkgdir"/usr/lib/systemd/system-preset/80-device-samsung-gtactive3wifi.preset
	install -Dm644 "$srcdir"/80-device-samsung-gtactive3wifi.user-preset \
		"$pkgdir"/usr/lib/systemd/user-preset/80-device-samsung-gtactive3wifi.preset
	# systemd-oomd kills apps before the shell (GNOME Shell, Phosh) and the
	# session leader
	local u
	for u in org.gnome.Shell@ mobi.phosh.Shell gnome-session-manager@; do
		install -Dm644 "$srcdir"/oomd-avoid.conf \
			"$pkgdir"/usr/lib/systemd/user/$u.service.d/50-gtactive3wifi-oomd.conf
	done
	# power-profiles-daemon profiles (tuned-ppd) tuned for this device; TuneD
	# looks in /etc/tuned/profiles first, and each includes the stock profile
	install -Dm644 "$srcdir"/powersave.conf \
		"$pkgdir"/etc/tuned/profiles/powersave/tuned.conf
	install -Dm644 "$srcdir"/throughput-performance.conf \
		"$pkgdir"/etc/tuned/profiles/throughput-performance/tuned.conf
	install -Dm644 "$srcdir"/gtactive3wifi-reboot.tmpfiles \
		"$pkgdir"/usr/lib/tmpfiles.d/gtactive3wifi-reboot.conf
	install -Dm644 "$srcdir"/firmware-path.tmpfiles \
		"$pkgdir"/usr/lib/tmpfiles.d/00-device-samsung-gtactive3wifi-firmware.conf
	# the owner's firmware, left on the ESP by the installer (setup.sh)
	install -Dm755 "$srcdir"/firmware-import.sh \
		"$pkgdir"/usr/libexec/gtactive3wifi/firmware-import
	install -Dm644 "$srcdir"/gtactive3wifi-firmware-import.service \
		-t "$pkgdir"/usr/lib/systemd/system/
	ln -s ../gtactive3wifi-firmware-import.service \
		"$pkgdir"/usr/lib/systemd/system/sysinit.target.wants/
	install -Dm644 "$srcdir"/sysctl.conf \
		"$pkgdir"/usr/lib/sysctl.d/90-device-samsung-gtactive3wifi.conf
	# hardware key bindings, read by GNOME Shell and Phosh
	install -Dm644 "$srcdir"/90_gtactive3wifi.gschema.override \
		-t "$pkgdir"/usr/share/glib-2.0/schemas/
	# ALSA UCM: speaker, headphones and microphones for PipeWire
	install -Dm644 "$srcdir"/gtactive3.conf "$srcdir"/HiFi.conf \
		-t "$pkgdir"/usr/share/alsa/ucm2/conf.d/gtactive3/
	install -Dm644 "$srcdir"/panfrost-environment.conf \
		"$pkgdir"/usr/lib/environment.d/90-gtactive3wifi-panfrost.conf
	# gdm's gnome-shell runs before any environment.d is read; greetd
	# (phrog, phoc and the Phosh session) takes it from /etc/profile. The
	# compositor's setting is the one that matters: Mesa gives every app's
	# window buffers the first modifier the compositor offers.
	install -Dm644 "$srcdir"/gdm-panfrost.conf \
		"$pkgdir"/usr/lib/systemd/system/gdm.service.d/90-gtactive3wifi-panfrost.conf
	# (Duranium's /etc comes from the base confext, not from packages: the
	# script lives in /usr and tmpfiles links it into /etc/profile.d)
	install -Dm644 "$srcdir"/panfrost-profile.sh \
		"$pkgdir"/usr/lib/gtactive3wifi/profile.d/90-gtactive3wifi-panfrost.sh
	install -Dm644 "$srcdir"/panfrost-profile.tmpfiles \
		"$pkgdir"/usr/lib/tmpfiles.d/gtactive3wifi-panfrost.conf
	install -Dm644 "$srcdir"/nm-wifi-powersave.conf \
		"$pkgdir"/usr/lib/NetworkManager/conf.d/90-gtactive3wifi-powersave.conf
	# this unit's own Wi-Fi MAC address (the nvram has a shared placeholder)
	install -Dm644 "$srcdir"/80-gtactive3wifi-wlan-mac.rules \
		"$srcdir"/61-gtactive3wifi-sensors.rules \
		-t "$pkgdir"/usr/lib/udev/rules.d/
	install -Dm755 "$srcdir"/wlan-efs-mac \
		"$pkgdir"/usr/libexec/gtactive3wifi/wlan-efs-mac
	install -Dm644 "$srcdir"/useradd-defaults "$pkgdir"/etc/default/useradd
	# the sysext/confext images of this version (scripts/duranium-update)
	install -Dm755 "$srcdir"/gtactive3wifi-extensions-link.sh \
		"$pkgdir"/usr/libexec/gtactive3wifi/extensions-link
	install -Dm644 "$srcdir"/gtactive3wifi-extensions-link.service \
		-t "$pkgdir"/usr/lib/systemd/system/
	for u in systemd-sysext systemd-confext; do
		mkdir -p "$pkgdir"/usr/lib/systemd/system/$u.service.wants
		ln -s ../gtactive3wifi-extensions-link.service \
			"$pkgdir"/usr/lib/systemd/system/$u.service.wants/
	done
	# the nested ESP at /boot (sysupdate puts the UKIs there)
	install -Dm644 "$srcdir"/boot.mount "$srcdir"/boot.automount \
		-t "$pkgdir"/usr/lib/systemd/system/
	mkdir -p "$pkgdir"/usr/lib/systemd/system/local-fs.target.wants
	ln -s ../boot.automount \
		"$pkgdir"/usr/lib/systemd/system/local-fs.target.wants/
	install -Dm644 "$srcdir"/README \
		"$pkgdir"/usr/share/doc/$pkgname/README
}

# GNOME (desktop shell) only: word completion, the preinstalled extensions
gnome() {
	pkgdesc="$pkgdesc (GNOME Shell defaults)"
	install_if="$pkgname=$pkgver-r$pkgrel postmarketos-ui-gnome"
	depends="
		ibus
		ibus-typing-booster
		hunspell-en
		gnome-shell-extension-blur-my-shell
		gnome-shell-extension-touchup
		"

	# gnome-shell's D-Bus services (Extensions app, notifications, screen
	# shield) are built with /usr/sbin/gjs; gjs is in /usr/bin
	mkdir -p "$subpkgdir"/usr/sbin
	ln -s ../bin/gjs "$subpkgdir"/usr/sbin/gjs
	install -Dm755 "$srcdir"/gtactive3wifi-typing-booster-defaults.sh \
		"$subpkgdir"/usr/libexec/gtactive3wifi/typing-booster-defaults
	install -Dm644 "$srcdir"/gtactive3wifi-typing-booster-defaults.service \
		-t "$subpkgdir"/usr/lib/systemd/user/
	mkdir -p "$subpkgdir"/usr/lib/systemd/user/default.target.wants
	ln -s ../gtactive3wifi-typing-booster-defaults.service \
		"$subpkgdir"/usr/lib/systemd/user/default.target.wants/
	install -Dm644 "$srcdir"/90_gtactive3wifi-gnome.gschema.override \
		-t "$subpkgdir"/usr/share/glib-2.0/schemas/
	install -Dm644 "$srcdir"/extension.js "$srcdir"/metadata.json \
		-t "$subpkgdir"/usr/share/gnome-shell/extensions/fast-animations@gtactive3wifi/
}

# podman (rootless for every user, rootful for root) with Alpine preinstalled:
# an OCI layout in /usr, loaded into root's store at boot and into each
# user's store at login (container-images.sh), so "podman run alpine" works
# offline from the first boot. Users created by useradd (Duranium's first
# boot, GNOME Settings/accountsservice) get their subordinate ID ranges from
# shadow (/etc/subuid exists: shadow-subids, a postmarketos-duranium
# dependency).
containers() {
	pkgdesc="$pkgdesc (podman with a preinstalled Alpine image)"
	# distrobox: containers of other distributions (Fedora, Arch, ...) that
	# share the home directory and export their apps to the app grid
	depends="podman distrobox"

	local img="$subpkgdir"/usr/lib/gtactive3wifi/container-images/alpine
	mkdir -p "$img"
	cp -R "$srcdir"/alpine-oci/. "$img"/
	# the name the image is stored under first, then further tags
	printf '%s\n' docker.io/library/alpine:${_alpine%.*} \
		docker.io/library/alpine:latest > "$img"/tags
	tar -xzOf "$srcdir"/$_alpine_rootfs ./etc/alpine-release > "$img"/alpine-release

	install -Dm755 "$srcdir"/container-images.sh \
		"$subpkgdir"/usr/libexec/gtactive3wifi/container-images
	install -Dm755 "$srcdir"/containers-selftest.sh \
		"$subpkgdir"/usr/libexec/gtactive3wifi/containers-selftest
	install -Dm644 "$srcdir"/gtactive3wifi-container-images.service \
		-t "$subpkgdir"/usr/lib/systemd/system/
	install -Dm644 "$srcdir"/gtactive3wifi-container-images.user.service \
		"$subpkgdir"/usr/lib/systemd/user/gtactive3wifi-container-images.service
	mkdir -p "$subpkgdir"/usr/lib/systemd/system/multi-user.target.wants \
		"$subpkgdir"/usr/lib/systemd/user/default.target.wants
	ln -s ../gtactive3wifi-container-images.service \
		"$subpkgdir"/usr/lib/systemd/system/multi-user.target.wants/
	ln -s ../gtactive3wifi-container-images.service \
		"$subpkgdir"/usr/lib/systemd/user/default.target.wants/
}

# The bring-up register console (TCP 23 on the USB debug interface: peek,
# poke, put, run ... as root, no authentication), for scripts/tab. Only with
# the USB debug layer: install_if puts it into the base image and into the
# initrd next to duranium-usb-debug-initramfs, and release images never get it.
console() {
	pkgdesc="$pkgdesc (bring-up debug console, development images)"
	install_if="$pkgname-initramfs=$pkgver-r$pkgrel duranium-usb-debug-initramfs"
	depends="$pkgname-initramfs=$pkgver-r$pkgrel"

	install -Dm755 "$srcdir"/gta3-console \
		"$subpkgdir"/usr/libexec/gtactive3wifi/gta3-console
	install -Dm644 "$srcdir"/gta3-debug-console.socket \
		"$srcdir"/gta3-debug-console@.service \
		-t "$subpkgdir"/usr/lib/systemd/system/
	# in the initrd and the booted system, like the rest of the debug layer
	mkdir -p "$subpkgdir"/usr/lib/systemd/system/sockets.target.wants
	ln -s ../gta3-debug-console.socket \
		"$subpkgdir"/usr/lib/systemd/system/sockets.target.wants/
}

# Everything early boot needs, in the Duranium initrd and in the booted system
initramfs() {
	pkgdesc="$pkgdesc (initrd and early boot support)"
	depends="kmod"

	install -Dm755 "$srcdir"/gtactive3wifi-usb-prep \
		"$subpkgdir"/usr/libexec/gtactive3wifi/usb-prep
	install -Dm644 "$srcdir"/gtactive3wifi-usb-prep.service \
		-t "$subpkgdir"/usr/lib/systemd/system/
	install -Dm644 "$srcdir"/modprobe-gtactive3wifi.conf \
		"$subpkgdir"/usr/lib/modprobe.d/gtactive3wifi.conf
	install -Dm644 "$srcdir"/90-gtactive3wifi-nested-gpt.rules \
		-t "$subpkgdir"/usr/lib/udev/rules.d/
	install -Dm644 "$srcdir"/system-watchdog.conf \
		"$subpkgdir"/usr/lib/systemd/system.conf.d/50-gtactive3wifi-watchdog.conf
	install -Dm644 "$srcdir"/80-device-samsung-gtactive3wifi.preset \
		"$subpkgdir"/usr/lib/systemd/initrd-preset/80-device-samsung-gtactive3wifi.preset
	# enable in the initrd regardless of how presets are applied there
	mkdir -p "$subpkgdir"/usr/lib/systemd/system/sysinit.target.wants
	ln -s ../gtactive3wifi-usb-prep.service \
		"$subpkgdir"/usr/lib/systemd/system/sysinit.target.wants/

	# initrd only (ConditionPathExists=/etc/initrd-release)
	install -Dm644 "$srcdir"/gtactive3wifi-initrd-deadline.service \
		-t "$subpkgdir"/usr/lib/systemd/system/
	mkdir -p "$subpkgdir"/usr/lib/systemd/system/initrd.target.wants
	ln -s ../gtactive3wifi-initrd-deadline.service \
		"$subpkgdir"/usr/lib/systemd/system/initrd.target.wants/
}

