# Reference: <https://postmarketos.org/devicepkg>
maintainer="dixonSolutions <203963471+dixonSolutions@users.noreply.github.com>"
pkgname=device-samsung-gtactive3wifi
pkgdesc="Samsung Galaxy Tab Active3 (Wi-Fi)"
pkgver=2
pkgrel=25
url="https://github.com/dixonSolutions/gtactive3-mainline"
license="MIT"
arch="aarch64"
options="!check !archcheck !strip !tracedeps"
depends="
	$pkgname-initramfs=$pkgver-r$pkgrel
	linux-postmarketos-exynos9810
	postmarketos-base
	systemd-boot
	"
# vte3 for /usr/libexec/vte-urlencode-cwd, which vte3-profile's
# /etc/profile.d/vte.sh runs at every bash prompt. Everything specific to
# one UI lives in a subpackage that installs itself with that UI (-gnome),
# so the same device package serves every image variant.
depends="$depends vte3"
# The Duranium USB debug layer (main/duranium-usb-debug) is not a
# dependency: development images add it (duranium-usb-debug,
# duranium-usb-debug-adb; build-image.sh CHANNEL=dev), release images leave
# it out, and the bring-up register console (-console) follows it.
makedepends="devicepkg-dev linux-headers"
subpackages="
	$pkgname-initramfs:initramfs
	$pkgname-console:console
	$pkgname-gnome:gnome:noarch
	"
source="
	deviceinfo
	kernel-cmdline.conf
	modules-initfs
	gtactive3wifi-usb-prep.c
	gtactive3wifi-usb-prep.service
	gta3-console.c
	gta3-console-libc.h
	gta3-debug-console.socket
	gta3-debug-console@.service
	gtactive3wifi-initrd-deadline.service
	90_gtactive3wifi.gschema.override
	gtactive3wifi-reboot.tmpfiles
	firmware-path.tmpfiles
	ucm/gtactive3.conf
	ucm/HiFi.conf
	modprobe-gtactive3wifi.conf
	90-gtactive3wifi-nested-gpt.rules
	system-watchdog.conf
	sleep-nosuspend.conf
	logind-nosuspend.conf
	panfrost-environment.conf
	gdm-panfrost.conf
	gtactive3wifi-typing-booster-defaults.sh
	gtactive3wifi-typing-booster-defaults.service
	80-device-samsung-gtactive3wifi.preset
	fast-animations/extension.js
	fast-animations/metadata.json
	useradd-defaults
	gtactive3wifi-extensions-link.sh
	gtactive3wifi-extensions-link.service
	boot.mount
	boot.automount
	README
	"

builddir="$srcdir"

build() {
	devicepkg_build $startdir $pkgname
	${CC:-gcc} $CFLAGS -O2 -Wall -static -o "$srcdir"/gtactive3wifi-usb-prep \
		"$srcdir"/gtactive3wifi-usb-prep.c $LDFLAGS
	# cross-native build: abuild's strip is the host one, so strip here
	${CROSS_COMPILE:-}strip "$srcdir"/gtactive3wifi-usb-prep
	# The bring-up debug console (gtactive3-mainline initramfs/init.c built
	# with CONSOLE_STDIO; refresh both copies from that repository)
	${CC:-gcc} $CFLAGS -O2 -Wall -Wno-unused-function -Wno-unused-variable \
		-static -DCONSOLE_STDIO -include "$srcdir"/gta3-console-libc.h \
		-o "$srcdir"/gta3-console "$srcdir"/gta3-console.c $LDFLAGS
	${CROSS_COMPILE:-}strip "$srcdir"/gta3-console
}

package() {
	devicepkg_package $startdir $pkgname

	# No SoC suspend/resume support yet: a failed resume is a silent hang
	install -Dm644 "$srcdir"/sleep-nosuspend.conf \
		"$pkgdir"/usr/lib/systemd/sleep.conf.d/50-gtactive3wifi.conf
	install -Dm644 "$srcdir"/logind-nosuspend.conf \
		"$pkgdir"/usr/lib/systemd/logind.conf.d/50-gtactive3wifi.conf
	install -Dm644 "$srcdir"/80-device-samsung-gtactive3wifi.preset \
		"$pkgdir"/usr/lib/systemd/system-preset/80-device-samsung-gtactive3wifi.preset
	install -Dm644 "$srcdir"/gtactive3wifi-reboot.tmpfiles \
		"$pkgdir"/usr/lib/tmpfiles.d/gtactive3wifi-reboot.conf
	install -Dm644 "$srcdir"/firmware-path.tmpfiles \
		"$pkgdir"/usr/lib/tmpfiles.d/00-device-samsung-gtactive3wifi-firmware.conf
	# ALSA UCM: speaker, headphones and microphones for PipeWire
	install -Dm644 "$srcdir"/gtactive3.conf "$srcdir"/HiFi.conf \
		-t "$pkgdir"/usr/share/alsa/ucm2/conf.d/gtactive3/
	install -Dm644 "$srcdir"/panfrost-environment.conf \
		"$pkgdir"/usr/lib/environment.d/90-gtactive3wifi-panfrost.conf
	# the login screens (gdm for GNOME, greetd + phrog for Phosh, which also
	# starts the user session) run before any environment.d is read
	local dm
	for dm in gdm greetd; do
		install -Dm644 "$srcdir"/gdm-panfrost.conf \
			"$pkgdir"/usr/lib/systemd/system/$dm.service.d/90-gtactive3wifi-panfrost.conf
	done
	install -Dm644 "$srcdir"/useradd-defaults "$pkgdir"/etc/default/useradd
	# the sysext/confext images of this version (scripts/duranium-update)
	install -Dm755 "$srcdir"/gtactive3wifi-extensions-link.sh \
		"$pkgdir"/usr/libexec/gtactive3wifi/extensions-link
	install -Dm644 "$srcdir"/gtactive3wifi-extensions-link.service \
		-t "$pkgdir"/usr/lib/systemd/system/
	for u in systemd-sysext systemd-confext; do
		mkdir -p "$pkgdir"/usr/lib/systemd/system/$u.service.wants
		ln -s ../gtactive3wifi-extensions-link.service \
			"$pkgdir"/usr/lib/systemd/system/$u.service.wants/
	done
	# the nested ESP at /boot (sysupdate puts the UKIs there)
	install -Dm644 "$srcdir"/boot.mount "$srcdir"/boot.automount \
		-t "$pkgdir"/usr/lib/systemd/system/
	mkdir -p "$pkgdir"/usr/lib/systemd/system/local-fs.target.wants
	ln -s ../boot.automount \
		"$pkgdir"/usr/lib/systemd/system/local-fs.target.wants/
	install -Dm644 "$srcdir"/README \
		"$pkgdir"/usr/share/doc/$pkgname/README
}

# GNOME (desktop shell) only: word completion, the preinstalled extensions,
# hardware key bindings
gnome() {
	pkgdesc="$pkgdesc (GNOME Shell defaults)"
	install_if="$pkgname=$pkgver-r$pkgrel postmarketos-ui-gnome"
	depends="
		ibus
		ibus-typing-booster
		hunspell-en
		gnome-shell-extension-blur-my-shell
		gnome-shell-extension-touchup
		"

	# gnome-shell's D-Bus services (Extensions app, notifications, screen
	# shield) are built with /usr/sbin/gjs; gjs is in /usr/bin
	mkdir -p "$subpkgdir"/usr/sbin
	ln -s ../bin/gjs "$subpkgdir"/usr/sbin/gjs
	install -Dm755 "$srcdir"/gtactive3wifi-typing-booster-defaults.sh \
		"$subpkgdir"/usr/libexec/gtactive3wifi/typing-booster-defaults
	install -Dm644 "$srcdir"/gtactive3wifi-typing-booster-defaults.service \
		-t "$subpkgdir"/usr/lib/systemd/user/
	mkdir -p "$subpkgdir"/usr/lib/systemd/user/default.target.wants
	ln -s ../gtactive3wifi-typing-booster-defaults.service \
		"$subpkgdir"/usr/lib/systemd/user/default.target.wants/
	install -Dm644 "$srcdir"/90_gtactive3wifi.gschema.override \
		-t "$subpkgdir"/usr/share/glib-2.0/schemas/
	install -Dm644 "$srcdir"/extension.js "$srcdir"/metadata.json \
		-t "$subpkgdir"/usr/share/gnome-shell/extensions/fast-animations@gtactive3wifi/
}

# The bring-up register console (TCP 23 on the USB debug interface: peek,
# poke, put, run ... as root, no authentication), for scripts/tab. Only with
# the USB debug layer: install_if puts it into the base image and into the
# initrd next to duranium-usb-debug-initramfs, and release images never get it.
console() {
	pkgdesc="$pkgdesc (bring-up debug console, development images)"
	install_if="$pkgname-initramfs=$pkgver-r$pkgrel duranium-usb-debug-initramfs"
	depends="$pkgname-initramfs=$pkgver-r$pkgrel"

	install -Dm755 "$srcdir"/gta3-console \
		"$subpkgdir"/usr/libexec/gtactive3wifi/gta3-console
	install -Dm644 "$srcdir"/gta3-debug-console.socket \
		"$srcdir"/gta3-debug-console@.service \
		-t "$subpkgdir"/usr/lib/systemd/system/
	# in the initrd and the booted system, like the rest of the debug layer
	mkdir -p "$subpkgdir"/usr/lib/systemd/system/sockets.target.wants
	ln -s ../gta3-debug-console.socket \
		"$subpkgdir"/usr/lib/systemd/system/sockets.target.wants/
}

# Everything early boot needs, in the Duranium initrd and in the booted system
initramfs() {
	pkgdesc="$pkgdesc (initrd and early boot support)"
	depends="kmod"

	install -Dm755 "$srcdir"/gtactive3wifi-usb-prep \
		"$subpkgdir"/usr/libexec/gtactive3wifi/usb-prep
	install -Dm644 "$srcdir"/gtactive3wifi-usb-prep.service \
		-t "$subpkgdir"/usr/lib/systemd/system/
	install -Dm644 "$srcdir"/modprobe-gtactive3wifi.conf \
		"$subpkgdir"/usr/lib/modprobe.d/gtactive3wifi.conf
	install -Dm644 "$srcdir"/90-gtactive3wifi-nested-gpt.rules \
		-t "$subpkgdir"/usr/lib/udev/rules.d/
	install -Dm644 "$srcdir"/system-watchdog.conf \
		"$subpkgdir"/usr/lib/systemd/system.conf.d/50-gtactive3wifi-watchdog.conf
	install -Dm644 "$srcdir"/80-device-samsung-gtactive3wifi.preset \
		"$subpkgdir"/usr/lib/systemd/initrd-preset/80-device-samsung-gtactive3wifi.preset
	# enable in the initrd regardless of how presets are applied there
	mkdir -p "$subpkgdir"/usr/lib/systemd/system/sysinit.target.wants
	ln -s ../gtactive3wifi-usb-prep.service \
		"$subpkgdir"/usr/lib/systemd/system/sysinit.target.wants/

	# initrd only (ConditionPathExists=/etc/initrd-release)
	install -Dm644 "$srcdir"/gtactive3wifi-initrd-deadline.service \
		-t "$subpkgdir"/usr/lib/systemd/system/
	mkdir -p "$subpkgdir"/usr/lib/systemd/system/initrd.target.wants
	ln -s ../gtactive3wifi-initrd-deadline.service \
		"$subpkgdir"/usr/lib/systemd/system/initrd.target.wants/
}

