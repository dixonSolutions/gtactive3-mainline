# Galaxy Tab Active3 hardware keys: Home (KEY_HOMEPAGE -> XF86HomePage)
# opens the app grid, Recent apps (KEY_SCALE -> XF86LaunchA) the window
# overview, like on Android. GNOME Shell and Phosh both read these keys
# (Phosh opens its overview for either). The Active key on the side
# (KEY_PROG1 -> XF86Launch1) takes a screenshot (both shells' screenshot
# keybinding; Shift+Print stays).
[org.gnome.shell.keybindings]
toggle-application-view=['<Super>a', 'XF86HomePage']
toggle-overview=['<Super>s', 'XF86LaunchA']
screenshot=['<Shift>Print', 'XF86Launch1']
