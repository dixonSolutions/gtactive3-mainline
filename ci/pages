"""


def page(data, fpr):
    e = html.escape
    out = [f"""<!doctype html><html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{e(MODELS)} Duranium releases</title><style>{CSS}</style></head><body><main>
<h1>{e(DEVICE)} ({e(MODELS)}) releases</h1>
<p class="muted">postmarketOS Duranium images with the
<a href="https://github.com/{e(REPO)}">{e(REPO)}</a> kernel and drivers.
Official record, generated {e(data['generated'])} from the GitHub releases.</p>
<nav><a href="releases.json">releases.json</a><a href="sysupdate-public-key.asc">signing key</a>
<a href="https://github.com/{e(REPO)}/blob/main/docs/INSTALL.md">install instructions</a>
<a href="https://github.com/{e(REPO)}/blob/main/docs/RELEASES.md">how releases work</a></nav>
<div class="card"><p><b>Signing key</b> <span class="mono">{e(fpr)}</span></p>
<p class="muted">Every channel's <code>SHA256SUMS</code> is signed with this key (<code>SHA256SUMS.gpg</code>);
installed tablets accept nothing else. The checksums below come from manifests whose signature this page
checked. To install, follow <a href="https://github.com/{e(REPO)}/blob/main/docs/INSTALL.md">docs/INSTALL.md</a>;
installed tablets update with <code>updatectl update</code>.
Vendor firmware is not included in any image.</p></div>"""]
    if not data["channels"]:
        out.append('<div class="card"><p>No channel has a signed release yet.</p></div>')
    for c in data["channels"]:
        badges = [f'<span class="badge {"pre" if c["prerelease"] else "ok"}">'
                  f'{"pre-release" if c["prerelease"] else "release"}</span>',
                  '<span class="badge ok">verified on the device</span>' if c["verified"]
                  else '<span class="badge warn">not verified on the device</span>',
                  '<span class="badge ok">signature checked</span>']
        if c["flavour"] == "dev":
            badges.append('<span class="badge warn">root over USB, no password</span>')
        out.append(f"""<div class="card" id="{e(c['id'])}"><div class="head"><h2>{e(c['title'])}
{'development' if c['flavour'] == 'dev' else ''}</h2>{''.join(badges)}</div>
<p class="muted">{e(c['description'])}</p>
<p>Channel <code>{e(c['id'])}</code> &middot; latest <b>{e(c['latest'])}</b> &middot;
<a href="https://github.com/{e(REPO)}/releases/tag/{e(c['id'])}">GitHub release</a> &middot;
<a href="channels/{e(c['id'])}.json">{e(c['id'])}.json</a></p>""")
        for i, v in enumerate(c["versions"]):
            rows = "".join(
                f'<tr><td>{e(KIND_LABEL.get(f["kind"], f["kind"]))}</td>'
                f'<td><a class="mono" href="{e(f["url"])}">{e(f["name"])}</a></td>'
                f'<td class="num">{size(f["size"])}</td>'
                f'<td class="sha mono" title="{e(f["sha256"])}">{e(f["sha256"])}</td></tr>'
                for f in v["files"])
            table = (f'<div class="tbl"><table><tr><th>Kind</th><th>File</th><th>Size</th><th>SHA-256</th></tr>'
                     f'{rows}</table></div>')
            label = f'Version {e(v["version"])} <span class="muted">({e(v["date"][:10])})</span>'
            out.append(f"<h3>{label}</h3>{table}" if i == 0 else
                       f"<details><summary>{label}</summary>{table}</details>")
        out.append("</div>")
    if data.get("bootchain"):
        b = data["bootchain"]
        rows = "".join(f'<tr><td><a class="mono" href="{e(f["url"])}">{e(f["name"])}</a></td>'
                       f'<td class="num">{size(f["size"])}</td>'
                       f'<td class="sha mono" title="{e(f["sha256"])}">{e(f["sha256"])}</td></tr>'
                       for f in b["files"])
        out.append(f"""<div class="card"><div class="head"><h2>Boot chain</h2>
<span class="badge ok">signature checked</span></div>
<p class="muted">uniLoader + U-Boot payload for the BOOT partition (GPL, no Samsung files); used by the installer.</p>
<div class="tbl"><table><tr><th>File</th><th>Size</th><th>SHA-256</th></tr>{rows}</table></div></div>""")
    out.append("</main></body></html>\n")
    return "\n".join(out)


def main():
    out = Path(sys.argv[1])
    (out / "channels").mkdir(parents=True, exist_ok=True)
    rels = releases()
    with tempfile.TemporaryDirectory() as t:
        tmp = Path(t)
        os.chmod(tmp, 0o700)
        ring = tmp / "ring.gpg"
        ring.write_bytes(subprocess.run(["gpg", "--dearmor"], input=KEY.read_bytes(),
                                        check=True, capture_output=True).stdout)
        fpr = fingerprint(ring)
        chans = []
        for ui, flavour, tag in channels():
            if tag in rels and (c := channel(ui, flavour, tag, rels[tag], ring, tmp)):
                chans.append(c)
        bc = bootchain(rels[BOOTCHAIN_TAG], ring, tmp) if BOOTCHAIN_TAG in rels else None
    now = datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")
    data = {"schema": 1, "generated": now, "repo": REPO, "channels": chans}
    if bc:
        data["bootchain"] = bc
    (out / "releases.json").write_text(json.dumps(data, indent=2) + "\n")
    for c in chans:
        (out / "channels" / f"{c['id']}.json").write_text(
            json.dumps({"schema": 1, "generated": now, "repo": REPO, **c}, indent=2) + "\n")
    (out / "sysupdate-public-key.asc").write_bytes(KEY.read_bytes())
    (out / "device.json").write_text(json.dumps({**CFG, "generated": now}, indent=2) + "\n")
    (out / "index.html").write_text(page(data, fpr))
    print(f"{len(chans)} channels: " + ", ".join(f"{c['id']} {c['latest']}" for c in chans))


if __name__ == "__main__":
    main()
