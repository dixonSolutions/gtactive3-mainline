#!/usr/bin/env python3
"""Generate the official release records (GitHub Pages) from the releases.

    ci/pages OUT

Writes OUT/releases.json (schema 1, below), OUT/channels/<id>.json (one
channel each, same fields plus schema/generated/repo), OUT/device.json (the
resolved config.toml plus "generated": what the exynos-linux site reads),
OUT/index.html (the same data for humans) and OUT/sysupdate-public-key.asc.

Only what a tablet would accept is listed: for every channel (ci/channels)
the release's SHA256SUMS must verify against update.public_key
(gpgv), and the versions, files and sha256 values come from it. Sizes and
URLs come from the GitHub release assets. A channel without a valid manifest
is left out (with a warning). Installers still verify the signature
themselves.

releases.json:
  {"schema": 1, "generated": iso8601, "repo": "owner/name",
   "channels": [{"id", "ui", "flavour": "release"|"dev", "title",
     "description", "prerelease", "verified", "latest",
     "versions": [{"version", "date",
       "files": [{"name", "size", "sha256", "url", "kind"}]}]}],
   "bootchain": {...}}   (only when the boot-chain release exists)
"verified" = built from an export that passed on the device
(pmos/VERIFIED); only such builds reach the release channels.
Environment: GITHUB_REPOSITORY, GH_TOKEN (API rate limit).
"""
import datetime
import hashlib
import html
import json
import os
import re
import subprocess
import sys
import tempfile
import urllib.error
import urllib.request
from pathlib import Path

HERE = Path(__file__).resolve().parent
CFG = json.loads(subprocess.run([str(HERE.parent / "scripts" / "config"), "json"],
                                check=True, capture_output=True, text=True).stdout)
REPO = CFG["project"]["repo"]
KEY = HERE.parent / CFG["update"]["public_key"]
BOOTCHAIN_TAG = CFG["bootchain"]["tag"]
TITLES = {ui: CFG["ui"][ui]["title"] for ui in CFG["images"]["uis"]}
DEVICE = CFG["device"]["name"]
MODELS = ", ".join(CFG["device"]["models"])
DESCRIPTIONS = {
    "release": "{title} for everyone: postmarketOS Duranium with the " + CFG["project"]["name"] + " kernel and drivers.",
    "dev": "{title} development build: adds the USB debug layer (root shell, ssh and adb over USB "
           "without a password). For development tablets only.",
}


def warn(msg):
    print(f"::warning::{msg}", file=sys.stderr)


def fetch(url, api=False):
    req = urllib.request.Request(url, headers={"User-Agent": CFG["project"]["name"] + "-pages"})
    if api:
        req.add_header("Accept", "application/vnd.github+json")
        if os.environ.get("GH_TOKEN"):
            req.add_header("Authorization", f"Bearer {os.environ['GH_TOKEN']}")
    with urllib.request.urlopen(req, timeout=60) as r:
        return r.read()


def releases():
    out, page = [], 1
    while True:
        try:
            raw = fetch(f"https://api.github.com/repos/{REPO}/releases?per_page=100&page={page}", api=True)
        except urllib.error.HTTPError as x:
            if x.code != 404:
                raise
            warn(f"{REPO}: no releases (HTTP 404)")
            return {}
        batch = json.loads(raw)
        out += batch
        if len(batch) < 100:
            return {r["tag_name"]: r for r in out}
        page += 1


def channels():
    lines = subprocess.run([str(HERE.parent / "scripts" / "config"), "channels"],
                           check=True, capture_output=True, text=True).stdout
    return [line.split() for line in lines.splitlines() if line.strip()]


def verified_manifest(rel, ring, tmp):
    """{name: sha256} of the release's SHA256SUMS if our key signed it."""
    assets = {a["name"]: a for a in rel["assets"]}
    if "SHA256SUMS" not in assets or "SHA256SUMS.gpg" not in assets:
        return None, None
    data = fetch(assets["SHA256SUMS"]["browser_download_url"])
    sig = fetch(assets["SHA256SUMS.gpg"]["browser_download_url"])
    (tmp / "m").write_bytes(data)
    (tmp / "m.gpg").write_bytes(sig)
    if subprocess.run(["gpgv", "--keyring", str(ring), str(tmp / "m.gpg"), str(tmp / "m")],
                      capture_output=True).returncode != 0:
        return None, None
    sums = {}
    for line in data.decode().splitlines():
        m = re.fullmatch(r"([0-9a-f]{64}) [ *](\S+)", line)
        if m:
            sums[m.group(2)] = m.group(1)
    extra = {
        "SHA256SUMS": hashlib.sha256(data).hexdigest(),
        "SHA256SUMS.gpg": hashlib.sha256(sig).hexdigest(),
    }
    return sums, extra


KINDS = ["install-raw", "uki", "usr", "usr-verity", "sysext", "confext", "manifest", "signature"]


def kind(name):
    for pat, k in ((r"\.efi$", "uki"), (r"\.usr-[a-z0-9]+-verity\.[0-9a-f]+\.raw\.zst$", "usr-verity"),
                   (r"\.usr-[a-z0-9]+\.[0-9a-f]+\.raw\.zst$", "usr"), (r"-sysext-[a-z0-9]+\.raw\.zst$", "sysext"),
                   (r"-confext-[a-z0-9]+\.raw\.zst$", "confext"), (r"_[0-9]{8}\.raw\.zst$", "install-raw")):
        if re.search(pat, name):
            return k
    return None


def file_entry(asset, sha, k):
    return {"name": asset["name"], "size": asset["size"], "sha256": sha,
            "url": asset["browser_download_url"], "kind": k}


def channel(ui, flavour, tag, rel, ring, tmp):
    sums, extra = verified_manifest(rel, ring, tmp)
    if sums is None:
        warn(f"{tag}: no SHA256SUMS signed by our key, left out")
        return None
    assets = {a["name"]: a for a in rel["assets"]}
    prefix = tag.removesuffix("-dev") + "_"
    versions = {}
    for name, sha in sums.items():
        m = re.match(re.escape(prefix) + r"([0-9]{8})\.", name)
        k = kind(name)
        if not m or not k:
            continue
        if name not in assets:
            warn(f"{tag}: SHA256SUMS names {name}, which is not in the release")
            continue
        versions.setdefault(m.group(1), []).append(file_entry(assets[name], sha, k))
    out = []
    for v in sorted(versions, reverse=True):
        files = sorted(versions[v], key=lambda f: (KINDS.index(f["kind"]), f["name"]))
        uki = next((f for f in files if f["kind"] == "uki"), None)
        if not uki:
            warn(f"{tag}: version {v} has no UKI, left out")
            continue
        date = assets[uki["name"]]["updated_at"]
        files += [file_entry(assets[n], extra[n], "manifest" if n == "SHA256SUMS" else "signature")
                  for n in ("SHA256SUMS", "SHA256SUMS.gpg")]
        out.append({"version": v, "date": date, "files": files})
    if not out:
        warn(f"{tag}: no complete version, left out")
        return None
    notes = rel.get("body") or ""
    m = re.search(r"^Verified on the device: (yes|no)\b", notes, re.M)
    title = TITLES.get(ui, ui.capitalize())
    return {
        "id": tag, "ui": ui, "flavour": flavour, "title": title,
        "description": DESCRIPTIONS[flavour].format(title=title),
        "prerelease": bool(rel["prerelease"]),
        "verified": (m.group(1) == "yes") if m else flavour == "release",
        "latest": out[0]["version"], "versions": out,
    }


def bootchain(rel, ring, tmp):
    sums, extra = verified_manifest(rel, ring, tmp)
    if sums is None:
        warn(f"{BOOTCHAIN_TAG}: no SHA256SUMS signed by our key, left out")
        return None
    assets = {a["name"]: a for a in rel["assets"]}
    files = [{"name": n, "size": assets[n]["size"], "sha256": s, "url": assets[n]["browser_download_url"]}
             for n, s in sorted(sums.items()) if n in assets]
    files += [{"name": n, "size": assets[n]["size"], "sha256": extra[n],
               "url": assets[n]["browser_download_url"]} for n in ("SHA256SUMS", "SHA256SUMS.gpg")]
    return {"tag": BOOTCHAIN_TAG, "prerelease": bool(rel["prerelease"]),
            "date": rel.get("published_at") or rel.get("created_at"), "files": files}


def fingerprint(ring):
    out = subprocess.run(["gpg", "--batch", "--show-keys", "--with-colons", str(ring)],
                         check=True, capture_output=True, text=True,
                         env={**os.environ, "GNUPGHOME": str(ring.parent)}).stdout
    fpr = next(line.split(":")[9] for line in out.splitlines() if line.startswith("fpr:"))
    return " ".join(fpr[i:i + 4] for i in range(0, 40, 4))


def size(n):
    for unit in ("B", "KiB", "MiB", "GiB"):
        if n < 1024 or unit == "GiB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024


KIND_LABEL = {"install-raw": "Install image", "uki": "Kernel (UKI)", "usr": "/usr image",
              "usr-verity": "/usr verity", "sysext": "System extension", "confext": "Config extension",
              "manifest": "Manifest", "signature": "Signature"}

CSS = """
:root{--bg:#fafaf8;--fg:#1d1d1f;--muted:#5f6368;--line:#e2e2de;--card:#fff;--accent:#2e6b4f;
--warn-bg:#fff4e0;--warn-fg:#7a4a00;--ok-bg:#e5f3ea;--ok-fg:#1e5a37;--pre-bg:#eceaf6;--pre-fg:#463c8a}
@media (prefers-color-scheme:dark){:root{--bg:#131314;--fg:#e8e8e6;--muted:#a0a0a6;--line:#2c2c30;
--card:#1b1b1d;--accent:#7cc8a0;--warn-bg:#3a2a10;--warn-fg:#f5c77a;--ok-bg:#16301f;--ok-fg:#8fd9ad;
--pre-bg:#25223d;--pre-fg:#bdb4f5}}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--fg);
font:15px/1.55 system-ui,-apple-system,"Segoe UI",sans-serif}
