#!/bin/bash
# Mark the committed pmos/ export (aports + duranium-build series) as passed
# on the device, so the next CI run also builds and publishes the public
# release channels (until then only the -dev channels get it, as
# pre-releases). Only on the device coordinator's word (docs/COORDINATION.md),
# after an on-device pass of exactly this export. Any later export of either
# goes to the -dev channels only until it is verified again.
#
#   scripts/pmos-verify "r12: boots, Wi-Fi/touch/GPU ok"   then commit + push
set -euo pipefail
P=$(cd "$(dirname "$0")/.." && pwd)
[ -n "${1:-}" ] || { echo "usage: $0 'what passed on the device'" >&2; exit 1; }
git -C "$P" diff --quiet HEAD -- pmos/aports pmos/duranium-build &&
	[ -z "$(git -C "$P" ls-files --others --exclude-standard pmos/aports pmos/duranium-build)" ] ||
	{ echo "commit the export first" >&2; exit 1; }
aports=$(git -C "$P" rev-parse HEAD:pmos/aports)
dbuild=$(git -C "$P" rev-parse HEAD:pmos/duranium-build)
kc=$(sed -n 's/^_commit="\(.*\)"/\1/p' "$P"/pmos/aports/device/testing/linux-postmarketos-exynos9810/APKBUILD)
# ci/state matches the first two fields
printf 'aports=%s duranium-build=%s kernel=%s %s %s\n' "$aports" "$dbuild" "${kc:0:12}" \
	"$(date -u +%Y-%m-%d)" "$1" > "$P/pmos/VERIFIED"
cat "$P/pmos/VERIFIED"
