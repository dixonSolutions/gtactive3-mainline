#!/bin/bash
# Find which line a physical key is really wired to: sample every GPIO data
# register (all Exynos9810 pin banks except VTS) and /proc/interrupts over the
# debug console, first idle, then while the user holds the key, and report
# the bits and interrupt counters that change.
#
#   scripts/keyscan base             record the idle state (nobody touching keys)
#   scripts/keyscan held NAME [SECS] sample while NAME is held, report changes
set -uo pipefail
P=$(cd "$(dirname "$0")/.." && pwd)
MODE=${1:-held}; NAME=${2:-key}; SECS=${3:-10}
ifc=$(for d in /sys/class/net/*; do [ "$(basename "$(readlink -f "$d/device/driver" 2>/dev/null)")" = cdc_ncm ] && basename "$d"; done | head -1 || true)
flock "$P/build/tab.lock" python3 -I - "fe80::57:aff:fe00:1%$ifc" "$MODE" "$NAME" "$SECS" "$P/build/keyscan-base.json" <<'PY'
import socket, sys, time, re, json
addr, mode, name, secs, basefile = sys.argv[1], sys.argv[2], sys.argv[3], int(sys.argv[4]), sys.argv[5]
BANKS = """etc1 0x14050004 gpa0 0x14050024 gpa1 0x14050044 gpa2 0x14050064 gpa3 0x14050084 gpq0 0x140500a4 gpa4 0x140500c4 gpb0 0x17c60004 gpb1 0x17c60024 gpb2 0x17c60044 gph0 0x13a80004 gph1 0x13a80024 gpm0 0x14220004 gpm1 0x14220024 gpm2 0x14220044 gpm3 0x14220064 gpm4 0x14220084 gpm5 0x142200a4 gpm6 0x142200c4 gpm7 0x142200e4 gpm10 0x14220104 gpm11 0x14220124 gpm12 0x14220144 gpm13 0x14220164 gpm14 0x14220184 gpm15 0x142201a4 gpm16 0x142201c4 gpm17 0x142201e4 gpm40 0x14220204 gpm41 0x14220224 gpm42 0x14220244 gpm43 0x14220264 gpf0 0x11050004 gpf1 0x11430004 gpf2 0x11430024 gpp0 0x10430004 gpp1 0x10430024 gpp2 0x10430044 gpp3 0x10430064 gpg0 0x10430084 gpg1 0x104300a4 gpg2 0x104300c4 gpp4 0x10830004 gpp5 0x10830024 gpp6 0x10830044 gpc0 0x10830064 gpc1 0x10830084 gpd0 0x108300a4 gpg3 0x108300c4""".split()
banks = list(zip(BANKS[0::2], BANKS[1::2]))

s = socket.create_connection((addr, 23), timeout=30)
s.settimeout(30)
def cmd(c):
    s.sendall((c + "\n").encode())
    buf = b""
    while not buf.endswith(b"> "):
        d = s.recv(65536)
        if not d:
            raise SystemExit("console closed")
        buf += d
    return buf[:-2].decode(errors="replace")
# the banner ends with the first prompt: consume it without sending anything
buf = b""
while not buf.endswith(b"> "):
    buf += s.recv(65536)
def snap():
    v = {}
    for n, a in banks:
        r = re.findall(r"0x[0-9a-fA-F]{8}", cmd("peek " + a))
        v[n] = int(r[-1], 16) if r else None
    irq = {}
    for l in cmd("cat /proc/interrupts").splitlines():
        m = re.match(r"\s*(\w+):\s+((?:\d+\s+)+)(.*)", l)
        if m:
            irq[m.group(1) + " " + m.group(3).strip()[-40:]] = sum(int(x) for x in m.group(2).split())
    return v, irq
if mode == "base":
    base = [snap() for _ in range(3)]
    noisy = sorted({n for n in base[0][0] if len({b[0][n] for b in base}) > 1})
    json.dump({"gpio": base[-1][0], "irq": base[-1][1], "noisy": noisy}, open(basefile, "w"))
    print(f"baseline saved: {len(banks)} banks, noisy {noisy}")
    raise SystemExit(0)
B = json.load(open(basefile))
b0, i0, noisy = B["gpio"], B["irq"], set(B["noisy"])
print(f"sampling {secs} s while {name} is held ...", flush=True)
held = []
t0 = time.time()
while time.time() - t0 < secs:
    held.append(snap())
print("done, release", flush=True)
for n, _ in banks:
    if n in noisy or b0[n] is None:
        continue
    vals = [h[0][n] for h in held if h[0][n] is not None]
    if not vals:
        continue
    diff = 0
    for v in vals:
        diff |= v ^ b0[n]
    steady = all((v ^ b0[n]) == diff for v in vals)
    if diff:
        bits = [i for i in range(8) if diff >> i & 1]
        print(f"GPIO {n}: bits {bits} changed {'steadily' if steady else 'intermittently'} "
              f"({b0[n]:#04x} -> {vals[len(vals)//2]:#04x})")
i1 = held[-1][1]
for k, c in i1.items():
    if k in i0 and c > i0[k]:
        print(f"IRQ {k}: +{c - i0[k]}")
print("noisy banks (ignored):", sorted(noisy))
PY
