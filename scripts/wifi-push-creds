#!/bin/bash
# Copy this laptop's current Wi-Fi network (NetworkManager) to the tablet,
# without printing the passphrase: the secret goes from nmcli into a 0600
# temp file, over the USB debug console, and the temp file is removed.
#
#   scripts/wifi-push-creds [CONNECTION]   (default: the active Wi-Fi one)
#
# On the bring-up init it writes /etc/wpa_supplicant.conf (used by
# scripts/wifi-test). On Duranium (gta3-console on port 23 as well) pass
# --nm to write a NetworkManager keyfile to
# /etc/NetworkManager/system-connections/ instead.
# Both forms are also cached in build/secrets/ (0600, gitignored, never
# printed) so later tests can push them again after a reflash.
set -euo pipefail
P=$(cd "$(dirname "$0")/.." && pwd)
NM=0
if [ "${1:-}" = "--nm" ]; then NM=1; shift; fi
CON=${1:-$(nmcli -t -f NAME,TYPE con show --active | awk -F: '$2=="802-11-wireless"{print $1; exit}')}
[ -n "$CON" ] || { echo "no active Wi-Fi connection" >&2; exit 1; }

umask 077
T=$(mktemp)
trap 'rm -f "$T"' EXIT
SSID=$(nmcli -g 802-11-wireless.ssid con show "$CON")
KM=$(nmcli -g 802-11-wireless-security.key-mgmt con show "$CON")
PSK=$(nmcli -s -g 802-11-wireless-security.psk con show "$CON")
case "$KM" in
wpa-psk|sae) ;;
*) echo "key management '$KM' not handled (only wpa-psk / sae)" >&2; exit 1 ;;
esac

if [ $NM = 0 ]; then
	{
		echo "ctrl_interface=/run/wpa_supplicant"
		echo "network={"
		printf '\tssid="%s"\n' "$SSID"
		printf '\tpsk="%s"\n' "$PSK"
		[ "$KM" = sae ] && printf '\tkey_mgmt=SAE\n\tieee80211w=2\n' || printf '\tkey_mgmt=WPA-PSK\n'
		echo "}"
	} > "$T"
	REMOTE=/etc/wpa_supplicant.conf
else
	{
		echo "[connection]"
		echo "id=$SSID"
		echo "type=wifi"
		echo "[wifi]"
		echo "mode=infrastructure"
		echo "ssid=$SSID"
		echo "[wifi-security]"
		echo "key-mgmt=$KM"
		echo "psk=$PSK"
		echo "[ipv4]"
		echo "method=auto"
		echo "[ipv6]"
		echo "method=auto"
	} > "$T"
	REMOTE="/etc/NetworkManager/system-connections/$SSID.nmconnection"
fi
unset PSK
mkdir -p -m 700 "$P/build/secrets"
if [ $NM = 0 ]; then cp "$T" "$P/build/secrets/wpa_supplicant.conf"
else cp "$T" "$P/build/secrets/wifi.nmconnection"; fi
flock "$P/build/tab.lock" "$P/scripts/tab-put" "$T" "$REMOTE" >/dev/null
if [ $NM = 1 ]; then
	# NetworkManager ignores keyfiles that others can read
	flock "$P/build/tab.lock" "$P/scripts/tab" "run /usr/bin/chmod 600 $REMOTE" >/dev/null
	flock "$P/build/tab.lock" "$P/scripts/tab" "run /usr/bin/nmcli connection reload" >/dev/null
fi
echo "pushed '$SSID' ($KM) to the tablet: $REMOTE"
